package components

// ChartTooltipProps describes the reading box a chart shows under the
// pointer. Class adds the chart's own placement, such as donut-tooltip.
type ChartTooltipProps struct {
	Class string
}

// ChartTooltip draws a chart's empty, hidden reading box. app.js fills it
// with a label and one row per series (chartTooltipRow) and places it beside
// the reading (placeChartTooltip).
templ ChartTooltip(p ChartTooltipProps) {
	<div class={ fieldClass("chart-tooltip", p.Class) } data-chart-tooltip aria-hidden="true" hidden></div>
}
