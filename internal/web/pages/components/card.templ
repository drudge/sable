package components

// CardProps describes a console card: the bordered, rounded panel that holds
// one area of a page.
type CardProps struct {
	// ID is the card's id, used by links, htmx targets, and tests.
	ID string
	// Article draws an <article> rather than a <section>, for a card that
	// stands on its own, such as a ranking on Home.
	Article bool
	// Class adds classes after "card", and Attrs go on the element, such as
	// htmx attributes, aria-label, or data hooks.
	Class string
	Attrs templ.Attributes
}

// Card draws a card around its children. A card with a title starts with
// CardHeader.
templ Card(p CardProps) {
	if p.Article {
		<article class={ fieldClass("card", p.Class) } if p.ID != "" { id={ p.ID } } { p.Attrs... }>
			{ children... }
		</article>
	} else {
		<section class={ fieldClass("card", p.Class) } if p.ID != "" { id={ p.ID } } { p.Attrs... }>
			{ children... }
		</section>
	}
}

// CardHeaderProps describes the title row at the top of a card.
type CardHeaderProps struct {
	// Icon names an Icon drawn before the title.
	Icon string
	// Glyph names an Icon drawn large in a tinted tile beside the title and
	// description, as on the Integrations cards.
	Glyph string
	Title string
	// TitleID is the heading's id, for a card labelled by its title.
	TitleID string
	// TitleClass adds classes to the heading.
	TitleClass string
	// Description is one short line under the title.
	Description string
	// DescriptionClass adds classes to the description, such as desktop-only.
	DescriptionClass string
	// HeadingClass adds classes to the block that holds the title and
	// description.
	HeadingClass string
	// Class adds classes to the header, and Attrs go on it.
	Class string
	Attrs templ.Attributes
}

// CardHeader draws a card's title and description. Its children are the
// card's header actions, which sit at the end of the row.
templ CardHeader(p CardHeaderProps) {
	<header if p.Class != "" { class={ p.Class } } { p.Attrs... }>
		if p.Glyph != "" {
			<div class="card-identity">
				<span class="card-glyph">@Icon(p.Glyph)</span>
				@cardHeading(p)
			</div>
		} else {
			@cardHeading(p)
		}
		{ children... }
	</header>
}

// cardHeading draws a card header's title and description.
templ cardHeading(p CardHeaderProps) {
	<div if p.HeadingClass != "" { class={ p.HeadingClass } }>
		<h2 if p.TitleID != "" { id={ p.TitleID } } if p.TitleClass != "" { class={ p.TitleClass } }>
			if p.Icon != "" {
				@Icon(p.Icon)<span>{ p.Title }</span>
			} else {
				{ p.Title }
			}
		</h2>
		if p.Description != "" {
			<p if p.DescriptionClass != "" { class={ p.DescriptionClass } }>{ p.Description }</p>
		}
	</div>
}
