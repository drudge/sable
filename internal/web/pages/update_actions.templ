package pages

import "github.com/drudge/sable/internal/web/pages/components"

const aboutUpdateNotesDialogID = "update-release-notes-dialog"
const notificationUpdateNotesDialogID = "notification-release-notes-dialog"
const clusterUpdateNotesDialogID = "cluster-release-notes-dialog"

func updateRestartAttributes(view UpdateView, continueURL string) templ.Attributes {
	if !view.Installed || !view.CanRestart {
		return nil
	}
	return templ.Attributes{
		"data-sable-restart": true,
		"data-restart-url": "/ui/updates/restart",
		"data-health-url": "/api/v1/health",
		"data-continue-url": continueURL,
		"data-updated-version": formatReleaseVersion(view.LatestVersion),
		"data-csrf-token": view.CSRFToken,
		"data-restart-confirm": updateRestartConfirmation(view),
		"data-restart-confirm-title": "Restart Sable?",
		"data-restart-confirm-action": "Restart Sable",
	}
}

templ updatePrimaryAction(view UpdateView, fromNotification bool) {
	if view.Busy {
		@components.Button(components.ButtonProps{Label: ifThen(view.Phase == "checking", "Checking…", "Installing…"), Icon: "refresh", Compact: true, Disabled: true, Class: "update-install-progress"})
	} else {
		switch updateAction(view) {
			case "restart":
				@components.Button(components.ButtonProps{Label: "Restart Sable", Icon: "power", Compact: true, Attrs: templ.Attributes{"data-sable-restart-button": true}})
			case "install":
				if view.CanUpdateCluster {
					@updateScopeButton(view, fromNotification)
				} else {
					@updateInstallButton(view, fromNotification)
				}
		}
	}
}

templ updateReleaseNotesButton(view UpdateView, dialogID string) {
	if view.ReleaseNotes != "" {
		@components.Button(components.ButtonProps{Label: "Release notes", Variant: components.ButtonOutline, Compact: true, Attrs: templ.Attributes{"id": dialogID + "-open", "data-dialog-open": dialogID}})
	} else if view.Available && !view.Installed && view.ReleaseURL != "" {
		<a id={ dialogID + "-open" } class="button outline compact" href={ templ.URL(view.ReleaseURL) } target="_blank" rel="noopener noreferrer"><span>Release notes</span>@Icon("external-link")</a>
	}
}

templ updateInstallButton(view UpdateView, fromNotification bool) {
	@updateInstallForm(view, fromNotification) {
		@components.Button(components.ButtonProps{Label: ifThen(fromNotification, "Install update", "Install v" + view.LatestVersion), Icon: "download", Compact: true, Type: "submit"})
	}
}

templ updateInstallForm(view UpdateView, fromNotification bool) {
	<form
		hx-post="/ui/updates/install"
		hx-target={ ifThen(fromNotification, "closest .toast-region", "#about-update") }
		hx-swap="outerHTML"
		hx-disable={ ifThen(fromNotification, "[data-update-version] button, [data-update-version] input", "#about-update button, #about-update input") }
		hx-confirm={ updateInstallConfirmation(view) }
		data-confirm-title="Install this release?"
		data-confirm-action="Download &amp; Install"
		data-confirm-tone="neutral"
	>
		if fromNotification {
			<input type="hidden" name="notification" value="true"/>
		}
		<input type="hidden" name="pre_release" value={ ifThen(view.IncludePreRelease, "true", "false") }/>
		{ children... }
	</form>
}

// updateScopeButton lets a primary install on this node or update the whole
// cluster. The notification and About share one remembered choice, so either
// one offers what was picked last.
templ updateScopeButton(view UpdateView, fromNotification bool) {
	{{ prefix := ifThen(fromNotification, "notification", "about") }}
	<div class="update-split-button" data-update-scope>
		<div data-update-scope-action="node">
			@updateInstallForm(view, fromNotification) {
				@components.Button(components.ButtonProps{Label: ifThen(fromNotification, "Install update", "Install v" + view.LatestVersion), Compact: true, Type: "submit", Attrs: templ.Attributes{"id": prefix + "-update-node"}})
			}
		</div>
		<div data-update-scope-action="cluster" hidden>
			@clusterUpdateForm(view.LatestVersion, prefix) {
				@components.Button(components.ButtonProps{Label: "Update cluster", Compact: true, Type: "submit", Attrs: templ.Attributes{"id": prefix + "-update-cluster"}})
			}
		</div>
		<button id={ prefix + "-update-scope" } class="button compact update-scope-trigger" type="button" aria-label="Choose update scope" aria-haspopup="menu" aria-expanded="false" aria-controls={ prefix + "-update-scope-menu" } data-update-scope-trigger>@Icon("chevron-down")</button>
		<div id={ prefix + "-update-scope-menu" } class="update-scope-menu" role="menu" aria-label="Update scope" popover="manual">
			@updateInstallForm(view, fromNotification) {
				<button class="update-scope-option" type="submit" role="menuitemradio" aria-checked="true" data-update-scope-option="node">@Icon("server")<span><strong>This node</strong><small>Install here, then restart when ready.</small></span>@Icon("check")</button>
			}
			@clusterUpdateForm(view.LatestVersion, prefix) {
				<button class="update-scope-option" type="submit" role="menuitemradio" aria-checked="false" data-update-scope-option="cluster">@Icon("cluster")<span><strong>Entire cluster</strong><small>Update all nodes, one at a time.</small></span>@Icon("check")</button>
			}
		</div>
	</div>
}

templ updateReleaseNotesDialog(view UpdateView, dialogID string) {
	if view.ReleaseNotes != "" {
		@components.Dialog(components.DialogProps{ID: dialogID, Title: "Sable v" + view.LatestVersion, Description: "Release notes", Class: "update-release-dialog"}) {
			<div class="scroll-fade-frame">
				<div class="release-notes-content" data-scroll-fade>
					@templ.Raw(releaseNotesHTML(view.ReleaseNotes))
				</div>
				@ScrollFadeHint()
			</div>
			<div class="dialog-footer">
				if view.ReleaseURL != "" {
					<a class="button outline" href={ templ.URL(view.ReleaseURL) } target="_blank" rel="noopener noreferrer"><span>View release</span>@Icon("external-link")</a>
				}
				@components.Button(components.ButtonProps{Label: "Done", Attrs: templ.Attributes{"data-dialog-close": true}})
			</div>
		}
	}
}
