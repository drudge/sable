package pages

import (
	"fmt"
	"net/url"
	"strings"
)

templ DashboardHome(view DashboardView) {
	<div class="dashboard-page isotope-dashboard">
		<h1 class="sr-only">Dashboard</h1>
		@Stats(dashboardStatsOverview(view))
		@QueryChart(view.Chart)
		@DashboardInsights(view.Insights, false)
		<footer class="dashboard-footer">
			<span><i></i>Sable operational</span>
			<span>{ view.DNSSECStatus }</span>
			<span>{ view.Database }</span>
			<span>{ view.DNSListeners }</span>
			<span>Revision { fmt.Sprint(view.ConfigRevision) }</span>
			<span>v{ view.Version }</span>
		</footer>
	</div>
}

func dashboardStatsOverview(view DashboardView) StatsOverviewView {
	scope := view.StatsScope
	values := view.Stats
	if scope == StatsScopeRange {
		values = view.Chart.Stats
	} else {
		scope = StatsScopeAll
	}
	return StatsOverviewView{
		Values:      values,
		Lifetime:    view.Stats,
		Scope:       scope,
		RangeName:   view.Chart.ActiveRange,
		RangeLabel:  view.Chart.RangeLabel,
		CustomStart: view.Chart.CustomStart,
		CustomEnd:   view.Chart.CustomEnd,
	}
}

// DashboardInsights carries the rankings and distributions for one time range.
// The chart's range picker swaps this block in alongside the plot, so an
// operator who asks for a week is ranked over that week rather than over a
// fixed sample of the newest rows.
templ DashboardInsights(view DashboardInsightsView, outOfBand bool) {
	<div
		class="dashboard-insights"
		id="dashboard-insights"
		if view.PollRange != "" {
			hx-get={ templ.SafeURL("/ui/stats/insights?range=" + view.PollRange) }
			hx-trigger="every 60s"
			hx-swap="outerHTML"
		}
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		<section class="dashboard-rankings" aria-label="Query rankings">
			@RankedPanel("Top Clients", "clients", view.TopClients, view)
			@RankedPanel("Top Domains", "domains", view.TopDomains, view)
			@RankedPanel("Top Blocked Domains", "blocked", view.TopBlocked, view)
		</section>
		<section class="dashboard-distributions" aria-label="Query distributions">
			@DistributionPanel("Query Types", view.QueryTypes)
			@DistributionPanel("Response Sources", view.ResponseSources)
			@DistributionPanel("Response Codes", view.ResponseCodes)
		</section>
	</div>
}

templ RankedPanel(title string, kind string, items []RankedStatView, insights DashboardInsightsView) {
	<article class="card ranking-card">
		<header>
			<div class="ranking-heading">
				<h2>{ title }</h2>
				if insights.RangeLabel != "" {
					<small>{ insights.RangeLabel }</small>
				}
			</div>
			<button class="ranking-view-all" type="button" data-dialog-open={ "top-stats-" + kind + "-dialog" }>
				<span>View all</span>
				@Icon("chevron-right")
			</button>
		</header>
		<div class="ranking-list">
			if len(items) == 0 {
				<div class="dashboard-empty">No queries in this range</div>
			}
			for _, item := range firstRanked(items, 5) {
				<a class="ranking-row" href={ templ.SafeURL(topStatsEntryURL(kind, item.Name, insights.LogWindowQuery)) }>
					<div>
						<strong title={ item.Name }>{ item.Name }</strong>
						if item.Secondary != "" {
							<small title={ item.Secondary }>{ item.Secondary }</small>
						}
					</div>
					<span>{ compactNumber(item.Value) }</span>
				</a>
			}
		</div>
	</article>
	@TopStatsDialog(title, kind, items, insights)
}

templ TopStatsDialog(title string, kind string, items []RankedStatView, insights DashboardInsightsView) {
	<dialog class="custom-server-dialog top-stats-dialog" id={ "top-stats-" + kind + "-dialog" } aria-labelledby={ "top-stats-" + kind + "-title" } data-top-stats-dialog>
		<header class="top-stats-header">
			<h2 id={ "top-stats-" + kind + "-title" }>{ title }</h2>
			if insights.RangeLabel != "" {
				<span class="top-stats-range">{ insights.RangeLabel }</span>
			}
			<button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		</header>
		<div class="top-stats-toolbar">
			<label class="top-stats-search">@Icon("search")<span class="sr-only">Filter { strings.ToLower(title) }</span><input type="search" placeholder={ topStatsPlaceholder(kind) } data-top-stats-search/></label>
			<label class="top-stats-limit"><span class="sr-only">Number of results</span><select data-top-stats-limit><option value="25">Top 25</option><option value="100" selected>Top 100</option><option value="250">Top 250</option><option value="1000">Top 1000</option></select></label>
		</div>
		<div class="top-stats-list">
			if len(items) == 0 {
				<div class="top-stats-empty">No data for this period</div>
			}
			for index, item := range items {
				<a class="top-stats-row" href={ templ.SafeURL(topStatsEntryURL(kind, item.Name, insights.LogWindowQuery)) } data-top-stats-row data-rank={ fmt.Sprint(index + 1) } data-search={ strings.ToLower(item.Name + " " + item.Secondary) } data-hits={ fmt.Sprint(item.Value) }>
					<span class="top-stats-rank">{ fmt.Sprint(index + 1) }</span>
					<div>
						<strong title={ item.Name }>{ item.Name }</strong>
						if item.Secondary != "" {
							<small title={ item.Secondary }>{ item.Secondary }</small>
						}
					</div>
					<span class="top-stats-hits">{ formatNumber(item.Value) }</span>
				</a>
			}
			<div class="top-stats-empty" data-top-stats-empty hidden>No entries match your filter</div>
		</div>
		<footer class="top-stats-footer" hidden?={ len(items) == 0 }><span data-top-stats-count>{ fmt.Sprint(min(len(items), 100)) } { topStatsNoun(kind) }</span><span data-top-stats-total>{ formatNumber(rankedTotal(firstRanked(items, 100))) } hits</span></footer>
	</dialog>
}

templ DistributionPanel(title string, items []DistributionItemView) {
	<article class="card distribution-card">
		<header><h2>{ title }</h2></header>
		<div class="distribution-content" data-donut>
			<div class="donut-wrap" aria-label={ title + " chart" }>
				<svg viewBox="0 0 120 120" role="img">
					<circle class="donut-track" cx="60" cy="60" r="44" pathLength="100"/>
					for index, item := range items {
						<circle
							class={ fmt.Sprintf("donut-segment donut-color-%d", item.Color) }
							cx="60" cy="60" r="44" pathLength="100"
							stroke-dasharray={ fmt.Sprintf("%.3f %.3f", item.Percent, 100-item.Percent) }
							stroke-dashoffset={ fmt.Sprintf("%.3f", item.Offset) }
							data-donut-segment={ fmt.Sprint(index) }
							data-donut-label={ item.Name }
							data-donut-value={ formatNumber(item.Value) }
							data-donut-share={ fmt.Sprintf("%.1f%% of total", item.Percent) }
						/>
					}
				</svg>
				if len(items) == 0 {
					<span>No data</span>
				}
			</div>
			<div class="distribution-legend">
				if len(items) == 0 {
					<div class="dashboard-empty compact">Waiting for queries</div>
				}
				for index, item := range items {
					<div data-donut-legend={ fmt.Sprint(index) }><i class={ fmt.Sprintf("donut-color-%d", item.Color) }></i><span title={ item.Name }>{ item.Name }</span><strong>{ compactNumber(item.Value) }</strong></div>
				}
			</div>
			if len(items) > 0 {
				<div class="chart-tooltip donut-tooltip" data-donut-tooltip aria-hidden="true" hidden></div>
			}
		</div>
	</article>
}

func compactNumber(value uint64) string {
	switch {
	case value >= 1_000_000:
		return fmt.Sprintf("%.1fM", float64(value)/1_000_000)
	case value >= 1_000:
		return fmt.Sprintf("%.1fK", float64(value)/1_000)
	default:
		return fmt.Sprint(value)
	}
}

func firstRanked(items []RankedStatView, limit int) []RankedStatView { return items[:min(len(items), limit)] }
func rankedTotal(items []RankedStatView) uint64 { var total uint64; for _, item := range items { total += item.Value }; return total }
func topStatsNoun(kind string) string { if kind == "clients" { return "clients" }; return "domains" }
func topStatsPlaceholder(kind string) string { if kind == "clients" { return "Filter clients..." }; return "Filter domains..." }
// topStatsEntryURL opens the query log on exactly what the ranking counted:
// the same entry, over the same window, matched whole rather than as a
// substring that would also sweep in 10.0.7.168 for 10.0.7.16.
func topStatsEntryURL(kind string, name string, window string) string {
	key := "name"
	if kind == "clients" { key = "client_ip" }
	value := "/logs?tab=queries&" + key + "=" + url.QueryEscape(name)
	if kind == "blocked" { value += "&source=blocked" }
	if window != "" { value += "&" + window }
	return value
}
