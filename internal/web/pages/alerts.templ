package pages

import (
	"fmt"
	"slices"
	"strings"
)

// AlertsState is whether alerts go out, as Settings > Alerts and the Insights
// bell say it.
type AlertsState string

const (
	// AlertsOn means alerts are not paused and some destination can send.
	AlertsOn AlertsState = "on"
	// AlertsPaused means an operator paused them. Nothing is sent, and what
	// comes up meanwhile is not sent later.
	AlertsPaused AlertsState = "paused"
	// AlertsOff means no destination can send yet.
	AlertsOff AlertsState = "off"
)

// AlertsView is Settings > Alerts: whether alerts go out, where they go and
// how sending there has gone, which groups are on, and the browsers that
// turned alerts on.
type AlertsView struct {
	// Available is false on a server that runs the console without alerts,
	// which then shows a note in place of the tab.
	Available bool
	// CanEdit is set for operators who may change settings. Everyone else sees
	// the tab without its buttons.
	CanEdit bool
	State   AlertsState
	// Destinations are where alerts go, in the order they were added.
	Destinations []AlertDestinationView
	Groups       AlertGroupsView
	// Push is set when this server can push alerts to browsers. Browsers are
	// the ones that turned alerts on, and BrowserDestination is set when a
	// destination sends to them.
	Push               bool
	Browsers           []AlertBrowserView
	BrowserDestination bool
	// NewDestination is the empty form the Add Destination dialog opens with.
	NewDestination AlertDestinationFormView
	Message        string
	Error          string
}

// AlertDestinationView is one destination as the list shows it. Nothing in it
// is a secret: the address comes cut short.
type AlertDestinationView struct {
	ID    string
	Label string
	// Format is "json", "text", "slack", "discord", "pushover", or "browser",
	// and FormatLabel names it the way people know it, such as "ntfy".
	Format      string
	FormatLabel string
	// Address is where it sends with its secret part cut short, such as
	// "https://ntfy.sh/••••erts" or "2 browsers".
	Address string
	// Everything is set when the destination gets every group. Otherwise
	// Groups names the ones it gets.
	Everything bool
	Groups     []string
	// Problem says why it cannot send yet, such as a URL that was never
	// saved.
	Problem string
	// LastSent and LastSentTitle describe the last alert it was sent since
	// Sable started, and LastError the send that failed after it, if one did.
	LastSent      string
	LastSentTitle string
	LastError     string
	LastErrorAt   string
}

// AlertGroupsView is which alert groups are on.
type AlertGroupsView struct {
	Insights     bool
	Cluster      bool
	Updates      bool
	Integrations bool
	// Backups is "failures", "all", or "off".
	Backups string
	Server  bool
	SignIns bool
	// SignInsAfter failed sign-ins within SignInsWithin minutes send one
	// alert.
	SignInsAfter  int
	SignInsWithin int
	// InsightKinds are the kinds of finding that can alert, each with its own
	// switch under Insights Findings.
	InsightKinds []AlertInsightKindView
	// InsightSettings opens Insights settings, for the limits and what shows
	// in Insights. Empty for an operator who cannot open them.
	InsightSettings string
}

// AlertInsightKindView is one kind of finding and whether it alerts. Its
// switch changes the same setting Insights settings does.
type AlertInsightKindView struct {
	// Key names the switch, as insight_alert_<key>.
	Key   string
	Title string
	Alert bool
	// Hidden marks a kind turned off in Insights. Turning its alerts on shows
	// it again.
	Hidden bool
}

// AlertBrowserView is one browser that turned alerts on.
type AlertBrowserView struct {
	ID    string
	Label string
	// Added says when it turned alerts on, and who did.
	Added string
}

// AlertDestinationFormView is the Add or Edit Destination dialog. Saved
// secrets never come back to the browser: each shows cut short as its field's
// placeholder, and a field left blank keeps what is saved.
type AlertDestinationFormView struct {
	// ID is empty for a new destination.
	ID   string
	Name string
	// Format is "json", "text", "slack", "discord", "pushover", or "browser".
	Format      string
	NtfyReceipt bool
	// Sends lists the groups the destination gets. Empty means every group.
	Sends []string
	// Groups are every group, in the order the console shows them.
	Groups []AlertGroupChoice
	// SavedURL, SavedPushoverToken, and SavedPushoverUser are what is saved,
	// cut short, or empty when nothing is.
	SavedURL           string
	SavedPushoverToken string
	SavedPushoverUser  string
	Headers            []AlertHeaderView
	// Push is set when this server can push to browsers, and BrowsersTaken
	// when another destination already does.
	Push          bool
	BrowsersTaken bool
}

// AlertGroupChoice is one group a destination can pick. Off is set when the
// group is switched off for every destination.
type AlertGroupChoice struct {
	Key   string
	Label string
	Off   bool
}

// AlertHeaderView is one extra header sent with each alert. Saved is its
// saved value cut short; the value itself is never sent back.
type AlertHeaderView struct {
	Name  string
	Saved string
}

// AlertPreview is a sample alert laid out the way it would be sent.
type AlertPreview struct {
	Method      string
	URL         string
	ContentType string
	Headers     []AlertHeaderPreview
	Body        string
	Error       string
}

// AlertHeaderPreview is one header a previewed alert carries.
type AlertHeaderPreview struct {
	Name  string
	Value string
}

// Text is the request as it would go over the wire, headers then body.
func (preview AlertPreview) Text() string {
	var text strings.Builder
	text.WriteString(preview.Method + " " + ifThen(preview.URL != "", preview.URL, "(no URL yet)") + "\n")
	text.WriteString("Content-Type: " + preview.ContentType + "\n")
	for _, header := range preview.Headers {
		text.WriteString(header.Name + ": " + header.Value + "\n")
	}
	text.WriteString("\n" + preview.Body)
	return text.String()
}

// alertGroupLabels names each alert group the way the console shows it.
var alertGroupLabels = map[string]string{
	"insights": "Insights Findings", "cluster": "Cluster", "updates": "Sable Updates", "integrations": "Integrations",
	"backups": "Backups", "server": "Server Health", "sign_ins": "Failed Sign-Ins",
}

// AlertGroupLabel names an alert group the way the console shows it.
func AlertGroupLabel(group string) string {
	if label, found := alertGroupLabels[group]; found {
		return label
	}
	return group
}

