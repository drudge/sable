package pages

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/drudge/sable/internal/blocking"
	"github.com/drudge/sable/internal/web/pages/components"
)

type BlockingPageView struct {
	Console DashboardView
	Enabled bool
	PausedUntil time.Time
	CompiledDomains int
	BlockedQueries uint64
	Domains []string
	AllowedDomains []string
	Lists []BlockListSourceView
	RemoteListCount int
	UpdateHours int
	LastUpdate time.Time
	NextUpdate time.Time
	Updating bool
	DegradedLists int
	RuleSets []RuleSetView
	// DefaultLists names the block lists for devices without a rule set;
	// empty means every list.
	DefaultLists []string
	ActiveTab string
	Message string
	Error string
	// OutOfBand marks the page content sent alongside a panel's own response,
	// so both update from one request.
	OutOfBand bool
}

type BlockListSourceView struct {
	Name string
	ConfiguredPath string
	Path string
	URL string
	Format string
	Lines int
	Accepted int
	Invalid int
	Exceptions int
	Unsupported int
	Healthy bool
	HealthSummary string
	HealthDetail string
}

type BlockListCatalogItem struct { Name, Description, URL, Category string }

var blockListCatalog = []BlockListCatalogItem{
	{"OISD Big", "Comprehensive list blocking ads, trackers, and malware", "https://big.oisd.nl/", "popular"},
	{"OISD Small", "Lightweight version with fewer false positives", "https://small.oisd.nl/", "popular"},
	{"Steven Black Unified", "Unified hosts file with adware and malware extensions", "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts", "popular"},
	{"Hagezi Pro", "Multi-source blocklist with strong protection", blocking.HageziProURL, "popular"},
	{"AdGuard DNS Filter", "Official AdGuard DNS filter list", "https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt", "ads"},
	{"AdAway Default", "Default blocklist from the AdAway project", "https://adaway.org/hosts.txt", "ads"},
	{"EasyList", "Primary advertising filter list", "https://easylist.to/easylist/easylist.txt", "ads"},
	{"Peter Lowe Ad/Tracking", "Known advertising and tracking servers", "https://pgl.yoyo.org/adservers/serverlist.php?hostformat=hosts&showintro=0", "ads"},
	{"URLhaus Malicious URLs", "Malware distribution sites from abuse.ch", "https://urlhaus.abuse.ch/downloads/hostfile/", "malware"},
	{"Phishing Army", "Community phishing domain blocklist", "https://phishing.army/download/phishing_army_blocklist.txt", "malware"},
	{"EasyPrivacy", "Tracking and privacy protection", "https://easylist.to/easylist/easyprivacy.txt", "privacy"},
	{"Steven Black + Social", "Base list with social media sites blocked", "https://raw.githubusercontent.com/StevenBlack/hosts/master/alternates/social/hosts", "social"},
}

// blockingTabs drives both the tab strip and the document title so the browser
// tab names the list an operator is actually looking at.
var blockingTabs = []tabOption{
	{"lists", "Block Lists", "list"},
	{"domains", "Blocked", "shield-x"},
	{"allowed", "Allowed", "shield-check"},
	{"rule-sets", "Rule Sets", "users"},
}

templ BlockingPage(view BlockingPageView) {
	@AppDocument(view.Console, documentTitle(tabLabel(blockingTabs, view.ActiveTab), "DNS Blocking"), blockingNavigationPage(view), blockingDocument(view))
}

// blockingDocument keeps the block list panel outside the page content, so
// the page can refresh beneath it while it stays open.
templ blockingDocument(view BlockingPageView) {
	@BlockingContent(view)
	@checkDomainDialog()
	@ruleSetDrawer()
	<dialog class="query-detail-dialog block-list-dialog" id="block-list-dialog" aria-labelledby="block-list-title" { blockListDrawerRoute()... }>
		<div class="query-detail-content" id="block-list-content">
			@blockListLoading()
		</div>
	</dialog>
	<template id="block-list-loading">
		@blockListLoading()
	</template>
}

templ BlockingContent(view BlockingPageView) {
	<div
		class="blocking-page page-stack"
		id="blocking-content"
		data-blocking-root
		data-title-base="DNS Blocking"
		if view.OutOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		@components.PageHeader(components.PageHeaderProps{Title: "DNS Blocking", Description: "Block unwanted domains using block lists and custom rules"})
		@Toast(view.Message, "success")
		@Toast(view.Error, "error")
		<template data-block-list-error-toast>
			@ToastSticky("Could not confirm the block list changes. Check your connection and refresh the page before trying again.", "error")
		</template>
		<div class="blocking-layout isotope-blocking-layout">
			<div class="blocking-main-column">
				@BlockingStatus(view)
				@checkDomainSearch()
				<section class="blocking-workspace">
					<div class="blocking-tabs" role="tablist" aria-label="Blocking configuration">
						for _, tab := range blockingTabs {
							@BlockingTab(tab, view.ActiveTab)
						}
					</div>
					<div class="blocking-panel isotope-list-panel" id="blocking-panel-lists" role="tabpanel" aria-labelledby="blocking-tab-lists" data-blocking-panel="lists" hidden?={ view.ActiveTab != "lists" }>
						<div class="blocking-list-toolbar">
							@components.Button(components.ButtonProps{Label: "Add Block List", Icon: "plus", Attrs: templ.Attributes{"data-dialog-open": "add-block-list-dialog", "data-replica-primary-action": true}})
						</div>
						<div class="blocking-source-list isotope-source-list">
							if len(view.Lists) == 0 {
								@components.EmptyState(components.EmptyStateProps{Icon: "list", Title: "No block lists configured", Description: "Add a curated list or custom URL to start blocking domains automatically.", Class: "blocking-empty"})
							}
							for _, list := range view.Lists {
								@BlockListRow(list)
							}
						</div>
					</div>
					@DomainPanel("domains", view.Domains, view.ActiveTab, false, view.RuleSets)
					@DomainPanel("allowed", view.AllowedDomains, view.ActiveTab, true, view.RuleSets)
					@RuleSetsPanel(view)
				</section>
			</div>
			<aside class="blocking-aside isotope-blocking-aside">
				@components.Card(components.CardProps{Class: "blocking-guidance"}) {
					<h2>How DNS Blocking Works</h2>@BlockingGuide("red", "Block Lists", "Subscribe to curated lists that automatically block ads, trackers, and malware")@BlockingGuide("red", "Custom Blocked Domains", "Manually add specific domains you want to block")@BlockingGuide("green", "Allowed Domains", "Override blocks for domains you need to access")
				}
				@components.Card(components.CardProps{Class: "blocking-guidance popular-lists"}) {
					<h2>Popular Block Lists</h2>@BlockingGuide("green", "Steven Black's Hosts", "Ads, malware, fakenews")@BlockingGuide("green", "OISD", "Comprehensive blocking")@BlockingGuide("green", "AdGuard DNS Filter", "Ads and tracking")
				}
				<div class="tip-box"><strong>Tip:</strong> Block lists update automatically every { fmt.Sprint(view.UpdateHours) } hours. Change this in <a href="/settings?tab=blocking#block-list-updates">Settings → Blocking</a>.</div>
			</aside>
		</div>
		@AddBlockListDialog(view.Lists)
		@DomainDialog("add-blocked-domain-dialog", "Add Blocked Domain", "/ui/blocking/domains/add", "Block Domain", "Enter a domain to block. Use a wildcard such as *.example.com to represent subdomains.")
		@DomainDialog("add-allowed-domain-dialog", "Add Allowed Domain", "/ui/blocking/allowed/add", "Allow Domain", "Exact entries allow only that name. Use *.example.com to allow its subdomains.")
		@FlushDomainDialog("flush-blocked-dialog", "Clear Custom Blocked Domains?", "/ui/blocking/domains/flush", len(view.Domains))
		@RuleSetDialog()
		@FlushDomainDialog("flush-allowed-dialog", "Clear Allowed Domains?", "/ui/blocking/allowed/flush", len(view.AllowedDomains))
	</div>
}

templ BlockingStatus(view BlockingPageView) {
	@components.Card(components.CardProps{Class: "blocking-status-card"}) {
		@components.CardHeader(components.CardHeaderProps{Icon: ifThen(view.Enabled && view.PausedUntil.IsZero(), "shield", "shield-off"), Title: "Blocking Status", Description: blockingStatusDescription(view)}) {
			<div class="blocking-status-actions"><a class="icon-button" href="/settings?tab=blocking" aria-label="Blocking settings" title="Blocking settings">@Icon("settings")</a><button class="button outline" hx-post="/ui/blocking/toggle" hx-target="#blocking-content" hx-swap="outerHTML">@Icon(ifThen(view.Enabled, "shield-off", "shield"))<span>{ ifThen(view.Enabled, "Disable", "Enable") }</span></button></div>
		}
		<div class="operational-metric-grid blocking-status-stats">
			@OperationalMetricCard("ban", "Blocked (Last Hour)", formatNumber(view.BlockedQueries), "Queries stopped by blocking policy", "red")
			@OperationalMetricCard("list", "Domains in Block Lists", formatNumber(uint64(view.CompiledDomains)), "Unique compiled blocking entries", "blue")
			@OperationalMetricCard("zap", "Active Block Lists", formatNumber(uint64(len(view.Lists))), blockListHealthDescription(view.DegradedLists), blockListHealthColor(view.DegradedLists))
		</div>
		<footer class="blocking-quick-actions">
			if !view.PausedUntil.IsZero() {
				@components.Button(components.ButtonProps{Label: "Resume Blocking", Icon: "play", Variant: components.ButtonOutline, Attrs: templ.Attributes{"hx-post": "/ui/blocking/resume", "hx-target": "#blocking-content", "hx-swap": "outerHTML", "data-blocking-resume": true}})
			} else {
				@components.Menu(components.MenuProps{Label: "Pause Blocking", Icon: "clock", Variant: components.ButtonOutline, Class: "pause-menu", Attrs: templ.Attributes{"data-blocking-pause-menu": true}, TriggerAttrs: templ.Attributes{"data-replica-primary-action": true}}) {<div><button hx-post="/ui/blocking/pause" hx-vals='{"minutes":"5"}' hx-target="#blocking-content" hx-swap="outerHTML">5 minutes</button><button hx-post="/ui/blocking/pause" hx-vals='{"minutes":"15"}' hx-target="#blocking-content" hx-swap="outerHTML">15 minutes</button><button hx-post="/ui/blocking/pause" hx-vals='{"minutes":"30"}' hx-target="#blocking-content" hx-swap="outerHTML">30 minutes</button><button hx-post="/ui/blocking/pause" hx-vals='{"minutes":"60"}' hx-target="#blocking-content" hx-swap="outerHTML">1 hour</button></div>}
			}
			<button class={ ifThen(view.Updating, "button outline blocking-update-button is-updating", "button outline blocking-update-button") } hx-post="/ui/blocking/lists/update" hx-target="#blocking-content" hx-swap="outerHTML" hx-disable="this" disabled?={ view.RemoteListCount == 0 || view.Updating } aria-label={ ifThen(view.Updating, "Updating block lists", "Update block lists") } data-blocking-update>@Icon("refresh")<span class="update-label">{ ifThen(view.Updating, "Updating…", "Update Block Lists") }</span></button>
			if !view.NextUpdate.IsZero() && view.RemoteListCount > 0 {
				<small><span>Next update</span><strong>{ FormatShortDateTime(view.NextUpdate, view.Console.TimeDisplay, false) }</strong></small>
			}
		</footer>
	}
}

templ BlockListRow(list BlockListSourceView) {
	<article class="blocking-source-row isotope-source-row" data-row-opener>
		<span class="blocking-source-icon">@Icon("list")</span>
		<div>
			<button class="blocking-source-name" type="button" { drawerOpener(BlockListDrawerLink(list.Name))... } aria-label={ "View details for " + list.Name }>{ list.Name }</button>
			<code title={ ifThen(list.URL != "", list.URL, list.ConfiguredPath) }>{ blockListLocation(list) }</code>
			<small>{ strings.ToUpper(list.Format) } · { formatNumber(uint64(list.Accepted)) } domains · { formatNumber(uint64(list.Invalid)) } invalid</small>
			if !list.Healthy {
				<small class="blocklist-health-warning" title={ list.HealthDetail }>@Icon("alert-triangle")<span>{ list.HealthSummary }</span></small>
			}
		</div>
		if list.URL != "" {
			<a class="icon-button" href={ templ.SafeURL(list.URL) } target="_blank" rel="noreferrer" aria-label={ "Open " + list.Name }>@Icon("external-link")</a>
		}
		<button class="icon-button danger" type="button" hx-post="/ui/blocking/lists/delete" hx-vals={ fmt.Sprintf("{\"name\":%q}", list.Name) } hx-target="#blocking-content" hx-swap="outerHTML" hx-confirm={ "Remove " + list.Name + " from the block lists?" } data-confirm-title="Remove block list?" data-confirm-action="Remove Block List" aria-label={ "Remove " + list.Name }>@Icon("trash")</button>
	</article>
}

templ DomainPanel(value string, domains []string, active string, allowed bool, ruleSets []RuleSetView) {
	<div class="blocking-panel isotope-domain-panel" id={ "blocking-panel-" + value } role="tabpanel" aria-labelledby={ "blocking-tab-" + value } data-blocking-panel={ value } hidden?={ active != value }>
		<div class="domain-list-toolbar">
			@components.Button(components.ButtonProps{Label: "Add Domain", Icon: "plus", Class: "domain-list-add", Attrs: templ.Attributes{"data-dialog-open": ifThen(allowed, "add-allowed-domain-dialog", "add-blocked-domain-dialog"), "data-replica-primary-action": true}})
			<form class="domain-import-form domain-list-import" hx-post={ ifThen(allowed, "/ui/blocking/allowed/import", "/ui/blocking/domains/import") } hx-encoding="multipart/form-data" hx-target="#blocking-content" hx-swap="outerHTML"><label class="button outline" data-replica-primary-action>@Icon("upload")<span>Import</span><input class="sr-only" type="file" name="file" accept=".txt,.hosts,text/plain" data-domain-import required/></label></form>
			if len(domains) > 0 {
				@components.Button(components.ButtonProps{Label: "Export", Icon: "download", Variant: components.ButtonOutline, Href: templ.SafeURL(ifThen(allowed, "/ui/blocking/allowed/export", "/ui/blocking/domains/export")), Class: "domain-list-export", Attrs: templ.Attributes{"download": ifThen(allowed, "allowed-domains.txt", "blocked-domains.txt")}})
			} else {
				<span class="button outline disabled domain-list-export" aria-disabled="true">@Icon("download")<span>Export</span></span>
			}
			@components.Button(components.ButtonProps{Label: "Clear All", Icon: "trash", Destructive: true, Disabled: len(domains) == 0, Class: "domain-list-clear", Attrs: templ.Attributes{"data-dialog-open": ifThen(allowed, "flush-allowed-dialog", "flush-blocked-dialog"), "data-replica-primary-action": true}})
		</div>
		@SearchField("Search " + domainPolicyKind(allowed) + " domains", "Search " + domainPolicyKind(allowed) + " domains...", "", "blocking-search", templ.Attributes{"data-domain-search": value})
		<div class="blocked-domain-list">
			if len(domains) == 0 {
				@components.EmptyState(components.EmptyStateProps{Description: "No " + domainPolicyKind(allowed) + " domains yet. Add your first domain to get started.", Class: "blocking-empty domain-list-empty"})
			}
			for _, domain := range domains {
				@PolicyDomainRow(domain, allowed, value, policyRemoveAttrs(domain, allowed, "/ui/blocking/"+ifThen(allowed, "allowed", "domains")+"/delete", fmt.Sprintf("{\"domain\":%q}", domain), "#blocking-content", "outerHTML", ""))
			}
			@components.EmptyState(components.EmptyStateProps{Description: "No domains match your search.", Class: "blocking-filter-empty", Attrs: templ.Attributes{"data-domain-empty": value, "hidden": true}})
		</div>
		<p class="domain-list-count"><span data-domain-total={ value }>{ formatNumber(uint64(len(domains))) }</span> { plural(len(domains), "domain", "domains") } in { domainPolicyKind(allowed) } list <span data-domain-shown={ value } hidden></span></p>
		@ruleSetDomainsNote(ruleSets, allowed)
	</div>
}

templ BlockingTab(tab tabOption, active string) { <button type="button" role="tab" id={ "blocking-tab-" + tab.Value } class={ ifThen(tab.Value == active, "active", "") } aria-label={ tab.Label } aria-selected={ fmt.Sprint(tab.Value == active) } aria-controls={ "blocking-panel-" + tab.Value } tabindex={ ifThen(tab.Value == active, "0", "-1") } data-blocking-tab={ tab.Value } data-tab-title={ tab.Label }>@Icon(tab.Icon)<span>{ tab.Label }</span></button> }

templ BlockingGuide(color, title, description string) { <div><i class={ color }></i><p><strong>{ title }</strong><span>{ description }</span></p></div> }

templ AddBlockListDialog(existing []BlockListSourceView) {
	@components.Dialog(components.DialogProps{ID: "add-block-list-dialog", TitleID: "add-block-list-title", Title: "Add Block List", Description: "Choose from popular block lists or enter a custom URL", Class: "blocking-dialog catalog-dialog", Attrs: templ.Attributes{"data-catalog-tabs": true}}) {
		<div class="catalog-tabs" role="tablist" aria-label="Block list categories">
			for _, category := range []string{"popular", "ads", "malware", "privacy", "social", "custom"} {
				<button type="button" role="tab" id={ "catalog-tab-" + category } class={ ifThen(category == "popular", "active", "") } aria-selected={ fmt.Sprint(category == "popular") } aria-controls={ "catalog-panel-" + category } tabindex={ ifThen(category == "popular", "0", "-1") } data-catalog-tab={ category }>{ strings.ToUpper(category[:1]) + category[1:] }</button>
			}
		</div>
		<div class="catalog-scroll">
			for _, category := range []string{"popular", "ads", "malware", "privacy", "social"} {
				<div id={ "catalog-panel-" + category } role="tabpanel" aria-labelledby={ "catalog-tab-" + category } data-catalog-panel={ category } hidden?={ category != "popular" }>
					for _, item := range blockListCatalog {
						if item.Category == category {
							@CatalogRow(item, blockListAdded(existing, item.URL))
						}
					}
				</div>
			}
			<div class="catalog-custom" id="catalog-panel-custom" role="tabpanel" aria-labelledby="catalog-tab-custom" data-catalog-panel="custom" hidden>
				<form data-block-list-add hx-post="/ui/blocking/lists/add" hx-target="#blocking-content" hx-swap="outerHTML" hx-sync="#add-block-list-dialog:drop" hx-disable="#add-block-list-dialog .block-list-add-button, #add-block-list-dialog input[type='url']">
					<label><span>Block List URL</span><div><input type="url" name="url" placeholder="https://example.com/blocklist.txt" required/><button class="button block-list-add-button" type="submit">@BlockListAddLabel()</button></div></label>
					<input type="hidden" name="format" value="auto"/>
				</form>
				<div><strong>Supported formats:</strong><ul><li>Standard hosts files</li><li>One domain per line</li><li>AdBlock-style host rules, like <code>||ads.example^</code></li></ul></div>
			</div>
		</div>
	}
}

templ BlockListAddLabel() {
	<span class="block-list-add-idle">@Icon("plus")<span>Add</span></span>
	<span class="block-list-add-pending">@Icon("loader-circle")<span class="sr-only">Adding…</span></span>
}

templ CatalogRow(item BlockListCatalogItem, added bool) {
	<article class="catalog-row"><div><strong>{ item.Name }</strong><p title={ item.Description }>{ item.Description }</p></div><a class="icon-button" href={ templ.SafeURL(item.URL) } target="_blank" rel="noreferrer" aria-label={ "View " + item.Name }>@Icon("external-link")</a>
		if added {
			@components.Button(components.ButtonProps{Label: "Added", Icon: "check", Variant: components.ButtonOutline, Disabled: true, Class: "catalog-added", Attrs: templ.Attributes{"aria-label": item.Name + " already added"}})
		} else {
			<button class="button block-list-add-button" type="button" aria-label={ "Add " + item.Name } data-block-list-add hx-post="/ui/blocking/lists/add" hx-vals={ fmt.Sprintf("{\"name\":%q,\"url\":%q,\"format\":\"auto\"}", item.Name, item.URL) } hx-target="#blocking-content" hx-swap="outerHTML" hx-sync="#add-block-list-dialog:drop" hx-disable="#add-block-list-dialog .block-list-add-button, #add-block-list-dialog input[type='url']">@BlockListAddLabel()</button>
		}
	</article>
}

templ DomainDialog(id, title, endpoint, action, description string) {
	@components.Dialog(components.DialogProps{ID: id, Title: title, Description: description, Class: "blocking-dialog"}) {
		<form class="blocking-dialog-form" hx-post={ endpoint } hx-target="#blocking-content" hx-swap="outerHTML"><label><span>Domain</span><input name="domain" placeholder="telemetry.example" autocomplete="off" required/></label>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: action, Type: "submit"})
			}
		</form>
	}
}

templ FlushDomainDialog(id, title, endpoint string, count int) {
	@components.Dialog(components.DialogProps{ID: id, Title: title, Description: "This removes all " + formatNumber(uint64(count)) + " custom entries. Block-list subscriptions are not affected.", Class: "blocking-dialog", NoClose: true}) {
		@components.DialogFooter("Cancel") {
			@components.Button(components.ButtonProps{Label: "Clear Domains", Destructive: true, Attrs: templ.Attributes{"hx-post": endpoint, "hx-target": "#blocking-content", "hx-swap": "outerHTML"}})
		}
	}
}

func blockListAdded(existing []BlockListSourceView, url string) bool { for _, list := range existing { if list.URL == url { return true } }; return false }
func blockListHealthDescription(degraded int) string { if degraded == 0 { return "Enabled block list sources" }; return fmt.Sprintf("%d %s failing to update", degraded, ifThen(degraded == 1, "source", "sources")) }

func blockListHealthColor(degraded int) string { return ifThen(degraded == 0, "purple", "red") }

func blockListLocation(list BlockListSourceView) string { return BlockListLocation(list.URL, ifThen(list.Path != "", list.Path, list.ConfiguredPath)) }
// BlockListLocation is how a list's source is shown: its URL without the
// scheme for a subscription, or its file path for a local list.
func BlockListLocation(sourceURL, path string) string { if sourceURL != "" { parsed := strings.TrimPrefix(strings.TrimPrefix(sourceURL, "https://"), "http://"); return strings.TrimSuffix(parsed, "/") }; return path }
func blockingStatusDescription(view BlockingPageView) string { if !view.Enabled { return "DNS blocking is currently disabled" }; if !view.PausedUntil.IsZero() { return "Temporarily disabled — resumes at " + FormatClock(view.PausedUntil, view.Console.TimeDisplay, false) }; return "DNS blocking is active and protecting your network" }
// ruleSetDomainsNote points from everyone's list to the rule sets that keep
// one of their own, which win over it for their devices.
templ ruleSetDomainsNote(ruleSets []RuleSetView, allowed bool) {
	{{ owners := ruleSetsWithDomains(ruleSets, allowed) }}
	if len(owners) > 0 {
		<p class="insight-blocking-note rule-set-domains-note">
			@Icon("users")
			<span>
				for index, name := range owners {
					{ listSeparator(index, len(owners)) }<button class="link-button" type="button" { drawerOpener(RuleSetDrawerLink(name))... }>{ name }</button>
				}
				{ plural(len(owners), " has its own ", " have their own ") + domainPolicyKind(allowed) + " domains too, which win over these for " + plural(len(owners), "its", "their") + " devices." }
			</span>
		</p>
	}
}

func ruleSetsWithDomains(ruleSets []RuleSetView, allowed bool) []string {
	var names []string
	for _, set := range ruleSets {
		if len(ruleSetList(set, allowed)) > 0 {
			names = append(names, set.Name)
		}
	}
	return names
}

// listSeparator goes before item index of count in a list written as prose,
// such as "Kids, Guests and Warehouse".
func listSeparator(index, count int) string {
	switch {
	case index == 0:
		return ""
	case index == count-1:
		return " and "
	default:
		return ", "
	}
}

// PolicyDomainRow is one domain on a blocked or allowed list. kind names the
// tab whose search filters it, and those rows say which list they're on; a
// list under its own heading needs neither. remove posts its removal, and
// without it the row has no remove button.
templ PolicyDomainRow(domain string, allowed bool, kind string, remove templ.Attributes) {
	<div class={ ifThen(allowed, "blocked-domain-row allowed", "blocked-domain-row") } data-policy-domain={ domain } if kind != "" { data-domain-kind={ kind } }><span>@Icon(ifThen(allowed, "shield-check", "shield-x"))</span><strong>{ domain }</strong>
		if kind != "" {
			<span class={ ifThen(allowed, "domain-policy-badge allowed", "domain-policy-badge blocked") }>{ domainPolicyKind(allowed) }</span>
		}
		if remove != nil {
			<button class="icon-button danger" type="button" aria-label={ "Remove " + domain } { remove... }>@Icon("trash")</button>
		}
	</div>
}

// policyRemoveAttrs asks before taking a domain off a list, then posts vals to
// endpoint. owner finishes the question, such as " for the Kids rule set".
func policyRemoveAttrs(domain string, allowed bool, endpoint, vals, target, swap, owner string) templ.Attributes {
	return templ.Attributes{
		"hx-post": endpoint, "hx-vals": vals, "hx-target": target, "hx-swap": swap,
		"hx-confirm": "Remove " + domain + " from the " + domainPolicyKind(allowed) + " list" + owner + "?",
		"data-confirm-title": "Remove " + domainPolicyKind(allowed) + " domain?", "data-confirm-action": "Remove Domain",
	}
}

func domainPolicyKind(allowed bool) string { if allowed { return "allowed" }; return "blocked" }
func blockingNavigationPage(view BlockingPageView) string { if view.ActiveTab == "allowed" { return "allowed" }; return "blocked" }

// BlockListRoute is where a block list's details panel lives. Each list's
// address opens the Blocking page with its panel open.
const BlockListRoute = "/blocked/lists/"

// BlockListPath is the address of one block list's panel.
func BlockListPath(name string) string { return BlockListRoute + url.PathEscape(name) }

// BlockListDrawerLink opens a block list's panel on the Blocking page.
func BlockListDrawerLink(name string) *DrawerLink {
	return &DrawerLink{
		Dialog: "block-list-dialog", Loading: "block-list-loading", Target: "block-list-content",
		URL: "/ui/blocking/list?" + url.Values{"name": []string{name}}.Encode(), Link: BlockListPath(name),
	}
}

func blockListDrawerRoute() templ.Attributes {
	return insightDrawerRoute(BlockListRoute, "/ui/blocking/list", "name", "block-list-content", "block-list-loading", "/blocked")
}

// BlockListDrawerView is one block list's details panel.
type BlockListDrawerView struct {
	List BlockListSourceView
	// Missing is set when no configured list has the requested name.
	Missing bool
	TimeDisplay TimeDisplay
	CanRefresh bool
	// LastUpdate is when the list last downloaded, or for a local file, when
	// the file last changed.
	LastUpdate time.Time
	NextUpdate time.Time
	// Retrying is set when NextUpdate is a retry after a failed download.
	Retrying bool
	ConsecutiveFailures int
	LastError string
	Message string
	Error string
}

templ blockListLoading() {
	@DetailDrawerContent(DetailDrawerView{ID: "block-list-dialog", TitleID: "block-list-title", Eyebrow: "Block List", Title: "Loading…", CloseLabel: "Close block list details"}, templ.NopComponent) {
		<div class="insight-device-loading" role="status" aria-live="polite">
			<span class="sr-only">Loading block list details…</span>
			<span class="insight-skeleton-line insights-skeleton-block"></span>
			<span class="insight-skeleton-title insights-skeleton-block"></span>
			<span class="insight-skeleton-line insights-skeleton-block"></span>
		</div>
	}
}

// BlockListDrawer is one block list's details, loaded into the open panel.
templ BlockListDrawer(view BlockListDrawerView) {
	@DetailDrawerContent(DetailDrawerView{ID: "block-list-dialog", TitleID: "block-list-title", Eyebrow: "Block List", Title: ifThen(view.Missing, "Block list not found", view.List.Name), CloseLabel: "Close block list details"}, blockListFooter(view)) {
		@Toast(view.Message, "success")
		if view.Error != "" {
			<div class="query-error" role="alert"><strong>Something went wrong</strong><span>{ view.Error }</span></div>
		}
		if view.Missing {
			<div class="query-detail-section-heading"><p>No block list has this name. It may have been removed or renamed.</p></div>
		} else {
			@components.FactList(components.FactListProps{Class: "query-detail-grid"}) {
				@components.Fact(components.FactProps{
					Label: ifThen(view.List.URL != "", "Source URL", "File"), Full: true,
					Value:  ifThen(view.List.URL != "", view.List.URL, ifThen(view.List.Path != "", view.List.Path, view.List.ConfiguredPath)),
					CopyID: "block-list-source", CopyLabel: ifThen(view.List.URL != "", "Copy source URL", "Copy file path"),
				})
				@components.Fact(components.FactProps{Label: "Format", Value: blockListFormatLabel(view.List.Format), Wide: true})
				@components.Fact(components.FactProps{Label: "Domains", Value: formatNumber(uint64(view.List.Accepted)), Wide: true})
				@components.Fact(components.FactProps{Label: "Lines read", Value: formatNumber(uint64(view.List.Lines)), Wide: true})
				@components.Fact(components.FactProps{Label: "Invalid lines", Value: formatNumber(uint64(view.List.Invalid)), Wide: true})
				if view.List.Exceptions > 0 {
					@components.Fact(components.FactProps{Label: "Exceptions", Value: formatNumber(uint64(view.List.Exceptions)), Wide: true})
				}
				if view.List.Unsupported > 0 {
					@components.Fact(components.FactProps{Label: "Unsupported rules", Value: formatNumber(uint64(view.List.Unsupported)), Wide: true})
				}
			}
			<section class="query-detail-answer" aria-labelledby="block-list-updates">
				<h3 id="block-list-updates">Updates</h3>
				if view.ConsecutiveFailures > 0 {
					<div class="query-error block-list-failure" role="status">
						<strong>{ view.List.HealthSummary }</strong>
						<span>{ ifThen(view.LastError != "", view.LastError, "The last update attempt failed.") }</span>
					</div>
				}
				@components.FactList(components.FactListProps{Class: "query-detail-grid"}) {
					@components.Fact(components.FactProps{Label: ifThen(view.List.URL != "", "Last update", "File changed"), Value: blockListTime(view.LastUpdate, view.TimeDisplay, ifThen(view.List.URL != "", "Not since Sable started", "—")), Wide: true})
					if view.List.URL != "" {
						@components.Fact(components.FactProps{Label: ifThen(view.Retrying, "Next retry", "Next update"), Value: blockListTime(view.NextUpdate, view.TimeDisplay, "Not scheduled"), Wide: true})
						@components.Fact(components.FactProps{Label: "Failures in a row", Value: ifThen(view.ConsecutiveFailures == 0, "None", fmt.Sprint(view.ConsecutiveFailures)), Wide: true})
					} else {
						@components.Fact(components.FactProps{Label: "Next update", Value: "Local file, never downloaded", Wide: true})
					}
				}
			</section>
		}
	}
}

templ blockListFooter(view BlockListDrawerView) {
	if !view.Missing {
		<div class="query-detail-policy-actions insight-drawer-actions">
			@CopyLinkButton(BlockListPath(view.List.Name))
			if view.CanRefresh && view.List.URL != "" {
				<button class="button blocking-update-button block-list-refresh" id="block-list-refresh" type="button" hx-post="/ui/blocking/lists/refresh" hx-vals={ fmt.Sprintf("{\"name\":%q}", view.List.Name) } hx-target="#block-list-content" hx-swap="innerHTML" hx-disable="this">@Icon("refresh")<span class="update-label">Refresh This List</span></button>
			}
		</div>
	}
}

func blockListTime(moment time.Time, display TimeDisplay, none string) string {
	if moment.IsZero() {
		return none
	}
	return FormatShortDateTime(moment, display, false)
}

func blockListFormatLabel(format string) string {
	switch format {
	case "", "auto":
		return "Detected automatically"
	case "hosts":
		return "Hosts file"
	case "domains":
		return "One domain per line"
	case "adblock":
		return "AdBlock filter list"
	default:
		return format
	}
}
