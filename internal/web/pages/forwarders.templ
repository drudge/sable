package pages

import (
	"strings"

	"github.com/drudge/sable/internal/web/pages/components"
)

// ForwarderStatView is one forwarder's line in the DNS Forwarders card: how
// it has been answering this node since Sable started.
type ForwarderStatView struct {
	Forwarder string
	// Route is the domain a route, forwarder zone, or FWD record sends to it;
	// empty for the resolver's own forwarders.
	Route    string
	Answered uint64
	Timeouts uint64
	Errors   uint64
	Median   string
	P95      string
	// Status is "ok", "cooling", "failing", or "idle".
	Status    string
	LastError string
	// Test is this forwarder's result when the card was drawn by Test
	// Forwarders, and nil otherwise.
	Test *ForwarderTestView
}

// ForwarderTestView is one forwarder's result from the Test button.
type ForwarderTestView struct {
	OK           bool
	ResponseTime string
	ResponseCode string
	// Validates is "yes", "no", or "" when the test could not tell.
	Validates string
	Error     string
}

// ForwardersCardView drives the stats and test half of the DNS Forwarders
// card. Available is false when this build of the console has no DNS
// handler to ask, as in some tests.
type ForwardersCardView struct {
	Available bool
	// Tested is set when Test Forwarders drew the list, so each row carries
	// its result.
	Tested bool
	Stats  []ForwarderStatView
}

var settingsForwarderOrderField = components.FieldProps{ID: "settings-forwarder-order", Label: "Forwarder Order", Help: "How each query picks among forwarders of the same priority. A forwarder that just failed always waits behind the healthy ones, and FWD priority always comes first.", Class: "narrow-control"}

templ SettingsForwarderOrder(order string) {
	@components.Field(settingsForwarderOrderField) {
		<select { components.FieldAttrs(settingsForwarderOrderField)... } name="forwarder_order" data-styled-select>
			<option value="round_robin" selected?={ order == "" || order == "round_robin" }>Round robin</option>
			<option value="in_order" selected?={ order == "in_order" }>In order (first listed first)</option>
			<option value="fastest" selected?={ order == "fastest" }>Fastest first</option>
		</select>
	}
}

templ SettingsForwarderActivity(view ForwardersCardView) {
	if view.Available {
		<section class="forwarder-activity" aria-labelledby="forwarder-activity-title">
			<div class="forwarder-activity-header">
				<div>
					<h4 id="forwarder-activity-title">On This Node</h4>
					<p>Client queries that reached each forwarder since Sable started. Cached answers and tests don't count.</p>
				</div>
				@components.Button(components.ButtonProps{Label: "Test Forwarders", Icon: "zap", Variant: components.ButtonOutline, Compact: true, Attrs: templ.Attributes{
					"hx-post": "/ui/settings/forwarders/test", "hx-target": "#forwarder-activity-list", "hx-swap": "outerHTML",
					"hx-disabled-elt": "this", "hx-indicator": "#forwarder-activity-list",
				}})
			</div>
			@SettingsForwarderList(view)
		</section>
	}
}

// SettingsForwarderList is the forwarder table, which Test Forwarders redraws
// with fresh numbers and each forwarder's result in its Test column.
templ SettingsForwarderList(view ForwardersCardView) {
	<div id="forwarder-activity-list" class="forwarder-activity-list" aria-live="polite">
		if len(view.Stats) == 0 {
			<p class="forwarder-empty">No forwarders are configured.</p>
		} else {
			<div class="forwarder-table">
				<div class="admin-mobile-list">
					for _, stat := range view.Stats {
						<article class="admin-mobile-row forwarder-mobile-row">
							<div>
								<strong>{ stat.Forwarder }</strong>
								@forwarderStatusBadge(stat)
								if stat.Route != "" {
									<small>{ "For " + stat.Route }</small>
								}
								<small>{ forwarderMobileSummary(stat) }</small>
								if stat.Test != nil {
									@forwarderMobileTest(*stat.Test)
								}
							</div>
						</article>
					}
				</div>
				@components.DataTable(components.DataTableProps{Caption: "Forwarders on this node", Class: "forwarder-stats-table", Columns: []components.DataTableColumn{
					{Label: "Forwarder"}, {Label: "Status"}, {Label: "Answered", Class: "right-cell"}, {Label: "Median", Class: "right-cell"},
					{Label: "95th pct", Class: "right-cell"}, {Label: "Failed", Class: "right-cell"}, {Label: "Test"},
				}}) {
					for _, stat := range view.Stats {
						<tr>
							<td>
								<div class="forwarder-cell">
									<code>{ stat.Forwarder }</code>
									if stat.Route != "" {
										<small>{ "For " + stat.Route }</small>
									}
									if stat.LastError != "" && (stat.Status == "failing" || stat.Status == "cooling") {
										<small class="forwarder-error">{ stat.LastError }</small>
									}
								</div>
							</td>
							<td>@forwarderStatusBadge(stat)</td>
							<td class="right-cell">{ ifThen(stat.Status == "idle", "—", formatNumber(stat.Answered)) }</td>
							<td class="right-cell">{ ifThen(stat.Median == "", "—", stat.Median) }</td>
							<td class="right-cell">{ ifThen(stat.P95 == "", "—", stat.P95) }</td>
							<td class="right-cell" title={ forwarderFailureDetail(stat) }>{ ifThen(stat.Timeouts+stat.Errors == 0, "—", formatNumber(stat.Timeouts+stat.Errors)) }</td>
							<td class="forwarder-test-cell">
								if stat.Test != nil {
									@forwarderTestCell(*stat.Test)
								} else {
									<span class="muted-cell">—</span>
								}
							</td>
						</tr>
					}
				}
			</div>
		}
		if view.Tested {
			<p class="forwarder-test-note">Tested just now from this node: example.com three times and dnssec-failed.org once, over each forwarder's own transport.</p>
		}
	</div>
}

templ forwarderMobileTest(test ForwarderTestView) {
	if test.OK {
		<small class="forwarder-test passed">@Icon("check-circle")<span>{ "Test: " + test.ResponseTime + " · " + forwarderValidation(test.Validates) }</span></small>
	} else {
		<small class="forwarder-test failed">@Icon("x-circle")<span>{ "Test failed: " + ifThen(test.Error != "", test.Error, "answered "+test.ResponseCode) }</span></small>
	}
}

templ forwarderTestCell(test ForwarderTestView) {
	if test.OK {
		<span class="forwarder-test passed">@Icon("check-circle")<span>{ test.ResponseTime }</span></span>
		<small>{ forwarderValidation(test.Validates) }</small>
	} else {
		<span class="forwarder-test failed">@Icon("x-circle")<span>Failed</span></span>
		<small>{ ifThen(test.Error != "", test.Error, "Answered "+test.ResponseCode) }</small>
	}
}

templ forwarderStatusBadge(stat ForwarderStatView) {
	switch stat.Status {
		case "cooling":
			@components.Badge(components.BadgeProps{Label: "Tried last", Tone: components.BadgeWarning, Title: "It failed lately, so it waits behind the healthy forwarders for a few seconds."})
		case "failing":
			@components.Badge(components.BadgeProps{Label: "Not answering", Tone: components.BadgeDanger})
		case "idle":
			@components.Badge(components.BadgeProps{Label: "No traffic yet", Title: "No client query has reached this forwarder since Sable started. Answers from the cache don't count."})
		default:
			@components.Badge(components.BadgeProps{Label: "Answering", Tone: components.BadgeSuccess})
	}
}

// forwarderValidation says whether a forwarder that passed the test
// validates DNSSEC.
func forwarderValidation(value string) string {
	switch value {
	case "yes":
		return "Validates DNSSEC"
	case "no":
		return "Doesn't validate DNSSEC"
	}
	return "DNSSEC unknown"
}

// forwarderMobileSummary is a forwarder's numbers on one line, for the
// phone layout, which has no columns.
func forwarderMobileSummary(stat ForwarderStatView) string {
	if stat.Status == "idle" {
		return "No traffic yet"
	}
	parts := []string{formatNumber(stat.Answered) + " answered"}
	if stat.Median != "" {
		parts = append(parts, stat.Median+" median", stat.P95+" 95th pct")
	}
	if failed := stat.Timeouts + stat.Errors; failed > 0 {
		parts = append(parts, formatNumber(failed)+" failed")
	}
	return strings.Join(parts, " · ")
}

// forwarderFailureDetail splits the Failed column into its kinds.
func forwarderFailureDetail(stat ForwarderStatView) string {
	if stat.Timeouts+stat.Errors == 0 {
		return ""
	}
	return formatNumber(stat.Timeouts) + " " + plural(int(stat.Timeouts), "timeout", "timeouts") + ", " +
		formatNumber(stat.Errors) + " " + plural(int(stat.Errors), "error", "errors")
}
