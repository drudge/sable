package pages

import (
	"strings"

	"github.com/drudge/sable/internal/web/pages/components"
)

// ForwarderStatView is one forwarder's line in the DNS Forwarders card: how
// it has been answering this node since Sable started.
type ForwarderStatView struct {
	Forwarder string
	// Route is the domain a route, forwarder zone, or FWD record sends to it;
	// empty for the resolver's own forwarders.
	Route    string
	Answered uint64
	Timeouts uint64
	Errors   uint64
	Median   string
	P95      string
	// Status is "ok", "cooling", "failing", or "idle".
	Status    string
	LastError string
	// Test is this forwarder's result when the card was drawn by Test
	// Forwarders, and nil otherwise.
	Test *ForwarderTestView
}

// ForwarderTestView is one forwarder's result from the Test button.
type ForwarderTestView struct {
	OK           bool
	ResponseTime string
	ResponseCode string
	// Validates is "yes", "no", or "" when the test could not tell.
	Validates string
	Error     string
}

// ForwarderEditorView drives the DNS Forwarders list: the forwarders the
// resolver saves, in order and editable, with how each has been answering
// this node, and below them the read-only forwarders that routes and
// forwarder zones send to.
type ForwarderEditorView struct {
	// Stats is set when the DNS handler reports on its forwarders, which
	// shows the stats columns and Test Forwarders.
	Stats bool
	// Tested is set when Test Forwarders drew the list, so each row carries
	// its result.
	Tested     bool
	Forwarders []ForwarderStatView
	Routes     []ForwarderStatView
	// Text is the saved forwarders one per line, for Edit as Text.
	Text string
}

var settingsForwarderOrderField = components.FieldProps{ID: "settings-forwarder-order", Label: "Forwarder Order", Help: "How each query picks among forwarders of the same priority. A forwarder that just failed always waits behind the healthy ones, and FWD priority always comes first.", Class: "narrow-control"}

templ SettingsForwarderOrder(order string) {
	@components.Field(settingsForwarderOrderField) {
		<select { components.FieldAttrs(settingsForwarderOrderField)... } name="forwarder_order" data-styled-select>
			<option value="round_robin" selected?={ order == "" || order == "round_robin" }>Round robin</option>
			<option value="in_order" selected?={ order == "in_order" }>In order (first listed first)</option>
			<option value="fastest" selected?={ order == "fastest" }>Fastest first</option>
		</select>
	}
}

templ SettingsForwarderEditor(view ForwarderEditorView) {
	<section class="forwarder-editor" data-forwarder-editor aria-labelledby="forwarder-editor-title">
		<div class="forwarder-editor-header">
			<div>
				<h4 id="forwarder-editor-title">Forwarders</h4>
				<p>Required in forwarding mode. Saved in the order shown.</p>
			</div>
			<div class="forwarder-editor-actions">
				@components.Button(components.ButtonProps{Label: "Edit as Text", Icon: "file-text", Variant: components.ButtonOutline, Compact: true, Attrs: templ.Attributes{"data-forwarder-text-toggle": true, "aria-pressed": "false", "data-replica-primary-action": true}})
				if view.Stats {
					@components.Button(components.ButtonProps{Label: "Test", Icon: "zap", Variant: components.ButtonOutline, Compact: true, Attrs: templ.Attributes{
						"hx-post": "/ui/settings/forwarders/test", "hx-target": "#forwarder-editor-body", "hx-swap": "outerHTML",
						"hx-disabled-elt": "this", "hx-indicator": "#forwarder-editor-body", "data-forwarder-test": true,
						"title": "Ask each saved forwarder example.com and dnssec-failed.org from this node",
					}})
				}
				@components.Button(components.ButtonProps{Label: "Add Forwarder", Icon: "plus", Compact: true, Attrs: templ.Attributes{"data-dialog-open": "add-forwarder-dialog", "data-forwarder-add": true, "data-replica-primary-action": true}})
			</div>
		</div>
		@SettingsForwarderEditorBody(view)
		<div class="forwarder-text" data-forwarder-text-panel hidden>
			@components.Field(settingsForwardersField) {
				<textarea { components.FieldAttrs(settingsForwardersField)... } name="forwarders" rows="5" spellcheck="false" disabled data-forwarder-text placeholder={ "1.1.1.1\ntls://dns.quad9.net (9.9.9.9)\nhttps://cloudflare-dns.com/dns-query (1.1.1.1)" }>{ view.Text }</textarea>
			}
			<p class="query-error" role="alert" data-forwarder-text-error hidden></p>
		</div>
		<template data-forwarder-row-template>
			@forwarderEditableRow(ForwarderStatView{Status: "new"}, view.Stats)
		</template>
	</section>
}

// SettingsForwarderEditorBody is the forwarder table, which Test Forwarders
// redraws with fresh numbers and each forwarder's result.
templ SettingsForwarderEditorBody(view ForwarderEditorView) {
	<div id="forwarder-editor-body" class="forwarder-editor-body" data-forwarder-body aria-live="polite">
		<div class="forwarder-table">
			<table class={ "isotope-table forwarder-edit-table", templ.KV("with-stats", view.Stats) }>
				<caption class="sr-only">Forwarders, in the order Sable tries them</caption>
				<thead>
					<tr>
						<th scope="col" class="forwarder-handle-cell"><span class="sr-only">Order</span></th>
						<th scope="col">Forwarder</th>
						if view.Stats {
							<th scope="col">Status</th>
							<th scope="col" class="right-cell">Answered</th>
							<th scope="col" class="right-cell">Median</th>
							<th scope="col" class="right-cell">95th pct</th>
							<th scope="col" class="right-cell">Failed</th>
							<th scope="col">Test</th>
						}
						<th scope="col" class="forwarder-row-actions"><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody data-forwarder-rows>
					for _, forwarder := range view.Forwarders {
						@forwarderEditableRow(forwarder, view.Stats)
					}
					<tr class="forwarder-empty-row" data-forwarder-empty hidden?={ len(view.Forwarders) > 0 }>
						<td colspan={ forwarderColumns(view.Stats) }>No forwarders yet. Add one, or switch to iterative recursion above.</td>
					</tr>
				</tbody>
				if len(view.Routes) > 0 {
					<tbody class="forwarder-routes">
						<tr class="forwarder-group-row">
							<th scope="rowgroup" colspan={ forwarderColumns(view.Stats) }>Routes and forwarder zones<small>Set in Zones and <code>resolver.routes</code></small></th>
						</tr>
						for _, route := range view.Routes {
							<tr class="forwarder-route-row">
								<td class="forwarder-handle-cell"></td>
								<td>
									@forwarderNameCell(route)
								</td>
								if view.Stats {
									@forwarderStatCells(route)
								}
								<td class="forwarder-row-actions"></td>
							</tr>
						}
					</tbody>
				}
			</table>
		</div>
		if view.Tested {
			<p class="forwarder-test-note">Tested just now from this node: example.com three times and dnssec-failed.org once, over each forwarder's own transport. The stats count client queries only.</p>
		} else if view.Stats {
			<p class="forwarder-test-note">Stats count client queries that reached each forwarder since Sable started. Cached answers and tests don't count.</p>
		}
	</div>
}

templ forwarderEditableRow(forwarder ForwarderStatView, stats bool) {
	<tr class="forwarder-edit-row" data-forwarder-row draggable="true">
		<td class="forwarder-handle-cell"><span class="forwarder-handle" title="Drag to reorder" aria-hidden="true">@Icon("grip-vertical")</span></td>
		<td>
			@forwarderNameCell(forwarder)
			<input type="hidden" name="forwarders" value={ forwarder.Forwarder } data-forwarder-value/>
		</td>
		if stats {
			@forwarderStatCells(forwarder)
		}
		<td class="forwarder-row-actions">
			<div class="forwarder-row-buttons">
				<button class="icon-button" type="button" data-replica-primary-action data-forwarder-move="-1" aria-label={ "Move " + forwarder.Forwarder + " up" } title="Move up">@Icon("chevron-up")</button>
				<button class="icon-button" type="button" data-replica-primary-action data-forwarder-move="1" aria-label={ "Move " + forwarder.Forwarder + " down" } title="Move down">@Icon("chevron-down")</button>
				<button class="icon-button danger" type="button" data-replica-primary-action data-forwarder-remove aria-label={ "Remove " + forwarder.Forwarder } title="Remove">@Icon("trash")</button>
			</div>
		</td>
	</tr>
}

templ forwarderNameCell(forwarder ForwarderStatView) {
	<div class="forwarder-cell">
		<code data-forwarder-label>{ forwarder.Forwarder }</code>
		<small data-forwarder-kind>{ forwarderKind(forwarder.Forwarder) }{ ifThen(forwarder.Route != "", " · for "+forwarder.Route, "") }</small>
		if forwarder.LastError != "" && (forwarder.Status == "failing" || forwarder.Status == "cooling") {
			<small class="forwarder-error">{ forwarder.LastError }</small>
		}
	</div>
}

templ forwarderStatCells(stat ForwarderStatView) {
	<td data-label="Status">@forwarderStatusBadge(stat)</td>
	<td class="right-cell" data-label="Answered">{ ifThen(stat.Status == "idle" || stat.Status == "new", "—", formatNumber(stat.Answered)) }</td>
	<td class="right-cell" data-label="Median">{ ifThen(stat.Median == "", "—", stat.Median) }</td>
	<td class="right-cell" data-label="95th pct">{ ifThen(stat.P95 == "", "—", stat.P95) }</td>
	<td class="right-cell" data-label="Failed" title={ forwarderFailureDetail(stat) }>{ ifThen(stat.Timeouts+stat.Errors == 0, "—", formatNumber(stat.Timeouts+stat.Errors)) }</td>
	<td class="forwarder-test-cell" data-label="Test">
		if stat.Test != nil {
			@forwarderTestCell(*stat.Test)
		} else {
			<span class="muted-cell">—</span>
		}
	</td>
}

templ forwarderTestCell(test ForwarderTestView) {
	if test.OK {
		<span class="forwarder-test passed">@Icon("check-circle")<span>{ test.ResponseTime }</span></span>
		<small>{ forwarderValidation(test.Validates) }</small>
	} else {
		<span class="forwarder-test failed">@Icon("x-circle")<span>Failed</span></span>
		<small>{ ifThen(test.Error != "", test.Error, "Answered "+test.ResponseCode) }</small>
	}
}

templ forwarderStatusBadge(stat ForwarderStatView) {
	switch stat.Status {
		case "cooling":
			@components.Badge(components.BadgeProps{Label: "Tried last", Tone: components.BadgeWarning, Title: "It failed lately, so it waits behind the healthy forwarders for a few seconds."})
		case "failing":
			@components.Badge(components.BadgeProps{Label: "Not answering", Tone: components.BadgeDanger})
		case "new":
			@components.Badge(components.BadgeProps{Label: "Not saved yet", Tone: components.BadgeCurrent})
		case "idle":
			@components.Badge(components.BadgeProps{Label: "No traffic yet", Title: "No client query has reached this forwarder since Sable started. Answers from the cache don't count."})
		default:
			@components.Badge(components.BadgeProps{Label: "Answering", Tone: components.BadgeSuccess})
	}
}

// forwarderValidation says whether a forwarder that passed the test
// validates DNSSEC.
func forwarderValidation(value string) string {
	switch value {
	case "yes":
		return "Validates DNSSEC"
	case "no":
		return "Doesn't validate DNSSEC"
	}
	return "DNSSEC unknown"
}


// forwarderFailureDetail splits the Failed column into its kinds.
func forwarderFailureDetail(stat ForwarderStatView) string {
	if stat.Timeouts+stat.Errors == 0 {
		return ""
	}
	return formatNumber(stat.Timeouts) + " " + plural(int(stat.Timeouts), "timeout", "timeouts") + ", " +
		formatNumber(stat.Errors) + " " + plural(int(stat.Errors), "error", "errors")
}

// forwarderColumns is how many columns the forwarder table has.
func forwarderColumns(stats bool) string {
	if stats {
		return "9"
	}
	return "3"
}

// forwarderKind names a forwarder's transport for the line under it.
func forwarderKind(forwarder string) string {
	lower := strings.ToLower(strings.TrimSpace(forwarder))
	switch {
	case strings.HasPrefix(lower, "https://"):
		return "DNS over HTTPS"
	case strings.HasPrefix(lower, "tls://"):
		return "DNS over TLS"
	case strings.HasPrefix(lower, "quic://"):
		return "DNS over QUIC"
	case strings.HasPrefix(lower, "tcp://"):
		return "Plain DNS over TCP"
	case lower == "":
		return ""
	}
	return "Plain DNS"
}

templ AddForwarderDialog() {
	@components.Dialog(components.DialogProps{ID: "add-forwarder-dialog", Title: "Add Forwarder", Description: "Pick a well-known resolver or enter your own. The new forwarder goes to the end of the list; save the settings to use it.", Class: "blocking-dialog"}) {
		<form class="blocking-dialog-form add-forwarder-form" data-add-forwarder-form novalidate>
			<div class="field-grid two">
				<label><span>Provider</span><select name="provider" data-styled-select data-forwarder-provider>
					<option value="custom">Custom</option>
					<option value="cloudflare">Cloudflare</option>
					<option value="quad9">Quad9</option>
					<option value="google">Google Public DNS</option>
					<option value="adguard">AdGuard DNS</option>
				</select></label>
				<label><span>Transport</span><select name="transport" data-styled-select data-forwarder-transport>
					<option value="https">DNS over HTTPS</option>
					<option value="tls">DNS over TLS</option>
					<option value="quic">DNS over QUIC</option>
					<option value="udp">Plain DNS (UDP)</option>
					<option value="tcp">Plain DNS (TCP)</option>
				</select></label>
			</div>
			<label><span>Server</span><input class="mono-input" name="server" data-forwarder-server autocomplete="off" spellcheck="false" placeholder="dns.example.com"/><small data-forwarder-server-help>A host name or IP address, with :port if it isn't the default.</small></label>
			<label data-forwarder-bootstrap-field><span>IP Address</span><input class="mono-input" name="bootstrap" data-forwarder-bootstrap autocomplete="off" spellcheck="false" placeholder="192.0.2.53"/><small>The server's address. Sable connects to it and checks the certificate against the host name, so it never has to look up its own forwarder through itself.</small></label>
			<div class="forwarder-preview"><span>Adds</span><code data-forwarder-preview>—</code></div>
			<p class="query-error" role="alert" data-forwarder-add-error hidden></p>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Add Forwarder", Type: "submit"})
			}
		</form>
	}
}
