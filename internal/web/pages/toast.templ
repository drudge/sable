package pages

// NotificationOptions configures the shared notification card. The surrounding
// region remains the server-owned HTMX fragment, while this component owns the
// visual and interaction contract shared by transient toasts and live notices.
type NotificationOptions struct {
	Variant           string
	Class             string
	Icon              string
	SecondaryIcon     string
	Title             string
	Message           string
	Duration          string
	Role              string
	Persistent        bool
	HasActions        bool
	Attributes        templ.Attributes
	MessageAttributes templ.Attributes
	DismissAttributes templ.Attributes
}

// ToastAction is an optional button carried by a toast.
type ToastAction struct {
	Label         string
	Icon          string
	Post          string
	Confirm       string
	ConfirmTitle  string
	ConfirmAction string
}

func (action ToastAction) Present() bool { return action.Label != "" && action.Post != "" }

// Toast reports something that happened and clears itself.
templ Toast(message string, variant string) {
	@toastNotice(message, variant, ToastAction{}, false)
}

// ToastWithAction carries a button, so it waits for the operator instead of
// counting down; an action you have to race a timer to reach may as well not
// be offered.
templ ToastWithAction(message string, variant string, action ToastAction) {
	@toastNotice(message, variant, action, true)
}

// ToastSticky waits to be dismissed without offering an action. It is for
// messages an operator has to actually read, such as why an operation failed.
templ ToastSticky(message string, variant string) {
	@toastNotice(message, variant, ToastAction{}, true)
}

// Notification is the single card used by every toast and update notice. Its
// children are optional actions, allowing callers to render buttons, links,
// forms, or split controls without duplicating the card shell.
templ Notification(options NotificationOptions) {
	<div
		class={
			"toast",
			"notification",
			"toast-" + options.Variant,
			options.Class,
			templ.KV("toast-persistent", options.Persistent),
			templ.KV("notification-has-actions", options.HasActions),
		}
		data-toast
		data-toast-duration={ options.Duration }
		role={ options.Role }
		{ options.Attributes... }
	>
		<button class="toast-dismiss notification-dismiss" type="button" data-toast-close aria-label="Dismiss notification" { options.DismissAttributes... }>@Icon("x")</button>
		<div class="notification-summary">
			<span class="notification-badge" aria-hidden="true">
				@Icon(options.Icon)
				if options.SecondaryIcon != "" {
					@Icon(options.SecondaryIcon)
				}
			</span>
			<div class="notification-copy">
				<strong>{ options.Title }</strong>
				<p { options.MessageAttributes... }>{ options.Message }</p>
			</div>
		</div>
		if options.HasActions {
			<div class="toast-actions notification-actions">
				{ children... }
			</div>
		}
	</div>
}

templ toastNotice(message string, variant string, action ToastAction, persistent bool) {
	if message != "" {
		<div class="toast-region" aria-live={ ifThen(variant == "error", "assertive", "polite") } aria-atomic="true">
			@Notification(NotificationOptions{
				Variant: variant,
				Icon: ifThen(variant == "error", "x-circle", "check-circle"),
				Title: ifThen(variant == "error", "Error", "Success"),
				Message: message,
				Duration: ifThen(persistent, "0", ifThen(variant == "error", "6500", "4500")),
				Role: ifThen(variant == "error", "alert", "status"),
				Persistent: persistent,
				HasActions: action.Present(),
			}) {
				if action.Present() {
					<button
						class="button compact"
						type="button"
						hx-post={ action.Post }
						hx-swap="none"
						hx-confirm={ action.Confirm }
						data-confirm-title={ action.ConfirmTitle }
						data-confirm-action={ action.ConfirmAction }
					>
						if action.Icon != "" {
							@Icon(action.Icon)
						}
						<span>{ action.Label }</span>
					</button>
				}
			}
		</div>
	}
}
