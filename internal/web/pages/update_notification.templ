package pages

templ ReleaseVersion(release string) {
	if releaseURL(release) != "" {
		<a class="inline-link" href={ templ.SafeURL(releaseURL(release)) } target="_blank" rel="noopener noreferrer" title="View this release on GitHub">{ formatReleaseVersion(release) }</a>
	} else {
		{ release }
	}
}

templ UpdateNotification(view UpdateView) {
	<div class="toast-region" aria-live="polite">
		<div class="toast toast-update toast-persistent" data-toast data-toast-duration="0" role="status" data-update-version={ view.LatestVersion }>
			<strong>Sable v{ view.LatestVersion } is available</strong>
			<button class="toast-dismiss" type="button" data-toast-close aria-label="Dismiss notification">@Icon("x")</button>
			<p>Review the release notes for what's changed and anything to know before updating. Install when you're ready.</p>
			<div class="toast-actions">
				@updateReleaseNotesButton(view, notificationUpdateNotesDialogID)
				if updateAction(view) == "install" {
					@updateInstallButton(view, true)
				}
			</div>
		</div>
		@updateReleaseNotesDialog(view, notificationUpdateNotesDialogID)
	</div>
}
