package pages

templ ReleaseVersion(release string) {
	if releaseURL(release) != "" {
		<a class="inline-link" href={ templ.SafeURL(releaseURL(release)) } target="_blank" rel="noopener noreferrer" title="View this release on GitHub">{ formatReleaseVersion(release) }</a>
	} else {
		{ release }
	}
}

func updateNotificationOptions(view UpdateView) NotificationOptions {
	attributes := updateRestartAttributes(view, "")
	if attributes == nil {
		attributes = templ.Attributes{}
	}
	attributes["data-update-version"] = view.LatestVersion
	message := updateDetail(view)
	if updateVariant(view) == "available" && view.Blocked == "" {
		message = "Review the release notes for what's changed and anything to know before updating. Install when you're ready."
	}
	return NotificationOptions{
		Variant:           "update",
		Class:             "toast-update-" + updateVariant(view),
		Icon:              ifThen(updateVariant(view) == "available", "sparkles", updateIcon(view)),
		SecondaryIcon:     ifThen(view.Installed && view.CanRestart, "refresh", ""),
		Title:             updateHeadline(view),
		Message:           message,
		Duration:          "0",
		Role:              "status",
		Persistent:        true,
		HasActions:        true,
		Attributes:        attributes,
		MessageAttributes: templ.Attributes{"data-restart-status": true},
		DismissAttributes: templ.Attributes{"id": "update-notification-dismiss"},
	}
}

templ UpdateNotification(view UpdateView) {
	<div
		id="update-notification"
		class="toast-region"
		aria-live="polite"
		data-live-refresh
		hx-get="/ui/updates?notification=true"
		hx-trigger={ ifThen(view.Busy, "sableUpdateChanged from:document, every 2s", "sableUpdateChanged from:document") }
		hx-target="this"
		hx-swap="outerHTML"
	>
		@Notification(updateNotificationOptions(view)) {
			@updateReleaseNotesButton(view, notificationUpdateNotesDialogID)
			@updatePrimaryAction(view, true)
		}
		@updateReleaseNotesDialog(view, notificationUpdateNotesDialogID)
	</div>
}

templ UpdateCompletedToast(release string) {
	<template data-update-completed-toast={ formatReleaseVersion(release) }>
		@Toast("Sable was updated to " + formatReleaseVersion(release) + ".", "success")
	</template>
}
