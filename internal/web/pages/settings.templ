package pages

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/drudge/sable/internal/web/pages/components"
)

// Settings draws these fields around its own textareas and selects.
var (
	settingsDNSListenField             = components.FieldProps{ID: "settings-dns-listen", Label: "Local End Points", Help: "Network interface addresses and ports to listen on (one per line, format: IP:port)."}
	settingsTimeFormatField            = components.FieldProps{ID: "settings-time-format", Label: "Time Format", Help: "This preference applies throughout Sable and is stored in this browser.", Class: "narrow-control"}
	settingsRecordNameField            = components.FieldProps{ID: "settings-record-name", Label: "Zone Record Names", Help: "Choose whether record lists show names relative to the selected zone.", Class: "narrow-control"}
	settingsACMEDomainsField           = components.FieldProps{ID: "settings-acme-domains", Label: "DNS Names", Help: "One name per line. Wildcards are supported through DNS-01."}
	settingsACMEDirectoryURLField      = components.FieldProps{ID: "settings-acme-directory-url", Label: "Certificate Authority", Help: "Use staging while testing to avoid production rate limits."}
	settingsRecursionClientsField      = components.FieldProps{ID: "settings-recursion-clients", Label: "Allowed Recursive Clients", Help: "Used with “Listed clients only”. Enter one IP address or CIDR network per line. An empty list denies all client recursion."}
	settingsRootHintsField             = components.FieldProps{ID: "settings-root-hints", Label: "Root Server Addresses", Help: "Optional IP:port seed addresses, one per line. Leave empty to use the bundled root hints."}
	settingsForwardersField            = components.FieldProps{ID: "settings-forwarders", Label: "Forwarder Addresses", Help: "Required in forwarding mode. Conditional routes and forwarder zones remain active in iterative mode."}
	settingsBlockingBypassClientsField = components.FieldProps{ID: "settings-blocking-bypass-clients", Label: "IP Addresses and Networks", Help: "Enter one IP address or CIDR network per line."}
	settingsServerLogLevelField        = components.FieldProps{ID: "settings-server-log-level", Label: "Minimum Log Level", Help: "Applies to both persisted history and stderr.", Class: "narrow-control"}
)

type SettingsPageView struct {
 PasskeysEnabled bool
 MaxConcurrent int
 MaxConcurrentPerClient int
	Console             DashboardView
	Insights            SettingsInsightsView
	Revision            uint64
	TimeFormat          string
	TimeZone            string
	ActiveTab           string
	Message             string
	Error               string
	HTTPListen          string
	HTTPSListen         string
	DNSListen           string
	DatabaseDriver      string
	DatabaseDSN         string
	Recursion string
 RecursionClients string
	// AttachedNetworks are the IPv6 networks private recursion also covers.
	AttachedNetworks []AttachedNetworkView
 ResolverMode        string
	Forwarders          string
	RootHints           string
	ResolverTimeout     string
	ResolverRetries     int
	ResolverRetryTimeout string
	CacheSize           int
	CacheMinimumTTL     uint32
	CacheMaximumTTL     uint32
	CacheNegativeTTL    uint32
	CacheFailureTTL     uint32
	SaveCache           bool
	ServeStale          bool
	CacheStaleTTL       uint32
	CacheStaleAnswerTTL uint32
	CacheStaleResetTTL  uint32
	CacheStaleMaxWaitMS int64
	CachePrefetchMinimumTTL uint32
	CachePrefetchTriggerTTL uint32
	CachePrefetchSample string
	CachePrefetchHitsPerHour uint32
	DNSSECValidation    bool
	QNAMEMinimization   bool
	TrustAnchorUpdates  bool
	DoTListen           string
	DoHListen           string
	DoQListen           string
	CertificateFile     string
	PrivateKeyFile      string
	CertificateMode     string
	ACMEEmail           string
	ACMEDomains         string
	ACMEDirectoryURL    string
	ACMEDNSProvider     string
	ACMEDNSZone         string
	ACMEStorageDirectory string
	ACMERenewBefore     string
	ACMECredentialsConfigured bool
	ACMEIssuer          string
	ACMEExpires         string
	ACMESubject         string
	ACMESerialNumber    string
	ACMEFingerprint     string
	ACMEIssuedOn        string
	ACMELastRenewal     string
	ACMECoveredNames    []string
	ACMEPendingNames    []string
	ACMELastError       string
	ACMERenewing        bool
	ACMEProviderEndpoint string
	ACMETSIGAlgorithm    string
	MinimumTLSVersion   string
	QueryLogEnabled     bool
	QueryLogRetention   string
	ServerLogEnabled    bool
	ServerLogLevel      string
	ServerLogRetention  string
	StatisticsRetention string
	SessionTTL          string
	APITokenTTL         string
	ConfigWatch         bool
	UpdatePreferences   SettingsUpdatePreferencesView
	BlockingUpdateHours int
	BlockingResponseType string
	BlockingResponseTTL uint32
	BlockingCustomAddresses string
	BlockingBypassClients string
	BlockingAllowTXTReport bool
	Backup                 SettingsBackupView
	// Alerts is the Alerts tab, which saves on its own like TSIG and Backup.
	Alerts AlertsView
	// TSIGKeys lists the shared secrets this node knows about. Only the name
	// and algorithm travel with the view: the secret itself stays in the
	// encrypted vault and is shown once, right after it is generated.
	TSIGKeys            []SettingsTSIGKeyView
	TSIGAlgorithms      []string
	TSIGGeneratedKey    string
	TSIGGeneratedSecret string
}

type SettingsTSIGKeyView struct {
	Name       string
	Algorithm  string
	Configured bool
	Zones      []string
}

// settingsTabs drives both the tab strip and the document title so the browser
// tab names the section an operator is actually looking at.
var settingsTabs = []tabOption{
	{"general", "General", "server"},
	{"web-service", "Web", "globe"},
	{"protocols", "Protocols", "arrow-left-right"},
	{"tsig", "TSIG", "key"},
	{"recursion", "Recursion", "refresh"},
	{"cache", "Cache", "database"},
	{"blocking", "Blocking", "shield"},
	{"logging", "Logging", "file-text"},
	{"alerts", "Alerts", "bell"},
	{"backup", "Backup", "hard-drive"},
}

templ SettingsPage(view SettingsPageView) {
	@AppDocument(view.Console, documentTitle(tabLabel(settingsTabs, view.ActiveTab), "Settings"), "settings", SettingsContent(view))
}

templ SettingsContent(view SettingsPageView) {
	<div class="settings-page page-stack isotope-control-page" id="settings-content" data-isotope-tabs data-active-tab={ view.ActiveTab } data-tab-param="tab" data-title-base="Settings">
		<header class="page-heading"><h1>Settings</h1><p>Configure DNS server settings and behavior. Some settings may require the DNS server to restart to take effect.</p></header>
		@Toast(view.Message, "success")
		@Toast(view.Error, "error")
		@components.Tabs(components.TabsProps{Label: "Settings sections", Class: "settings-tab-list", TabClass: "settings-tab", Active: view.ActiveTab, Tabs: tabList(settingsTabs)})
		<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="general" hidden?={ view.ActiveTab != "general" }>@SettingsGeneralPanel(view)</div>
		<form id="settings-form" class="isotope-settings-form" hx-post="/ui/settings" hx-target="#settings-content" hx-swap="outerHTML">
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="web-service" hidden?={ view.ActiveTab != "web-service" }>@SettingsWebPanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="protocols" hidden?={ view.ActiveTab != "protocols" }>@SettingsProtocolsPanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="recursion" hidden?={ view.ActiveTab != "recursion" }>@SettingsRecursionPanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="cache" hidden?={ view.ActiveTab != "cache" }>@SettingsCachePanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="blocking" hidden?={ view.ActiveTab != "blocking" }>@SettingsBlockingPanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="logging" hidden?={ view.ActiveTab != "logging" }>@SettingsLoggingPanel(view)</div>
		</form>
		// TSIG, Alerts, and Backup live outside the settings form. Each posts
		// its own actions and must never be swept up by a Save Settings
		// submission.
		<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="tsig" hidden?={ view.ActiveTab != "tsig" }>@SettingsTSIGPanel(view)</div>
		<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="alerts" hidden?={ view.ActiveTab != "alerts" }>@SettingsAlertsPanel(view.Alerts)</div>
		<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="backup" hidden?={ view.ActiveTab != "backup" }>@SettingsBackupPanel(view.Backup)</div>
		@AddTSIGKeyDialog(view)
		if view.Insights.CanEdit {
			@SettingsInsightsDialogs()
		}
		if view.Alerts.Available && view.Alerts.CanEdit {
			@AlertDestinationDialog(view.Alerts.NewDestination)
			@AlertWatchDialog(view.Alerts)
		}
		@RunLocalBackupDialog()
		@LocalBackupRestoreDialog()
		@UploadBackupRestoreDialog()
		@ManualCertificateDialogs()
		@CertificateDetailsDialog(view)
	</div>
}

templ SettingsGeneralPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("server", "Server Identity", "Configure the DNS server's identity and listening endpoints") {
			<div class="isotope-card-content">@components.Field(settingsDNSListenField) {<textarea { components.FieldAttrs(settingsDNSListenField)... } name="dns_listen" form="settings-form" rows="3" spellcheck="false" required>{ view.DNSListen }</textarea>}</div>
		}
		@SettingsCard("database", "Storage", "Persistent configuration and DNS data backend") {
			<div class="isotope-card-content field-grid two"><div class="read-only-field"><span>Database Driver</span><strong>{ view.DatabaseDriver }</strong></div><div class="read-only-field"><span>Data Source</span><strong>{ view.DatabaseDSN }</strong></div></div>
		}
		@SettingsInsights(view.Insights)
		@SettingsUpdatePreferences(view.UpdatePreferences)
		<div class="settings-panel-save">@components.Button(components.ButtonProps{Label: "Save Settings", Type: "submit", Attrs: templ.Attributes{"form": "settings-form", "name": "settings_tab", "value": "general"}})</div>
	</div>
}

type SettingsUpdatePreferencesView struct {
 IncludePreRelease bool
 CanEditReleaseChannel bool
	CheckOnLogin bool
	// CheckSchedule is hourly, daily, or weekly. Daily and weekly checks run
	// at CheckAt, HH:MM in this node's local time, and weekly ones on CheckDay.
	CheckSchedule string
	CheckAt string
	CheckDay string
	CanEdit bool
	Message string
	Error string
}

// updateCheckDays are the days a weekly update check can fall on, as the
// schedule saves them and as the picker shows them.
var updateCheckDays = [][2]string{
	{"monday", "Monday"}, {"tuesday", "Tuesday"}, {"wednesday", "Wednesday"}, {"thursday", "Thursday"},
	{"friday", "Friday"}, {"saturday", "Saturday"}, {"sunday", "Sunday"},
}

templ SettingsUpdatePreferences(view SettingsUpdatePreferencesView) {
	<div id="settings-update-preferences">
		@Toast(view.Message, "success")
		@Toast(view.Error, "error")
		@SettingsCard("download", "Software Updates", "Update preferences for this node") {
			<div class="isotope-card-content">
 <input type="hidden" name="update_preferences_present" value="true" form="settings-form"/>
				@updateCheckSchedule(view)
                if view.CanEditReleaseChannel {
                    <input type="hidden" form="settings-form" name="release_channel_present" value="true"/>
                }
                @components.SwitchField(components.SwitchFieldProps{ID: "update-pre-release", Title: "Include pre-releases", Description: "Include preview releases when checking for updates.", Name: "pre_release", Checked: view.IncludePreRelease, Disabled: !view.CanEditReleaseChannel, InputAttrs: templ.Attributes{"form": "settings-form"}})
			</div>
		}
	</div>
}

// updateCheckSchedule is the Check for updates switch with when to check
// under it. The schedule folds away while checks are off, and the day and time
// show only for the schedules that use them.
templ updateCheckSchedule(view SettingsUpdatePreferencesView) {
	<div class="update-check">
		@components.SwitchField(components.SwitchFieldProps{ID: "update-check-on-login", Title: "Check for updates", Description: "Look for a new release when you sign in and on a schedule. Updates are installed only when you choose.", Name: "check_on_login", Checked: view.CheckOnLogin, Disabled: !view.CanEdit, InputAttrs: templ.Attributes{"form": "settings-form"}})
		<div class="update-check-schedule" role="group" aria-label="When to check for updates">
			<span>Check</span>
			<select form="settings-form" name="check_schedule" aria-label="How often to check for updates" data-styled-select disabled?={ !view.CanEdit }>
				<option value="hourly" selected?={ view.CheckSchedule == "hourly" }>Hourly</option>
				<option value="daily" selected?={ view.CheckSchedule == "daily" }>Daily</option>
				<option value="weekly" selected?={ view.CheckSchedule == "weekly" }>Weekly</option>
			</select>
			<span class="update-check-day">
				<span>on</span>
				<select form="settings-form" name="check_day" aria-label="Day to check for updates" data-styled-select disabled?={ !view.CanEdit }>
					for _, day := range updateCheckDays {
						<option value={ day[0] } selected?={ view.CheckDay == day[0] }>{ day[1] }</option>
					}
				</select>
			</span>
			<span class="update-check-at">
				<span>at</span>
				<input type="time" form="settings-form" name="check_at" value={ view.CheckAt } step="60" aria-label="Time to check for updates" data-styled-time disabled?={ !view.CanEdit }/>
			</span>
		</div>
	</div>
}

templ SettingsWebPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("globe", "Web Service Settings", "Configure the web interface and API service") {
			<div class="isotope-card-content field-grid two"><div class="read-only-field"><span>HTTP Listen Address</span><strong>{ view.HTTPListen }</strong><small>The local setup and recovery listener is configured in <code>sable.toml</code>.</small></div>@components.Field(components.FieldProps{ID: "settings-https-listen", Label: "HTTPS Listen Address", Help: "Uses the public certificate configured under Protocols. Changing this address requires a restart.", Input: templ.Attributes{"name": "https_listen", "value": view.HTTPSListen, "placeholder": "0.0.0.0:5443"}})</div>
		}
		@SettingsCard("fingerprint-pattern", "Passkeys", "Configure passkey sign-in") {
 <div class="isotope-card-content"><input type="hidden" name="passkeys_present" value="true"/>@components.SwitchField(components.SwitchFieldProps{ID: "settings-passkeys", Title: "Enable passkeys", Description: "Allow passkey sign-in and registration alongside passwords and single sign-on. Disabling preserves saved passkeys and requires another sign-in method for every active account.", Name: "passkeys_enabled", Checked: view.PasskeysEnabled})</div>
 }
		@SettingsCard("shield", "Session Security", "Configure authentication lifetimes for the web service") {
			<div class="isotope-card-content field-grid two"><div class="read-only-field"><span>Session Lifetime</span><strong>{ view.SessionTTL }</strong></div><div class="read-only-field"><span>Default API Token Lifetime</span><strong>{ view.APITokenTTL }</strong></div></div>
		}
		@SettingsCard("clock", "Display Preferences", "Choose how times and zone records are shown in this browser") {
			<div class="isotope-card-content field-grid two">@components.Field(settingsTimeFormatField) {<select { components.FieldAttrs(settingsTimeFormatField)... } data-time-format-preference data-styled-select><option value="12" selected?={ view.TimeFormat != "24" }>12-hour (9:30 PM)</option><option value="24" selected?={ view.TimeFormat == "24" }>24-hour (21:30)</option></select>}<div class="read-only-field"><span>Time Zone</span><strong>{ view.TimeZone }</strong><small>Detected from this browser. Timestamps are shown in this zone regardless of the server clock.</small></div>@components.Field(settingsRecordNameField) {<select { components.FieldAttrs(settingsRecordNameField)... } data-record-name-preference data-styled-select><option value="relative" selected?={ !view.Console.ShowFullRecordNames }>Relative to zone (www)</option><option value="full" selected?={ view.Console.ShowFullRecordNames }>Fully qualified (www.example.com)</option></select>}</div>
		}
	</div>
}

templ SettingsProtocolsPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("arrow-left-right", "Secure DNS Protocols", "Enable encrypted DNS protocols for enhanced privacy") {
			<div class="isotope-card-content protocol-grid three"><div class="protocol-setting"><div><strong>DNS-over-TLS (DoT)</strong><small>Port 853</small></div><textarea name="dot_listen" rows="2" spellcheck="false" placeholder="0.0.0.0:853">{ view.DoTListen }</textarea></div><div class="protocol-setting"><div><strong>DNS-over-HTTPS (DoH)</strong><small>HTTPS endpoint</small></div><textarea name="doh_listen" rows="2" spellcheck="false" placeholder="0.0.0.0:443">{ view.DoHListen }</textarea></div><div class="protocol-setting"><div><strong>DNS-over-QUIC (DoQ)</strong><small>UDP port 853</small></div><textarea name="doq_listen" rows="2" spellcheck="false" placeholder="0.0.0.0:853">{ view.DoQListen }</textarea></div></div>
		}
		<div id="public-certificates">
			@SettingsCard("shield", "Public TLS Certificate", "Certificate used by the Web, DNS-over-HTTPS, and DNS-over-TLS endpoints") {
				<div class="isotope-card-content certificate-settings" data-certificate-settings>
					<div class="certificate-mode-control" role="radiogroup" aria-label="Certificate source"><label class={ ifThen(view.CertificateMode != "acme", "active", "") }><input type="radio" name="certificate_mode" value="manual" checked?={ view.CertificateMode != "acme" }/><span>Manual Certificate</span></label><label class={ ifThen(view.CertificateMode == "acme", "active", "") }><input type="radio" name="certificate_mode" value="acme" checked?={ view.CertificateMode == "acme" }/><span>Let's Encrypt (ACME)</span></label></div>
					<div class="manual-certificate-settings" data-certificate-manual hidden?={ view.CertificateMode == "acme" }>
						<div class="field-grid two"><label class="field-control"><span>Certificate File</span><input name="certificate_file" value={ view.CertificateFile } placeholder="/etc/sable/tls/fullchain.pem"/></label><label class="field-control"><span>Private Key File</span><input name="private_key_file" value={ view.PrivateKeyFile } placeholder="/etc/sable/tls/privkey.pem"/></label></div>
						<div class="certificate-manual-actions">@components.Button(components.ButtonProps{Label: "Generate Self-Signed", Icon: "key", Attrs: templ.Attributes{"data-dialog-open": "generate-certificate-dialog", "data-replica-primary-action": true}})@components.Button(components.ButtonProps{Label: "Import PEM", Icon: "upload", Variant: components.ButtonOutline, Attrs: templ.Attributes{"data-dialog-open": "import-certificate-dialog", "data-replica-primary-action": true}})</div>
						<div class="certificate-manual-note">@Icon("info")<span>Generated certificates are useful for private deployments but remain untrusted until their identity is added to client trust stores.</span></div>
					</div>
					<div class="acme-settings" data-certificate-acme hidden?={ view.CertificateMode != "acme" }>
						<div class={ "certificate-status", ifThen(view.ACMELastError != "", "attention", ifThen(view.ACMEIssuer != "", "active", "pending")) }>
							<span class="certificate-status-icon">
								if view.ACMELastError != "" {
									@Icon("shield-x")
								} else if view.ACMEIssuer != "" {
									@Icon("shield-check")
								} else {
									@Icon("shield")
								}
							</span>
							<div class="certificate-status-detail">
								<div class="certificate-status-heading"><strong>Managed certificate</strong><span class={ ifThen(view.ACMELastError != "", "badge danger", ifThen(view.ACMEIssuer != "", "badge success", "badge")) }>{ ifThen(view.ACMELastError != "", "Attention", ifThen(view.ACMEIssuer != "", "Active", "Not issued")) }</span></div>
								if view.ACMEIssuer != "" {
									<span>
										{ view.ACMEIssuer }<span class="certificate-status-separator">·</span>expires { view.ACMEExpires }
										if len(view.ACMECoveredNames) > 0 {
											<span class="certificate-status-separator">·</span>
											<button class="certificate-details-link" type="button" data-dialog-open="certificate-details-dialog">{ coveredNamesSummary(view.ACMECoveredNames) }</button>
										}
									</span>
								} else {
									<span>No certificate has been issued yet. Complete the settings below, save, then issue one.</span>
								}
							</div>
							@components.Button(components.ButtonProps{Label: ifThen(view.ACMERenewing, "Issuing…", ifThen(view.ACMEIssuer != "", "Renew Now", "Issue Certificate")), Icon: "refresh", Type: "submit", Disabled: view.ACMERenewing, Class: "certificate-renew-button", Attrs: templ.Attributes{"formaction": "/ui/certificates/renew", "hx-post": "/ui/certificates/renew", "hx-target": "#settings-content", "hx-swap": "outerHTML", "data-replica-primary-action": true}})
						</div>
						if view.ACMELastError != "" {
							<div class="certificate-error" role="alert">@Icon("alert-triangle")<span>{ view.ACMELastError }</span></div>
						}
						<div class="field-grid two">@components.Field(components.FieldProps{ID: "settings-acme-email", Label: "Contact Email", Help: "Used by the certificate authority for expiry and account notices.", Input: templ.Attributes{"type": "email", "name": "acme_email", "value": view.ACMEEmail, "placeholder": "dns-admin@example.com"}})@components.Field(settingsACMEDomainsField) {<textarea { components.FieldAttrs(settingsACMEDomainsField)... } name="acme_domains" rows="3" spellcheck="false" placeholder="dns.example.com&#10;*.example.com">{ view.ACMEDomains }</textarea>}@components.Field(settingsACMEDirectoryURLField) {<select { components.FieldAttrs(settingsACMEDirectoryURLField)... } name="acme_directory_url" data-styled-select><option value="https://acme-v02.api.letsencrypt.org/directory" selected?={ view.ACMEDirectoryURL == "https://acme-v02.api.letsencrypt.org/directory" }>Let's Encrypt Production</option><option value="https://acme-staging-v02.api.letsencrypt.org/directory" selected?={ view.ACMEDirectoryURL == "https://acme-staging-v02.api.letsencrypt.org/directory" }>Let's Encrypt Staging</option></select>}@components.Field(components.FieldProps{ID: "settings-acme-renew-before", Label: "Renew Before Expiry", Help: "Between 1d and 60d.", Input: templ.Attributes{"name": "acme_renew_before", "value": view.ACMERenewBefore, "placeholder": "30d"}})</div>
						<div class="acme-provider-card" data-acme-provider-root data-acme-provider-selected={ view.ACMEDNSProvider }>
							<header>
								<span class="acme-provider-icon">@Icon("globe-lock")</span>
								<div><strong>DNS-01 Provider</strong><small>Credentials are encrypted in Sable's secret vault.</small></div>
								<span class={ ifThen(view.ACMECredentialsConfigured, "badge success", "badge") }>{ ifThen(view.ACMECredentialsConfigured, "Configured", "Credentials required") }</span>
							</header><div class="field-grid two"><label class="field-control"><span>Provider</span><select name="acme_dns_provider" data-acme-provider data-styled-select><option value="" data-placeholder selected?={ view.ACMEDNSProvider == "" }>Choose a provider</option><option value="cloudflare" selected?={ view.ACMEDNSProvider == "cloudflare" }>Cloudflare</option><option value="porkbun" selected?={ view.ACMEDNSProvider == "porkbun" }>Porkbun</option><option value="namecheap" selected?={ view.ACMEDNSProvider == "namecheap" }>Namecheap</option><option value="godaddy" selected?={ view.ACMEDNSProvider == "godaddy" }>GoDaddy</option><option value="digitalocean" selected?={ view.ACMEDNSProvider == "digitalocean" }>DigitalOcean</option><option value="hetzner" selected?={ view.ACMEDNSProvider == "hetzner" }>Hetzner</option><option value="route53" selected?={ view.ACMEDNSProvider == "route53" }>Amazon Route 53</option><option value="ovh" selected?={ view.ACMEDNSProvider == "ovh" }>OVHcloud</option><option value="rfc2136" selected?={ view.ACMEDNSProvider == "rfc2136" }>RFC 2136 Dynamic Update</option></select></label>@components.Field(components.FieldProps{ID: "settings-acme-dns-zone", Label: "DNS Zone (optional)", Help: "Set this for delegated subzones; otherwise Sable detects the registrable zone.", Input: templ.Attributes{"name": "acme_dns_zone", "value": view.ACMEDNSZone, "placeholder": "example.com"}})</div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="cloudflare" hidden?={ view.ACMEDNSProvider != "cloudflare" }><label class="field-control"><span>API Token</span><input type="password" name="cloudflare_api_token" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "Cloudflare API token") }/></label><label class="field-control"><span>Zone ID (optional)</span><input name="cloudflare_zone_id" placeholder="Detected from the zone when blank"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="porkbun" hidden?={ view.ACMEDNSProvider != "porkbun" }><label class="field-control"><span>API Key</span><input type="password" name="porkbun_api_key" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "Porkbun API key") }/></label><label class="field-control"><span>Secret API Key</span><input type="password" name="porkbun_secret" autocomplete="new-password" placeholder="Secret API key"/></label></div>
							<div class="field-grid three acme-credential-fields" data-acme-credentials="namecheap" hidden?={ view.ACMEDNSProvider != "namecheap" }><label class="field-control"><span>API Username</span><input name="namecheap_username" autocomplete="off"/></label><label class="field-control"><span>API Key</span><input type="password" name="namecheap_api_key" autocomplete="new-password"/></label><label class="field-control"><span>Allow-listed Client IP</span><input name="namecheap_client_ip" placeholder="203.0.113.10"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="godaddy" hidden?={ view.ACMEDNSProvider != "godaddy" }><label class="field-control"><span>Production API Token</span><input type="password" name="godaddy_api_token" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "GoDaddy API token") }/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="digitalocean" hidden?={ view.ACMEDNSProvider != "digitalocean" }><label class="field-control"><span>API Token</span><input type="password" name="digitalocean_api_token" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "DigitalOcean API token") }/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="hetzner" hidden?={ view.ACMEDNSProvider != "hetzner" }><label class="field-control"><span>API Token</span><input type="password" name="hetzner_api_token" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "Hetzner API token") }/></label><label class="field-control"><span>Zone ID (optional)</span><input name="hetzner_zone_id" placeholder="Uses the DNS zone name when blank"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="route53" hidden?={ view.ACMEDNSProvider != "route53" }><label class="field-control"><span>Access Key ID</span><input name="route53_access_key_id" autocomplete="off" placeholder="AKIA…"/></label><label class="field-control"><span>Secret Access Key</span><input type="password" name="route53_secret_access_key" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "AWS secret access key") }/></label><label class="field-control"><span>Hosted Zone ID</span><input name="route53_zone_id" placeholder="Z0123456789EXAMPLE"/></label><label class="field-control"><span>Session Token (optional)</span><input type="password" name="route53_session_token" autocomplete="new-password" placeholder="For temporary AWS credentials"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="ovh" hidden?={ view.ACMEDNSProvider != "ovh" }><label class="field-control"><span>API Endpoint</span><select name="ovh_endpoint" data-styled-select><option value="ovh-eu" selected?={ view.ACMEProviderEndpoint == "" || view.ACMEProviderEndpoint == "ovh-eu" }>Europe</option><option value="ovh-ca" selected?={ view.ACMEProviderEndpoint == "ovh-ca" }>Canada</option><option value="ovh-us" selected?={ view.ACMEProviderEndpoint == "ovh-us" }>United States</option></select></label><label class="field-control"><span>Application Key</span><input name="ovh_application_key" autocomplete="off"/></label><label class="field-control"><span>Application Secret</span><input type="password" name="ovh_application_secret" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "OVHcloud application secret") }/></label><label class="field-control"><span>Consumer Key</span><input type="password" name="ovh_consumer_key" autocomplete="new-password"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="rfc2136" hidden?={ view.ACMEDNSProvider != "rfc2136" }><label class="field-control"><span>Authoritative Server</span><input name="rfc2136_server" placeholder="dns.example.com:53"/></label><label class="field-control"><span>TSIG Key Name</span><input name="rfc2136_tsig_name" placeholder="acme-update."/></label><label class="field-control"><span>TSIG Secret</span><input type="password" name="rfc2136_tsig_secret" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "Base64-encoded shared secret") }/></label><label class="field-control"><span>TSIG Algorithm</span><select name="rfc2136_tsig_algorithm" data-styled-select><option value="hmac-sha256" selected?={ view.ACMETSIGAlgorithm == "" || view.ACMETSIGAlgorithm == "hmac-sha256" }>HMAC-SHA256</option><option value="hmac-sha384" selected?={ view.ACMETSIGAlgorithm == "hmac-sha384" }>HMAC-SHA384</option><option value="hmac-sha512" selected?={ view.ACMETSIGAlgorithm == "hmac-sha512" }>HMAC-SHA512</option></select></label></div>
						</div>
						@components.Field(components.FieldProps{ID: "settings-acme-storage-dir", Label: "Certificate Storage", Help: "Account key, certificate, and private key stay node-local.", Input: templ.Attributes{"name": "acme_storage_dir", "value": view.ACMEStorageDirectory, "placeholder": "data/tls/acme"}})
					</div>
					<div class="certificate-shared-settings">
						<span class="certificate-shared-label">Applies to both sources</span>
						<label class="field-control narrow-control"><span>Minimum TLS Version</span><select name="minimum_tls_version" data-styled-select><option value="1.2" selected?={ view.MinimumTLSVersion == "1.2" }>TLS 1.2</option><option value="1.3" selected?={ view.MinimumTLSVersion == "1.3" }>TLS 1.3</option></select></label>
					</div>
				</div>
			}
		</div>
		@SettingsSaveButton("protocols")
	</div>
}

templ ManualCertificateDialogs() {
	@components.Dialog(components.DialogProps{ID: "generate-certificate-dialog", TitleID: "generate-certificate-title", Title: "Generate Self-Signed Certificate", Description: "Create and configure a node-local certificate for Web, DoH, and DoT", Class: "isotope-form-dialog certificate-dialog"}) {
		<form hx-post="/ui/certificates/generate" hx-target="#settings-content" hx-swap="outerHTML">
			<input type="hidden" name="settings_tab" value="protocols"/>
			<div class="isotope-dialog-body">
				<label><span>DNS Names and IP Addresses</span><textarea class="mono-input" name="manual_certificate_names" rows="5" placeholder={ "dns.example.com\n*.example.com\n192.0.2.10" } required></textarea><small>Enter one subject alternative name per line. Include every address clients use.</small></label>
				<div class="field-grid two"><label><span>Validity (days)</span><input type="number" name="manual_certificate_valid_days" value="365" min="1" max="3650" required/></label><label><span>Protected Storage Directory</span><input class="mono-input" name="manual_certificate_storage_dir" value="data/tls/manual" required/><small>Must remain inside the Sable configuration directory.</small></label></div>
				<div class="cluster-dialog-note">@Icon("shield-check")<p><strong>ECDSA P-256 identity</strong><span>The private key is written with owner-only permissions and is never stored in TOML or returned by the API.</span></p></div>
			</div>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Generate & Use Certificate", Type: "submit"})
			}
		</form>
	}
	@components.Dialog(components.DialogProps{ID: "import-certificate-dialog", TitleID: "import-certificate-title", Title: "Import Certificate", Description: "Validate and store an existing PEM certificate chain and private key", Class: "isotope-form-dialog certificate-dialog"}) {
		<form hx-post="/ui/certificates/import" hx-target="#settings-content" hx-swap="outerHTML">
			<input type="hidden" name="settings_tab" value="protocols"/>
			<div class="isotope-dialog-body">
				<label><span>Certificate Chain (PEM)</span><textarea class="mono-input" name="manual_certificate_pem" rows="7" spellcheck="false" autocomplete="off" placeholder="-----BEGIN CERTIFICATE-----" required></textarea></label>
				<label><span>Private Key (PEM)</span><textarea class="mono-input" name="manual_private_key_pem" rows="7" spellcheck="false" autocomplete="off" placeholder="-----BEGIN PRIVATE KEY-----" required></textarea></label>
				<label><span>Protected Storage Directory</span><input class="mono-input" name="manual_import_storage_dir" value="data/tls/manual" required/></label>
				<div class="cluster-dialog-note">@Icon("lock")<p><strong>Validated before activation</strong><span>Sable verifies the key pair and validity period before committing either file. The private key is never rendered back into the UI.</span></p></div>
			</div>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Import & Use Certificate", Type: "submit"})
			}
		</form>
	}
}

// AttachedNetworkView is one IPv6 network private recursion covers, with the
// interface it's on or the node that shared it.
type AttachedNetworkView struct {
	Prefix string
	Source string
}

// SettingsAttachedNetworks lists the networks private recursion covers
// besides the fixed private ranges. It only shows while private access is
// chosen.
templ SettingsAttachedNetworks(networks []AttachedNetworkView) {
	<div class="read-only-field attached-networks">
		<span>This Network</span>
		if len(networks) > 0 {
			<ul class="attached-network-list">
				for _, network := range networks {
					<li><code>{ network.Prefix }</code><small>{ network.Source }</small></li>
				}
			</ul>
		} else {
			<strong>No IPv6 network found</strong>
		}
		<small>Private access also covers the IPv6 networks Sable is attached to.</small>
	</div>
}

templ SettingsRecursionPanel(view SettingsPageView) {
 <div class="settings-panel-stack">
 @SettingsCard("shield", "Recursive Clients", "Control who can use forwarding, recursion, and cached recursive answers") {
 <div class="isotope-card-content">
 <label class="field-control"><span>Recursion Access</span><select name="recursion" data-styled-select>
 <option value="private" selected?={ view.Recursion == "private" }>Private networks and loopback (default)</option>
 <option value="acl" selected?={ view.Recursion == "acl" }>Listed clients only</option>
 <option value="deny" selected?={ view.Recursion == "deny" }>Disabled — authoritative and local answers only</option>
 <option value="allow" selected?={ view.Recursion == "allow" }>Everyone — public recursive resolver</option>
 </select><small>Applies to UDP, TCP, DoT, DoH, and DoQ. Private access includes link-local clients. Authoritative zones remain public.</small></label>
 @SettingsAttachedNetworks(view.AttachedNetworks)
 @components.Field(settingsRecursionClientsField) {<textarea { components.FieldAttrs(settingsRecursionClientsField)... } name="recursion_clients" rows="4" spellcheck="false" placeholder={ "192.168.1.0/24\nfd00::/8" }>{ view.RecursionClients }</textarea>}
 </div>
 }

		@SettingsCard("shield", "Resolution Capacity", "Bound outstanding DNS work during bursts and upstream outages") {
 <div class="isotope-card-content field-grid two">
 @components.Field(components.FieldProps{ID: "settings-max-concurrent", Label: "Maximum Concurrent Resolutions", Help: "Node-wide limit for unresolved requests and background refreshes. Excess requests receive REFUSED; cached and local answers remain available.", Input: templ.Attributes{"type": "number", "name": "max_concurrent", "min": "1", "max": "65536", "value": fmt.Sprint(view.MaxConcurrent), "required": true}})
 @components.Field(components.FieldProps{ID: "settings-max-concurrent-per-client", Label: "Maximum Per Client", Help: "Limit per source IP, including requests waiting for an identical lookup. Background refreshes share a separate client allowance.", Input: templ.Attributes{"type": "number", "name": "max_concurrent_per_client", "min": "1", "max": "65536", "value": fmt.Sprint(view.MaxConcurrentPerClient), "required": true}})
 </div>
 }
 @SettingsCard("refresh", "Recursive Resolver", "Configure recursive resolution behavior and DNSSEC validation") {
			<div class="isotope-card-content">
				<div class="blocking-radio-list settings-blocking-radio-list"><label><input type="radio" name="resolver_mode" value="recursive" checked?={ view.ResolverMode == "recursive" }/><span><strong>Iterative Recursion</strong><small>Resolve directly from the DNS root. Conditional routes still use their configured forwarders.</small></span></label><label><input type="radio" name="resolver_mode" value="forward" checked?={ view.ResolverMode == "forward" }/><span><strong>Forwarding</strong><small>Send unmatched queries to the forwarders configured below.</small></span></label></div>
				<div class="field-grid two">@components.Field(components.FieldProps{ID: "settings-resolver-timeout", Label: "Resolution Timeout", Help: "End-to-end deadline, such as `3s`.", Input: templ.Attributes{"name": "resolver_timeout", "value": view.ResolverTimeout, "required": true}})@components.SwitchField(components.SwitchFieldProps{ID: "settings-dnssec-validation", Title: "Validate DNSSEC", Description: "Reject bogus signatures during recursive resolution.", Name: "dnssec_validation", Checked: view.DNSSECValidation})</div>
				<div class="field-grid two">@components.Field(components.FieldProps{ID: "settings-resolver-retries", Label: "Upstream Retries", Help: "Attempts per upstream before failover on a dropped packet. Raise `Resolution Timeout` too if you increase this in recursive mode.", Input: templ.Attributes{"type": "number", "name": "resolver_retries", "min": "1", "max": "10", "value": fmt.Sprint(view.ResolverRetries), "required": true}})@components.Field(components.FieldProps{ID: "settings-resolver-retry-timeout", Label: "Retry Timeout", Help: "How long each attempt waits, such as `1500ms`.", Input: templ.Attributes{"name": "resolver_retry_timeout", "value": view.ResolverRetryTimeout, "required": true}})</div>
				@components.SwitchField(components.SwitchFieldProps{ID: "settings-qname-minimization", Title: "QNAME Minimization", Description: "Ask each zone only for the next part of a name, so parent zones never see the whole name. Turn off only if a DNS provider fails with it on.", Name: "qname_minimization", Checked: view.QNAMEMinimization})
				@components.SwitchField(components.SwitchFieldProps{ID: "settings-trust-anchor-updates", Title: "Automatic Trust-Anchor Updates", Description: "Maintain RFC 5011 root trust anchors without manual intervention.", Name: "trust_anchor_updates", Checked: view.TrustAnchorUpdates})
				<details class="settings-advanced"><summary>@Icon("sliders")<span>Advanced root hints</span>@Icon("chevron-down")</summary>@components.Field(settingsRootHintsField) {<textarea { components.FieldAttrs(settingsRootHintsField)... } name="root_hints" rows="5" spellcheck="false" placeholder="Use Sable's bundled IANA root hints">{ view.RootHints }</textarea>}</details>
			</div>
		}
		@SettingsCard("arrow-left-right", "DNS Forwarders", "Forward queries to upstream DNS servers instead of recursive resolution") {
			<div class="isotope-card-content">@components.Field(settingsForwardersField) {<textarea { components.FieldAttrs(settingsForwardersField)... } name="forwarders" rows="4" spellcheck="false" placeholder={ "8.8.8.8\n1.1.1.1" }>{ view.Forwarders }</textarea>}</div>
		}
		@SettingsSaveButton("recursion")
	</div>
}

templ SettingsCachePanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("database", "Cache Settings", "Configure DNS cache behavior, limits, and TTL policy") {
			<div class="isotope-card-content">@components.SwitchField(components.SwitchFieldProps{ID: "settings-save-cache", Title: "Save Cache to Disk", Description: "Persist warm cache entries in the configured database during a controlled shutdown and restore them at startup.", Name: "save_cache", Checked: view.SaveCache})@components.Field(components.FieldProps{ID: "settings-cache-size", Label: "Maximum Cache Entries", Help: "Maximum number of DNS responses held in the bounded, sharded LRU cache.", Class: "narrow-control", Input: templ.Attributes{"type": "number", "name": "cache_size", "min": "1", "value": fmt.Sprint(view.CacheSize), "required": true}})<div class="field-grid four cache-ttl-grid">@components.Field(components.FieldProps{ID: "settings-cache-minimum-ttl", Label: "Minimum TTL (sec)", Help: "Raises shorter upstream TTLs.", Input: templ.Attributes{"type": "number", "name": "cache_minimum_ttl", "min": "0", "max": "4294967295", "value": fmt.Sprint(view.CacheMinimumTTL), "required": true}})@components.Field(components.FieldProps{ID: "settings-cache-maximum-ttl", Label: "Maximum TTL (sec)", Help: "Caps longer upstream TTLs.", Input: templ.Attributes{"type": "number", "name": "cache_maximum_ttl", "min": "1", "max": "4294967295", "value": fmt.Sprint(view.CacheMaximumTTL), "required": true}})@components.Field(components.FieldProps{ID: "settings-cache-negative-ttl", Label: "Negative TTL (sec)", Help: "NXDOMAIN and negative answers.", Input: templ.Attributes{"type": "number", "name": "cache_negative_ttl", "min": "0", "max": "4294967295", "value": fmt.Sprint(view.CacheNegativeTTL), "required": true}})@components.Field(components.FieldProps{ID: "settings-cache-failure-ttl", Label: "Failure TTL (sec)", Help: "SERVFAIL caching; 0 disables it.", Input: templ.Attributes{"type": "number", "name": "cache_failure_ttl", "min": "0", "max": "4294967295", "value": fmt.Sprint(view.CacheFailureTTL), "required": true}})</div></div>
		}
		@SettingsCard("refresh", "Serve Stale Records", "Serve recently expired records when upstream resolution fails") {
			<div class="isotope-card-content">@components.SwitchField(components.SwitchFieldProps{ID: "settings-serve-stale", Title: "Enable Serve Stale", Description: "Improve availability during upstream outages without serving stale data during normal operation.", Name: "serve_stale", Checked: view.ServeStale})<div class="field-grid four">@components.Field(components.FieldProps{ID: "settings-cache-stale-ttl", Label: "Maximum Stale Age (sec)", Help: "Maximum age for retained stale records.", Input: templ.Attributes{"type": "number", "name": "cache_stale_ttl", "min": "1", "max": "4294967295", "value": fmt.Sprint(view.CacheStaleTTL), "required": true}})@components.Field(components.FieldProps{ID: "settings-cache-stale-answer-ttl", Label: "Answer TTL (sec)", Help: "TTL returned in stale responses.", Input: templ.Attributes{"type": "number", "name": "cache_stale_answer_ttl", "min": "1", "max": "4294967295", "value": fmt.Sprint(view.CacheStaleAnswerTTL), "required": true}})@components.Field(components.FieldProps{ID: "settings-cache-stale-reset-ttl", Label: "Retry TTL (sec)", Help: "Delay before retrying a failed upstream.", Input: templ.Attributes{"type": "number", "name": "cache_stale_reset_ttl", "min": "1", "max": "4294967295", "value": fmt.Sprint(view.CacheStaleResetTTL), "required": true}})@components.Field(components.FieldProps{ID: "settings-cache-stale-max-wait-ms", Label: "Max Wait (ms)", Help: "Wait before returning stale data.", Input: templ.Attributes{"type": "number", "name": "cache_stale_max_wait_ms", "min": "1", "max": "60000", "value": fmt.Sprint(view.CacheStaleMaxWaitMS), "required": true}})</div></div>
		}
		@SettingsCard("refresh", "Cache Prefetching", "Refresh popular records in the background before they expire") {
			<div class="isotope-card-content field-grid four">@components.Field(components.FieldProps{ID: "settings-cache-prefetch-minimum-ttl", Label: "Eligibility TTL (sec)", Help: "Minimum original TTL for prefetch.", Input: templ.Attributes{"type": "number", "name": "cache_prefetch_minimum_ttl", "min": "0", "max": "4294967295", "value": fmt.Sprint(view.CachePrefetchMinimumTTL), "required": true}})@components.Field(components.FieldProps{ID: "settings-cache-prefetch-trigger-ttl", Label: "Trigger TTL (sec)", Help: "Refresh at this remaining TTL; 0 disables.", Input: templ.Attributes{"type": "number", "name": "cache_prefetch_trigger_ttl", "min": "0", "max": "4294967295", "value": fmt.Sprint(view.CachePrefetchTriggerTTL), "required": true}})@components.Field(components.FieldProps{ID: "settings-cache-prefetch-sample-interval", Label: "Sample Interval", Help: "Duration such as `5m`.", Input: templ.Attributes{"name": "cache_prefetch_sample_interval", "value": view.CachePrefetchSample, "required": true}})@components.Field(components.FieldProps{ID: "settings-cache-prefetch-hits-per-hour", Label: "Sample Hits/Hour", Help: "Minimum popularity for prefetch.", Input: templ.Attributes{"type": "number", "name": "cache_prefetch_hits_per_hour", "min": "1", "max": "4294967295", "value": fmt.Sprint(view.CachePrefetchHitsPerHour), "required": true}})</div>
		}
		@SettingsSaveButton("cache")
	</div>
}

templ SettingsBlockingPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("shield", "Blocking Response", "Configure how Sable responds to blocked DNS requests") {
			<div class="isotope-card-content">
				<div class="blocking-radio-list settings-blocking-radio-list"><label><input type="radio" name="blocking_response_type" value="zero" checked?={ view.BlockingResponseType == "zero" }/><span><strong>Any Address</strong><small>Respond with 0.0.0.0 and :: for blocked domains.</small></span></label><label><input type="radio" name="blocking_response_type" value="nxdomain" checked?={ view.BlockingResponseType == "nxdomain" }/><span><strong>NX Domain</strong><small>Respond with NXDOMAIN (domain does not exist).</small></span></label><label><input type="radio" name="blocking_response_type" value="custom" checked?={ view.BlockingResponseType == "custom" }/><span><strong>Custom Address</strong><small>Respond with the IP addresses specified below.</small></span></label></div>
				<label class="blocking-textarea" data-custom-addresses hidden?={ view.BlockingResponseType != "custom" }><span>Custom Blocking Addresses</span><textarea name="blocking_custom_addresses" rows="3" placeholder={ "127.0.0.1\n::1" }>{ view.BlockingCustomAddresses }</textarea><small>Enter one IPv4 or IPv6 address per line.</small></label>
				<label class="blocking-number"><span>Response TTL (seconds)</span><input type="number" name="blocking_response_ttl" min="0" max="4294967295" value={ fmt.Sprint(view.BlockingResponseTTL) } required/><small>How long clients should cache a blocking response.</small></label>
			</div>
		}
		@SettingsCard("refresh", "Block List Updates", "Configure automatic refreshes for remote block lists") {
			<div class="isotope-card-content">@components.Field(components.FieldProps{ID: "settings-blocking-update-hours", Label: "Update Interval (hours)", Help: "Remote block lists are downloaded and compiled on this schedule.", Class: "narrow-control", Input: templ.Attributes{"type": "number", "name": "blocking_update_hours", "min": "1", "max": "8760", "value": fmt.Sprint(view.BlockingUpdateHours), "required": true}})</div>
		}
		@SettingsCard("server", "Bypass Clients", "Exclude trusted clients and networks from DNS blocking") {
			<div class="isotope-card-content">@components.Field(settingsBlockingBypassClientsField) {<textarea { components.FieldAttrs(settingsBlockingBypassClientsField)... } name="blocking_bypass_clients" rows="4" placeholder={ "192.168.1.100\n10.0.0.0/8" }>{ view.BlockingBypassClients }</textarea>}</div>
		}
		@SettingsCard("sliders", "Advanced Options", "Additional blocking response behavior") {
			<div class="isotope-card-content">@components.SwitchField(components.SwitchFieldProps{ID: "settings-blocking-allow-txt-report", Title: "Allow TXT Blocking Report", Description: "Return blocking information when a blocked name is queried for TXT records.", Name: "blocking_allow_txt_report", Checked: view.BlockingAllowTXTReport})</div>
		}
		<div class="settings-blocking-actions">@components.Button(components.ButtonProps{Label: "Manage Block Lists and Domains", Icon: "shield", Variant: components.ButtonOutline, Href: "/blocked"})@components.Button(components.ButtonProps{Label: "Save Settings", Type: "submit", Attrs: templ.Attributes{"name": "settings_tab", "value": "blocking"}})</div>
	</div>
}

templ SettingsLoggingPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("logs", "DNS Query Logs", "Control searchable DNS query history") {
			<div class="isotope-card-content">@components.SwitchField(components.SwitchFieldProps{ID: "settings-query-log-enabled", Title: "Log DNS Queries", Description: "Persist DNS queries for search, rankings, and operational analysis.", Name: "query_log_enabled", Checked: view.QueryLogEnabled})@components.Field(components.FieldProps{ID: "settings-query-log-retention", Label: "Query Log Retention", Help: "Positive duration such as `30d`. Fixed units: y, mo, w, and d.", Class: "narrow-control", Input: templ.Attributes{"name": "query_log_retention", "value": view.QueryLogRetention, "required": true}})</div>
		}
		@SettingsCard("server", "Server Logs", "Control runtime and audit history") {
			<div class="isotope-card-content">@components.SwitchField(components.SwitchFieldProps{ID: "settings-server-log-enabled", Title: "Persist Server Logs", Description: "Keep searchable runtime and audit entries across restarts. Entries always continue to stderr.", Name: "server_log_enabled", Checked: view.ServerLogEnabled})<div class="field-grid two">@components.Field(settingsServerLogLevelField) {<select { components.FieldAttrs(settingsServerLogLevelField)... } name="server_log_level" data-styled-select><option value="debug" selected?={ view.ServerLogLevel == "debug" }>Debug</option><option value="info" selected?={ view.ServerLogLevel == "info" }>Info</option><option value="warn" selected?={ view.ServerLogLevel == "warn" }>Warning</option><option value="error" selected?={ view.ServerLogLevel == "error" }>Error</option></select>}@components.Field(components.FieldProps{ID: "settings-server-log-retention", Label: "Server Log Retention", Help: "Positive duration such as `60d`. Fixed units: y, mo, w, and d.", Class: "narrow-control", Input: templ.Attributes{"name": "server_log_retention", "value": view.ServerLogRetention, "required": true}})</div></div>
		}
		@SettingsCard("line-chart", "Dashboard History", "Control retained chart data") {
			<div class="isotope-card-content">@components.Field(components.FieldProps{ID: "settings-statistics-retention", Label: "Statistics Retention", Help: "Defaults to one fixed year: `1y` equals 365 days. Lifetime counters are not pruned.", Class: "narrow-control", Input: templ.Attributes{"name": "statistics_retention", "value": view.StatisticsRetention, "required": true}})</div>
		}
		@SettingsSaveButton("logging")
	</div>
}

// SettingsBackupView drives the backup panel. The passphrase is never echoed
// back into it, so a re-render after an error always asks for it again.
type SettingsBackupView struct {
	Available     bool
	CanCreate     bool
	CanRestore    bool
	Message       string
	Error         string
	DownloadToken  string
	DownloadName   string
	DownloadSize   string
	DownloadExpiry string
	// DownloadExpiresAt is the same deadline as a Unix millisecond stamp, so
	// the browser can keep the countdown honest instead of showing whatever
	// was true when the page happened to render.
	DownloadExpiresAt int64
	LocalAvailable             bool
	ScheduleEnabled            bool
	ScheduleDirectory          string
	ScheduleResolvedDirectory  string
	ScheduleInterval           string
	ScheduleRunAt              string
	ScheduleRetentionCount     int
	SchedulePassphraseStored   bool
	ScheduleNextRun            string
	ScheduleNextRunCompact     string
	ScheduleLastSuccess        string
	ScheduleLastSuccessCompact string
	ScheduleLastError          string
	LocalBackups               []SettingsLocalBackupView
	// OfferRestart marks a result that only takes effect after a restart, so
	// the notice carries the button rather than only naming the step.
	OfferRestart bool
	// Job describes the operation running right now. While it is set the panel
	// shows progress in place of the forms and asks for the next poll.
	Job *SettingsBackupJobView
}

// SettingsLocalBackupView is one on-disk archive offered for restore.
type SettingsLocalBackupView struct {
	Name         string
	Created      string
	Hostname     string
	SableVersion string
	Size         string
	Scheduled    bool
}

// SettingsBackupJobView is the live state of a running backup or restore.
type SettingsBackupJobView struct {
	Kind    string
	Title   string
	Stage   string
	Step    int
	Total   int
	Percent int
}

// Running reports whether an operation of the given kind is under way, which
// decides whether a card shows its form or its progress.
func (view SettingsBackupView) Running(kind string) bool {
	return view.Job != nil && view.Job.Kind == kind
}

// Busy reports whether any operation is under way. Both cards lock down while
// one runs, because a backup and a restore would fight over the same files.
func (view SettingsBackupView) Busy() bool { return view.Job != nil }

// SettingsTSIGPanel manages the shared secrets that authenticate transfers and
// dynamic updates. Only the name and algorithm are configuration; the secret
// itself lives in the node's encrypted vault, which is why the list can say
// whether a key has one but never show it again after it is created.
templ SettingsTSIGPanel(view SettingsPageView) {
	<div class="settings-panel-stack tsig-panel">
		if view.TSIGGeneratedSecret != "" {
			<div class="token-created">
				<strong>Copy this secret now</strong>
				<div class="copyable-text token-secret"><span id="generated-tsig-secret">{ view.TSIGGeneratedSecret }</span><button type="button" data-copy-target="generated-tsig-secret" aria-label="Copy TSIG secret" title="Copy TSIG secret">@CopyIcons()</button></div>
				<span>Configure the other server with this secret for { TSIGDisplayName(view.TSIGGeneratedKey) }. Sable keeps it encrypted and will not show it again; rotate the key if you lose it.</span>
			</div>
		}
		@components.Card(components.CardProps{Class: "settings-source-card settings-action-card"}) {
			@components.CardHeader(components.CardHeaderProps{Icon: "key", Title: "TSIG Keys", Description: "Shared secrets that authenticate NOTIFY, AXFR, IXFR, and dynamic updates. Secrets are held in this node's encrypted vault, never in sable.toml."}) {
				@components.Button(components.ButtonProps{Label: "Add Key", Icon: "plus", Compact: true, Attrs: templ.Attributes{"data-dialog-open": "add-tsig-key-dialog", "data-replica-primary-action": true}})
			}
			<div class="isotope-card-content">
				if len(view.TSIGKeys) == 0 {
					@components.EmptyState(components.EmptyStateProps{Icon: "key", Title: "No TSIG keys yet", Description: "Zones without a key fall back to source-IP and transfer-policy authorization.", Class: "tsig-empty"})
				} else {
					<div class="tsig-key-list isotope-source-list">
						for _, key := range view.TSIGKeys {
							@SettingsTSIGKeyRow(key)
						}
					</div>
				}
			</div>
		}
	</div>
}

templ AddTSIGKeyDialog(view SettingsPageView) {
	@components.Dialog(components.DialogProps{ID: "add-tsig-key-dialog", TitleID: "add-tsig-key-title", Title: "Add TSIG Key", Description: "Leave the secret blank and Sable generates one sized to the algorithm. Paste a secret instead when another server already owns the key.", Class: "blocking-dialog"}) {
		<form class="blocking-dialog-form" hx-post="/ui/settings/tsig/save" hx-target="#settings-content" hx-swap="outerHTML">
			<label><span>Key Name</span><input class="mono-input" name="tsig_name" placeholder="transfer-key" autocomplete="off" required/><small>A DNS name. Both servers must agree on it exactly.</small></label>
			<label><span>Algorithm</span><select name="tsig_algorithm" data-styled-select>
				for _, algorithm := range view.TSIGAlgorithms {
					<option value={ algorithm }>{ TSIGAlgorithmLabel(algorithm) }</option>
				}
			</select><small>HMAC-SHA256 suits almost everything.</small></label>
			<label><span>Secret (optional)</span><input class="mono-input" type="password" name="tsig_secret" autocomplete="new-password" placeholder="Generate one for me"/><small>Base64, at least 128 bits. Sable shows a generated secret once.</small></label>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Add Key", Type: "submit"})
			}
		</form>
	}
}

// SettingsTSIGKeyRow follows the block-list row: an icon, the name, one muted
// line of detail, and the actions. A stored secret is the normal state and goes
// unremarked; only a key the vault cannot answer for earns a warning line.
templ SettingsTSIGKeyRow(key SettingsTSIGKeyView) {
	<article class="tsig-key-row">
		<span class="tsig-key-icon">@Icon("key")</span>
		<div>
			<strong>{ TSIGDisplayName(key.Name) }</strong>
			<small>{ TSIGAlgorithmLabel(key.Algorithm) } · { tsigKeyUsage(key) }</small>
			if !key.Configured {
				<small class="tsig-key-warning" title="Add the key again with its secret, or rotate it to generate a new one.">@Icon("alert-triangle")<span>No secret stored</span></small>
			}
		</div>
		@components.Button(components.ButtonProps{Label: "Rotate", Icon: "refresh", Variant: components.ButtonOutline, Compact: true, Attrs: templ.Attributes{"hx-post": "/ui/settings/tsig/save", "hx-vals": fmt.Sprintf("{\"tsig_name\":%q,\"tsig_algorithm\":%q,\"tsig_rotate\":\"true\"}", key.Name, key.Algorithm), "hx-target": "#settings-content", "hx-swap": "outerHTML", "hx-confirm": "Generate a new secret for " + TSIGDisplayName(key.Name) + "? Every server using this key must be updated."}})
		<button class="icon-button danger" type="button" hx-post="/ui/settings/tsig/delete" hx-vals={ fmt.Sprintf("{\"tsig_name\":%q}", key.Name) } hx-target="#settings-content" hx-swap="outerHTML" hx-confirm={ "Remove " + TSIGDisplayName(key.Name) + "? The stored secret is destroyed." } aria-label={ "Remove " + TSIGDisplayName(key.Name) }>@Icon("trash")</button>
	</article>
}

// tsigKeyUsage names the zones depending on a key, which is what an operator
// needs to know before rotating or removing it.
func tsigKeyUsage(key SettingsTSIGKeyView) string {
	if len(key.Zones) == 0 {
		return "Not referenced by any zone"
	}
	return "Used by " + strings.Join(key.Zones, ", ")
}

// TSIGDisplayName drops the root label from a key name. Sable canonicalizes
// key names to their fully qualified form, but zone names are shown bare and an
// operator writing the key into another server types it that way too.
func TSIGDisplayName(name string) string {
	if name == "." {
		return name
	}
	return strings.TrimSuffix(name, ".")
}

// TSIGAlgorithmLabel renders the wire name of an HMAC algorithm the way an
// operator writes it down.
func TSIGAlgorithmLabel(algorithm string) string {
	switch strings.ToLower(strings.TrimSuffix(algorithm, ".")) {
	case "hmac-sha384":
		return "HMAC-SHA384"
	case "hmac-sha512":
		return "HMAC-SHA512"
	case "hmac-sha256":
		return "HMAC-SHA256"
	}
	return algorithm
}

templ BackupRestoreWarning(detail string) {
	<div class="warning-box zone-conversion-warning backup-restore-warning" role="alert">
		@Icon("alert-triangle")
		<div><strong>Restoring replaces what is here now</strong><p>{ detail }</p></div>
	</div>
}

templ SettingsBackupPanel(view SettingsBackupView) {
	<div
		class="settings-panel-stack backup-panel"
		id="backup-panel"
		data-live-refresh
		if view.Busy() {
			hx-get="/ui/backup/progress"
			hx-trigger="every 400ms"
			hx-target="this"
			hx-swap="outerHTML"
		}
	>
		if view.OfferRestart {
			@ToastWithAction(view.Message, "success", ToastAction{
				Label: "Restart Sable", Icon: "refresh", Post: "/ui/backup/restart",
				Confirm:      "Restart Sable now? The restored deployment takes over once it comes back.",
				ConfirmTitle: "Restart Sable?", ConfirmAction: "Restart",
			})
		} else {
			@Toast(view.Message, "success")
		}
		// A backup or restore failure names what went wrong and what to do
		// about it, so it waits to be dismissed rather than clearing itself
		// while the operator is still reading.
		@ToastSticky(view.Error, "error")
		if !view.Available {
			@SettingsCard("hard-drive", "Backup and Restore", "Capture this deployment or restore it from an archive") {
				<div class="isotope-card-content"><div class="certificate-manual-note">@Icon("info")<span>Backups are unavailable on this node. Use <code>sable backup create</code> on the host instead.</span></div></div>
			}
		} else {
			if view.LocalAvailable {
				@SettingsCard("calendar", "Scheduled Local Backups", "Create encrypted archives on this node and automatically rotate the oldest") {
					<div class="isotope-card-content">
						if !view.CanCreate {
							<div class="certificate-manual-note">@Icon("lock")<span>Your role cannot change the local backup policy.</span></div>
						} else {
							<form class="backup-form" hx-post="/ui/backup/schedule" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-passphrase-pair data-passphrase-optional>
								@components.SwitchField(components.SwitchFieldProps{ID: "backup-schedule-enabled", Title: "Enable Scheduled Backups", Description: "The first archive is created immediately, then at the interval below.", Name: "enabled", Value: "on", Checked: view.ScheduleEnabled})
								<div class="field-grid four">
									@components.Field(components.FieldProps{ID: "backup-schedule-directory", Label: "Local Directory", Help: "Relative paths resolve beside `sable.toml`.", Input: templ.Attributes{"name": "directory", "value": view.ScheduleDirectory, "required": true}})
									@components.Field(components.FieldProps{ID: "backup-schedule-interval", Label: "Interval", Help: "For example `6h`, `1d`, or `1w`.", Input: templ.Attributes{"name": "interval", "value": view.ScheduleInterval, "required": true}})
									@components.Field(components.FieldProps{ID: "backup-schedule-run-at", Label: "Run At", Help: "Anchors the interval in this node's local time. Your browser uses your preferred 12- or 24-hour display.", Input: templ.Attributes{"type": "time", "name": "run_at", "value": view.ScheduleRunAt, "step": "60", "data-styled-time": true, "required": true}})
									@components.Field(components.FieldProps{ID: "backup-schedule-retention-count", Label: "Scheduled Backups to Keep", Help: "Applies to this node's scheduled archives. Manual and imported backups remain until deleted.", Input: templ.Attributes{"type": "number", "name": "retention_count", "min": "1", "max": "1000", "value": fmt.Sprint(view.ScheduleRetentionCount), "required": true}})
								</div>
								<div class="field-grid two">
									@components.Field(components.FieldProps{ID: "backup-schedule-passphrase", Label: "Archive Passphrase", Help: BackupSchedulePassphraseNote(view.SchedulePassphraseStored), Input: templ.Attributes{"type": "password", "name": "passphrase", "autocomplete": "new-password", "minlength": "12", "placeholder": BackupSchedulePassphrasePlaceholder(view.SchedulePassphraseStored), "data-passphrase": true}})
									<label class="field-control"><span>Confirm Passphrase</span><input type="password" name="passphrase_confirmation" autocomplete="new-password" minlength="12" placeholder="Repeat a new passphrase" data-passphrase-confirmation/><small class="field-note" data-passphrase-note hidden></small></label>
								</div>
								<div class="backup-schedule-status">
									<div class="backup-schedule-timestamps">
										if view.ScheduleNextRun != "" {
											<span><strong>Next backup</strong><span class="backup-schedule-time-full">{ view.ScheduleNextRun }</span><span class="backup-schedule-time-compact">{ view.ScheduleNextRunCompact }</span></span>
										}
										if view.ScheduleLastSuccess != "" {
											<span><strong>Last success</strong><span class="backup-schedule-time-full">{ view.ScheduleLastSuccess }</span><span class="backup-schedule-time-compact">{ view.ScheduleLastSuccessCompact }</span></span>
										}
										if view.ScheduleLastError != "" {
											<span class="error"><strong>Last error</strong>{ view.ScheduleLastError }</span>
										}
									</div>
									@components.Button(components.ButtonProps{Label: "Save Schedule", Compact: true, Type: "submit", Attrs: templ.Attributes{"data-passphrase-submit": true}})
								</div>
							</form>
						}
					</div>
				}
				@components.Card(components.CardProps{Class: "settings-source-card settings-action-card backup-history-card"}) {
					@components.CardHeader(components.CardHeaderProps{Icon: "hard-drive", Title: "Local Backups", Description: "Encrypted backups stored on this node, ready to download or restore."}) {
						<div class="backup-history-header-actions">
							if view.CanRestore {
								@components.Button(components.ButtonProps{Label: "Restore from File…", Icon: "upload", Variant: components.ButtonOutline, Compact: true, Disabled: view.Busy(), Attrs: templ.Attributes{"data-dialog-open": "upload-backup-restore-dialog", "data-upload-backup-restore": true, "data-replica-primary-action": true}})
							}
							if view.CanCreate {
								if view.SchedulePassphraseStored {
									<div class="backup-run-split">
										<form hx-post="/ui/backup/run" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-local-backup-run-stored-form>
											<input type="hidden" name="use_stored_passphrase" value="on"/>
											@components.Button(components.ButtonProps{Label: "Backup Now", Icon: "play", Compact: true, Type: "submit", Disabled: view.Busy(), Attrs: templ.Attributes{"data-replica-primary-action": true}})
										</form>
										if !view.Busy() {
											<details class="backup-run-menu">
												<summary class="button compact" aria-label="More backup options" title="More backup options">@Icon("chevron-down")</summary>
												<div><button type="button" data-dialog-open="run-local-backup-dialog" data-run-local-backup>@Icon("key")<span>Use a different passphrase…</span></button></div>
											</details>
										}
									</div>
								} else {
									@components.Button(components.ButtonProps{Label: "Backup Now", Icon: "play", Compact: true, Disabled: view.Busy(), Attrs: templ.Attributes{"data-dialog-open": "run-local-backup-dialog", "data-run-local-backup": true}})
								}
							}
						</div>
					}
					<div class="isotope-card-content">
						if view.Busy() {
							@BackupProgress(*view.Job)
						}
						if !view.CanCreate && !view.CanRestore {
							<div class="certificate-manual-note">@Icon("lock")<span>Your role cannot download or restore local backups.</span></div>
						} else if len(view.LocalBackups) == 0 {
							@components.EmptyState(components.EmptyStateProps{Icon: "hard-drive", Title: "No local backups yet", Class: "backup-local-empty"}) {
								<p>Enable the schedule above or place a valid <code>.sablebackup</code> archive in the configured directory.</p>
							}
						} else {
							<div class="backup-local-list">
								for _, archive := range view.LocalBackups {
									<div class="backup-local-row">
										<div class="backup-local-icon">@Icon("hard-drive")</div>
										<div class="backup-local-detail"><strong>{ archive.Name }</strong><span>{ archive.Created } · { archive.Size } · { archive.Hostname }</span><span>Sable { archive.SableVersion }{ BackupKindLabel(archive.Scheduled) }</span></div>
										<div class="backup-local-actions">
											if view.CanCreate {
												@components.Button(components.ButtonProps{Label: "Download", Icon: "download", Variant: components.ButtonOutline, Compact: true, Href: LocalBackupDownloadURL(archive.Name), Attrs: templ.Attributes{"download": archive.Name}})
										}
										if view.CanRestore {
											@components.Button(components.ButtonProps{Label: "Restore", Icon: "rotate-ccw", Variant: components.ButtonOutline, Compact: true, Disabled: view.Busy(), Attrs: templ.Attributes{"data-dialog-open": "local-backup-restore-dialog", "data-local-backup-restore": true, "data-local-backup-name": archive.Name, "data-local-backup-scheduled": fmt.Sprint(archive.Scheduled), "data-replica-primary-action": true}})
										}
										if view.CanCreate {
											<form hx-post="/ui/backup/delete-local" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" hx-confirm={ "Delete " + archive.Name + "? This local backup cannot be recovered." } data-confirm-title="Delete local backup?" data-confirm-action="Delete Backup">
												<input type="hidden" name="name" value={ archive.Name }/>
												@components.Button(components.ButtonProps{Label: "Delete", Icon: "trash", Variant: components.ButtonOutline, Compact: true, Type: "submit", Disabled: view.Busy(), Class: "backup-local-delete", Attrs: templ.Attributes{"data-replica-primary-action": true}})
											</form>
										}
										</div>
									</div>
								}
							</div>
							if view.CanRestore {
								<small class="backup-local-restore-note">Scheduled archives use the passphrase in the encrypted vault when the restore field is blank. Enter the older passphrase after a rotation, or for another local archive.</small>
							}
							<small class="backup-local-retention-note">Scheduled rotation keeps at most { fmt.Sprint(view.ScheduleRetentionCount) } archives created by this node. Manual and imported archives are not removed automatically.</small>
						}
					</div>
					if view.ScheduleResolvedDirectory != "" {
						<footer class="backup-history-footer"><span>Local path</span><code>{ view.ScheduleResolvedDirectory }</code></footer>
					}
				}
			}
			if !view.LocalAvailable {
				@SettingsCard("hard-drive", "Download a Backup", "A sealed archive of everything this node needs to be rebuilt, private keys included") {
				<div class="isotope-card-content">
					if !view.CanCreate {
						<div class="certificate-manual-note">@Icon("lock")<span>Your role cannot take backups of this deployment.</span></div>
					} else if view.Running("backup") {
						@BackupProgress(*view.Job)
					} else {
						<form class="backup-form" hx-post="/ui/backup/download" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-passphrase-pair>
							<div class="field-grid two">
								@components.Field(components.FieldProps{ID: "backup-download-passphrase", Label: "Backup Passphrase", Help: "Sable cannot recover this. Store it wherever you keep credentials, and not beside the backup.", Input: templ.Attributes{"type": "password", "name": "passphrase", "autocomplete": "new-password", "minlength": "12", "required": true, "placeholder": "At least 12 characters", "data-passphrase": true}})
								<label class="field-control"><span>Confirm Passphrase</span><input type="password" name="passphrase_confirmation" autocomplete="new-password" minlength="12" required placeholder="Repeat the passphrase" data-passphrase-confirmation/><small class="field-note" data-passphrase-note hidden></small></label>
							</div>
							<div class="backup-actions">
								@components.Button(components.ButtonProps{Label: "Create Backup", Icon: "download", Type: "submit", Disabled: view.Busy(), Attrs: templ.Attributes{"data-passphrase-submit": true}})
							</div>
						</form>
						if view.DownloadToken != "" {
							<div class="backup-download">
								<div class="backup-download-file">@Icon("hard-drive")<div><strong>{ view.DownloadName }</strong><span>{ view.DownloadSize } · <span data-backup-expiry data-expires-at={ fmt.Sprint(view.DownloadExpiresAt) }>{ view.DownloadExpiry }</span></span></div></div>
								@components.Button(components.ButtonProps{Label: "Save File", Icon: "download", Href: templ.SafeURL("/ui/backup/download/" + view.DownloadToken), Attrs: templ.Attributes{"download": view.DownloadName}})
							</div>
						}
						<details class="settings-advanced">
							<summary>@Icon("info")<span>What the archive contains</span>@Icon("chevron-down")</summary>
							<ul class="backup-inventory">
								<li>Configuration, exactly as written</li>
								<li>Zones, records, and their DNSSEC settings</li>
								<li>Users, roles, and API tokens</li>
								<li>DNSSEC signing keys and integration credentials</li>
								<li>DNSSEC trust anchors and TLS material</li>
								<li>Cluster membership and node trust</li>
							</ul>
							<small>Query logs, statistics, sessions, and the DNS cache stay behind. A restored node rebuilds them.</small>
						</details>
					}
				</div>
				}
			}
			if !view.LocalAvailable {
				@SettingsDangerCard("upload", "Restore a Backup", "Replace this node's state with the contents of an archive") {
				<div class="isotope-card-content">
					if !view.CanRestore {
						<div class="certificate-manual-note">@Icon("lock")<span>Your role cannot restore backups onto this deployment.</span></div>
					} else if view.Running("restore") {
						@BackupProgress(*view.Job)
					} else {
						@BackupRestoreWarning("Sable validates and stages the archive while this node keeps serving its current state. A controlled restart applies the zones, users, roles, API tokens, secrets, and configuration with automatic rollback if any step fails.")
						<form class="backup-form" hx-post="/ui/backup/restore" hx-target="#backup-panel" hx-swap="outerHTML" hx-encoding="multipart/form-data" hx-disable="find button[type='submit']" hx-confirm="Restore this backup? Every zone, user, role, API token, and secret on this node is replaced." data-confirm-title="Restore backup?" data-confirm-action="Restore Backup" data-backup-restore-form>
							<div class="field-control">
								<span>Backup File</span>
								<div class="file-picker">
									<input class="sr-only" id="backup-archive-file" type="file" name="archive" accept=".sablebackup" data-file-picker-input data-backup-archive-input required/>
									<label class="button outline" for="backup-archive-file">@Icon("upload")<span>Choose File</span></label>
									<span data-file-picker-name>No file selected</span>
								</div>
							</div>
							// The envelope header is not encrypted, so the browser can say
							// which node and which day a file came from before anyone
							// commits to replacing this deployment with it.
							@BackupArchivePreview(false)
							<div class="field-grid two">
								<label class="field-control"><span>Passphrase</span><input type="password" name="passphrase" autocomplete="off" required placeholder="The passphrase this backup was sealed with"/></label>
								@components.SwitchField(components.SwitchFieldProps{ID: "backup-restore-keep-configuration", Title: "Keep this node's configuration", Description: "Restore the data but leave local listeners, storage, and paths alone.", Name: "keep_configuration", Value: "on", Plain: true})
							</div>
							@BackupUploadMeter()
							<div class="backup-actions">
								@components.Button(components.ButtonProps{Label: "Restore Backup", Icon: "upload", Destructive: true, Type: "submit", Disabled: view.Busy(), Attrs: templ.Attributes{"data-replica-primary-action": true}})
							</div>
						</form>
					}
				</div>
				}
			}
		}
	</div>
}

// RunLocalBackupDialog collects a one-off passphrase only when the operator
// chooses to create an archive; the finished file appears in local history.
templ RunLocalBackupDialog() {
	@components.Dialog(components.DialogProps{ID: "run-local-backup-dialog", TitleID: "run-local-backup-title", Title: "Backup Now", Description: "Create a durable local backup outside the scheduled rotation set.", Class: "blocking-dialog"}) {
		<form class="blocking-dialog-form" hx-post="/ui/backup/run" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-passphrase-pair data-local-backup-run-form>
			<label><span>Backup Passphrase</span><input type="password" name="passphrase" autocomplete="new-password" minlength="12" required placeholder="At least 12 characters" data-passphrase/><small>Sable cannot recover this. Store it wherever you keep credentials, not beside the archive.</small></label>
			<label><span>Confirm Passphrase</span><input type="password" name="passphrase_confirmation" autocomplete="new-password" minlength="12" required placeholder="Repeat the passphrase" data-passphrase-confirmation/><small class="field-note" data-passphrase-note hidden></small></label>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Backup Now", Icon: "play", Type: "submit", Disabled: true, Attrs: templ.Attributes{"data-passphrase-submit": true}})
			}
		</form>
	}
}

// LocalBackupRestoreDialog keeps credentials and restore policy out of the
// history list. A row's Restore button supplies only the selected archive name.
templ LocalBackupRestoreDialog() {
	@components.Dialog(components.DialogProps{ID: "local-backup-restore-dialog", TitleID: "local-backup-restore-title", Title: "Restore Local Backup", DescriptionContent: localBackupRestoreLead(), Class: "blocking-dialog"}) {
		<form class="blocking-dialog-form" hx-post="/ui/backup/restore-local" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-local-backup-restore-form>
			<input type="hidden" name="name" data-local-backup-restore-input/>
			@BackupRestoreWarning("Zones, users, roles, API tokens, and secrets are validated and staged while this node keeps serving its current state.")
			<label><span>Passphrase</span><input type="password" name="passphrase" autocomplete="off" data-local-backup-passphrase/><small data-local-backup-passphrase-note></small></label>
			@components.ChoiceCard(components.ChoiceCardProps{ID: "local-backup-restore-keep-configuration", Title: "Keep this node's configuration", Description: "Restore data while leaving local listeners, storage, and paths alone.", Style: components.ChoiceRow, Name: "keep_configuration"})
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Restore Backup", Icon: "rotate-ccw", Destructive: true, Type: "submit", Attrs: templ.Attributes{"data-replica-primary-action": true}})
			}
		</form>
	}
}

// localBackupRestoreLead names the backup the restore dialog stages; app.js
// fills in the name when the dialog opens.
templ localBackupRestoreLead() {
	Stage <strong data-local-backup-restore-name></strong> before a controlled restart.
}

// UploadBackupRestoreDialog mirrors local restore, changing only how the
// archive is selected and requiring the passphrase that sealed the file.
templ UploadBackupRestoreDialog() {
	@components.Dialog(components.DialogProps{ID: "upload-backup-restore-dialog", TitleID: "upload-backup-restore-title", Title: "Restore Backup", Description: "Choose a Sable archive and stage it before a controlled restart.", Class: "blocking-dialog"}) {
		<form class="blocking-dialog-form backup-form" hx-post="/ui/backup/restore" hx-target="#backup-panel" hx-swap="outerHTML" hx-encoding="multipart/form-data" hx-disable="find button[type='submit']" data-backup-restore-form data-upload-backup-restore-form>
			@BackupRestoreWarning("Zones, users, roles, API tokens, and secrets are validated and staged while this node keeps serving its current state.")
			<div class="backup-file-upload" data-backup-file-upload data-file-dropzone-root data-file-dropzone-state="empty">
				<label class="file-dropzone" data-file-dropzone>
					<input id="restore-backup-archive-file" type="file" name="archive" accept=".sablebackup" data-file-dropzone-input data-file-picker-input data-backup-archive-input required aria-label="Choose Sable backup"/>
					<span class="file-dropzone-upload-icon">@Icon("upload")</span>
					<strong>Drop your Sable backup here</strong>
					<span>or <span class="file-dropzone-browse">browse files</span></span>
					<small>.sablebackup archives</small>
				</label>
				<div class="file-dropzone-selection" data-backup-file-selection hidden>
					@Icon("hard-drive")
					<div>
						<strong data-file-picker-name></strong>
						@BackupArchivePreview(true)
					</div>
					<button class="button outline icon-button" type="button" data-backup-file-remove aria-label="Remove selected backup">@Icon("x")</button>
				</div>
				<p class="zone-import-help" data-file-dropzone-status role="status" aria-live="polite"></p>
			</div>
			<label><span>Passphrase</span><input type="password" name="passphrase" autocomplete="off" required placeholder="The passphrase this backup was sealed with"/></label>
			@components.ChoiceCard(components.ChoiceCardProps{ID: "upload-backup-restore-keep-configuration", Title: "Keep this node's configuration", Description: "Restore data while leaving local listeners, storage, and paths alone.", Style: components.ChoiceRow, Name: "keep_configuration"})
			@BackupUploadMeter()
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Restore Backup", Icon: "upload", Destructive: true, Type: "submit", Attrs: templ.Attributes{"data-replica-primary-action": true}})
			}
		</form>
	}
}

func BackupSchedulePassphrasePlaceholder(stored bool) string {
	if stored { return "Stored securely — leave blank to keep" }
	return "At least 12 characters"
}

func BackupSchedulePassphraseNote(stored bool) string {
	if stored { return "A passphrase is stored in the encrypted vault. Enter a new one only to rotate it." }
	return "Required before the schedule can be enabled; it is stored in the encrypted vault."
}

func BackupKindLabel(scheduled bool) string {
	if scheduled { return " · Scheduled" }
	return " · Local archive"
}

func LocalBackupDownloadURL(name string) templ.SafeURL {
	return templ.SafeURL("/ui/backup/local?name=" + url.QueryEscape(name))
}

// BackupProgress renders a real bar: the stage is the work actually under way
// and the count is the stages already finished, not a timer pretending to be
// one.
templ BackupProgress(job SettingsBackupJobView) {
	<div class="backup-progress" role="status" aria-live="polite">
		<div class="backup-progress-heading">
			<strong>{ job.Title }</strong>
			<span>{ fmt.Sprintf("%d%%", job.Percent) }</span>
		</div>
		<div class="backup-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ fmt.Sprint(job.Percent) } aria-label={ job.Title }>
			<div class="backup-progress-fill" data-progress-fill></div>
		</div>
		<div class="backup-progress-meta">
			<span>{ job.Stage }</span>
			<span>{ fmt.Sprintf("Step %d of %d", min(job.Step+1, job.Total), job.Total) }</span>
		</div>
	</div>
}

// BackupUploadMeter is filled in by the browser from real upload progress
// events. A large archive crossing a slow link is the one part of a restore
// the server cannot see, so it is measured on the client instead.
templ BackupUploadMeter() {
	<div class="backup-progress backup-upload" data-backup-upload hidden>
		<div class="backup-progress-heading">
			<strong>Uploading archive</strong>
			<span data-backup-upload-percent>0%</span>
		</div>
		<div class="backup-progress-track">
			<div class="backup-progress-fill" data-backup-upload-fill></div>
		</div>
	</div>
}

// SettingsCard is one card of Settings. Its id comes from its title, so a
// link such as /settings?tab=blocking#block-list-updates opens it.
templ SettingsCard(icon, title, description string) {
	@components.Card(components.CardProps{ID: SettingsCardID(title), Class: "settings-source-card", Attrs: templ.Attributes{"data-settings-card": true}}) {
		@components.CardHeader(components.CardHeaderProps{Icon: icon, Title: title, Description: description})
		{ children... }
	}
}
// SettingsCardID is the id a Settings card is linked by: its title in lower
// case, with a hyphen between words. "Block List Updates" is
// block-list-updates.
func SettingsCardID(title string) string {
	words := strings.FieldsFunc(strings.ToLower(title), func(r rune) bool {
		return !(r >= 'a' && r <= 'z' || r >= '0' && r <= '9')
	})
	return strings.Join(words, "-")
}

templ SettingsSaveButton(tab string) { <div class="settings-panel-save">@components.Button(components.ButtonProps{Label: "Save Settings", Type: "submit", Attrs: templ.Attributes{"name": "settings_tab", "value": tab}})</div> }

// SettingsDangerCard marks a card whose action cannot be casually undone. The
// restore card looks different from the download card on purpose: one produces
// a file, the other replaces every user and secret on the node.
templ SettingsDangerCard(icon, title, description string) {
	@components.Card(components.CardProps{ID: SettingsCardID(title), Class: "settings-source-card settings-danger-card", Attrs: templ.Attributes{"data-settings-card": true}}) {
		@components.CardHeader(components.CardHeaderProps{Icon: icon, Title: title, Description: description})
		{ children... }
	}
}

// BackupArchivePreview is filled in by the browser once a file is chosen. The
// envelope header travels unencrypted precisely so a backup can identify itself
// without its passphrase.
templ BackupArchivePreview(inline bool) {
	<div class={ "backup-archive-preview", templ.KV("inline", inline) } data-backup-archive-preview hidden>
		if !inline {
			<span class="backup-archive-icon" aria-hidden="true">@Icon("hard-drive")</span>
		}
		<div>
			<strong data-backup-archive-title></strong>
			<span data-backup-archive-detail></span>
		</div>
	</div>
}

// coveredNamesSummary labels the link that opens the certificate details. It
// names the single covered host when there is only one, because "1 name" tells
// an operator less than the name itself does.
func coveredNamesSummary(names []string) string {
	switch len(names) {
	case 0:
		return ""
	case 1:
		return names[0]
	default:
		return fmt.Sprintf("%d names", len(names))
	}
}

templ CertificateDetailsDialog(view SettingsPageView) {
	@components.Dialog(components.DialogProps{ID: "certificate-details-dialog", TitleID: "certificate-details-title", Title: "Certificate Details", Description: "The certificate currently installed for Web, DoH, DoT, and DoQ", Class: "isotope-form-dialog certificate-dialog"}) {
		<div class="dialog-body certificate-details-body">
			<div class="certificate-detail-grid">
				<div class="certificate-detail"><span>Issued by</span><strong>{ ifThen(view.ACMEIssuer != "", view.ACMEIssuer, "Unknown") }</strong></div>
				<div class="certificate-detail"><span>Subject</span><strong>{ ifThen(view.ACMESubject != "", view.ACMESubject, "Not set") }</strong></div>
				<div class="certificate-detail"><span>Issued on</span><strong>{ ifThen(view.ACMEIssuedOn != "", view.ACMEIssuedOn, "Unknown") }</strong></div>
				<div class="certificate-detail"><span>Expires</span><strong>{ ifThen(view.ACMEExpires != "", view.ACMEExpires, "Unknown") }</strong></div>
			</div>
			<div class="certificate-detail-section">
				<h3>Covered Hosts</h3>
				<p>A client is only protected when the name it connects to appears here.</p>
				if len(view.ACMECoveredNames) > 0 {
					<ul class="certificate-name-list">
						for _, name := range view.ACMECoveredNames {
							<li>@Icon("check-circle")<span>{ name }</span></li>
						}
					</ul>
				} else {
					<p class="certificate-detail-empty">No certificate is installed yet.</p>
				}
			</div>
			if len(view.ACMEPendingNames) > 0 {
				<div class="certificate-detail-section">
					<h3>Not Covered Yet</h3>
					<p>These names are configured but are not on the installed certificate. Issue a new one to include them.</p>
					<ul class="certificate-name-list pending">
						for _, name := range view.ACMEPendingNames {
							<li>@Icon("alert-triangle")<span>{ name }</span></li>
						}
					</ul>
				</div>
			}
			<div class="certificate-detail-section">
				<h3>Identity</h3>
				<div class="certificate-detail">
					<span>Serial number</span>
					<div class="copyable-text certificate-detail-value">
						<code id="certificate-serial-number">{ ifThen(view.ACMESerialNumber != "", view.ACMESerialNumber, "Unknown") }</code>
						if view.ACMESerialNumber != "" {
							<button type="button" data-copy-target="certificate-serial-number" aria-label="Copy serial number" title="Copy serial number">@CopyIcons()</button>
						}
					</div>
				</div>
				<div class="certificate-detail">
					<span>SHA-256 fingerprint</span>
					<div class="copyable-text certificate-detail-value">
						<code id="certificate-fingerprint">{ ifThen(view.ACMEFingerprint != "", view.ACMEFingerprint, "Unknown") }</code>
						if view.ACMEFingerprint != "" {
							<button type="button" data-copy-target="certificate-fingerprint" aria-label="Copy fingerprint" title="Copy fingerprint">@CopyIcons()</button>
						}
					</div>
				</div>
				if view.ACMELastRenewal != "" {
					<div class="certificate-detail"><span>Last issued or renewed</span><strong>{ view.ACMELastRenewal }</strong></div>
				}
			</div>
		</div>
		@components.DialogFooter("Close") {
			
		}
	}
}
