package pages

import (
	"fmt"
	"net/url"
	"strings"
)

type SettingsPageView struct {
	Console             DashboardView
	Revision            uint64
	TimeFormat          string
	TimeZone            string
	ActiveTab           string
	Message             string
	Error               string
	HTTPListen          string
	HTTPSListen         string
	DNSListen           string
	DatabaseDriver      string
	DatabaseDSN         string
	ResolverMode        string
	Forwarders          string
	RootHints           string
	ResolverTimeout     string
	ResolverRetries     int
	ResolverRetryTimeout string
	CacheSize           int
	CacheMinimumTTL     uint32
	CacheMaximumTTL     uint32
	CacheNegativeTTL    uint32
	CacheFailureTTL     uint32
	SaveCache           bool
	ServeStale          bool
	CacheStaleTTL       uint32
	CacheStaleAnswerTTL uint32
	CacheStaleResetTTL  uint32
	CacheStaleMaxWaitMS int64
	CachePrefetchMinimumTTL uint32
	CachePrefetchTriggerTTL uint32
	CachePrefetchSample string
	CachePrefetchHitsPerHour uint32
	DNSSECValidation    bool
	TrustAnchorUpdates  bool
	DoTListen           string
	DoHListen           string
	DoQListen           string
	CertificateFile     string
	PrivateKeyFile      string
	CertificateMode     string
	ACMEEmail           string
	ACMEDomains         string
	ACMEDirectoryURL    string
	ACMEDNSProvider     string
	ACMEDNSZone         string
	ACMEStorageDirectory string
	ACMERenewBefore     string
	ACMECredentialsConfigured bool
	ACMEIssuer          string
	ACMEExpires         string
	ACMESubject         string
	ACMESerialNumber    string
	ACMEFingerprint     string
	ACMEIssuedOn        string
	ACMELastRenewal     string
	ACMECoveredNames    []string
	ACMEPendingNames    []string
	ACMELastError       string
	ACMERenewing        bool
	ACMEProviderEndpoint string
	ACMETSIGAlgorithm    string
	MinimumTLSVersion   string
	QueryLogEnabled     bool
	QueryLogRetention   string
	ServerLogEnabled    bool
	ServerLogLevel      string
	ServerLogRetention  string
	StatisticsRetention string
	SessionTTL          string
	APITokenTTL         string
	ConfigWatch         bool
	BlockingUpdateHours int
	BlockingResponseType string
	BlockingResponseTTL uint32
	BlockingCustomAddresses string
	BlockingBypassClients string
	BlockingAllowTXTReport bool
	Backup                 SettingsBackupView
	// TSIGKeys lists the shared secrets this node knows about. Only the name
	// and algorithm travel with the view: the secret itself stays in the
	// encrypted vault and is shown once, right after it is generated.
	TSIGKeys            []SettingsTSIGKeyView
	TSIGAlgorithms      []string
	TSIGGeneratedKey    string
	TSIGGeneratedSecret string
}

type SettingsTSIGKeyView struct {
	Name       string
	Algorithm  string
	Configured bool
	Zones      []string
}

// settingsTabs drives both the tab strip and the document title so the browser
// tab names the section an operator is actually looking at.
var settingsTabs = []tabOption{
	{"general", "General", "server"},
	{"web-service", "Web", "globe"},
	{"protocols", "Protocols", "arrow-left-right"},
	{"tsig", "TSIG", "key"},
	{"recursion", "Recursion", "refresh"},
	{"cache", "Cache", "database"},
	{"blocking", "Blocking", "shield"},
	{"logging", "Logging", "file-text"},
	{"backup", "Backup", "hard-drive"},
}

templ SettingsPage(view SettingsPageView) {
	@AppDocument(view.Console, documentTitle(tabLabel(settingsTabs, view.ActiveTab), "Settings"), "settings", SettingsContent(view))
}

templ SettingsContent(view SettingsPageView) {
	<div class="settings-page page-stack isotope-control-page" id="settings-content" data-isotope-tabs data-active-tab={ view.ActiveTab } data-tab-param="tab" data-title-base="Settings">
		<header class="page-heading"><h1>Settings</h1><p>Configure DNS server settings and behavior. Some settings may require the DNS server to restart to take effect.</p></header>
		@Toast(view.Message, "success")
		@Toast(view.Error, "error")
		<div class="isotope-tab-list settings-tab-list" role="tablist" aria-label="Settings sections">
			for _, tab := range settingsTabs {
				@SettingsTab(tab, view.ActiveTab, false)
			}
		</div>
		<form class="isotope-settings-form" hx-post="/ui/settings" hx-target="#settings-content" hx-swap="outerHTML">
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="general" hidden?={ view.ActiveTab != "general" }>@SettingsGeneralPanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="web-service" hidden?={ view.ActiveTab != "web-service" }>@SettingsWebPanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="protocols" hidden?={ view.ActiveTab != "protocols" }>@SettingsProtocolsPanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="recursion" hidden?={ view.ActiveTab != "recursion" }>@SettingsRecursionPanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="cache" hidden?={ view.ActiveTab != "cache" }>@SettingsCachePanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="blocking" hidden?={ view.ActiveTab != "blocking" }>@SettingsBlockingPanel(view)</div>
			<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="logging" hidden?={ view.ActiveTab != "logging" }>@SettingsLoggingPanel(view)</div>
		</form>
		// TSIG and Backup live outside the settings form. Each posts its own
		// actions and must never be swept up by a Save Settings submission.
		<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="tsig" hidden?={ view.ActiveTab != "tsig" }>@SettingsTSIGPanel(view)</div>
		<div class="settings-tab-panel" role="tabpanel" data-isotope-panel="backup" hidden?={ view.ActiveTab != "backup" }>@SettingsBackupPanel(view.Backup)</div>
		@AddTSIGKeyDialog(view)
		@RunLocalBackupDialog()
		@LocalBackupRestoreDialog()
		@UploadBackupRestoreDialog()
		@ManualCertificateDialogs()
		@CertificateDetailsDialog(view)
	</div>
}

templ SettingsTab(tab tabOption, active string, disabled bool) {
	<button class={ ifThen(active == tab.Value, "isotope-tab settings-tab active", "isotope-tab settings-tab") } type="button" role="tab" data-isotope-tab={ tab.Value } data-tab-title={ tab.Label } aria-selected={ fmt.Sprint(active == tab.Value) } tabindex={ ifThen(active == tab.Value, "0", "-1") } disabled?={ disabled } title={ ifThen(disabled, tab.Label + " settings are not available yet", "") }>@Icon(tab.Icon)<span>{ tab.Label }</span></button>
}

templ SettingsGeneralPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("server", "Server Identity", "Configure the DNS server's identity and listening endpoints") {
			<div class="isotope-card-content"><label class="field-control"><span>Local End Points</span><textarea name="dns_listen" rows="3" spellcheck="false" required>{ view.DNSListen }</textarea><small>Network interface addresses and ports to listen on (one per line, format: IP:port).</small></label></div>
		}
		@SettingsCard("database", "Storage", "Persistent configuration and DNS data backend") {
			<div class="isotope-card-content field-grid two"><div class="read-only-field"><span>Database Driver</span><strong>{ view.DatabaseDriver }</strong></div><div class="read-only-field"><span>Data Source</span><strong>{ view.DatabaseDSN }</strong></div></div>
		}
		@SettingsSaveButton("general")
	</div>
}

templ SettingsWebPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("globe", "Web Service Settings", "Configure the web interface and API service") {
			<div class="isotope-card-content field-grid two"><div class="read-only-field"><span>HTTP Listen Address</span><strong>{ view.HTTPListen }</strong><small>The local setup and recovery listener is configured in <code>sable.toml</code>.</small></div><label class="field-control"><span>HTTPS Listen Address</span><input name="https_listen" value={ view.HTTPSListen } placeholder="0.0.0.0:5443"/><small>Uses the public certificate configured under Protocols. Changing this address requires a restart.</small></label></div>
		}
		@SettingsCard("shield", "Session Security", "Configure authentication lifetimes for the web service") {
			<div class="isotope-card-content field-grid two"><div class="read-only-field"><span>Session Lifetime</span><strong>{ view.SessionTTL }</strong></div><div class="read-only-field"><span>Default API Token Lifetime</span><strong>{ view.APITokenTTL }</strong></div></div>
		}
		@SettingsCard("clock", "Display Preferences", "Choose how times are shown in this browser") {
			<div class="isotope-card-content field-grid two"><label class="field-control narrow-control"><span>Time Format</span><select data-time-format-preference data-styled-select><option value="12" selected?={ view.TimeFormat != "24" }>12-hour (9:30 PM)</option><option value="24" selected?={ view.TimeFormat == "24" }>24-hour (21:30)</option></select><small>This preference applies throughout Sable and is stored in this browser.</small></label><div class="read-only-field"><span>Time Zone</span><strong>{ view.TimeZone }</strong><small>Detected from this browser. Timestamps are shown in this zone regardless of the server clock.</small></div></div>
		}
	</div>
}

templ SettingsProtocolsPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("arrow-left-right", "Secure DNS Protocols", "Enable encrypted DNS protocols for enhanced privacy") {
			<div class="isotope-card-content protocol-grid three"><div class="protocol-setting"><div><strong>DNS-over-TLS (DoT)</strong><small>Port 853</small></div><textarea name="dot_listen" rows="2" spellcheck="false" placeholder="0.0.0.0:853">{ view.DoTListen }</textarea></div><div class="protocol-setting"><div><strong>DNS-over-HTTPS (DoH)</strong><small>HTTPS endpoint</small></div><textarea name="doh_listen" rows="2" spellcheck="false" placeholder="0.0.0.0:443">{ view.DoHListen }</textarea></div><div class="protocol-setting"><div><strong>DNS-over-QUIC (DoQ)</strong><small>UDP port 853</small></div><textarea name="doq_listen" rows="2" spellcheck="false" placeholder="0.0.0.0:853">{ view.DoQListen }</textarea></div></div>
		}
		<div id="public-certificates">
			@SettingsCard("shield", "Public TLS Certificate", "Certificate used by the Web, DNS-over-HTTPS, and DNS-over-TLS endpoints") {
				<div class="isotope-card-content certificate-settings" data-certificate-settings>
					<div class="certificate-mode-control" role="radiogroup" aria-label="Certificate source"><label class={ ifThen(view.CertificateMode != "acme", "active", "") }><input type="radio" name="certificate_mode" value="manual" checked?={ view.CertificateMode != "acme" }/><span>Manual Certificate</span></label><label class={ ifThen(view.CertificateMode == "acme", "active", "") }><input type="radio" name="certificate_mode" value="acme" checked?={ view.CertificateMode == "acme" }/><span>Let's Encrypt (ACME)</span></label></div>
					<div class="manual-certificate-settings" data-certificate-manual hidden?={ view.CertificateMode == "acme" }>
						<div class="field-grid two"><label class="field-control"><span>Certificate File</span><input name="certificate_file" value={ view.CertificateFile } placeholder="/etc/sable/tls/fullchain.pem"/></label><label class="field-control"><span>Private Key File</span><input name="private_key_file" value={ view.PrivateKeyFile } placeholder="/etc/sable/tls/privkey.pem"/></label></div>
						<div class="certificate-manual-actions"><button class="button secondary" type="button" data-dialog-open="generate-certificate-dialog" data-replica-primary-action>@Icon("key")<span>Generate Self-Signed</span></button><button class="button outline" type="button" data-dialog-open="import-certificate-dialog" data-replica-primary-action>@Icon("upload")<span>Import PEM</span></button></div>
						<div class="certificate-manual-note">@Icon("info")<span>Generated certificates are useful for private deployments but remain untrusted until their identity is added to client trust stores.</span></div>
					</div>
					<div class="acme-settings" data-certificate-acme hidden?={ view.CertificateMode != "acme" }>
						<div class={ "certificate-status", ifThen(view.ACMELastError != "", "attention", ifThen(view.ACMEIssuer != "", "active", "pending")) }>
							<span class="certificate-status-icon">
								if view.ACMELastError != "" {
									@Icon("shield-x")
								} else if view.ACMEIssuer != "" {
									@Icon("shield-check")
								} else {
									@Icon("shield")
								}
							</span>
							<div class="certificate-status-detail">
								<div class="certificate-status-heading"><strong>Managed certificate</strong><span class={ ifThen(view.ACMELastError != "", "badge danger", ifThen(view.ACMEIssuer != "", "badge success", "badge")) }>{ ifThen(view.ACMELastError != "", "Attention", ifThen(view.ACMEIssuer != "", "Active", "Not issued")) }</span></div>
								if view.ACMEIssuer != "" {
									<span>
										{ view.ACMEIssuer }<span class="certificate-status-separator">·</span>expires { view.ACMEExpires }
										if len(view.ACMECoveredNames) > 0 {
											<span class="certificate-status-separator">·</span>
											<button class="certificate-details-link" type="button" data-dialog-open="certificate-details-dialog">{ coveredNamesSummary(view.ACMECoveredNames) }</button>
										}
									</span>
								} else {
									<span>No certificate has been issued yet. Complete the settings below, save, then issue one.</span>
								}
							</div>
							<button class="button secondary certificate-renew-button" type="submit" formaction="/ui/certificates/renew" hx-post="/ui/certificates/renew" hx-target="#settings-content" hx-swap="outerHTML" disabled?={ view.ACMERenewing } data-replica-primary-action>@Icon("refresh")<span>{ ifThen(view.ACMERenewing, "Issuing…", ifThen(view.ACMEIssuer != "", "Renew Now", "Issue Certificate")) }</span></button>
						</div>
						if view.ACMELastError != "" {
							<div class="certificate-error" role="alert">@Icon("alert-triangle")<span>{ view.ACMELastError }</span></div>
						}
						<div class="field-grid two"><label class="field-control"><span>Contact Email</span><input type="email" name="acme_email" value={ view.ACMEEmail } placeholder="dns-admin@example.com"/><small>Used by the certificate authority for expiry and account notices.</small></label><label class="field-control"><span>DNS Names</span><textarea name="acme_domains" rows="3" spellcheck="false" placeholder="dns.example.com&#10;*.example.com">{ view.ACMEDomains }</textarea><small>One name per line. Wildcards are supported through DNS-01.</small></label><label class="field-control"><span>Certificate Authority</span><select name="acme_directory_url" data-styled-select><option value="https://acme-v02.api.letsencrypt.org/directory" selected?={ view.ACMEDirectoryURL == "https://acme-v02.api.letsencrypt.org/directory" }>Let's Encrypt Production</option><option value="https://acme-staging-v02.api.letsencrypt.org/directory" selected?={ view.ACMEDirectoryURL == "https://acme-staging-v02.api.letsencrypt.org/directory" }>Let's Encrypt Staging</option></select><small>Use staging while testing to avoid production rate limits.</small></label><label class="field-control"><span>Renew Before Expiry</span><input name="acme_renew_before" value={ view.ACMERenewBefore } placeholder="30d"/><small>Between 1d and 60d.</small></label></div>
						<div class="acme-provider-card" data-acme-provider-root data-acme-provider-selected={ view.ACMEDNSProvider }>
							<header>
								<span class="acme-provider-icon">@Icon("globe-lock")</span>
								<div><strong>DNS-01 Provider</strong><small>Credentials are encrypted in Sable's secret vault.</small></div>
								<span class={ ifThen(view.ACMECredentialsConfigured, "badge success", "badge") }>{ ifThen(view.ACMECredentialsConfigured, "Configured", "Credentials required") }</span>
							</header><div class="field-grid two"><label class="field-control"><span>Provider</span><select name="acme_dns_provider" data-acme-provider data-styled-select><option value="" data-placeholder selected?={ view.ACMEDNSProvider == "" }>Choose a provider</option><option value="cloudflare" selected?={ view.ACMEDNSProvider == "cloudflare" }>Cloudflare</option><option value="porkbun" selected?={ view.ACMEDNSProvider == "porkbun" }>Porkbun</option><option value="namecheap" selected?={ view.ACMEDNSProvider == "namecheap" }>Namecheap</option><option value="godaddy" selected?={ view.ACMEDNSProvider == "godaddy" }>GoDaddy</option><option value="digitalocean" selected?={ view.ACMEDNSProvider == "digitalocean" }>DigitalOcean</option><option value="hetzner" selected?={ view.ACMEDNSProvider == "hetzner" }>Hetzner</option><option value="route53" selected?={ view.ACMEDNSProvider == "route53" }>Amazon Route 53</option><option value="ovh" selected?={ view.ACMEDNSProvider == "ovh" }>OVHcloud</option><option value="rfc2136" selected?={ view.ACMEDNSProvider == "rfc2136" }>RFC 2136 Dynamic Update</option></select></label><label class="field-control"><span>DNS Zone (optional)</span><input name="acme_dns_zone" value={ view.ACMEDNSZone } placeholder="example.com"/><small>Set this for delegated subzones; otherwise Sable detects the registrable zone.</small></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="cloudflare" hidden?={ view.ACMEDNSProvider != "cloudflare" }><label class="field-control"><span>API Token</span><input type="password" name="cloudflare_api_token" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "Cloudflare API token") }/></label><label class="field-control"><span>Zone ID (optional)</span><input name="cloudflare_zone_id" placeholder="Detected from the zone when blank"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="porkbun" hidden?={ view.ACMEDNSProvider != "porkbun" }><label class="field-control"><span>API Key</span><input type="password" name="porkbun_api_key" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "Porkbun API key") }/></label><label class="field-control"><span>Secret API Key</span><input type="password" name="porkbun_secret" autocomplete="new-password" placeholder="Secret API key"/></label></div>
							<div class="field-grid three acme-credential-fields" data-acme-credentials="namecheap" hidden?={ view.ACMEDNSProvider != "namecheap" }><label class="field-control"><span>API Username</span><input name="namecheap_username" autocomplete="off"/></label><label class="field-control"><span>API Key</span><input type="password" name="namecheap_api_key" autocomplete="new-password"/></label><label class="field-control"><span>Allow-listed Client IP</span><input name="namecheap_client_ip" placeholder="203.0.113.10"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="godaddy" hidden?={ view.ACMEDNSProvider != "godaddy" }><label class="field-control"><span>Production API Token</span><input type="password" name="godaddy_api_token" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "GoDaddy API token") }/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="digitalocean" hidden?={ view.ACMEDNSProvider != "digitalocean" }><label class="field-control"><span>API Token</span><input type="password" name="digitalocean_api_token" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "DigitalOcean API token") }/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="hetzner" hidden?={ view.ACMEDNSProvider != "hetzner" }><label class="field-control"><span>API Token</span><input type="password" name="hetzner_api_token" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "Hetzner API token") }/></label><label class="field-control"><span>Zone ID (optional)</span><input name="hetzner_zone_id" placeholder="Uses the DNS zone name when blank"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="route53" hidden?={ view.ACMEDNSProvider != "route53" }><label class="field-control"><span>Access Key ID</span><input name="route53_access_key_id" autocomplete="off" placeholder="AKIA…"/></label><label class="field-control"><span>Secret Access Key</span><input type="password" name="route53_secret_access_key" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "AWS secret access key") }/></label><label class="field-control"><span>Hosted Zone ID</span><input name="route53_zone_id" placeholder="Z0123456789EXAMPLE"/></label><label class="field-control"><span>Session Token (optional)</span><input type="password" name="route53_session_token" autocomplete="new-password" placeholder="For temporary AWS credentials"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="ovh" hidden?={ view.ACMEDNSProvider != "ovh" }><label class="field-control"><span>API Endpoint</span><select name="ovh_endpoint" data-styled-select><option value="ovh-eu" selected?={ view.ACMEProviderEndpoint == "" || view.ACMEProviderEndpoint == "ovh-eu" }>Europe</option><option value="ovh-ca" selected?={ view.ACMEProviderEndpoint == "ovh-ca" }>Canada</option><option value="ovh-us" selected?={ view.ACMEProviderEndpoint == "ovh-us" }>United States</option></select></label><label class="field-control"><span>Application Key</span><input name="ovh_application_key" autocomplete="off"/></label><label class="field-control"><span>Application Secret</span><input type="password" name="ovh_application_secret" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "OVHcloud application secret") }/></label><label class="field-control"><span>Consumer Key</span><input type="password" name="ovh_consumer_key" autocomplete="new-password"/></label></div>
							<div class="field-grid two acme-credential-fields" data-acme-credentials="rfc2136" hidden?={ view.ACMEDNSProvider != "rfc2136" }><label class="field-control"><span>Authoritative Server</span><input name="rfc2136_server" placeholder="dns.example.com:53"/></label><label class="field-control"><span>TSIG Key Name</span><input name="rfc2136_tsig_name" placeholder="acme-update."/></label><label class="field-control"><span>TSIG Secret</span><input type="password" name="rfc2136_tsig_secret" autocomplete="new-password" placeholder={ ifThen(view.ACMECredentialsConfigured, "Configured — leave blank to keep", "Base64-encoded shared secret") }/></label><label class="field-control"><span>TSIG Algorithm</span><select name="rfc2136_tsig_algorithm" data-styled-select><option value="hmac-sha256" selected?={ view.ACMETSIGAlgorithm == "" || view.ACMETSIGAlgorithm == "hmac-sha256" }>HMAC-SHA256</option><option value="hmac-sha384" selected?={ view.ACMETSIGAlgorithm == "hmac-sha384" }>HMAC-SHA384</option><option value="hmac-sha512" selected?={ view.ACMETSIGAlgorithm == "hmac-sha512" }>HMAC-SHA512</option></select></label></div>
						</div>
						<label class="field-control"><span>Certificate Storage</span><input name="acme_storage_dir" value={ view.ACMEStorageDirectory } placeholder="data/tls/acme"/><small>Account key, certificate, and private key stay node-local.</small></label>
					</div>
					<div class="certificate-shared-settings">
						<span class="certificate-shared-label">Applies to both sources</span>
						<label class="field-control narrow-control"><span>Minimum TLS Version</span><select name="minimum_tls_version" data-styled-select><option value="1.2" selected?={ view.MinimumTLSVersion == "1.2" }>TLS 1.2</option><option value="1.3" selected?={ view.MinimumTLSVersion == "1.3" }>TLS 1.3</option></select></label>
					</div>
				</div>
			}
		</div>
		@SettingsSaveButton("protocols")
	</div>
}

templ ManualCertificateDialogs() {
	<dialog class="custom-server-dialog isotope-form-dialog certificate-dialog" id="generate-certificate-dialog" aria-labelledby="generate-certificate-title">
		<div class="dialog-header"><h2 id="generate-certificate-title">Generate Self-Signed Certificate</h2><p>Create and configure a node-local certificate for Web, DoH, and DoT</p></div><button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		<form hx-post="/ui/certificates/generate" hx-target="#settings-content" hx-swap="outerHTML">
			<input type="hidden" name="settings_tab" value="protocols"/>
			<div class="isotope-dialog-body">
				<label><span>DNS Names and IP Addresses</span><textarea class="mono-input" name="manual_certificate_names" rows="5" placeholder={ "dns.example.com\n*.example.com\n192.0.2.10" } required></textarea><small>Enter one subject alternative name per line. Include every address clients use.</small></label>
				<div class="field-grid two"><label><span>Validity (days)</span><input type="number" name="manual_certificate_valid_days" value="365" min="1" max="3650" required/></label><label><span>Protected Storage Directory</span><input class="mono-input" name="manual_certificate_storage_dir" value="data/tls/manual" required/><small>Must remain inside the Sable configuration directory.</small></label></div>
				<div class="cluster-dialog-note">@Icon("shield-check")<p><strong>ECDSA P-256 identity</strong><span>The private key is written with owner-only permissions and is never stored in TOML or returned by the API.</span></p></div>
			</div>
			<div class="dialog-footer"><button class="button outline" type="button" data-dialog-close>Cancel</button><button class="button" type="submit">Generate &amp; Use Certificate</button></div>
		</form>
	</dialog>
	<dialog class="custom-server-dialog isotope-form-dialog certificate-dialog" id="import-certificate-dialog" aria-labelledby="import-certificate-title">
		<div class="dialog-header"><h2 id="import-certificate-title">Import Certificate</h2><p>Validate and store an existing PEM certificate chain and private key</p></div><button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		<form hx-post="/ui/certificates/import" hx-target="#settings-content" hx-swap="outerHTML">
			<input type="hidden" name="settings_tab" value="protocols"/>
			<div class="isotope-dialog-body">
				<label><span>Certificate Chain (PEM)</span><textarea class="mono-input" name="manual_certificate_pem" rows="7" spellcheck="false" autocomplete="off" placeholder="-----BEGIN CERTIFICATE-----" required></textarea></label>
				<label><span>Private Key (PEM)</span><textarea class="mono-input" name="manual_private_key_pem" rows="7" spellcheck="false" autocomplete="off" placeholder="-----BEGIN PRIVATE KEY-----" required></textarea></label>
				<label><span>Protected Storage Directory</span><input class="mono-input" name="manual_import_storage_dir" value="data/tls/manual" required/></label>
				<div class="cluster-dialog-note">@Icon("lock")<p><strong>Validated before activation</strong><span>Sable verifies the key pair and validity period before committing either file. The private key is never rendered back into the UI.</span></p></div>
			</div>
			<div class="dialog-footer"><button class="button outline" type="button" data-dialog-close>Cancel</button><button class="button" type="submit">Import &amp; Use Certificate</button></div>
		</form>
	</dialog>
}

templ SettingsRecursionPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("refresh", "Recursive Resolver", "Configure recursive resolution behavior and DNSSEC validation") {
			<div class="isotope-card-content">
				<div class="blocking-radio-list settings-blocking-radio-list"><label><input type="radio" name="resolver_mode" value="recursive" checked?={ view.ResolverMode == "recursive" }/><span><strong>Iterative Recursion</strong><small>Resolve directly from the DNS root with QNAME minimization. Conditional routes still use their configured forwarders.</small></span></label><label><input type="radio" name="resolver_mode" value="forward" checked?={ view.ResolverMode == "forward" }/><span><strong>Forwarding</strong><small>Send unmatched queries to the forwarders configured below.</small></span></label></div>
				<div class="field-grid two"><label class="field-control"><span>Resolution Timeout</span><input name="resolver_timeout" value={ view.ResolverTimeout } required/><small>End-to-end deadline, such as <code>3s</code>.</small></label><label class="field-control switch-row"><span><strong>Validate DNSSEC</strong><small>Reject bogus signatures during recursive resolution.</small></span><input type="checkbox" name="dnssec_validation" value="true" checked?={ view.DNSSECValidation }/></label></div>
				<div class="field-grid two"><label class="field-control"><span>Upstream Retries</span><input type="number" name="resolver_retries" min="1" max="10" value={ fmt.Sprint(view.ResolverRetries) } required/><small>Attempts per upstream before failover on a dropped packet. Raise <code>Resolution Timeout</code> too if you increase this in recursive mode.</small></label><label class="field-control"><span>Retry Timeout</span><input name="resolver_retry_timeout" value={ view.ResolverRetryTimeout } required/><small>How long each attempt waits, such as <code>1500ms</code>.</small></label></div>
				<label class="field-control switch-row"><span><strong>Automatic Trust-Anchor Updates</strong><small>Maintain RFC 5011 root trust anchors without manual intervention.</small></span><input type="checkbox" name="trust_anchor_updates" value="true" checked?={ view.TrustAnchorUpdates }/></label>
				<details class="settings-advanced"><summary>@Icon("sliders")<span>Advanced root hints</span>@Icon("chevron-down")</summary><label class="field-control"><span>Root Server Addresses</span><textarea name="root_hints" rows="5" spellcheck="false" placeholder="Use Sable's bundled IANA root hints">{ view.RootHints }</textarea><small>Optional IP:port seed addresses, one per line. Leave empty to use the bundled root hints.</small></label></details>
			</div>
		}
		@SettingsCard("arrow-left-right", "DNS Forwarders", "Forward queries to upstream DNS servers instead of recursive resolution") {
			<div class="isotope-card-content"><label class="field-control"><span>Forwarder Addresses</span><textarea name="forwarders" rows="4" spellcheck="false" placeholder={ "8.8.8.8\n1.1.1.1" }>{ view.Forwarders }</textarea><small>Required in forwarding mode. Conditional routes and forwarder zones remain active in iterative mode.</small></label></div>
		}
		@SettingsSaveButton("recursion")
	</div>
}

templ SettingsCachePanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("database", "Cache Settings", "Configure DNS cache behavior, limits, and TTL policy") {
			<div class="isotope-card-content"><label class="field-control switch-row"><span><strong>Save Cache to Disk</strong><small>Persist warm cache entries in the configured database during a controlled shutdown and restore them at startup.</small></span><input type="checkbox" name="save_cache" value="true" checked?={ view.SaveCache }/></label><label class="field-control narrow-control"><span>Maximum Cache Entries</span><input type="number" name="cache_size" min="1" value={ fmt.Sprint(view.CacheSize) } required/><small>Maximum number of DNS responses held in the bounded, sharded LRU cache.</small></label><div class="field-grid four cache-ttl-grid"><label class="field-control"><span>Minimum TTL (sec)</span><input type="number" name="cache_minimum_ttl" min="0" max="4294967295" value={ fmt.Sprint(view.CacheMinimumTTL) } required/><small>Raises shorter upstream TTLs.</small></label><label class="field-control"><span>Maximum TTL (sec)</span><input type="number" name="cache_maximum_ttl" min="1" max="4294967295" value={ fmt.Sprint(view.CacheMaximumTTL) } required/><small>Caps longer upstream TTLs.</small></label><label class="field-control"><span>Negative TTL (sec)</span><input type="number" name="cache_negative_ttl" min="0" max="4294967295" value={ fmt.Sprint(view.CacheNegativeTTL) } required/><small>NXDOMAIN and negative answers.</small></label><label class="field-control"><span>Failure TTL (sec)</span><input type="number" name="cache_failure_ttl" min="0" max="4294967295" value={ fmt.Sprint(view.CacheFailureTTL) } required/><small>SERVFAIL caching; 0 disables it.</small></label></div></div>
		}
		@SettingsCard("refresh", "Serve Stale Records", "Serve recently expired records when upstream resolution fails") {
			<div class="isotope-card-content"><label class="field-control switch-row"><span><strong>Enable Serve Stale</strong><small>Improve availability during upstream outages without serving stale data during normal operation.</small></span><input type="checkbox" name="serve_stale" value="true" checked?={ view.ServeStale }/></label><div class="field-grid four"><label class="field-control"><span>Maximum Stale Age (sec)</span><input type="number" name="cache_stale_ttl" min="1" max="4294967295" value={ fmt.Sprint(view.CacheStaleTTL) } required/><small>Maximum age for retained stale records.</small></label><label class="field-control"><span>Answer TTL (sec)</span><input type="number" name="cache_stale_answer_ttl" min="1" max="4294967295" value={ fmt.Sprint(view.CacheStaleAnswerTTL) } required/><small>TTL returned in stale responses.</small></label><label class="field-control"><span>Retry TTL (sec)</span><input type="number" name="cache_stale_reset_ttl" min="1" max="4294967295" value={ fmt.Sprint(view.CacheStaleResetTTL) } required/><small>Delay before retrying a failed upstream.</small></label><label class="field-control"><span>Max Wait (ms)</span><input type="number" name="cache_stale_max_wait_ms" min="1" max="60000" value={ fmt.Sprint(view.CacheStaleMaxWaitMS) } required/><small>Wait before returning stale data.</small></label></div></div>
		}
		@SettingsCard("refresh", "Cache Prefetching", "Refresh popular records in the background before they expire") {
			<div class="isotope-card-content field-grid four"><label class="field-control"><span>Eligibility TTL (sec)</span><input type="number" name="cache_prefetch_minimum_ttl" min="0" max="4294967295" value={ fmt.Sprint(view.CachePrefetchMinimumTTL) } required/><small>Minimum original TTL for prefetch.</small></label><label class="field-control"><span>Trigger TTL (sec)</span><input type="number" name="cache_prefetch_trigger_ttl" min="0" max="4294967295" value={ fmt.Sprint(view.CachePrefetchTriggerTTL) } required/><small>Refresh at this remaining TTL; 0 disables.</small></label><label class="field-control"><span>Sample Interval</span><input name="cache_prefetch_sample_interval" value={ view.CachePrefetchSample } required/><small>Duration such as <code>5m</code>.</small></label><label class="field-control"><span>Sample Hits/Hour</span><input type="number" name="cache_prefetch_hits_per_hour" min="1" max="4294967295" value={ fmt.Sprint(view.CachePrefetchHitsPerHour) } required/><small>Minimum popularity for prefetch.</small></label></div>
		}
		@SettingsSaveButton("cache")
	</div>
}

templ SettingsBlockingPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("shield", "Blocking Response", "Configure how Sable responds to blocked DNS requests") {
			<div class="isotope-card-content">
				<div class="blocking-radio-list settings-blocking-radio-list"><label><input type="radio" name="blocking_response_type" value="zero" checked?={ view.BlockingResponseType == "zero" }/><span><strong>Any Address</strong><small>Respond with 0.0.0.0 and :: for blocked domains.</small></span></label><label><input type="radio" name="blocking_response_type" value="nxdomain" checked?={ view.BlockingResponseType == "nxdomain" }/><span><strong>NX Domain</strong><small>Respond with NXDOMAIN (domain does not exist).</small></span></label><label><input type="radio" name="blocking_response_type" value="custom" checked?={ view.BlockingResponseType == "custom" }/><span><strong>Custom Address</strong><small>Respond with the IP addresses specified below.</small></span></label></div>
				<label class="blocking-textarea" data-custom-addresses hidden?={ view.BlockingResponseType != "custom" }><span>Custom Blocking Addresses</span><textarea name="blocking_custom_addresses" rows="3" placeholder={ "127.0.0.1\n::1" }>{ view.BlockingCustomAddresses }</textarea><small>Enter one IPv4 or IPv6 address per line.</small></label>
				<label class="blocking-number"><span>Response TTL (seconds)</span><input type="number" name="blocking_response_ttl" min="0" max="4294967295" value={ fmt.Sprint(view.BlockingResponseTTL) } required/><small>How long clients should cache a blocking response.</small></label>
			</div>
		}
		@SettingsCard("refresh", "Block List Updates", "Configure automatic refreshes for remote block lists") {
			<div class="isotope-card-content"><label class="field-control narrow-control"><span>Update Interval (hours)</span><input type="number" name="blocking_update_hours" min="1" max="8760" value={ fmt.Sprint(view.BlockingUpdateHours) } required/><small>Remote block lists are downloaded and compiled on this schedule.</small></label></div>
		}
		@SettingsCard("server", "Bypass Clients", "Exclude trusted clients and networks from DNS blocking") {
			<div class="isotope-card-content"><label class="field-control"><span>IP Addresses and Networks</span><textarea name="blocking_bypass_clients" rows="4" placeholder={ "192.168.1.100\n10.0.0.0/8" }>{ view.BlockingBypassClients }</textarea><small>Enter one IP address or CIDR network per line.</small></label></div>
		}
		@SettingsCard("sliders", "Advanced Options", "Additional blocking response behavior") {
			<div class="isotope-card-content"><label class="blocking-check"><input type="checkbox" name="blocking_allow_txt_report" value="true" checked?={ view.BlockingAllowTXTReport }/><span><strong>Allow TXT Blocking Report</strong><small>Return blocking information when a blocked name is queried for TXT records.</small></span></label></div>
		}
		<div class="settings-blocking-actions"><a class="button outline" href="/blocked">@Icon("shield")<span>Manage Block Lists and Domains</span></a><button class="button" type="submit" name="settings_tab" value="blocking">Save Settings</button></div>
	</div>
}

templ SettingsLoggingPanel(view SettingsPageView) {
	<div class="settings-panel-stack">
		@SettingsCard("logs", "DNS Query Logs", "Control searchable DNS query history") {
			<div class="isotope-card-content"><label class="field-control switch-row"><span><strong>Log DNS Queries</strong><small>Persist DNS queries for search, rankings, and operational analysis.</small></span><input type="checkbox" name="query_log_enabled" value="true" checked?={ view.QueryLogEnabled }/></label><label class="field-control narrow-control"><span>Query Log Retention</span><input name="query_log_retention" value={ view.QueryLogRetention } required/><small>Positive duration such as <code>30d</code>. Fixed units: y, mo, w, and d.</small></label></div>
		}
		@SettingsCard("server", "Server Logs", "Control runtime and audit history") {
			<div class="isotope-card-content"><label class="field-control switch-row"><span><strong>Persist Server Logs</strong><small>Keep searchable runtime and audit entries across restarts. Entries always continue to stderr.</small></span><input type="checkbox" name="server_log_enabled" value="true" checked?={ view.ServerLogEnabled }/></label><div class="field-grid two"><label class="field-control narrow-control"><span>Minimum Log Level</span><select name="server_log_level" data-styled-select><option value="debug" selected?={ view.ServerLogLevel == "debug" }>Debug</option><option value="info" selected?={ view.ServerLogLevel == "info" }>Info</option><option value="warn" selected?={ view.ServerLogLevel == "warn" }>Warning</option><option value="error" selected?={ view.ServerLogLevel == "error" }>Error</option></select><small>Applies to both persisted history and stderr.</small></label><label class="field-control narrow-control"><span>Server Log Retention</span><input name="server_log_retention" value={ view.ServerLogRetention } required/><small>Positive duration such as <code>60d</code>. Fixed units: y, mo, w, and d.</small></label></div></div>
		}
		@SettingsCard("line-chart", "Dashboard History", "Control retained chart data") {
			<div class="isotope-card-content"><label class="field-control narrow-control"><span>Statistics Retention</span><input name="statistics_retention" value={ view.StatisticsRetention } required/><small>Defaults to one fixed year: <code>1y</code> equals 365 days. Lifetime counters are not pruned.</small></label></div>
		}
		@SettingsSaveButton("logging")
	</div>
}

// SettingsBackupView drives the backup panel. The passphrase is never echoed
// back into it, so a re-render after an error always asks for it again.
type SettingsBackupView struct {
	Available     bool
	CanCreate     bool
	CanRestore    bool
	Message       string
	Error         string
	DownloadToken  string
	DownloadName   string
	DownloadSize   string
	DownloadExpiry string
	// DownloadExpiresAt is the same deadline as a Unix millisecond stamp, so
	// the browser can keep the countdown honest instead of showing whatever
	// was true when the page happened to render.
	DownloadExpiresAt int64
	LocalAvailable             bool
	ScheduleEnabled            bool
	ScheduleDirectory          string
	ScheduleResolvedDirectory  string
	ScheduleInterval           string
	ScheduleRunAt              string
	ScheduleRetentionCount     int
	SchedulePassphraseStored   bool
	ScheduleNextRun            string
	ScheduleNextRunCompact     string
	ScheduleLastSuccess        string
	ScheduleLastSuccessCompact string
	ScheduleLastError          string
	LocalBackups               []SettingsLocalBackupView
	// OfferRestart marks a result that only takes effect after a restart, so
	// the notice carries the button rather than only naming the step.
	OfferRestart bool
	// Job describes the operation running right now. While it is set the panel
	// shows progress in place of the forms and asks for the next poll.
	Job *SettingsBackupJobView
}

// SettingsLocalBackupView is one on-disk archive offered for restore.
type SettingsLocalBackupView struct {
	Name         string
	Created      string
	Hostname     string
	SableVersion string
	Size         string
	Scheduled    bool
}

// SettingsBackupJobView is the live state of a running backup or restore.
type SettingsBackupJobView struct {
	Kind    string
	Title   string
	Stage   string
	Step    int
	Total   int
	Percent int
}

// Running reports whether an operation of the given kind is under way, which
// decides whether a card shows its form or its progress.
func (view SettingsBackupView) Running(kind string) bool {
	return view.Job != nil && view.Job.Kind == kind
}

// Busy reports whether any operation is under way. Both cards lock down while
// one runs, because a backup and a restore would fight over the same files.
func (view SettingsBackupView) Busy() bool { return view.Job != nil }

// SettingsTSIGPanel manages the shared secrets that authenticate transfers and
// dynamic updates. Only the name and algorithm are configuration; the secret
// itself lives in the node's encrypted vault, which is why the list can say
// whether a key has one but never show it again after it is created.
templ SettingsTSIGPanel(view SettingsPageView) {
	<div class="settings-panel-stack tsig-panel">
		if view.TSIGGeneratedSecret != "" {
			<div class="token-created">
				<strong>Copy this secret now</strong>
				<div class="copyable-text token-secret"><span id="generated-tsig-secret">{ view.TSIGGeneratedSecret }</span><button type="button" data-copy-target="generated-tsig-secret" aria-label="Copy TSIG secret" title="Copy TSIG secret">@CopyIcons()</button></div>
				<span>Configure the other server with this secret for { TSIGDisplayName(view.TSIGGeneratedKey) }. Sable keeps it encrypted and will not show it again; rotate the key if you lose it.</span>
			</div>
		}
		<section class="card settings-source-card settings-action-card">
			<header>
				<div><h2>@Icon("key")<span>TSIG Keys</span></h2><p>Shared secrets that authenticate NOTIFY, AXFR, IXFR, and dynamic updates. Secrets are held in this node's encrypted vault, never in sable.toml.</p></div>
				<button class="button compact" type="button" data-dialog-open="add-tsig-key-dialog" data-replica-primary-action>@Icon("plus")<span>Add Key</span></button>
			</header>
			<div class="isotope-card-content">
				if len(view.TSIGKeys) == 0 {
					<div class="tsig-empty">@Icon("key")<h3>No TSIG keys yet</h3><p>Zones without a key fall back to source-IP and transfer-policy authorization.</p></div>
				} else {
					<div class="tsig-key-list isotope-source-list">
						for _, key := range view.TSIGKeys {
							@SettingsTSIGKeyRow(key)
						}
					</div>
				}
			</div>
		</section>
	</div>
}

templ AddTSIGKeyDialog(view SettingsPageView) {
	<dialog class="custom-server-dialog blocking-dialog" id="add-tsig-key-dialog" aria-labelledby="add-tsig-key-title">
		<div class="dialog-header"><h2 id="add-tsig-key-title">Add TSIG Key</h2><p>Leave the secret blank and Sable generates one sized to the algorithm. Paste a secret instead when another server already owns the key.</p></div>
		<button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		<form class="blocking-dialog-form" hx-post="/ui/settings/tsig/save" hx-target="#settings-content" hx-swap="outerHTML">
			<label><span>Key Name</span><input class="mono-input" name="tsig_name" placeholder="transfer-key" autocomplete="off" required/><small>A DNS name. Both servers must agree on it exactly.</small></label>
			<label><span>Algorithm</span><select name="tsig_algorithm" data-styled-select>
				for _, algorithm := range view.TSIGAlgorithms {
					<option value={ algorithm }>{ TSIGAlgorithmLabel(algorithm) }</option>
				}
			</select><small>HMAC-SHA256 suits almost everything.</small></label>
			<label><span>Secret (optional)</span><input class="mono-input" type="password" name="tsig_secret" autocomplete="new-password" placeholder="Generate one for me"/><small>Base64, at least 128 bits. Sable shows a generated secret once.</small></label>
			<footer class="dialog-footer"><button class="button outline" type="button" data-dialog-close>Cancel</button><button class="button" type="submit">Add Key</button></footer>
		</form>
	</dialog>
}

// SettingsTSIGKeyRow follows the block-list row: an icon, the name, one muted
// line of detail, and the actions. A stored secret is the normal state and goes
// unremarked; only a key the vault cannot answer for earns a warning line.
templ SettingsTSIGKeyRow(key SettingsTSIGKeyView) {
	<article class="tsig-key-row">
		<span class="tsig-key-icon">@Icon("key")</span>
		<div>
			<strong>{ TSIGDisplayName(key.Name) }</strong>
			<small>{ TSIGAlgorithmLabel(key.Algorithm) } · { tsigKeyUsage(key) }</small>
			if !key.Configured {
				<small class="tsig-key-warning" title="Add the key again with its secret, or rotate it to generate a new one.">@Icon("alert-triangle")<span>No secret stored</span></small>
			}
		</div>
		<button class="button outline compact" type="button" hx-post="/ui/settings/tsig/save" hx-vals={ fmt.Sprintf("{\"tsig_name\":%q,\"tsig_algorithm\":%q,\"tsig_rotate\":\"true\"}", key.Name, key.Algorithm) } hx-target="#settings-content" hx-swap="outerHTML" hx-confirm={ "Generate a new secret for " + TSIGDisplayName(key.Name) + "? Every server using this key must be updated." }>@Icon("refresh")<span>Rotate</span></button>
		<button class="icon-button danger" type="button" hx-post="/ui/settings/tsig/delete" hx-vals={ fmt.Sprintf("{\"tsig_name\":%q}", key.Name) } hx-target="#settings-content" hx-swap="outerHTML" hx-confirm={ "Remove " + TSIGDisplayName(key.Name) + "? The stored secret is destroyed." } aria-label={ "Remove " + TSIGDisplayName(key.Name) }>@Icon("trash")</button>
	</article>
}

// tsigKeyUsage names the zones depending on a key, which is what an operator
// needs to know before rotating or removing it.
func tsigKeyUsage(key SettingsTSIGKeyView) string {
	if len(key.Zones) == 0 {
		return "Not referenced by any zone"
	}
	return "Used by " + strings.Join(key.Zones, ", ")
}

// TSIGDisplayName drops the root label from a key name. Sable canonicalizes
// key names to their fully qualified form, but zone names are shown bare and an
// operator writing the key into another server types it that way too.
func TSIGDisplayName(name string) string {
	if name == "." {
		return name
	}
	return strings.TrimSuffix(name, ".")
}

// TSIGAlgorithmLabel renders the wire name of an HMAC algorithm the way an
// operator writes it down.
func TSIGAlgorithmLabel(algorithm string) string {
	switch strings.ToLower(strings.TrimSuffix(algorithm, ".")) {
	case "hmac-sha384":
		return "HMAC-SHA384"
	case "hmac-sha512":
		return "HMAC-SHA512"
	case "hmac-sha256":
		return "HMAC-SHA256"
	}
	return algorithm
}

templ SettingsBackupPanel(view SettingsBackupView) {
	<div class="settings-panel-stack backup-panel" id="backup-panel">
		if view.Busy() {
			// Each rendered panel asks for the next poll, so the loop stops on
			// its own as soon as a render comes back without a running job.
			<div hx-get="/ui/backup/progress" hx-trigger="load delay:400ms" hx-target="#backup-panel" hx-swap="outerHTML"></div>
		}
		if view.OfferRestart {
			@ToastWithAction(view.Message, "success", ToastAction{
				Label: "Restart Sable", Icon: "refresh", Post: "/ui/backup/restart",
				Confirm:      "Restart Sable now? The restored deployment takes over once it comes back.",
				ConfirmTitle: "Restart Sable?", ConfirmAction: "Restart",
			})
		} else {
			@Toast(view.Message, "success")
		}
		// A backup or restore failure names what went wrong and what to do
		// about it, so it waits to be dismissed rather than clearing itself
		// while the operator is still reading.
		@ToastSticky(view.Error, "error")
		if !view.Available {
			@SettingsCard("hard-drive", "Backup and Restore", "Capture this deployment or restore it from an archive") {
				<div class="isotope-card-content"><div class="certificate-manual-note">@Icon("info")<span>Backups are unavailable on this node. Use <code>sable backup create</code> on the host instead.</span></div></div>
			}
		} else {
			if view.LocalAvailable {
				@SettingsCard("calendar", "Scheduled Local Backups", "Create encrypted archives on this node and automatically rotate the oldest") {
					<div class="isotope-card-content">
						if !view.CanCreate {
							<div class="certificate-manual-note">@Icon("lock")<span>Your role cannot change the local backup policy.</span></div>
						} else {
							<form class="backup-form" hx-post="/ui/backup/schedule" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-passphrase-pair data-passphrase-optional>
								<label class="field-control switch-row"><span><strong>Enable Scheduled Backups</strong><small>The first archive is created immediately, then at the interval below.</small></span><input type="checkbox" name="enabled" checked?={ view.ScheduleEnabled }/></label>
								<div class="field-grid four">
									<label class="field-control"><span>Local Directory</span><input name="directory" value={ view.ScheduleDirectory } required/><small>Relative paths resolve beside <code>sable.toml</code>.</small></label>
									<label class="field-control"><span>Interval</span><input name="interval" value={ view.ScheduleInterval } required/><small>For example <code>6h</code>, <code>1d</code>, or <code>1w</code>.</small></label>
									<label class="field-control"><span>Run At</span><input type="time" name="run_at" value={ view.ScheduleRunAt } step="60" data-styled-time required/><small>Anchors the interval in this node's local time. Your browser uses your preferred 12- or 24-hour display.</small></label>
									<label class="field-control"><span>Backups to Keep</span><input type="number" name="retention_count" min="1" max="1000" value={ fmt.Sprint(view.ScheduleRetentionCount) } required/><small>Oldest scheduled archives are purged after success.</small></label>
								</div>
								<div class="field-grid two">
									<label class="field-control"><span>Archive Passphrase</span><input type="password" name="passphrase" autocomplete="new-password" minlength="12" placeholder={ BackupSchedulePassphrasePlaceholder(view.SchedulePassphraseStored) } data-passphrase/><small>{ BackupSchedulePassphraseNote(view.SchedulePassphraseStored) }</small></label>
									<label class="field-control"><span>Confirm Passphrase</span><input type="password" name="passphrase_confirmation" autocomplete="new-password" minlength="12" placeholder="Repeat a new passphrase" data-passphrase-confirmation/><small class="field-note" data-passphrase-note hidden></small></label>
								</div>
								<div class="backup-schedule-status">
									<div class="backup-schedule-timestamps">
										if view.ScheduleNextRun != "" {
											<span><strong>Next backup</strong><span class="backup-schedule-time-full">{ view.ScheduleNextRun }</span><span class="backup-schedule-time-compact">{ view.ScheduleNextRunCompact }</span></span>
										}
										if view.ScheduleLastSuccess != "" {
											<span><strong>Last success</strong><span class="backup-schedule-time-full">{ view.ScheduleLastSuccess }</span><span class="backup-schedule-time-compact">{ view.ScheduleLastSuccessCompact }</span></span>
										}
										if view.ScheduleLastError != "" {
											<span class="error"><strong>Last error</strong>{ view.ScheduleLastError }</span>
										}
									</div>
									<button class="button compact" type="submit" data-passphrase-submit><span>Save Schedule</span></button>
								</div>
							</form>
						}
					</div>
				}
				<section class="card settings-source-card settings-action-card backup-history-card">
					<header>
						<div><h2>@Icon("hard-drive")<span>Local Backups</span></h2><p>Encrypted backups stored on this node, ready to download or restore.</p></div>
						<div class="backup-history-header-actions">
							if view.CanRestore {
								<button class="button outline compact" type="button" disabled?={ view.Busy() } data-dialog-open="upload-backup-restore-dialog" data-upload-backup-restore data-replica-primary-action>@Icon("upload")<span>Restore from File…</span></button>
							}
							if view.CanCreate {
								if view.SchedulePassphraseStored {
									<div class="backup-run-split">
										<form hx-post="/ui/backup/run" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-local-backup-run-stored-form>
											<input type="hidden" name="use_stored_passphrase" value="on"/>
											<button class="button compact" type="submit" disabled?={ view.Busy() } data-replica-primary-action>@Icon("play")<span>Backup Now</span></button>
										</form>
										if !view.Busy() {
											<details class="backup-run-menu">
												<summary class="button compact" aria-label="More backup options" title="More backup options">@Icon("chevron-down")</summary>
												<div><button type="button" data-dialog-open="run-local-backup-dialog" data-run-local-backup>@Icon("key")<span>Use a different passphrase…</span></button></div>
											</details>
										}
									</div>
								} else {
									<button class="button compact" type="button" disabled?={ view.Busy() } data-dialog-open="run-local-backup-dialog" data-run-local-backup>@Icon("play")<span>Backup Now</span></button>
								}
							}
						</div>
					</header>
					<div class="isotope-card-content">
						if view.Busy() {
							@BackupProgress(*view.Job)
						}
						if !view.CanCreate && !view.CanRestore {
							<div class="certificate-manual-note">@Icon("lock")<span>Your role cannot download or restore local backups.</span></div>
						} else if len(view.LocalBackups) == 0 {
							<div class="backup-local-empty">@Icon("hard-drive")<strong>No local backups yet</strong><span>Enable the schedule above or place a valid <code>.sablebackup</code> archive in the configured directory.</span></div>
						} else {
							<div class="backup-local-list">
								for _, archive := range view.LocalBackups {
									<div class="backup-local-row">
										<div class="backup-local-icon">@Icon("hard-drive")</div>
										<div class="backup-local-detail"><strong>{ archive.Name }</strong><span>{ archive.Created } · { archive.Size } · { archive.Hostname }</span><span>Sable { archive.SableVersion }{ BackupKindLabel(archive.Scheduled) }</span></div>
										<div class="backup-local-actions">
											if view.CanCreate {
												<a class="button outline compact" href={ LocalBackupDownloadURL(archive.Name) } download={ archive.Name }>@Icon("download")<span>Download</span></a>
										}
										if view.CanRestore {
											<button class="button outline compact" type="button" disabled?={ view.Busy() } data-dialog-open="local-backup-restore-dialog" data-local-backup-restore data-local-backup-name={ archive.Name } data-local-backup-scheduled={ fmt.Sprint(archive.Scheduled) } data-replica-primary-action>@Icon("rotate-ccw")<span>Restore</span></button>
										}
										if view.CanCreate {
											<form hx-post="/ui/backup/delete-local" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" hx-confirm={ "Delete " + archive.Name + "? This local backup cannot be recovered." } data-confirm-title="Delete local backup?" data-confirm-action="Delete Backup">
												<input type="hidden" name="name" value={ archive.Name }/>
												<button class="button outline compact backup-local-delete" type="submit" disabled?={ view.Busy() } data-replica-primary-action>@Icon("trash")<span>Delete</span></button>
											</form>
										}
										</div>
									</div>
								}
							</div>
							if view.CanRestore {
								<small class="backup-local-restore-note">Scheduled archives use the passphrase in the encrypted vault when the restore field is blank. Enter the older passphrase after a rotation, or for another local archive.</small>
							}
						}
					</div>
					if view.ScheduleResolvedDirectory != "" {
						<footer class="backup-history-footer"><span>Local path</span><code>{ view.ScheduleResolvedDirectory }</code></footer>
					}
				</section>
			}
			if !view.LocalAvailable {
				@SettingsCard("hard-drive", "Download a Backup", "A sealed archive of everything this node needs to be rebuilt, private keys included") {
				<div class="isotope-card-content">
					if !view.CanCreate {
						<div class="certificate-manual-note">@Icon("lock")<span>Your role cannot take backups of this deployment.</span></div>
					} else if view.Running("backup") {
						@BackupProgress(*view.Job)
					} else {
						<form class="backup-form" hx-post="/ui/backup/download" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-passphrase-pair>
							<div class="field-grid two">
								<label class="field-control"><span>Backup Passphrase</span><input type="password" name="passphrase" autocomplete="new-password" minlength="12" required placeholder="At least 12 characters" data-passphrase/><small>Sable cannot recover this. Store it wherever you keep credentials, and not beside the backup.</small></label>
								<label class="field-control"><span>Confirm Passphrase</span><input type="password" name="passphrase_confirmation" autocomplete="new-password" minlength="12" required placeholder="Repeat the passphrase" data-passphrase-confirmation/><small class="field-note" data-passphrase-note hidden></small></label>
							</div>
							<div class="backup-actions">
								<button class="button" type="submit" disabled?={ view.Busy() } data-passphrase-submit>@Icon("download")<span>Create Backup</span></button>
							</div>
						</form>
						if view.DownloadToken != "" {
							<div class="backup-download">
								<div class="backup-download-file">@Icon("hard-drive")<div><strong>{ view.DownloadName }</strong><span>{ view.DownloadSize } · <span data-backup-expiry data-expires-at={ fmt.Sprint(view.DownloadExpiresAt) }>{ view.DownloadExpiry }</span></span></div></div>
								<a class="button" href={ templ.SafeURL("/ui/backup/download/" + view.DownloadToken) } download={ view.DownloadName }>@Icon("download")<span>Save File</span></a>
							</div>
						}
						<details class="settings-advanced">
							<summary>@Icon("info")<span>What the archive contains</span>@Icon("chevron-down")</summary>
							<ul class="backup-inventory">
								<li>Configuration, exactly as written</li>
								<li>Zones, records, and their DNSSEC settings</li>
								<li>Users, roles, and API tokens</li>
								<li>DNSSEC signing keys and integration credentials</li>
								<li>DNSSEC trust anchors and TLS material</li>
								<li>Cluster membership and node trust</li>
							</ul>
							<small>Query logs, statistics, sessions, and the DNS cache stay behind. A restored node rebuilds them.</small>
						</details>
					}
				</div>
				}
			}
			if !view.LocalAvailable {
				@SettingsDangerCard("upload", "Restore a Backup", "Replace this node's state with the contents of an archive") {
				<div class="isotope-card-content">
					if !view.CanRestore {
						<div class="certificate-manual-note">@Icon("lock")<span>Your role cannot restore backups onto this deployment.</span></div>
					} else if view.Running("restore") {
						@BackupProgress(*view.Job)
					} else {
						<div class="cluster-dialog-note">@Icon("alert-triangle")<p><strong>Restoring replaces what is here now</strong><span>Sable validates and stages the archive while this node keeps serving its current state. A controlled restart applies the zones, users, roles, API tokens, secrets, and configuration with automatic rollback if any step fails.</span></p></div>
						<form class="backup-form" hx-post="/ui/backup/restore" hx-target="#backup-panel" hx-swap="outerHTML" hx-encoding="multipart/form-data" hx-disable="find button[type='submit']" hx-confirm="Restore this backup? Every zone, user, role, API token, and secret on this node is replaced." data-confirm-title="Restore backup?" data-confirm-action="Restore Backup" data-backup-restore-form>
							<div class="field-control">
								<span>Backup File</span>
								<div class="file-picker">
									<input class="sr-only" id="backup-archive-file" type="file" name="archive" accept=".sablebackup" data-file-picker-input data-backup-archive-input required/>
									<label class="button outline" for="backup-archive-file">@Icon("upload")<span>Choose File</span></label>
									<span data-file-picker-name>No file selected</span>
								</div>
							</div>
							// The envelope header is not encrypted, so the browser can say
							// which node and which day a file came from before anyone
							// commits to replacing this deployment with it.
							@BackupArchivePreview()
							<div class="field-grid two">
								<label class="field-control"><span>Passphrase</span><input type="password" name="passphrase" autocomplete="off" required placeholder="The passphrase this backup was sealed with"/></label>
								<label class="field-control switch-row"><span><strong>Keep this node's configuration</strong><small>Restore the data but leave local listeners, storage, and paths alone.</small></span><input type="checkbox" name="keep_configuration"/></label>
							</div>
							@BackupUploadMeter()
							<div class="backup-actions">
								<button class="button destructive" type="submit" disabled?={ view.Busy() } data-replica-primary-action>@Icon("upload")<span>Restore Backup</span></button>
							</div>
						</form>
					}
				</div>
				}
			}
		}
	</div>
}

// RunLocalBackupDialog collects a one-off passphrase only when the operator
// chooses to create an archive; the finished file appears in local history.
templ RunLocalBackupDialog() {
	<dialog class="custom-server-dialog blocking-dialog" id="run-local-backup-dialog" aria-labelledby="run-local-backup-title">
		<div class="dialog-header"><h2 id="run-local-backup-title">Backup Now</h2><p>Create a durable local backup outside the scheduled rotation set.</p></div>
		<button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		<form class="blocking-dialog-form" hx-post="/ui/backup/run" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-passphrase-pair data-local-backup-run-form>
			<label><span>Backup Passphrase</span><input type="password" name="passphrase" autocomplete="new-password" minlength="12" required placeholder="At least 12 characters" data-passphrase/><small>Sable cannot recover this. Store it wherever you keep credentials, not beside the archive.</small></label>
			<label><span>Confirm Passphrase</span><input type="password" name="passphrase_confirmation" autocomplete="new-password" minlength="12" required placeholder="Repeat the passphrase" data-passphrase-confirmation/><small class="field-note" data-passphrase-note hidden></small></label>
			<footer class="dialog-footer"><button class="button outline" type="button" data-dialog-close>Cancel</button><button class="button" type="submit" data-passphrase-submit disabled>@Icon("play")<span>Backup Now</span></button></footer>
		</form>
	</dialog>
}

// LocalBackupRestoreDialog keeps credentials and restore policy out of the
// history list. A row's Restore button supplies only the selected archive name.
templ LocalBackupRestoreDialog() {
	<dialog class="custom-server-dialog blocking-dialog" id="local-backup-restore-dialog" aria-labelledby="local-backup-restore-title">
		<div class="dialog-header"><h2 id="local-backup-restore-title">Restore Local Backup</h2><p>Stage <strong data-local-backup-restore-name></strong> before a controlled restart.</p></div>
		<button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		<form class="blocking-dialog-form" hx-post="/ui/backup/restore-local" hx-target="#backup-panel" hx-swap="outerHTML" hx-disable="find button[type='submit']" data-local-backup-restore-form>
			<input type="hidden" name="name" data-local-backup-restore-input/>
			<div class="cluster-dialog-note">@Icon("alert-triangle")<p><strong>Restoring replaces what is here now</strong><span>Zones, users, roles, API tokens, and secrets are validated and staged while this node keeps serving its current state.</span></p></div>
			<label><span>Passphrase</span><input type="password" name="passphrase" autocomplete="off" data-local-backup-passphrase/><small data-local-backup-passphrase-note></small></label>
			<label class="zone-import-option"><input type="checkbox" name="keep_configuration"/><span><strong>Keep this node's configuration</strong><small>Restore data while leaving local listeners, storage, and paths alone.</small></span></label>
			<footer class="dialog-footer"><button class="button outline" type="button" data-dialog-close>Cancel</button><button class="button destructive" type="submit" data-replica-primary-action>@Icon("rotate-ccw")<span>Restore Backup</span></button></footer>
		</form>
	</dialog>
}

// UploadBackupRestoreDialog mirrors local restore, changing only how the
// archive is selected and requiring the passphrase that sealed the file.
templ UploadBackupRestoreDialog() {
	<dialog class="custom-server-dialog blocking-dialog" id="upload-backup-restore-dialog" aria-labelledby="upload-backup-restore-title">
		<div class="dialog-header"><h2 id="upload-backup-restore-title">Restore Backup</h2><p>Choose a Sable archive and stage it before a controlled restart.</p></div>
		<button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		<form class="blocking-dialog-form backup-form" hx-post="/ui/backup/restore" hx-target="#backup-panel" hx-swap="outerHTML" hx-encoding="multipart/form-data" hx-disable="find button[type='submit']" data-backup-restore-form data-upload-backup-restore-form>
			<div class="cluster-dialog-note">@Icon("alert-triangle")<p><strong>Restoring replaces what is here now</strong><span>Zones, users, roles, API tokens, and secrets are validated and staged while this node keeps serving its current state.</span></p></div>
			<div class="field-control">
				<span>Backup File</span>
				<div class="file-picker">
					<input class="sr-only" id="restore-backup-archive-file" type="file" name="archive" accept=".sablebackup" data-file-picker-input data-backup-archive-input required/>
					<label class="button outline" for="restore-backup-archive-file">@Icon("upload")<span>Choose File</span></label>
					<span data-file-picker-name>No file selected</span>
				</div>
			</div>
			@BackupArchivePreview()
			<label><span>Passphrase</span><input type="password" name="passphrase" autocomplete="off" required placeholder="The passphrase this backup was sealed with"/></label>
			<label class="zone-import-option"><input type="checkbox" name="keep_configuration"/><span><strong>Keep this node's configuration</strong><small>Restore data while leaving local listeners, storage, and paths alone.</small></span></label>
			@BackupUploadMeter()
			<footer class="dialog-footer"><button class="button outline" type="button" data-dialog-close>Cancel</button><button class="button destructive" type="submit" data-replica-primary-action>@Icon("upload")<span>Restore Backup</span></button></footer>
		</form>
	</dialog>
}

func BackupSchedulePassphrasePlaceholder(stored bool) string {
	if stored { return "Stored securely — leave blank to keep" }
	return "At least 12 characters"
}

func BackupSchedulePassphraseNote(stored bool) string {
	if stored { return "A passphrase is stored in the encrypted vault. Enter a new one only to rotate it." }
	return "Required before the schedule can be enabled; it is stored in the encrypted vault."
}

func BackupKindLabel(scheduled bool) string {
	if scheduled { return " · Scheduled" }
	return " · Local archive"
}

func LocalBackupDownloadURL(name string) templ.SafeURL {
	return templ.SafeURL("/ui/backup/local?name=" + url.QueryEscape(name))
}

// BackupProgress renders a real bar: the stage is the work actually under way
// and the count is the stages already finished, not a timer pretending to be
// one.
templ BackupProgress(job SettingsBackupJobView) {
	<div class="backup-progress" role="status" aria-live="polite">
		<div class="backup-progress-heading">
			<strong>{ job.Title }</strong>
			<span>{ fmt.Sprintf("%d%%", job.Percent) }</span>
		</div>
		<div class="backup-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ fmt.Sprint(job.Percent) } aria-label={ job.Title }>
			<div class="backup-progress-fill" data-progress-fill></div>
		</div>
		<div class="backup-progress-meta">
			<span>{ job.Stage }</span>
			<span>{ fmt.Sprintf("Step %d of %d", min(job.Step+1, job.Total), job.Total) }</span>
		</div>
	</div>
}

// BackupUploadMeter is filled in by the browser from real upload progress
// events. A large archive crossing a slow link is the one part of a restore
// the server cannot see, so it is measured on the client instead.
templ BackupUploadMeter() {
	<div class="backup-progress backup-upload" data-backup-upload hidden>
		<div class="backup-progress-heading">
			<strong>Uploading archive</strong>
			<span data-backup-upload-percent>0%</span>
		</div>
		<div class="backup-progress-track">
			<div class="backup-progress-fill" data-backup-upload-fill></div>
		</div>
	</div>
}

templ SettingsCard(icon, title, description string) {
	<section class="card settings-source-card">
		<header><h2>@Icon(icon)<span>{ title }</span></h2><p>{ description }</p></header>
		{ children... }
	</section>
}
templ SettingsSaveButton(tab string) { <div class="settings-panel-save"><button class="button" type="submit" name="settings_tab" value={ tab }>Save Settings</button></div> }

// SettingsDangerCard marks a card whose action cannot be casually undone. The
// restore card looks different from the download card on purpose: one produces
// a file, the other replaces every user and secret on the node.
templ SettingsDangerCard(icon, title, description string) {
	<section class="card settings-source-card settings-danger-card">
		<header><h2>@Icon(icon)<span>{ title }</span></h2><p>{ description }</p></header>
		{ children... }
	</section>
}

// BackupArchivePreview is filled in by the browser once a file is chosen. The
// envelope header travels unencrypted precisely so a backup can identify itself
// without its passphrase.
templ BackupArchivePreview() {
	<div class="backup-archive-preview" data-backup-archive-preview hidden>
		<span class="backup-archive-icon" aria-hidden="true">@Icon("hard-drive")</span>
		<div>
			<strong data-backup-archive-title></strong>
			<span data-backup-archive-detail></span>
		</div>
	</div>
}

// coveredNamesSummary labels the link that opens the certificate details. It
// names the single covered host when there is only one, because "1 name" tells
// an operator less than the name itself does.
func coveredNamesSummary(names []string) string {
	switch len(names) {
	case 0:
		return ""
	case 1:
		return names[0]
	default:
		return fmt.Sprintf("%d names", len(names))
	}
}

templ CertificateDetailsDialog(view SettingsPageView) {
	<dialog class="custom-server-dialog isotope-form-dialog certificate-dialog" id="certificate-details-dialog" aria-labelledby="certificate-details-title">
		<div class="dialog-header"><h2 id="certificate-details-title">Certificate Details</h2><p>The certificate currently installed for Web, DoH, DoT, and DoQ</p></div><button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		<div class="dialog-body certificate-details-body">
			<div class="certificate-detail-grid">
				<div class="certificate-detail"><span>Issued by</span><strong>{ ifThen(view.ACMEIssuer != "", view.ACMEIssuer, "Unknown") }</strong></div>
				<div class="certificate-detail"><span>Subject</span><strong>{ ifThen(view.ACMESubject != "", view.ACMESubject, "Not set") }</strong></div>
				<div class="certificate-detail"><span>Issued on</span><strong>{ ifThen(view.ACMEIssuedOn != "", view.ACMEIssuedOn, "Unknown") }</strong></div>
				<div class="certificate-detail"><span>Expires</span><strong>{ ifThen(view.ACMEExpires != "", view.ACMEExpires, "Unknown") }</strong></div>
			</div>
			<div class="certificate-detail-section">
				<h3>Covered Hosts</h3>
				<p>A client is only protected when the name it connects to appears here.</p>
				if len(view.ACMECoveredNames) > 0 {
					<ul class="certificate-name-list">
						for _, name := range view.ACMECoveredNames {
							<li>@Icon("check-circle")<span>{ name }</span></li>
						}
					</ul>
				} else {
					<p class="certificate-detail-empty">No certificate is installed yet.</p>
				}
			</div>
			if len(view.ACMEPendingNames) > 0 {
				<div class="certificate-detail-section">
					<h3>Not Covered Yet</h3>
					<p>These names are configured but are not on the installed certificate. Issue a new one to include them.</p>
					<ul class="certificate-name-list pending">
						for _, name := range view.ACMEPendingNames {
							<li>@Icon("alert-triangle")<span>{ name }</span></li>
						}
					</ul>
				</div>
			}
			<div class="certificate-detail-section">
				<h3>Identity</h3>
				<div class="certificate-detail">
					<span>Serial number</span>
					<div class="copyable-text certificate-detail-value">
						<code id="certificate-serial-number">{ ifThen(view.ACMESerialNumber != "", view.ACMESerialNumber, "Unknown") }</code>
						if view.ACMESerialNumber != "" {
							<button type="button" data-copy-target="certificate-serial-number" aria-label="Copy serial number" title="Copy serial number">@CopyIcons()</button>
						}
					</div>
				</div>
				<div class="certificate-detail">
					<span>SHA-256 fingerprint</span>
					<div class="copyable-text certificate-detail-value">
						<code id="certificate-fingerprint">{ ifThen(view.ACMEFingerprint != "", view.ACMEFingerprint, "Unknown") }</code>
						if view.ACMEFingerprint != "" {
							<button type="button" data-copy-target="certificate-fingerprint" aria-label="Copy fingerprint" title="Copy fingerprint">@CopyIcons()</button>
						}
					</div>
				</div>
				if view.ACMELastRenewal != "" {
					<div class="certificate-detail"><span>Last issued or renewed</span><strong>{ view.ACMELastRenewal }</strong></div>
				}
			</div>
		</div>
		<div class="dialog-footer"><button class="button outline" type="button" data-dialog-close>Close</button></div>
	</dialog>
}
