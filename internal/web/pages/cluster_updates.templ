package pages

import (
	"fmt"

	"github.com/drudge/sable/internal/cluster"
)

type ClusterUpdateView struct {
	Initialized bool
 UnavailableReason string
 Supported bool
	CanApply  bool
	Version   string
	Release   UpdateView
	Rollout   cluster.RolloutStatus
}

// Keep a started rollout visible while restarting nodes renegotiate support,
// and preserve its outcome even if a node later becomes unavailable.
func (view ClusterUpdateView) Visible() bool {
	return view.Initialized || view.Supported || view.Rollout.ID != ""
}

func (view ClusterUpdateView) DisplayVersion() string {
	if view.Rollout.Active() || view.Release.LatestVersion == "" && view.Version == "" {
		return formatReleaseVersion(view.Rollout.Version)
	}
	if view.Release.LatestVersion != "" {
		return formatReleaseVersion(view.Release.LatestVersion)
	}
	return formatReleaseVersion(view.Version)
}

func (view ClusterUpdateView) UpdateAvailable() bool {
	return view.Supported && view.Version != "" && !view.Rollout.Active()
}

func (view ClusterUpdateView) UpToDate() bool {
	return view.Rollout.Phase == "complete" && view.Version == "" && view.DisplayVersion() == formatReleaseVersion(view.Rollout.Version)
}

templ ClusterUpdatePanel(view ClusterUpdateView, outOfBand bool) {
	<div
		id="cluster-updates"
		hidden?={ !view.Visible() }
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		if view.Visible() {
			<section class="card cluster-update-card">
				<header>
					<h2>Rolling Updates</h2>
					if view.DisplayVersion() != "" {
						<span class={ "status-badge cluster-update-version", templ.KV("available", view.UpdateAvailable()), templ.KV("current", view.UpToDate()) }>
							if view.UpdateAvailable() {
								@Icon("sparkles")
								<span class="sr-only">Update available: </span>
							} else if view.UpToDate() {
								@Icon("check")
								<span class="sr-only">Up to date: </span>
							}
							{ view.DisplayVersion() }
						</span>
					}
				</header>
				<div class="cluster-update-content">
					<p>Update replicas one at a time, then the primary.</p>
 if !view.Supported && view.UnavailableReason != "" {
 <div class="cluster-dialog-note">@Icon("info")<p><strong>Rolling updates unavailable</strong><span>{ view.UnavailableReason }</span></p></div>
 }
					if view.Rollout.ID != "" {
						if view.Rollout.Phase != "complete" {
							<strong class="cluster-update-status" role="status">{ rolloutPhaseLabel(view.Rollout.Phase) }</strong>
						}
						if view.Rollout.Error != "" {
							<p role="alert">{ view.Rollout.Error }</p>
						}
						<ol class="cluster-update-nodes" role="list" aria-label="Node update progress">
							for index, node := range view.Rollout.Nodes {
								{{ phase := rolloutNodePhase(view.Rollout, index) }}
								<li class="cluster-update-node" data-state={ phase }>
									<span class="cluster-update-step" aria-hidden="true">
										if rolloutNodeBusy(phase) {
											@Icon("loader-circle")
										} else if phase == "complete" {
											@Icon("check")
										} else if phase == "failed" {
											@Icon("x")
										} else {
											{ fmt.Sprint(index + 1) }
										}
									</span>
									<div><strong>{ node.Name }</strong><span>{ rolloutNodePhaseLabel(phase) }</span></div>
								</li>
							}
						</ol>
					}
					<div class="cluster-update-actions">
						@updateReleaseNotesButton(view.Release, clusterUpdateNotesDialogID)
 if !view.Supported && !view.Rollout.Active() {
 <button class="button compact" type="button" disabled>Update all</button>
 }
						if view.Rollout.Active() {
							if view.CanApply {
								<button class="button outline compact" id="cluster-update-stop" type="button" hx-post="/ui/updates/cluster/stop" hx-target="#cluster-content" hx-swap="outerHTML" hx-confirm="Stop this rollout? An installation or restart already in progress may finish." data-confirm-title="Stop rolling update?" data-confirm-action="Stop rollout">Stop rollout</button>
							}
						} else if view.Supported && view.CanApply && view.Version != "" {
							@clusterUpdateForm(view.Version, false) {
								<button id="cluster-update-start" class="button compact" type="submit">@Icon("download")
<span>Update all</span></button>
							}
						}
						if view.Release.CanCheck && !view.Rollout.Active() && !view.Release.Busy && view.Version == "" {
							<form data-update-check hx-post="/ui/updates/command-check" hx-target="body" hx-swap="beforeend" hx-disable="find button">
								<button id="cluster-update-check" class="button outline compact" type="submit">@Icon("refresh")<span class="about-update-check-idle">{ ifThen(view.Rollout.ID != "" || view.Release.Checked, "Check again", "Check for updates") }</span><span class="about-update-check-pending" role="status">Checking…</span></button>
							</form>
						}
					</div>
				</div>
			</section>
			@updateReleaseNotesDialog(view.Release, clusterUpdateNotesDialogID)
		}
	</div>
}

templ clusterUpdateForm(version string, fromNotification bool) {
	<form
		hx-post="/ui/updates/cluster"
		hx-target={ ifThen(fromNotification, "closest .toast-region", "#cluster-content") }
		hx-swap="outerHTML"
		hx-disable={ ifThen(fromNotification, "[data-update-version] button, [data-update-version] input", "#cluster-updates button, #cluster-updates input") }
		hx-confirm={ "Install Sable v" + version + " on every node? Each replica restarts and synchronizes before the next node updates. The primary restarts last, briefly interrupting its console. DNS clients must be configured to use multiple nodes." }
		data-confirm-title="Update the entire cluster?"
		data-confirm-action="Start rolling update"
		data-confirm-tone="neutral"
	>
		<input type="hidden" name="version" value={ version }/>
		if fromNotification {
			<input type="hidden" name="notification" value="true"/>
		}
		{ children... }
	</form>
}

func rolloutNodePhase(rollout cluster.RolloutStatus, index int) string {
	phase := rollout.Nodes[index].Phase
	if phase == "complete" {
		return phase
	}
	if rollout.Phase == "failed" || rollout.Phase == "stopped" {
		if index == rollout.Index {
			return rollout.Phase
		}
		return "skipped"
	}
	if rollout.Phase == "verifying" {
		return rollout.Phase
	}
	return phase
}

func rolloutNodeBusy(phase string) bool {
	switch phase {
	case "install", "installing", "restart", "restarting", "verifying":
		return true
	default:
		return false
	}
}

func rolloutNodePhaseLabel(phase string) string {
	switch phase {
	case "verifying":
		return "Verifying sync"
	default:
		return rolloutPhaseLabel(phase)
	}
}

func rolloutPhaseLabel(phase string) string {
	switch phase {
	case "preparing":
		return "Checking nodes"
	case "updating":
		return "Updating cluster"
	case "verifying":
		return "Verifying cluster"
	case "queued":
		return "Waiting"
	case "install", "installing":
		return "Installing"
	case "restart", "restarting":
		return "Restarting"
	case "complete":
		return "Up to date"
	case "failed":
		return "Failed"
	case "stopped":
		return "Stopped"
	case "skipped":
		return "Not updated"
	default:
		return phase
	}
}
