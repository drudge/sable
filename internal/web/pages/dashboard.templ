package pages

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/drudge/sable/internal/web/pages/components"
)

// Indicator CSS lives in app.css to respect the console's strict style-src CSP.
// Long-running operations stay unbounded, matching Sable's htmx 2 behavior.
// History traversal reloads the page because htmx's default body swap detaches
// controls captured during app.js initialization, including the command palette.
const htmxConfig = `{"includeIndicatorCSS":false,"defaultTimeout":0,"history":"reload"}`

type DashboardView struct {
	Version     string
	TimeDisplay TimeDisplay
	ShowFullRecordNames bool
	Username    string
	DisplayName string
	// AvatarURL points at the signed-in operator's profile picture, and is
	// empty when there is none and the account initial is drawn instead.
	AvatarURL            string
	CSRFToken            string
	SecurityEnabled      bool
	CanSettings          bool
	CanWriteSettings     bool
	BackupsAvailable     bool
	CanCreateBackups     bool
	CanRestoreBackups    bool
	BackupPassphraseStored bool
	CanAdministration    bool
	CanWriteUsers        bool
	CanZones             bool
	CanCreateZones       bool
	CanBlocking          bool
	CanWriteBlocking     bool
	BlockingEnabled      bool
	HasRemoteBlockLists  bool
	CanLogs              bool
	// InsightsOff hides Insights everywhere while it is turned off.
	InsightsOff          bool
	CanMetrics           bool
	CanCheckUpdates      bool
	CheckUpdatesOnLogin bool
	CanCluster           bool
	CanWriteCluster      bool
	ControlPlaneReadOnly bool
	PrimaryURL           string
	Database             string
	DNSListeners         string
	EncryptedDNS         string
	QueryServer          string
	CacheSize            int
	ForwardRoutes        int
	LocalHosts           int
	QueryLogStatus       string
	DNSSECStatus         string
	ConfigRevision       uint64
	Stats                StatsView
	StatsScope           string
	Chart                QueryChartView
	Insights             DashboardInsightsView
	CommandEntities      []CommandEntityView
}

// CommandEntityView is a searchable object in the global command palette.
// Unlike a page or action, an entity points at one configured Sable resource.
type CommandEntityView struct {
	ID           string
	Label        string
	Description  string
	Icon         string
	Kind         string
	Keywords     string
	Href         string
	Route        string
	Dialog       string
	Focus        string
	SearchPrompt string
	SearchParam  string
}

func commandEntitiesByKind(entities []CommandEntityView, kind string) []CommandEntityView {
	matched := make([]CommandEntityView, 0, len(entities))
	for _, entity := range entities {
		if entity.Kind == kind {
			matched = append(matched, entity)
		}
	}
	return matched
}

type DashboardInsightsView struct {
	// RangeLabel names the window the rankings and distributions describe, and
	// LogWindowQuery reproduces that window on the query log page so a ranking
	// row and the log it links to report the same count.
	RangeLabel     string
	LogWindowQuery string
	// PollRange names the chart range the panels may refresh themselves on. It
	// is empty for the wide ranges, whose counts are recounted only when the
	// range picker asks for them.
	PollRange       string
	LoadURL         string
	Loading         bool
	TopClients      []RankedStatView
	TopDomains      []RankedStatView
	TopBlocked      []RankedStatView
	QueryTypes      []DistributionItemView
	ResponseSources []DistributionItemView
	ResponseCodes   []DistributionItemView
}

type RankedStatView struct {
	Name      string
	Secondary string
	Value     uint64
	// Href replaces the query log link a ranking builds from Name, for
	// entries that are not a single client or domain.
	Href string
	// Drawer opens the entry's details in a drawer instead of following a
	// link.
	Drawer *DrawerLink
	// Icon leads the entry, such as an app's logo.
	Icon templ.Component
}

// DrawerLink opens a detail drawer whose content loads on demand: the dialog
// to open, the template it starts from while loading, and the URL and element
// of its content.
type DrawerLink struct {
	Dialog  string
	Loading string
	URL     string
	Target  string
	// Link is the page address of what the drawer shows, which the browser
	// shows while it is open, when it has one.
	Link string
}

// drawerOpener is what a button needs to open a DrawerLink's drawer and load
// its content into it.
func drawerOpener(drawer *DrawerLink) templ.Attributes {
	attributes := templ.Attributes{
		"data-dialog-open": drawer.Dialog, "data-drawer-loading": drawer.Loading,
		"hx-get": drawer.URL, "hx-target": "#" + drawer.Target, "hx-swap": "innerHTML", "hx-indicator": "#" + drawer.Target,
	}
	if drawer.Link != "" {
		attributes["data-dialog-url"] = drawer.Link
	}
	return attributes
}

type DistributionItemView struct {
	Name    string
	Value   uint64
	Percent float64
	Offset  float64
	Color   int
}

type QueryChartView struct {
	ActiveRange, RangeLabel string
	Stats                   StatsView
	Total, Successful       string
	ServerFailure           string
	NXDomain                string
	Refused                 string
	Recursive               string
	Blocked                 string
	CacheHits               string
	StartLabel              string
	EndLabel                string
	HasActivity             bool
	Live                    bool
	Historical              bool
	Maximum                 uint64
	CustomStart             string
	CustomEnd               string
	HoverData               string
}

type StatsView struct {
	Queries              uint64
	NoError              uint64
	ServerFailures       uint64
	NXDomain             uint64
	Refused              uint64
	Recursive            uint64
	Dropped              uint64
	Clients              int
	Blocked              uint64
	Failures             uint64
	UpstreamErrors       uint64
	CacheHits            uint64
	CacheMisses          uint64
	CacheEntries         int
	CacheHitRatio        string
	RoutedQueries        uint64
	LocalAnswers         uint64
	AuthoritativeAnswers uint64
	DNSSECSecure         uint64
	DNSSECInsecure       uint64
	DNSSECBogus          uint64
	LocalHosts           int
	BlockedDomains       int
	BlockLists           int
	Uptime               string
}

const (
	StatsScopeAll   = "all"
	StatsScopeRange = "range"
)

// StatsOverviewView keeps the displayed values separate from the lifetime
// totals. Most counters can follow the chart range, while counters that are not
// retained in historical buckets remain honest about using their original
// lifetime or recent-sample value.
type StatsOverviewView struct {
	Values      StatsView
	Lifetime    StatsView
	Scope       string
	RangeName   string
	RangeLabel  string
	CustomStart string
	CustomEnd   string
	CanLogs     bool
	// LogWindowQuery reproduces the selected chart window on the query log
	// page. It is only applied to cards whose value follows that window.
	LogWindowQuery string
	OutOfBand   bool
}

type QueryView struct {
	Success    bool
	Question   string
	RecordType string
	Server     string
	Protocol   string
	Elapsed    string
	Size       string
	RCode      string
	Flags      []string
	Answers    []RecordView
	Authority  []RecordView
	Additional []RecordView
	Response   string
	JSON       string
	Error      string
}

type RecordView struct {
	Name string
	Type string
	Data string
	TTL  uint32
}

type ResolverOption struct {
	Value  string
	Label  string
	Detail string
	Search string
}

func (option ResolverOption) SearchText() string {
	return strings.TrimSpace(option.Label + " " + option.Detail + " " + option.Value + " " + option.Search)
}

type DNSClientPageView struct {
	Console      DashboardView
	ClusterNodes []ResolverOption
	QueryName    string
	RecordType   string
}

var dnsClientRecordTypes = []string{"A", "AAAA", "ANY", "CAA", "CNAME", "DNSKEY", "DS", "HTTPS", "MX", "NAPTR", "NS", "PTR", "SOA", "SRV", "SVCB", "TLSA", "TXT"}

