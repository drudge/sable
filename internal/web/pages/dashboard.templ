package pages

import (
	"fmt"
	"net/url"
	"strings"
)

// htmx injects its own indicator CSS as soon as it loads, which the console's
// strict style-src CSP blocks. Turning the injection off keeps the console
// CSP-clean; the equivalent rules live in app.css. Sable keeps long-running
// operations unbounded, matching its htmx 2 behavior.
const htmxConfig = `{"includeIndicatorCSS":false,"defaultTimeout":0}`

type DashboardView struct {
	Version     string
	TimeDisplay TimeDisplay
	Username    string
	DisplayName string
	// AvatarURL points at the signed-in operator's profile picture, and is
	// empty when there is none and the account initial is drawn instead.
	AvatarURL            string
	CSRFToken            string
	SecurityEnabled      bool
	CanSettings          bool
	CanWriteSettings     bool
	CanAdministration    bool
	CanWriteUsers        bool
	CanZones             bool
	CanCreateZones       bool
	CanBlocking          bool
	CanWriteBlocking     bool
	BlockingEnabled      bool
	HasRemoteBlockLists  bool
	CanLogs              bool
	CanMetrics           bool
	CanCluster           bool
	CanWriteCluster      bool
	ControlPlaneReadOnly bool
	PrimaryURL           string
	Database             string
	DNSListeners         string
	EncryptedDNS         string
	QueryServer          string
	CacheSize            int
	ForwardRoutes        int
	LocalHosts           int
	QueryLogStatus       string
	DNSSECStatus         string
	ConfigRevision       uint64
	Stats                StatsView
	StatsScope           string
	Chart                QueryChartView
	Insights             DashboardInsightsView
	CommandEntities      []CommandEntityView
}

// CommandEntityView is a searchable object in the global command palette.
// Unlike a page or action, an entity points at one configured Sable resource.
type CommandEntityView struct {
	ID           string
	Label        string
	Description  string
	Icon         string
	Kind         string
	Keywords     string
	Href         string
	Route        string
	Dialog       string
	Focus        string
	SearchPrompt string
	SearchParam  string
}

func commandEntitiesByKind(entities []CommandEntityView, kind string) []CommandEntityView {
	matched := make([]CommandEntityView, 0, len(entities))
	for _, entity := range entities {
		if entity.Kind == kind {
			matched = append(matched, entity)
		}
	}
	return matched
}

type DashboardInsightsView struct {
	// RangeLabel names the window the rankings and distributions describe, and
	// LogWindowQuery reproduces that window on the query log page so a ranking
	// row and the log it links to report the same count.
	RangeLabel     string
	LogWindowQuery string
	// PollRange names the chart range the panels may refresh themselves on. It
	// is empty for the wide ranges, whose counts are recounted only when the
	// range picker asks for them.
	PollRange       string
	LoadURL         string
	Loading         bool
	TopClients      []RankedStatView
	TopDomains      []RankedStatView
	TopBlocked      []RankedStatView
	QueryTypes      []DistributionItemView
	ResponseSources []DistributionItemView
	ResponseCodes   []DistributionItemView
}

type RankedStatView struct {
	Name      string
	Secondary string
	Value     uint64
}

type DistributionItemView struct {
	Name    string
	Value   uint64
	Percent float64
	Offset  float64
	Color   int
}

type QueryChartView struct {
	ActiveRange, RangeLabel string
	Stats                   StatsView
	Total, Successful       string
	ServerFailure           string
	NXDomain                string
	Refused                 string
	Recursive               string
	Blocked                 string
	CacheHits               string
	StartLabel              string
	EndLabel                string
	HasActivity             bool
	Live                    bool
	Historical              bool
	Maximum                 uint64
	CustomStart             string
	CustomEnd               string
	HoverData               string
}

type StatsView struct {
	Queries              uint64
	NoError              uint64
	ServerFailures       uint64
	NXDomain             uint64
	Refused              uint64
	Recursive            uint64
	Dropped              uint64
	Clients              int
	Blocked              uint64
	Failures             uint64
	UpstreamErrors       uint64
	CacheHits            uint64
	CacheMisses          uint64
	CacheEntries         int
	CacheHitRatio        string
	RoutedQueries        uint64
	LocalAnswers         uint64
	AuthoritativeAnswers uint64
	DNSSECSecure         uint64
	DNSSECInsecure       uint64
	DNSSECBogus          uint64
	LocalHosts           int
	BlockedDomains       int
	BlockLists           int
	Uptime               string
}

const (
	StatsScopeAll   = "all"
	StatsScopeRange = "range"
)

// StatsOverviewView keeps the displayed values separate from the lifetime
// totals. Most counters can follow the chart range, while counters that are not
// retained in historical buckets remain honest about using their original
// lifetime or recent-sample value.
type StatsOverviewView struct {
	Values      StatsView
	Lifetime    StatsView
	Scope       string
	RangeName   string
	RangeLabel  string
	CustomStart string
	CustomEnd   string
	OutOfBand   bool
}

type QueryView struct {
	Success    bool
	Question   string
	RecordType string
	Server     string
	Protocol   string
	Elapsed    string
	Size       string
	RCode      string
	Flags      []string
	Answers    []RecordView
	Authority  []RecordView
	Additional []RecordView
	Response   string
	JSON       string
	Error      string
}

type RecordView struct {
	Name string
	Type string
	Data string
	TTL  uint32
}

type ResolverOption struct {
	Value  string
	Label  string
	Detail string
	Search string
}

func (option ResolverOption) SearchText() string {
	return strings.TrimSpace(option.Label + " " + option.Detail + " " + option.Value + " " + option.Search)
}

type DNSClientPageView struct {
	Console      DashboardView
	ClusterNodes []ResolverOption
}

var localResolverOptions = []ResolverOption{
	{Value: "this-server", Label: "This Server"},
