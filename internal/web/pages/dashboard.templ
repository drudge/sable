type QueryLogEntryView struct {
	OccurredAt string
	ClientIP   string
	Name       string
	RecordType string
	Status     string
	Source     string
	Protocol   string
	Answers    []string
	Duration   string
	Decision   QueryDecisionView
}

type QueryDecisionView struct {
	Available      bool
	Summary        string
	Policy         string
	PolicyDetail   string
	Cache          string
	Resolver       string
	ResolverDetail string
	DNSSEC         string
}

templ Dashboard(view DashboardView) {
	@AppDocument(view, "Dashboard", "dashboard", Empty())
}

templ DNSClientPage(view DNSClientPageView) {
	@AppDocument(view.Console, "DNS Client", "dns-client", DNSClientContent(view))
}

templ Empty() {
}

templ AppDocument(view DashboardView, pageTitle string, activePage string, page templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ pageTitle } · Sable</title>
			<link rel="icon" href={ assetURL("sable-mark.svg") } type="image/svg+xml"/>
			<link rel="icon" href={ assetURL("sable-icon-180.png") } type="image/png" sizes="180x180"/>
			<link rel="apple-touch-icon" href={ assetURL("sable-icon-180.png") }/>
			<script src={ assetURL("bootstrap.js") }></script>
			<link rel="stylesheet" href={ assetURL("app.css") }/>
			<script src={ assetURL("app.js") } defer></script>
			<script src={ assetURL("htmx.min.js") } defer></script>
		</head>
		<body hx-headers:inherited={ fmt.Sprintf("{\"X-CSRF-Token\":%q}", view.CSRFToken) } data-control-plane-read-only={ fmt.Sprint(view.ControlPlaneReadOnly) } data-cluster-primary-url={ view.PrimaryURL }>
			<nav class="skip-links" aria-label="Skip links">
				<a href="#main-content">Skip to main content</a>
				<a href="#primary-navigation">Skip to navigation</a>
			</nav>
			<div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-a11y-announcer></div>
			@CommandPalette(view)
			<div class="app-shell">
				<aside class="sidebar" id="app-sidebar" aria-label="Application sidebar">
					<div class="sidebar-header">
						<a class="brand" href="/" aria-label="Sable dashboard" data-tooltip={ brandTooltip(view) }>
							@SableMark("")
							<span class="brand-copy"><strong>Sable</strong><small>{ view.Version }</small></span>
						</a>
						<button class="sidebar-collapse" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true" aria-label="Collapse sidebar" title="Collapse sidebar">
							@Icon("panel")
						</button>
					</div>
					<nav class="nav" id="primary-navigation" aria-label="Primary navigation" tabindex="-1">
						<div class="nav-group">
							<div class="nav-label">Overview</div>
							@NavItem("Dashboard", "/", "dashboard", activePage == "dashboard", false)
							if view.CanZones {
								@NavItem("Zones", "/zones", "globe", activePage == "zones", false)
							}
							if view.CanSettings {
								@NavItem("Cache", "/cache", "database", activePage == "cache", false)
							}
							if view.CanBlocking {
								@NavItem("Allowed", "/blocked?tab=allowed", "shield-check", activePage == "allowed", false)
								@NavItem("Blocked", "/blocked?tab=domains", "shield-x", activePage == "blocked", false)
							}
							if view.CanSettings {
								@NavItem("Integrations", "/integrations", "plug", activePage == "integrations", false)
							}
							@NavItem("DNS Client", "/dns-client", "terminal", activePage == "dns-client", false)
							if view.CanLogs {
								@NavItem("Logs", "/logs", "logs", activePage == "logs", false)
							}
						</div>
						<div class="nav-group">
							<div class="nav-label">System</div>
							if view.CanSettings {
								@NavItem("Settings", "/settings", "settings", activePage == "settings", false)
							}
							if view.CanAdministration {
								@NavItem("Administration", "/administration", "users", activePage == "administration", false)
							}
							if view.CanCluster {
								@NavItem("Cluster", "/cluster", "cluster", activePage == "cluster", false)
							}
							@NavItem("About", "/about", "info", activePage == "about", false)
						</div>
					</nav>
					<div class="sidebar-bottom">
						<button class="command-palette-trigger" type="button" data-command-open aria-haspopup="dialog" aria-controls="command-palette" aria-expanded="false" aria-keyshortcuts="Meta+K Control+K" data-tooltip="Command palette">
							@Icon("search")
							<span class="command-palette-trigger-label">Commands</span>
							<kbd data-command-shortcut>⌘K</kbd>
						</button>
						<div class="sidebar-account" data-account-menu>
							<button class="user-menu" type="button" data-account-trigger aria-haspopup="dialog" aria-expanded="false" data-tooltip={ accountDisplayName(view) }>
								@AccountAvatar(view)
								<span class="user-copy"><strong>{ accountDisplayName(view) }</strong><small>{ ifThen(view.SecurityEnabled, view.Username, "local console") }</small></span>
								<span class="user-action">
									@Icon("chevron-up")
								</span>
							</button>
							<div class="account-popover" data-account-popover role="dialog" aria-label="Account and appearance" hidden>
								if view.SecurityEnabled {
									<div class="account-popover-header">
										@AccountAvatar(view)
										<span><strong>{ accountDisplayName(view) }</strong><small>{ view.Username }</small></span>
									</div>
									<a class="account-menu-item" href="/profile">
										@Icon("user")
										<span>Profile</span>
									</a>
									<a class="account-menu-item" href="/profile?tab=tokens">
										@Icon("key")
										<span>API Tokens</span>
									</a>
									<div class="account-menu-separator"></div>
								}
								<div class="account-theme">
									<div class="account-theme-label">
										@Icon("sun")
										<span>Theme</span>
									</div>
									<div class="account-theme-options" role="radiogroup" aria-label="Theme"><button type="button" data-theme-value="system" role="radio">System</button><button type="button" data-theme-value="light" role="radio">Light</button><button type="button" data-theme-value="dark" role="radio">Dark</button></div>
								</div>
								if view.SecurityEnabled {
									<div class="account-menu-separator"></div>
									<button class="account-menu-item account-sign-out" hx-post="/logout" hx-swap="none">
										@Icon("log-out")
										<span>Sign out</span>
									</button>
								}
							</div>
						</div>
					</div>
					<button class="sidebar-rail" type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true" aria-label="Expand sidebar" title="Expand sidebar"></button>
				</aside>
				<div class="sidebar-scrim" data-sidebar-toggle aria-hidden="true"></div>
				<main class="main" id="main-content" tabindex="-1">
					<header class="mobile-header" data-mobile-header>
						<button type="button" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="false" aria-label="Open navigation">
							@Icon("menu")
						</button>
						<a class="mobile-header-brand" href="/">Sable</a>
						<button class="mobile-command-palette-trigger" type="button" data-command-open aria-haspopup="dialog" aria-controls="command-palette" aria-expanded="false" aria-keyshortcuts="Meta+K Control+K" aria-label="Open command palette">
							@Icon("search")
						</button>
					</header>
					if view.ControlPlaneReadOnly {
						<div class="replica-read-only-banner" role="status">
							<div class="replica-read-only-copy">
								@Icon("lock")
								<span><strong>Replica · Read-only</strong><span>View and troubleshoot here. Make configuration changes on the primary.</span></span>
							</div>
							if view.PrimaryURL != "" {
								<a class="replica-primary-link" href={ templ.SafeURL(view.PrimaryURL) } target="_blank" rel="noopener noreferrer">
									<span>Open Primary</span>@Icon("external-link")
								</a>
							}
						</div>
					}
					<div class="content">
						if activePage == "dashboard" {
							@DashboardHome(view)
						} else {
							@page
						}
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ CommandPalette(view DashboardView) {
	{{ zoneCommands := commandEntitiesByKind(view.CommandEntities, "Zone") }}
	{{ searchCommands := commandEntitiesByKind(view.CommandEntities, "Search") }}
	{{ integrationCommands := commandEntitiesByKind(view.CommandEntities, "Integration") }}
	{{ actionCommands := commandEntitiesByKind(view.CommandEntities, "Action") }}
	<dialog class="command-palette" id="command-palette" aria-labelledby="command-palette-title" data-command-palette>
		<h2 class="sr-only" id="command-palette-title">Command palette</h2>
		<div class="command-palette-search">
			@Icon("search")
			<label class="sr-only" for="command-palette-input" data-command-input-label>Search commands</label>
			<input id="command-palette-input" type="search" placeholder="Search pages and actions…" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="command-palette-results" aria-expanded="false" data-command-input/>
			<kbd data-command-shortcut>⌘K</kbd>
			<button type="button" data-command-close aria-label="Close command palette">
				@Icon("x")
			</button>
		</div>
		<div class="command-palette-search-scope" data-command-search-scope hidden>
			<button type="button" data-command-search-back aria-label="Back to commands">
				@Icon("arrow-left")
			</button>
			<span><strong data-command-search-label></strong><small>Type your search above, then press Enter.</small></span>
			<div class="command-palette-search-modes" role="radiogroup" aria-label="Search query logs by" data-command-search-modes hidden>
				<button type="button" role="radio" aria-checked="true" data-command-search-mode></button>
				<button type="button" role="radio" aria-checked="false" tabindex="-1" data-command-search-mode></button>
			</div>
		</div>
		<div class="command-palette-results" id="command-palette-results" role="listbox" aria-label="Commands" data-command-list>
			<section class="command-palette-group" role="group" aria-labelledby="command-pages-title" data-command-group>
				<h3 id="command-pages-title">Pages</h3>
				@CommandOption("command-page-dashboard", "Dashboard", "Overview and query statistics", "dashboard", "Page", "home overview statistics metrics", "/", "", "", "", "")
				if view.CanZones {
					@CommandOption("command-page-zones", "Zones", "Manage DNS zones and records", "globe", "Page", "authoritative primary secondary forwarding records", "/zones", "", "", "", "")
				}
				if view.CanSettings {
					@CommandOption("command-page-cache", "DNS Cache", "Inspect cached resolver responses", "database", "Page", "resolver cached responses purge", "/cache", "", "", "", "")
				}
				if view.CanBlocking {
					@CommandOption("command-page-allowed", "Allowed Domains", "Domains exempt from blocking", "shield-check", "Page", "allow permit whitelist exceptions", "/blocked?tab=allowed", "", "", "", "")
					@CommandOption("command-page-blocked", "Blocked Domains", "Custom blocked-domain policy", "shield-x", "Page", "block deny blacklist policy", "/blocked?tab=domains", "", "", "", "")
				}
				if view.CanSettings {
					@CommandOption("command-page-integrations", "Integrations", "UniFi and single sign-on", "plug", "Page", "unifi sso oidc", "/integrations", "", "", "", "")
				}
				@CommandOption("command-page-dns-client", "DNS Client", "Resolve and diagnose DNS queries", "terminal", "Page", "query dig nslookup lookup resolver", "/dns-client", "", "", "", "")
				if view.CanLogs {
					@CommandOption("command-page-server-logs", "Server Logs", "Runtime events and diagnostics", "logs", "Page", "runtime debug errors diagnostics", "/logs", "", "", "", "")
					@CommandOption("command-page-query-logs", "Query Logs", "Search DNS query history", "search", "Page", "history clients domains response", "/logs?tab=queries", "", "", "", "")
				}
				if view.CanSettings {
					@CommandOption("command-page-settings", "Settings", "DNS, logging, blocking, and backups", "settings", "Page", "configuration resolver protocols backup", "/settings", "", "", "", "")
				}
				if view.CanAdministration {
					@CommandOption("command-page-administration", "Administration", "Users, groups, tokens, and sessions", "users", "Page", "accounts permissions roles sessions", "/administration", "", "", "", "")
				}
				if view.CanCluster {
					@CommandOption("command-page-cluster", "Cluster", "Members, certificates, and replication", "cluster", "Page", "nodes primary replica sync", "/cluster", "", "", "", "")
				}
				@CommandOption("command-page-about", "About", "Version and update information", "info", "Page", "release build update", "/about", "", "", "", "")
				if view.SecurityEnabled {
					@CommandOption("command-page-profile", "Profile", "Account details and password", "user", "Page", "account display name email password", "/profile", "", "", "", "")
					@CommandOption("command-page-api-tokens", "API Tokens", "Personal application credentials", "key", "Page", "token credentials automation", "/profile?tab=tokens", "", "", "", "")
				}
			</section>
			if len(zoneCommands) > 0 {
				<section class="command-palette-group" role="group" aria-labelledby="command-zones-title" data-command-group>
					<h3 id="command-zones-title">Zones</h3>
					for _, command := range zoneCommands {
						@CommandOption(command.ID, command.Label, command.Description, command.Icon, command.Kind, command.Keywords, command.Href, command.Route, "", command.Focus, "")
					}
				</section>
			}
			if view.CanLogs || view.CanSettings || view.CanBlocking || len(searchCommands) > 0 {
				<section class="command-palette-group" role="group" aria-labelledby="command-search-title" data-command-group>
					<h3 id="command-search-title">Search actions</h3>
					if view.CanLogs {
						@CommandSearchOption("command-action-search-server-logs", "Search Server Logs", "Enter a term without leaving the command palette", "search", "runtime debug errors diagnostics", "/logs", "#runtime-log-search", "Search server logs…", "search")
						@CommandSearchModesOption("command-action-search-query-logs", "Search Query Logs", "Search by domain or client IP", "search", "dns history client response filters ip address", "/logs?tab=queries&filters=1", "Domain", "name", "#query-log-filters input[name='name']", "Search query logs by domain…", "Client IP", "client_ip", "#query-log-filters input[name='client_ip']", "Search query logs by client IP…")
					}
					if view.CanSettings {
						@CommandSearchOption("command-action-search-cache", "Search DNS Cache", "Enter a domain without leaving the command palette", "search", "cached resolver responses browser", "/cache", "#cache-browser-dialog [data-cache-search]", "Search cached domains…", "")
					}
					if view.CanBlocking {
						@CommandSearchOption("command-action-search-blocked", "Search Blocked Domains", "Filter the custom blocked-domain list", "search", "deny blacklist policy", "/blocked?tab=domains", "[data-domain-search=domains]", "Search blocked domains…", "")
						@CommandSearchOption("command-action-search-allowed", "Search Allowed Domains", "Filter the blocking exceptions list", "search", "permit whitelist exceptions", "/blocked?tab=allowed", "[data-domain-search=allowed]", "Search allowed domains…", "")
					}
					for _, command := range searchCommands {
						@CommandSearchOption(command.ID, command.Label, command.Description, command.Icon, command.Keywords, command.Route, command.Focus, command.SearchPrompt, command.SearchParam)
					}
				</section>
			}
			if len(integrationCommands) > 0 {
				<section class="command-palette-group" role="group" aria-labelledby="command-integrations-title" data-command-group>
					<h3 id="command-integrations-title">Integrations</h3>
					for _, command := range integrationCommands {
						@CommandOption(command.ID, command.Label, command.Description, command.Icon, command.Kind, command.Keywords, command.Href, command.Route, "", command.Focus, "")
					}
				</section>
			}
			<section class="command-palette-group" role="group" aria-labelledby="command-actions-title" data-command-group>
				<h3 id="command-actions-title">Quick actions</h3>
				@CommandOption("command-action-query", "Run DNS Query", "Open the DNS client and focus the domain field", "terminal", "Action", "resolve lookup dig nslookup", "", "/dns-client", "", "#query-name", "")
				if view.CanCreateZones && !view.ControlPlaneReadOnly {
					@CommandOption("command-action-add-zone", "Add Zone", "Open the new DNS zone workflow", "plus", "Action", "create authoritative secondary forwarder", "", "/zones", "create-zone-dialog", "", "")
					@CommandOption("command-action-import-zone", "Import Zone", "Open the zone file import workflow", "upload", "Action", "upload bind file records origin", "", "/zones", "import-new-zone-dialog", "", "")
				}
				if view.CanWriteBlocking && !view.ControlPlaneReadOnly {
					@CommandOption("command-action-block-domain", "Block Domain", "Add a custom blocked domain", "shield-x", "Action", "deny blacklist policy", "", "/blocked?tab=domains", "add-blocked-domain-dialog", "", "")
					@CommandOption("command-action-allow-domain", "Allow Domain", "Add a blocking policy exception", "shield-check", "Action", "permit whitelist exception", "", "/blocked?tab=allowed", "add-allowed-domain-dialog", "", "")
					if view.BlockingEnabled {
						@CommandPostOption("command-action-pause-blocking-5", "Pause Blocking for 5 Minutes", "Temporarily bypass blocking policy", "clock", "stop suspend bypass filtering policy", "/ui/blocking/pause", `{"minutes":"5"}`)
						@CommandPostOption("command-action-pause-blocking-15", "Pause Blocking for 15 Minutes", "Temporarily bypass blocking policy", "clock", "stop suspend bypass filtering policy", "/ui/blocking/pause", `{"minutes":"15"}`)
						@CommandPostOption("command-action-pause-blocking-30", "Pause Blocking for 30 Minutes", "Temporarily bypass blocking policy", "clock", "stop suspend bypass filtering policy", "/ui/blocking/pause", `{"minutes":"30"}`)
						@CommandPostOption("command-action-pause-blocking-60", "Pause Blocking for 1 Hour", "Temporarily bypass blocking policy", "clock", "stop suspend bypass filtering policy", "/ui/blocking/pause", `{"minutes":"60"}`)
						@CommandPostOption("command-action-resume-blocking", "Resume Blocking", "Resume DNS filtering immediately", "play", "unpause restart filtering policy", "/ui/blocking/resume", `{}`)
					}
					if view.HasRemoteBlockLists {
						@CommandPostOption("command-action-update-block-lists", "Update Block Lists", "Download and compile remote blocking sources", "refresh", "download refresh compile blocking sources", "/ui/blocking/lists/update", `{}`)
					}
				}
				if view.CanSettings {
					@CommandOption("command-action-browse-cache", "Browse DNS Cache", "Search cached domains and responses", "folder", "Action", "resolver inspect cached", "", "/cache", "cache-browser-dialog", "", "")
				}
				if view.CanWriteSettings {
					@CommandOption("command-action-flush-cache", "Flush DNS Cache", "Open the cache-clearing confirmation", "trash", "Action", "clear purge cached resolver", "", "/cache", "cache-flush-dialog", "", "")
				}
				if view.SecurityEnabled && !view.ControlPlaneReadOnly {
					@CommandOption("command-action-create-token", "Create API Token", "Open the personal token workflow", "key", "Action", "credential automation secret", "", "/profile?tab=tokens", "create-token-dialog", "", "")
				}
				if view.CanWriteUsers && !view.ControlPlaneReadOnly {
					@CommandOption("command-action-add-user", "Add User", "Open the managed user workflow", "user", "Action", "create account operator", "", "/administration?tab=users", "create-user-dialog", "", "")
					@CommandOption("command-action-add-group", "Add Group", "Create a permission group", "users", "Action", "role permissions access", "", "/administration?tab=groups", "create-group-dialog", "", "")
				}
				for _, command := range actionCommands {
					@CommandOption(command.ID, command.Label, command.Description, command.Icon, command.Kind, command.Keywords, command.Href, command.Route, command.Dialog, command.Focus, "")
				}
				@CommandOption("command-action-theme-system", "Use System Theme", "Follow the operating system appearance", "dashboard", "Action", "appearance automatic color", "", "", "", "", "system")
				@CommandOption("command-action-theme-light", "Use Light Theme", "Switch Sable to its light appearance", "sun", "Action", "appearance color", "", "", "", "", "light")
				@CommandOption("command-action-theme-dark", "Use Dark Theme", "Switch Sable to its dark appearance", "moon", "Action", "appearance color", "", "", "", "", "dark")
			</section>
		</div>
		<div class="command-palette-empty" role="status" data-command-empty hidden>No matching commands</div>
		<span class="sr-only" aria-live="polite" aria-atomic="true" data-command-status></span>
		<footer class="command-palette-footer" aria-hidden="true"><span data-command-footer-default><kbd>↑</kbd><kbd>↓</kbd> Navigate</span><span data-command-footer-default><kbd>↵</kbd> Run</span><span data-command-footer-default><kbd>Esc</kbd> Close</span><span data-command-footer-search-mode hidden><kbd>←</kbd><kbd>→</kbd> Search by</span><span data-command-footer-search hidden><kbd>↵</kbd> Search</span><span data-command-footer-search hidden><kbd>Esc</kbd> Back</span></footer>
	</dialog>
}

templ CommandOption(id, label, description, icon, kind, keywords, href, route, dialog, focus, theme string) {
	<button type="button" id={ id } role="option" aria-selected="false" tabindex="-1" data-command-item data-command-label={ label } data-command-keywords={ keywords } data-command-href={ href } data-command-route={ route } data-command-dialog={ dialog } data-command-focus={ focus } data-command-theme={ theme }>
		<span class="command-palette-option-icon">
			@Icon(icon)
		</span>
		<span class="command-palette-option-copy"><strong>{ label }</strong><small>{ description }</small></span>
		<span class="command-palette-option-kind">{ kind }</span>
	</button>
}

templ CommandSearchOption(id, label, description, icon, keywords, route, focus, prompt, parameter string) {
	<button type="button" id={ id } role="option" aria-selected="false" tabindex="-1" data-command-item data-command-label={ label } data-command-keywords={ keywords } data-command-route={ route } data-command-focus={ focus } data-command-search="true" data-command-search-prompt={ prompt } data-command-search-param={ parameter }>
		<span class="command-palette-option-icon">
			@Icon(icon)
		</span>
		<span class="command-palette-option-copy"><strong>{ label }</strong><small>{ description }</small></span>
		<span class="command-palette-option-kind">Search</span>
	</button>
}

templ CommandSearchModesOption(id, label, description, icon, keywords, route, primaryLabel, primaryParameter, primaryFocus, primaryPrompt, alternateLabel, alternateParameter, alternateFocus, alternatePrompt string) {
	<button type="button" id={ id } role="option" aria-selected="false" tabindex="-1" data-command-item data-command-label={ label } data-command-keywords={ keywords } data-command-route={ route } data-command-focus={ primaryFocus } data-command-search="true" data-command-search-prompt={ primaryPrompt } data-command-search-param={ primaryParameter } data-command-search-mode-label={ primaryLabel } data-command-search-alt-label={ alternateLabel } data-command-search-alt-param={ alternateParameter } data-command-search-alt-focus={ alternateFocus } data-command-search-alt-prompt={ alternatePrompt }>
		<span class="command-palette-option-icon">
			@Icon(icon)
		</span>
		<span class="command-palette-option-copy"><strong>{ label }</strong><small>{ description }</small></span>
		<span class="command-palette-option-kind">Search</span>
	</button>
}

templ CommandPostOption(id, label, description, icon, keywords, post, values string) {
	<button type="button" id={ id } role="option" aria-selected="false" tabindex="-1" data-command-item data-command-label={ label } data-command-keywords={ keywords } data-command-post={ post } data-command-values={ values }>
		<span class="command-palette-option-icon">
			@Icon(icon)
		</span>
		<span class="command-palette-option-copy"><strong>{ label }</strong><small>{ description }</small></span>
		<span class="command-palette-option-kind">Action</span>
	</button>
}

templ SableMark(extraClass string) {
	<span class={ "brand-mark " + extraClass } aria-hidden="true"><img src={ assetURL("sable-mark.svg") } alt="" width="32" height="32"/></span>
}

templ DNSClientContent(view DNSClientPageView) {
	<div class="dns-client-page page-stack">
		<header class="page-heading">
			<h1>DNS Client</h1>
			<p>Resolve DNS records and diagnose name resolution issues</p>
		</header>
		<div class="page-columns">
			<div class="page-main">
				<section class="card emphasized query-composer">
					<form id="dns-query-form" hx-post="/ui/query" hx-target="#dns-query-result" hx-swap="innerHTML">
						<div class="query-primary-row">
							<div class="search-field">
								<label class="sr-only" for="query-name">Domain name</label>@Icon("search")
								<input id="query-name" name="name" placeholder="Domain name" autocomplete="off" data-query-name required/>
								<button class="query-clear" type="button" data-query-clear aria-label="Clear domain">
									@Icon("x")
								</button>
							</div>
							<label class="sr-only" for="record-type">Record type</label>
							<select id="record-type" name="type" class="record-type-select">
								<option>A</option><option>AAAA</option><option>ANY</option><option>CAA</option><option>CNAME</option><option>DNSKEY</option><option>DS</option><option>HTTPS</option><option>MX</option><option>NAPTR</option><option>NS</option><option>PTR</option><option>SOA</option><option>SRV</option><option>SVCB</option><option>TLSA</option><option>TXT</option>
							</select>
							<button class="button resolve-button" type="submit">
								@Icon("search")
								<span>Resolve</span>
							</button>
						</div>
						<div class="query-options-row">
							<input type="hidden" name="local_server" value={ view.Console.QueryServer }/>
							<div class="resolver-combobox" data-resolver-combobox>
								<input type="hidden" name="resolver" value="this-server" data-resolver-value/>
								<input type="hidden" name="custom_name" data-custom-name/>
								<input type="hidden" name="custom_ip" data-custom-ip/>
								<button class="resolver-trigger" type="button" role="combobox" aria-expanded="false" aria-controls="resolver-command-list" data-resolver-trigger>
									<span data-resolver-label>This Server</span>@Icon("chevrons")
								</button>
								<div class="resolver-popover" data-resolver-popover hidden>
									<label class="resolver-search">
										<span class="sr-only">Search servers</span>@Icon("search")
										<input type="search" placeholder="Search servers..." autocomplete="off" data-resolver-search/>
									</label>
									<div class="resolver-command-list" id="resolver-command-list" role="listbox" data-resolver-list>
										<div class="resolver-empty" data-resolver-empty hidden>No server found.</div>
										@ResolverGroup("Local", localResolverOptions)
										if len(view.ClusterNodes) > 0 {
											@ResolverGroup("Cluster Nodes", view.ClusterNodes)
										}
										@ResolverGroup("Public Resolvers", publicResolverOptions)
										@ResolverGroup("Root Servers", rootResolverOptions)
										<div class="resolver-separator"></div>
										<div class="resolver-group" data-resolver-group>
											<div class="resolver-group-heading">Custom</div>
											<button class="resolver-option" type="button" role="option" data-resolver-option="custom" data-resolver-label-value="" data-resolver-custom-option hidden>
												<span class="resolver-check">
													@Icon("check")
												</span><span class="resolver-option-label" data-resolver-custom-label></span>
											</button>
											<button class="resolver-option resolver-custom-edit" type="button" data-resolver-custom-edit data-search="custom server address">
												<span>Custom...</span>
											</button>
										</div>
									</div>
								</div>
							</div>
							<label class="transport-picker"><span class="sr-only">Protocol</span><select name="transport" data-transport-picker><option value="udp">UDP</option><option value="tcp">TCP</option><option value="tcp-tls">TLS</option><option value="doh">HTTPS</option><option value="quic">QUIC</option></select></label>
							<label class="edns-subnet"><span class="sr-only">EDNS client subnet</span><input name="edns_subnet" placeholder="EDNS subnet" autocomplete="off"/></label>
							<label class="checkbox-field"><input type="checkbox" name="dnssec" value="true"/><span>DNSSEC</span></label>
						</div>
						<dialog class="custom-server-dialog" data-custom-dialog aria-labelledby="custom-server-title" aria-describedby="custom-server-description">
							<div class="dialog-header">
								<h2 id="custom-server-title">Custom DNS Server</h2>
								<p id="custom-server-description">Target a specific server by name, IP, or both. Providing both pins the hostname to that IP — matching how cluster nodes are addressed, and letting TLS/HTTPS/QUIC validate the certificate name.</p>
							</div>
							<button class="dialog-close" type="button" data-custom-cancel aria-label="Close">
								@Icon("x")
							</button>
							<div class="custom-server-fields">
								<label><span>Name <small>(optional)</small></span><input type="text" placeholder="dns.example.com" autocomplete="off" data-custom-name-draft/></label>
								<label><span>IP Address <small>(optional)</small></span><input type="text" placeholder="10.0.7.22" autocomplete="off" data-custom-ip-draft/></label>
								<div class="custom-server-preview" data-custom-preview hidden><span>Server address</span><code data-custom-preview-value></code></div>
							</div>
							<div class="dialog-footer"><button class="button outline" type="button" data-custom-cancel>Cancel</button><button class="button" type="button" data-custom-apply disabled>Use Server</button></div>
						</dialog>
					</form>
				</section>
				<div id="dns-query-result">
					@DNSQueryEmpty()
				</div>
			</div>
			<aside class="page-aside">
				<section class="card guidance-card">
					<div class="guidance-header"><h2>Quick Queries</h2><p data-quick-query-description>Enter a domain, then select a query type</p></div>
					<div class="quick-query-list">
						@QuickQuery("Mail Servers", "MX", "mail")
						@QuickQuery("Name Servers", "NS", "globe")
						@QuickQuery("Text Records", "TXT", "file-text")
						@QuickQuery("IPv4 Address", "A", "hash")
						@QuickQuery("IPv6 Address", "AAAA", "hash")
						@QuickQuery("DNSSEC Keys", "DNSKEY", "shield-check")
					</div>
				</section>
				<section class="card guidance-card">
					<div class="guidance-header"><h2>Understanding Results</h2></div>
					<div class="guidance-list">
						@GuidanceItem("green", "Answer Section", "Direct answers to your query — the records you asked for")
						@GuidanceItem("blue", "Authority Section", "Name servers authoritative for the domain")
						@GuidanceItem("purple", "Additional Section", "Extra records such as name-server addresses")
					</div>
				</section>
				<div class="tip-box"><strong>Tip:</strong> Use "Recursive Resolver" to see the full resolution path, or query external servers like Cloudflare (1.1.1.1) to compare results.</div>
			</aside>
		</div>
	</div>
}

templ ResolverGroup(heading string, options []ResolverOption) {
	<div class="resolver-group" data-resolver-group>
		<div class="resolver-group-heading">{ heading }</div>
		for _, option := range options {
			<button class="resolver-option" type="button" role="option" aria-selected={ fmt.Sprint(option.Value == "this-server") } data-resolver-option={ option.Value } data-resolver-label-value={ option.Label } data-search={ option.SearchText() }>
				<span class="resolver-check">
					@Icon("check")
				</span>
				<span class="resolver-option-copy">
					<span class="resolver-option-label">{ option.Label }</span>
					if option.Detail != "" {
						<small>{ option.Detail }</small>
					}
				</span>
			</button>
		}
	</div>
}

templ QuickQuery(label string, recordType string, icon string) {
	<button class="quick-query" type="button" data-query-type={ recordType } hx-post="/ui/query" hx-include="#dns-query-form" hx-vals={ fmt.Sprintf("{\"type\":%q}", recordType) } hx-target="#dns-query-result" hx-swap="innerHTML">
		@Icon(icon)
		<span>{ label }</span><code>{ recordType }</code>
	</button>
}

templ GuidanceItem(color string, title string, description string) {
	<div class="guidance-item"><i class={ color }></i><div><strong>{ title }</strong><p>{ description }</p></div></div>
}

templ DNSQueryEmpty() {
	<section class="card dns-query-empty">
		@Icon("search")
		<h2>Ready to Query</h2>
		<p>Enter a domain name above and click Resolve to look up DNS records. Use Quick Queries for common lookups.</p>
	</section>
}

// AuthPage renders the sign-in and first-run setup screens. A non-empty
// ssoLabel adds the single sign-on button; an empty one means no provider is
// configured, so the button is absent rather than present and broken.
templ AuthPage(setup bool, errorMessage string, csrfToken string, returnTo string, ssoLabel string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ ifThen(setup, "Set up Sable", "Sign in to Sable") }</title>
			<link rel="icon" href={ assetURL("sable-mark.svg") } type="image/svg+xml"/>
			<link rel="icon" href={ assetURL("sable-icon-180.png") } type="image/png" sizes="180x180"/>
			<link rel="apple-touch-icon" href={ assetURL("sable-icon-180.png") }/>
			<script src={ assetURL("bootstrap.js") }></script>
			<link rel="stylesheet" href={ assetURL("app.css") }/>
			<script src={ assetURL("app.js") } defer></script>
		</head>
		<body class="auth-body">
			<main class="auth-card">
				<div class="auth-logo" aria-hidden="true"><img src={ assetURL("sable-mark.svg") } alt="" width="32" height="32"/></div>
				if setup {
					<h1>Sable</h1>
					<p>Create your administrator account</p>
				} else {
					<h1>Sable</h1>
					<p>Sign in to your Sable DNS server</p>
				}
				if errorMessage != "" {
					<div class="auth-error">{ errorMessage }</div>
				}
				if !setup && ssoLabel != "" {
					<form class="auth-form auth-sso" method="post" action="/auth/oidc/start">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<input type="hidden" name="return_to" value={ returnTo }/>
						<button class="auth-sso-button" type="submit">
							@Icon("key-round")
							<span>Sign in with { ssoLabel }</span>
						</button>
					</form>
					<div class="auth-divider"><span>or</span></div>
				}
				<form class="auth-form" method="post" action={ ifThen(setup, "/setup", "/login") }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					if !setup {
						<input type="hidden" name="return_to" value={ returnTo }/>
					}
					<label><span>Username</span><input name="username" minlength="3" maxlength="64" autocomplete="username" required/></label>
					<label><span>Password</span><input type="password" name="password" minlength="12" maxlength="1024" autocomplete={ ifThen(setup, "new-password", "current-password") } required/></label>
					if setup {
						<label><span>Confirm password</span><input type="password" name="confirm_password" minlength="12" maxlength="1024" autocomplete="new-password" required/></label>
					}
					<button type="submit">{ ifThen(setup, "Create administrator", "Sign in") }</button>
				</form>
			</main>
		</body>
	</html>
}

templ APITokenResult(token string, expires string, errorMessage string) {
	if errorMessage != "" {
		<div class="query-error"><strong>Token creation failed</strong><span>{ errorMessage }</span></div>
	} else {
		<div class="token-created">
			<strong>Copy this token now</strong>
			<div class="copyable-text token-secret">
				<span id="created-api-token">{ token }</span>
				<button type="button" data-copy-target="created-api-token" aria-label="Copy API token" title="Copy API token">
					@CopyIcons()
				</button>
			</div>
			if expires == "" {
				<span>Never expires. Sable stores only its SHA-256 hash.</span>
			} else {
				<span>Expires { expires }. Sable stores only its SHA-256 hash.</span>
			}
		</div>
	}
}

func ifThen(condition bool, whenTrue, whenFalse string) string {
	if condition {
		return whenTrue
	}
	return whenFalse
}

func successfulQueries(view StatsView) uint64 {
	failed := view.Failures + view.UpstreamErrors + view.Blocked
	if failed >= view.Queries {
		return 0
	}
	return view.Queries - failed
}

func percent(value, total uint64) string {
	if total == 0 {
		return "0.00%"
	}
	return fmt.Sprintf("%.2f%%", float64(value)*100/float64(total))
}

func displayUsername(username string) string {
	if username == "" {
		return "Sable"
	}
	return username
}

func brandTooltip(view DashboardView) string {
	if strings.TrimSpace(view.Version) == "" {
		return "Sable"
	}
	return "Sable " + view.Version
}

// AccountAvatar draws the operator's profile picture when one has been synced
// from the identity provider, and their initial when it has not. The image is
// served from Sable's own origin rather than linked to the provider, which is
// what keeps it inside the console's image policy and keeps the provider from
// learning which pages get looked at.
templ AccountAvatar(view DashboardView) {
	if view.AvatarURL != "" {
		<img class="avatar avatar-image" src={ view.AvatarURL } alt="" width="32" height="32"/>
	} else {
		<span class="avatar">{ userInitial(accountDisplayName(view)) }</span>
	}
}

func accountDisplayName(view DashboardView) string {
	if strings.TrimSpace(view.DisplayName) != "" {
		return view.DisplayName
	}
	return displayUsername(view.Username)
}

func userInitial(username string) string {
	username = displayUsername(username)
	return string([]rune(username)[0])
}

func rcodeClass(rcode string) string {
	if strings.EqualFold(rcode, "NOERROR") {
		return "success"
	}
	if strings.EqualFold(rcode, "NXDOMAIN") {
		return "warning"
	}
	return "error"
}

func rcodeDisplay(rcode string) string {
	if strings.EqualFold(rcode, "NOERROR") {
		return "NoError"
	}
	if strings.EqualFold(rcode, "NXDOMAIN") {
		return "NXDomain"
	}
	return rcode
}

templ RecentQueryLog(entries []QueryLogEntryView) {
	if len(entries) == 0 {
		<div class="query-log-empty">No persisted queries yet.</div>
	} else {
		<div class="table-scroll">
			<table class="query-log-table">
				<caption class="sr-only">Recent DNS queries</caption>
				<thead>
					<tr><th>Time</th><th>Name</th><th>Type</th><th>Result</th><th>Source</th><th>Client</th><th>Latency</th></tr>
				</thead>
				<tbody>
					for _, entry := range entries {
						<tr>
							<td>{ entry.OccurredAt }</td>
							<td class="query-name">{ entry.Name }</td>
							<td>{ entry.RecordType }</td>
							<td>{ entry.Status }</td>
							<td><span class="source-pill">{ entry.Source }</span></td>
							<td>{ entry.ClientIP }</td>
							<td>{ entry.Duration }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ Stats(view StatsOverviewView) {
	<section
		id="runtime-stats"
		class="stats-overview"
		aria-labelledby="stats-overview-title"
		data-stats-scope={ view.Scope }
		if view.OutOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		<header class="stats-overview-header">
			<div class="stats-overview-heading">
				<h2 id="stats-overview-title">Overview</h2>
				if view.Scope == StatsScopeRange {
					<span class="stats-range-label">{ view.RangeLabel }</span>
				}
			</div>
			<div class="stats-scope-toggle" role="group" aria-label="Overview time scope">
				@StatsScopeButton("All time", StatsScopeAll, view)
				@StatsScopeButton("Chart range", StatsScopeRange, view)
			</div>
		</header>
		<div class="stats-grid primary-stats">
			@StatCard("Total Queries", formatNumber(view.Values.Queries), "100%", "blue")
			@StatCard("No Error", formatNumber(view.Values.NoError), percent(view.Values.NoError, view.Values.Queries), "green")
			@StatCard("Server Failure", formatNumber(view.Values.ServerFailures), percent(view.Values.ServerFailures, view.Values.Queries), "red")
			@StatCard("NX Domain", formatNumber(view.Values.NXDomain), percent(view.Values.NXDomain, view.Values.Queries), "slate")
			@StatCard("Refused", formatNumber(view.Values.Refused), percent(view.Values.Refused, view.Values.Queries), "teal")
			@StatCard("Authoritative", formatNumber(view.Lifetime.AuthoritativeAnswers), nonRangedStatDetail(percent(view.Lifetime.AuthoritativeAnswers, view.Lifetime.Queries), view.Scope), "sky")
			@StatCard("Recursive", formatNumber(view.Values.Recursive), percent(view.Values.Recursive, view.Values.Queries), "emerald")
			@StatCard("Cached", formatNumber(view.Values.CacheHits), percent(view.Values.CacheHits, view.Values.Queries), "amber")
			@StatCard("Blocked", formatNumber(view.Values.Blocked), percent(view.Values.Blocked, view.Values.Queries), "orange")
			@StatCard("Dropped", formatNumber(view.Lifetime.Dropped), nonRangedStatDetail(percent(view.Lifetime.Dropped, view.Lifetime.Queries), view.Scope), "rose")
			@StatCard("Clients", formatNumber(uint64(view.Lifetime.Clients)), clientsStatDetail(view.Scope), "purple")
			@StatCard("Cache Hit Rate", view.Values.CacheHitRatio, compactNumber(view.Values.CacheHits)+" hits", "cyan")
		</div>
	</section>
	// The chart refresh owns polling so its cards and plot cannot drift apart.
}

templ StatsScopeButton(label string, scope string, view StatsOverviewView) {
	<button
		type="button"
		class={ ifThen(view.Scope == scope, "active", "") }
		aria-pressed={ fmt.Sprint(view.Scope == scope) }
		hx-get={ statsScopeURL(scope, view) }
		hx-target="#query-statistics"
		hx-swap="outerHTML"
		hx-indicator="#dashboard-update-indicator"
	>{ label }</button>
}

func statsScopeURL(scope string, view StatsOverviewView) templ.SafeURL {
	parameters := url.Values{
		"range":          []string{view.RangeName},
		"remember_scope": []string{"1"},
		"stats_scope":    []string{scope},
	}
	if view.RangeName == "custom" {
		parameters.Set("start", view.CustomStart)
		parameters.Set("end", view.CustomEnd)
	}
	return templ.SafeURL("/ui/stats/chart?" + parameters.Encode())
}

func nonRangedStatDetail(detail string, scope string) string {
	if scope == StatsScopeRange {
		return detail + " · all time"
	}
	return detail
}

func clientsStatDetail(scope string) string {
	if scope == StatsScopeRange {
		return "Recent sample · not ranged"
	}
	return "Recent sample"
}

templ QueryChart(view QueryChartView) {
	<section class="card chart-card" id="query-statistics" data-range-root hx-get={ templ.SafeURL("/ui/stats/chart?range=" + view.ActiveRange) } hx-trigger={ ifThen(view.ActiveRange == "custom", "none", "every 10s") } hx-swap="outerHTML" hx-indicator:inherited="#dashboard-update-indicator">
		<div class="card-header chart-header">
			<h2>Query Statistics</h2>
			if view.ActiveRange == "custom" {
				<div class="chart-live">Custom range</div>
			} else {
				<div class={ ifThen(view.Live, "chart-live active", "chart-live") }><span></span>Live</div>
			}
			<div class="range-tabs" role="group" aria-label="Query statistics time range">
				@RangeButton("Hour", "hour", view.ActiveRange)
				@RangeButton("Day", "day", view.ActiveRange)
				@RangeButton("Week", "week", view.ActiveRange)
				@RangeButton("Month", "month", view.ActiveRange)
				@RangeButton("Year", "year", view.ActiveRange)
				<button type="button" id="chart-range-custom" class={ ifThen(view.ActiveRange == "custom", "active", "") } aria-pressed={ fmt.Sprint(view.ActiveRange == "custom") } aria-haspopup="dialog" aria-expanded="false" aria-controls="chart-custom-range" data-range-open>Custom</button>
			</div>
			<label class="range-select">
				<span class="sr-only">Query statistics time range</span>
				<select id="chart-range-select" name="range" aria-label="Query statistics time range" hx-get="/ui/stats/chart?insights=1" hx-trigger="change" hx-target="#query-statistics" hx-swap="outerHTML">
					@RangeOption("Hour", "hour", view.ActiveRange)
					@RangeOption("Day", "day", view.ActiveRange)
					@RangeOption("Week", "week", view.ActiveRange)
					@RangeOption("Month", "month", view.ActiveRange)
					@RangeOption("Year", "year", view.ActiveRange)
				</select>
			</label>
			<button class="range-custom-mobile" id="chart-range-custom-mobile" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="chart-custom-range" data-range-open>Custom</button>
		</div>
		<div class="range-popover chart-range-popover" id="chart-custom-range" role="dialog" aria-label="Custom query range" data-range-popover hidden>
			<form class="range-picker-body" hx-get="/ui/stats/chart?insights=1" hx-target="#query-statistics" hx-swap="outerHTML" data-range-form>
				<input type="hidden" name="range" value="custom"/>
				<input type="hidden" name="start" value={ view.CustomStart } data-range-start required/>
				<input type="hidden" name="end" value={ view.CustomEnd } data-range-end required/>
				@RangeCalendar()
				<div class="range-times">
					<label><span>From</span><input class="time-field" id="custom-range-start-time" type="time" step="60" data-range-start-time required/></label>
					<label><span>To</span><input class="time-field" id="custom-range-end-time" type="time" step="60" data-range-end-time required/></label>
				</div>
				<p class="range-error" role="alert" data-range-error hidden></p>
				<button class="button range-apply" type="submit" data-range-apply>Apply</button>
			</form>
		</div>
		<div class="chart-wrap">
			<div class="chart-plot" data-chart-plot data-chart-points={ view.HoverData } role="img" tabindex="0" aria-label="Query activity chart. Use Left and Right Arrow keys to inspect samples." aria-describedby="query-chart-keyboard-status">
				<svg viewBox="0 0 1200 320" preserveAspectRatio="none" aria-hidden="true">
					<g class="chart-lines"><line x1="58" y1="24" x2="1190" y2="24"></line><line x1="58" y1="92" x2="1190" y2="92"></line><line x1="58" y1="160" x2="1190" y2="160"></line><line x1="58" y1="228" x2="1190" y2="228"></line><line x1="58" y1="296" x2="1190" y2="296"></line></g>
					if view.HasActivity {
						<polyline class="chart-series total" points={ view.Total }></polyline>
						<polyline class="chart-series success" points={ view.Successful }></polyline>
						<polyline class="chart-series server-failure" points={ view.ServerFailure }></polyline>
						<polyline class="chart-series nx-domain" points={ view.NXDomain }></polyline>
						<polyline class="chart-series refused" points={ view.Refused }></polyline>
						<polyline class="chart-series recursive" points={ view.Recursive }></polyline>
						<polyline class="chart-series blocked" points={ view.Blocked }></polyline>
						<polyline class="chart-series cache" points={ view.CacheHits }></polyline>
					}
				</svg>
				<div class="chart-y-labels" aria-hidden="true">
					<span>{ compactNumber(view.Maximum) }</span>
					<span>{ compactNumber(view.Maximum * 3 / 4) }</span>
					<span>{ compactNumber(view.Maximum / 2) }</span>
					<span>{ compactNumber(view.Maximum / 4) }</span>
					<span>0</span>
				</div>
				if view.HasActivity {
					<div class="chart-hover" data-chart-hover-layer aria-hidden="true" hidden></div>
					<div class="chart-tooltip" data-chart-tooltip aria-hidden="true" hidden></div>
				}
				<span class="sr-only" id="query-chart-keyboard-status" aria-live="polite" aria-atomic="true" data-chart-keyboard-status></span>
			</div>
			if !view.HasActivity {
				<div class="chart-empty">{ ifThen(view.Historical, "No queries in this range", "Waiting for query samples") }</div>
			}
			<div class="chart-axis"><span>{ view.StartLabel }</span><span>{ view.EndLabel }</span></div>
		</div>
		<div class="chart-legend"><span class="blue">total</span><span class="green">noError</span><span class="pink">serverFailure</span><span class="gray">nxDomain</span><span class="teal">refused</span><span class="lime">recursive</span><span class="yellow">cached</span><span class="orange">blocked</span></div>
	</section>
}

templ RangeCalendar() {
	<div class="calendar-caption">
		<button type="button" aria-label="Previous month" data-calendar-previous>
			@Icon("chevron-left")
		</button>
		<div class="calendar-dropdowns">
			<label>
				<span class="sr-only">Month</span>
				<select aria-label="Month" data-calendar-month>
					<option value="0">Jan</option><option value="1">Feb</option><option value="2">Mar</option><option value="3">Apr</option><option value="4">May</option><option value="5">Jun</option><option value="6">Jul</option><option value="7">Aug</option><option value="8">Sep</option><option value="9">Oct</option><option value="10">Nov</option><option value="11">Dec</option>
				</select>
			</label>
			<label><span class="sr-only">Year</span><select aria-label="Year" data-calendar-year></select></label>
		</div>
		<button type="button" aria-label="Next month" data-calendar-next>
			@Icon("chevron-right")
		</button>
	</div>
	<div class="calendar-weekdays" aria-hidden="true"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
	<div class="calendar-grid" role="group" aria-label="Choose date range" data-calendar-grid></div>
}

templ RangeButton(label string, value string, active string) {
	// The identifier survives the live refresh: htmx only restores focus to a
	// swapped-in control when it carries the same id as the focused one.
	<button
		type="button"
		id={ "chart-range-" + value }
		class={ ifThen(value == active, "active", "") }
		aria-pressed={ fmt.Sprint(value == active) }
		data-range={ value }
		hx-get={ templ.SafeURL("/ui/stats/chart?insights=1&range=" + value) }
		hx-target="#query-statistics"
		hx-swap="outerHTML"
	>{ label }</button>
}

templ RangeOption(label string, value string, active string) {
	if value == active {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ StatCard(label string, value string, subValue string, color string) {
	<article class={ "stat-card " + color } data-stat-label={ label }>
		<strong data-stat-number="value">{ value }</strong>
		<span data-stat-number="detail">{ subValue }</span>
		<div>{ label }</div>
	</article>
}

templ SummaryCard(label string, value string) {
	<article class="summary-card"><strong>{ value }</strong><span>{ label }</span></article>
}

templ OperationalMetricCard(icon, label, value, description, color string) {
	<article class={ "operational-metric " + color }>
		<div class="operational-metric-label">
			<span>
				@Icon(icon)
			</span><strong>{ label }</strong>
		</div>
		<b>{ value }</b>
		if description != "" {
			<p>{ description }</p>
		}
	</article>
}

templ NavItem(label string, href string, icon string, active bool, disabled bool) {
	if disabled {
		<span class="nav-item disabled" data-tooltip={ label } aria-label={ label }>
			@Icon(icon)
			<span>{ label }</span>
		</span>
	} else {
		<a class={ ifThen(active, "nav-item active", "nav-item") } href={ templ.SafeURL(href) } data-tooltip={ label } aria-label={ label } aria-current={ ifThen(active, "page", "false") }>
			@Icon(icon)
			<span>{ label }</span>
		</a>
	}
}

templ Icon(kind string) {
	<svg class={ "nav-icon icon-" + kind } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch kind {
			case "dashboard":
				<rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect>
			case "globe":
				<circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"></path>
			case "globe-lock":
				<path d="M15.686 15A14.5 14.5 0 0 1 12 22a14.5 14.5 0 0 1 0-20 10 10 0 1 0 9.542 13"></path><path d="M2 12h8.5"></path><path d="M20 6V4a2 2 0 1 0-4 0v2"></path><rect width="8" height="5" x="14" y="6" rx="1"></rect>
			case "database":
				<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5M3 12c0 1.7 4 3 9 3s9-1.3 9-3"></path>
			case "shield-check":
				<path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"></path><path d="m9 12 2 2 4-4"></path>
			case "shield-x":
				<path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"></path><path d="m9.5 9.5 5 5m0-5-5 5"></path>
			case "shield":
				<path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"></path>
			case "shield-off":
				<path d="M4.7 4.7 12 2l8 3v8c0 2.1-.6 3.8-1.6 5.2M9.1 20.8C6 19.2 4 16.8 4 13V5l.5-.2M2 2l20 20"></path>
			case "apps":
				<rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect>
			case "plug":
				<path d="M12 22v-5M9 8V2M15 8V2M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path>
			case "terminal":
				<rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m7 10 2.5 2L7 14M12.5 14h4"></path>
			case "logs":
				<path d="M4 4h12v16H4zM8 8h4M8 12h4M8 16h4"></path><path d="M16 8h4v12h-4"></path>
				// Both names draw the sliders, so a gear never turns up beside one.
			case "settings", "settings-2":
				<path d="M20 7h-9M14 17H5"></path><circle cx="7" cy="7" r="3"></circle><circle cx="17" cy="17" r="3"></circle>
			case "server":
				<rect x="3" y="4" width="18" height="6" rx="2"></rect><rect x="3" y="14" width="18" height="6" rx="2"></rect><path d="M7 7h.01M7 17h.01"></path>
			case "server-plus":
				<path d="M14 10H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5"></path><path d="M14 14H5a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h9"></path><path d="M7 6.5h.01M7 17.5h.01M19 14v7M15.5 17.5h7"></path>
			case "server-crash":
				<path d="M6 10H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"></path><path d="M6 14H4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2h-2"></path><path d="M6 6h.01M6 18h.01M13 6l-4 6h6l-4 6"></path>
				// The bars break either side of the cog so the gear reads clearly at
				// nav size instead of colliding with the rack outlines.
			case "server-cog":
				<path d="M5 10H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-1"></path><path d="M5 14H4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2h-1"></path><path d="M6 6h.01M6 18h.01"></path><circle cx="12" cy="12" r="3"></circle><path d="M12 8v1M12 15v1M16 12h-1M9 12H8"></path><path d="m15 9-.88.88M9.88 14.12 9 15M15 15l-.88-.88M9.88 9.88 9 9"></path>
			case "users":
				<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"></path>
			case "user":
				<path d="M20 21a8 8 0 0 0-16 0"></path><circle cx="12" cy="7" r="4"></circle>
			case "cluster":
				<rect x="16" y="16" width="6" height="6" rx="1"></rect><rect x="2" y="16" width="6" height="6" rx="1"></rect><rect x="9" y="2" width="6" height="6" rx="1"></rect><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"></path><path d="M12 12V8"></path>
			case "crown":
				<path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path><path d="M5 21h14"></path>
			case "info":
				<circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path>
			case "lock":
				<rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"></path>
			case "panel":
				<rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path>
			case "moon":
				<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"></path>
			case "sun":
				<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
			case "chevrons":
				<path d="m7 15 5 5 5-5M7 9l5-5 5 5"></path>
			case "chevron-left":
				<path d="m15 18-6-6 6-6"></path>
			case "chevron-right":
				<path d="m9 18 6-6-6-6"></path>
			case "chevron-up":
				<path d="m18 15-6-6-6 6"></path>
			case "chevrons-left":
				<path d="m11 17-5-5 5-5M18 17l-5-5 5-5"></path>
			case "chevrons-right":
				<path d="m13 17 5-5-5-5M6 17l5-5-5-5"></path>
			case "chevron-down":
				<path d="m6 9 6 6 6-6"></path>
			case "arrow-left":
				<path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path>
			case "arrow-right":
				<path d="m12 5 7 7-7 7"></path><path d="M5 12h14"></path>
			case "arrow-left-right":
				<path d="m8 3-4 4 4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path>
			case "more-vertical":
				<circle cx="12" cy="5" r="1" fill="currentColor" stroke="none"></circle><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"></circle><circle cx="12" cy="19" r="1" fill="currentColor" stroke="none"></circle>
			case "menu":
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "list":
				<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
			case "sliders":
				<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"></path>
			case "filter":
				<path d="M22 3H2l8 9.5V19l4 2v-8.5z"></path>
			case "calendar":
				<rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path>
			case "clock":
				<circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path>
			case "zap":
				<path d="M13 2 3 14h9l-1 8 10-12h-9z"></path>
			case "ban":
				<circle cx="12" cy="12" r="10"></circle><path d="m4.9 4.9 14.2 14.2"></path>
			case "external-link":
				<path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
			case "play":
				<path d="m5 3 14 9-14 9z"></path>
			case "pause":
				<rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect>
			case "upload":
				<path d="M12 16V4M7 9l5-5 5 5"></path><path d="M5 20h14a2 2 0 0 0 2-2v-3M3 15v3a2 2 0 0 0 2 2"></path>
			case "download":
				<path d="M12 4v12M7 11l5 5 5-5"></path><path d="M5 20h14a2 2 0 0 0 2-2"></path>
			case "send":
				<path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path>
			case "search":
				<circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
			case "check":
				<path d="m20 6-11 11-5-5"></path>
			case "x":
				<path d="M18 6 6 18M6 6l12 12"></path>
			case "refresh":
				<path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path><path d="M8 16H3v5"></path>
			case "rotate-ccw":
				<path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path>
			case "folder":
				<path d="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
			case "trash":
				<path d="M3 6h18M8 6V4h8v2M19 6l-1 15H6L5 6M10 11v6M14 11v6"></path>
			case "log-in":
				<path d="m10 17 5-5-5-5M15 12H3"></path><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
			case "log-out":
				<path d="m14 8 4 4-4 4M18 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
			case "sparkles":
				<path d="m12 3-1.4 3.6a2 2 0 0 1-1.2 1.2L6 9l3.4 1.2a2 2 0 0 1 1.2 1.2L12 15l1.4-3.6a2 2 0 0 1 1.2-1.2L18 9l-3.4-1.2a2 2 0 0 1-1.2-1.2z"></path><path d="m5 16-.7 1.8a1 1 0 0 1-.6.6L2 19l1.7.6a1 1 0 0 1 .6.6L5 22l.7-1.8a1 1 0 0 1 .6-.6L8 19l-1.7-.6a1 1 0 0 1-.6-.6zM19 2v4M17 4h4"></path>
			case "copy":
				<rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
			case "key":
				<circle cx="7.5" cy="15.5" r="5.5"></circle><path d="m21 2-9.6 9.6M15.5 7.5l3 3M18.5 4.5l3 3"></path>
			case "wifi-sync":
				<path d="M11.965 10.105v4L13.5 12.5a5 5 0 0 1 8 1.5m-9.535.105h4m2 4h4L20.43 19.71a5 5 0 0 1-8-1.5M2 8.82a15 15 0 0 1 20 0m-.035 13.285v-4M5 12.86a10 10 0 0 1 3-2.032m.5 5.601h.01"></path>
			case "key-round":
				<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
			case "power":
				<path d="M12 2v10"></path><path d="M18.4 6.6a9 9 0 1 1-12.8 0"></path>
			case "check-circle":
				<circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path>
			case "alert-triangle":
				<path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3z"></path><path d="M12 9v4M12 17h.01"></path>
			case "x-circle":
				<circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path>
			case "hard-drive":
				<line x1="22" x2="2" y1="12" y2="12"></line><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path><line x1="6" x2="6.01" y1="16" y2="16"></line><line x1="10" x2="10.01" y1="16" y2="16"></line>
			case "timer":
				<line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle>
			case "flag":
				<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1zM4 22v-7"></path>
			case "file-text":
				<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="8" x2="16" y1="13" y2="13"></line><line x1="8" x2="16" y1="17" y2="17"></line>
			case "mail":
				<rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
			case "hash":
				<line x1="4" x2="20" y1="9" y2="9"></line><line x1="4" x2="20" y1="15" y2="15"></line><line x1="10" x2="8" y1="3" y2="21"></line><line x1="16" x2="14" y1="3" y2="21"></line>
			case "line-chart":
				<path d="M3 3v18h18"></path><path d="m7 16 4-5 4 3 5-7"></path>
			case "layers":
				<path d="m12 2 9 5-9 5-9-5z"></path><path d="m3 12 9 5 9-5"></path><path d="m3 17 9 5 9-5"></path>
		}
	</svg>
}

templ QueryResult(view QueryView) {
	if view.Success {
		<section class="card emphasized dns-result-card">
			<div class="dns-result-header">
				<div>
					<div class="result-status">
						@RCodeIcon(view.RCode)
						<span class={ "rcode " + rcodeClass(view.RCode) }>{ rcodeDisplay(view.RCode) }</span><span>{ view.RecordType } via { view.Server }</span>
					</div>
					<h2>{ view.Question }</h2>
				</div>
				<button class="button outline copy-response" type="button" data-copy-target="dns-query-json">
					@CopyIcons()
					<span data-copy-label>Copy JSON</span>
				</button>
			</div>
			<pre id="dns-query-json" hidden>{ view.JSON }</pre>
			<div class="result-content">
				<div class="result-metadata">
					@MetadataCard("blue", "globe", "Protocol", view.Protocol)
					@MetadataCard("purple", "hard-drive", "Size", view.Size)
					@MetadataCard("green", "timer", "Round Trip", view.Elapsed)
					<div class="metadata-card amber">
						<div class="metadata-label">
							@Icon("flag")
							<span>Flags</span>
						</div>
						<div class="flag-list">
							if len(view.Flags) == 0 {
								<small>None</small>
							}
							for _, flag := range view.Flags {
								<code>{ flag }</code>
							}
						</div>
					</div>
				</div>
				if len(view.Answers) > 0 {
					@RecordSection("Answer", "file-text", view.Answers)
				}
				if len(view.Authority) > 0 {
					@RecordSection("Authority", "shield-check", view.Authority)
				}
				if len(view.Additional) > 0 {
					@RecordSection("Additional", "globe", view.Additional)
				}
				if len(view.Answers) == 0 && len(view.Authority) == 0 && len(view.Additional) == 0 {
					<div class="no-records">
						@Icon("search")
						<h3>No Records Found</h3>
						<p>The query returned no answer, authority, or additional records.</p>
					</div>
				}
				<details class="raw-response"><summary>Raw DNS response</summary><pre id="raw-dns-response">{ view.Response }</pre></details>
			</div>
		</section>
	} else {
		<section class="card query-failure"><div class="query-error"><strong>Query failed</strong><span>{ view.Error }</span></div></section>
	}
}

templ RCodeIcon(rcode string) {
	if strings.EqualFold(rcode, "NOERROR") {
		<span class="rcode-icon success">
			@Icon("check-circle")
		</span>
	} else if strings.EqualFold(rcode, "NXDOMAIN") {
		<span class="rcode-icon warning">
			@Icon("alert-triangle")
		</span>
	} else {
		<span class="rcode-icon error">
			@Icon("x-circle")
		</span>
	}
}

templ CopyIcons() {
	<span class="copy-icon-default">
		@Icon("copy")
	</span>
	<span class="copy-icon-success">
		@Icon("check")
	</span>
}

templ MetadataCard(color string, icon string, label string, value string) {
	<div class={ "metadata-card " + color }>
		<div class="metadata-label">
			@Icon(icon)
			<span>{ label }</span>
		</div><strong>{ value }</strong>
	</div>
}

templ CopyableText(id string, text string, kind string) {
	<div class={ "copyable-text " + kind }>
		<span id={ id }>{ text }</span>
		<button type="button" data-copy-target={ id } aria-label="Copy to clipboard" title="Copy to clipboard">
			@CopyIcons()
		</button>
	</div>
}

templ RecordSection(title string, icon string, records []RecordView) {
	<section class="record-section">
		<h3>
			@Icon(icon)
			<span class="record-section-title">{ title }</span><span>{ fmt.Sprint(len(records)) }</span>
		</h3>
		<div class="record-list">
			for index, record := range records {
				<div class="record-row">
					<code class="record-type">{ record.Type }</code>
					<div class="record-value">
						@CopyableText(fmt.Sprintf("record-%s-%d-name", strings.ToLower(title), index), record.Name, "record-name")
						if record.Data != "" {
							@CopyableText(fmt.Sprintf("record-%s-%d-data", strings.ToLower(title), index), record.Data, "record-data")
						}
					</div>
					<div class="record-ttl"><span>TTL</span><strong>{ fmt.Sprintf("%ds", record.TTL) }</strong></div>
				</div>
			}
		</div>
	</section>
}

templ ActionResult(message string, failed bool) {
	if failed {
		<span class="action-message failed">{ message }</span>
	} else {
		<span class="action-message">{ message }</span>
	}
}
