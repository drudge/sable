package pages

import "github.com/drudge/sable/internal/web/pages/components"

// SettingsInsightsView is the Insights switch at the top of Settings >
// General, with what Insights holds right now.
type SettingsInsightsView struct {
	Enabled bool
	CanEdit bool
	// Data says what Insights holds, such as "46 addresses and 12 hardware
	// addresses, back to Nov 20, 2025." Empty when it holds nothing.
	Data    string
	Message string
	Error   string
}

templ SettingsInsights(view SettingsInsightsView) {
	<div id="settings-insights">
		@Toast(view.Message, "success")
		@Toast(view.Error, "error")
		@SettingsCard("lightbulb", "Insights", "Learn what's on your network and flag changes. All of it stays on this server.") {
			<div class="isotope-card-content settings-insights">
				if view.Enabled {
					// Turning it off asks first, so the switch stays on until the
					// dialog says otherwise.
					@components.SwitchField(components.SwitchFieldProps{ID: "settings-insights-enabled", Title: "Insights", Description: "Record which devices use Sable and what hardware they are.", Checked: true, Disabled: !view.CanEdit, Attrs: templ.Attributes{"id": "settings-insights-switch"}, InputAttrs: templ.Attributes{"data-insights-off": "insights-off-dialog", "data-replica-primary-action": true}})
				} else {
					@components.SwitchField(components.SwitchFieldProps{ID: "settings-insights-enabled", Title: "Insights", Description: "Off. Sable records nothing about your devices.", Name: "enabled", Disabled: !view.CanEdit, Attrs: templ.Attributes{"id": "settings-insights-switch"}, InputAttrs: templ.Attributes{"hx-post": "/ui/settings/insights", "hx-trigger": "change", "hx-target": "#settings-insights", "hx-swap": "outerHTML", "data-replica-primary-action": true}})
				}
				if view.Data != "" {
					<div class="settings-insights-data">
						<p><strong>Device data:</strong> { view.Data }</p>
						if view.CanEdit {
							<button class="button outline destructive" type="button" data-dialog-open="insights-delete-dialog" data-replica-primary-action>@Icon("trash")<span>Delete Insights Data</span></button>
						}
					</div>
				}
			</div>
		}
	</div>
}

// SettingsInsightsDialogs asks before Insights is turned off, and before what
// it collected is deleted.
templ SettingsInsightsDialogs() {
	@components.ConfirmDialog(components.ConfirmDialogProps{
		ID:          "insights-off-dialog",
		TitleID:     "insights-off-title",
		Title:       "Turn Off Insights?",
		Description: "Stop watching the devices on your network",
		Message:     "Sable stops collecting device data and hides Insights. Dashboard names from UniFi and the neighbor table go away.",
		Action:      "Turn Off",
		Form:        templ.Attributes{"data-insights-form": true, "hx-post": "/ui/settings/insights", "hx-target": "#settings-insights", "hx-swap": "outerHTML", "hx-disable": "find button"},
	}) {
		<input type="hidden" name="enabled" value="false"/><label class="settings-insights-delete"><input type="checkbox" name="delete" value="true" checked/><span>Also delete what Insights has collected</span></label>
	}
	@components.ConfirmDialog(components.ConfirmDialogProps{
		ID:          "insights-delete-dialog",
		TitleID:     "insights-delete-title",
		Title:       "Delete Insights Data?",
		Description: "Forget what Insights has learned",
		Message:     "Sable forgets every device it has seen, the hardware behind each address, and the findings you hid. The query log stays.",
		Action:      "Delete Data",
		ActionIcon:  "trash",
		Form:        templ.Attributes{"data-insights-form": true, "hx-post": "/ui/settings/insights/delete", "hx-target": "#settings-insights", "hx-swap": "outerHTML", "hx-disable": "find button"},
	})
}

// InsightsOffPage stands in for Insights while it is turned off, and says
// where to turn it back on.
templ InsightsOffPage(console DashboardView) {
	@AppDocument(console, documentTitle("Insights"), "insights", insightsOffDocument(console))
}

templ insightsOffDocument(console DashboardView) {
	<div class="page-stack insights-off-page">
		<header class="page-heading"><h1>Insights</h1><p>Understand what's happening on your network</p></header>
		<section class="card">
			<div class="cluster-empty-state">
				<span class="cluster-empty-icon">@Icon("lightbulb")</span>
				<h3>Insights Is Off</h3>
				<p>Sable is not recording which devices use it, so there is nothing to show.</p>
				if console.CanSettings {
					<div class="cluster-empty-actions">
						<a class="button" href="/settings?tab=general#settings-insights">@Icon("settings-2")<span>Open Settings</span></a>
					</div>
				}
			</div>
		</section>
	</div>
}
