package pages

import "fmt"
import "strconv"
import "strings"

type IntegrationsPageView struct {
	Console DashboardView
	Message string
	Error   string
	UniFi   UniFiAppView
	SSO     SSOAppView
}

// SSOAppView describes the single sign-on card. Available is false on a
// deployment with authentication switched off, where the card would offer
// something that cannot work.
type SSOAppView struct {
	Available    bool
	Configured   bool
	Enabled      bool
	Label        string
	Issuer       string
	ClientID     string
	RedirectURL  string
	Scopes       string
	GroupsClaim  string
	Provision    bool
	LinkByEmail  bool
	SyncRoles    bool
	DefaultRoles string
	SecretStored bool
	Mappings     []SSOMappingView
	Users        int
	LastSignIn   string
	Check        SSOCheckView
	Wizard       SSOWizardView
}

type SSOMappingView struct {
	Group string
	Role  string
}

// SSOCheckView holds the result of the last test against the provider. It is
// empty until an operator asks for one, because the card must render without
// contacting anything.
type SSOCheckView struct {
	Ran          bool
	Reachable    bool
	Error        string
	SupportsPKCE bool
	EndSession   bool
}

// SSOWizardView is the four-step setup dialog. It carries every answer the
// operator has given so far, because each step is a server round trip: the
// provider step has to contact the issuer before the rest is worth filling in.
type SSOWizardView struct {
	Open  bool
	Step  string
	Error string

	Label       string
	Issuer      string
	ClientID    string
	RedirectURL string

	Scopes        string
	UsernameClaim string
	GroupsClaim   string
	FetchUserInfo bool

	Provision    bool
	LinkByEmail  bool
	SyncRoles    bool
	DefaultRoles string
	Mappings     []SSOMappingView

	// SecretStored reports whether the vault already holds a client secret, so
	// a returning operator is not asked to paste it again.
	SecretStored bool
	// Roles is every Sable role a mapping may point at.
	Roles []string
	// Probe is what the provider said about itself when the first step
	// contacted it.
	Probe SSOProbeView
}

// SSOProbeView is what a provider advertises in its discovery document. The
// claims step shows it so an operator picks a claim the provider actually
// sends rather than guessing at one.
type SSOProbeView struct {
	Ran          bool
	Issuer       string
	Scopes       []string
	Claims       []string
	SupportsPKCE bool
	EndSession   bool
}

type UniFiAppView struct {
	Available             bool
	Configured            bool
	Enabled               bool
	ControllerURL         string
	Site                  string
	Interval              string
	SyncReservations      bool
	SyncActive            bool
	CAFile                string
	Insecure              bool
	CredentialsConfigured bool
	AuthMode              string
	Username              string
	Mappings              []UniFiMappingView
	Status                UniFiStatusView
	Wizard                UniFiWizardView
}

type UniFiMappingView struct {
	ID       string
	Name     string
	Zone     string
	Template string
	TTL      uint32
	Reverse  bool
	Enabled  bool
	Preview  string
}

type UniFiStatusView struct {
	Running      bool
	LastSuccess  string
	NextAttempt  string
	Duration     string
	LastError    string
	Hosts        int
	ZonesCreated int
	Added        int
	Updated      int
	Removed      int
}

type UniFiWizardView struct {
	Open                  bool
	Step                  string
	Error                 string
	ControllerURL         string
	Site                  string
	AuthMode              string
	Username              string
	CAFile                string
	Insecure              bool
	Interval              string
	SyncReservations      bool
	SyncActive            bool
	CredentialsConfigured bool
	Selected              []string
	Networks              []UniFiWizardNetworkView
	ZoneOptions           []string
	Plan                  UniFiPlanView
}

type UniFiWizardNetworkView struct {
	ID           string
	Name         string
	Subnet       string
	Hosts        int
	Selected     bool
	Zone         string
	Template     string
	TTL          uint32
	Reverse      bool
	ReverseZones []string
	Preview      string
}

type UniFiPlanView struct {
	CreatedZones []string
	Publishing   []UniFiPlanRecordView
	Added        []UniFiPlanRecordView
	Updated      []UniFiPlanRecordView
	Removed      []UniFiPlanRecordView
	Skipped      []string
	Hosts        int
	Empty        bool
}

type UniFiPlanRecordView struct {
	Name  string
	Type  string
	Value string
}

templ IntegrationsPage(view IntegrationsPageView) {
	@AppDocument(view.Console, "Integrations", "integrations", IntegrationsContent(view))
}

templ IntegrationsContent(view IntegrationsPageView) {
	<div class="integrations-page page-stack isotope-control-page" id="integrations-content">
		<header class="page-heading"><h1>Integrations</h1><p>Connect Sable to the systems that already know your network, and publish what they know as DNS.</p></header>
		@Toast(view.Message, "success")
		@Toast(view.Error, "error")
		@UniFiCard(view.UniFi)
		if view.SSO.Available {
			@SSOCard(view.SSO)
		}
		if view.UniFi.Available && view.UniFi.Configured {
			@RemoveUniFiDialog()
		}
		if view.UniFi.Wizard.Open {
			@UniFiWizardDialog(view.UniFi)
		}
		if view.SSO.Available && view.SSO.Configured {
			@RemoveSSODialog(view.SSO)
		}
		if view.SSO.Wizard.Open {
			@SSOWizardDialog(view.SSO.Wizard)
		}
	</div>
}

templ SSOCard(view SSOAppView) {
	<section class="card integration-card" id="sso-card">
		<header>
			<div class="integration-card-identity">
				<span class="integration-card-glyph">@Icon("key-round")</span>
				<div>
					<h2>Single Sign-On</h2>
					<p>Signs operators in through an OpenID Connect provider and maps their groups to Sable roles.</p>
				</div>
			</div>
			<span class={ ssoBadgeClass(view) }>{ ssoBadgeLabel(view) }</span>
		</header>
		if !view.Configured {
			<div class="integration-card-body integration-card-empty">
				<p>Point Sable at your identity provider, then decide which of its groups become which Sable roles. Everyone keeps their password until they choose to stop using it.</p>
				<a class="button" href="/integrations?setup=sso">@Icon("plus")<span>Set Up Single Sign-On</span></a>
			</div>
		} else {
			<div class="integration-card-body">
				if view.Check.Ran {
					if view.Check.Reachable {
						<div class="unifi-status">@Icon("shield-check")<div><strong>The provider answered</strong><span>{ ssoCheckSummary(view.Check) }</span></div></div>
					} else {
						<div class="unifi-status error">@Icon("alert-triangle")<div><strong>Could not reach the provider</strong><span>{ view.Check.Error }</span></div></div>
					}
				}
				if !view.SecretStored {
					<div class="unifi-status error">@Icon("alert-triangle")<div><strong>No client secret is stored</strong><span>Sign-in cannot complete until the provider's client secret is saved.</span></div></div>
				}
				<div class="sso-facts">
					<div><span class="sso-fact-label">Provider</span><span class="sso-fact-value">{ view.Label }</span></div>
					<div><span class="sso-fact-label">Issuer</span><span class="sso-fact-value" title={ view.Issuer }>{ ssoIssuerHost(view.Issuer) }</span></div>
					<div><span class="sso-fact-label">Linked accounts</span><span class="sso-fact-value">{ strconv.Itoa(view.Users) }</span></div>
					<div><span class="sso-fact-label">Last sign-in</span><span class="sso-fact-value">{ ssoLastSignIn(view) }</span></div>
				</div>
				@SSOMappingTable(view)
				<div class="integration-card-actions">
					<button class="button outline destructive" type="button" data-dialog-open="remove-sso-dialog">@Icon("trash")<span>Remove</span></button>
					<div class="integration-card-actions-primary">
						<form hx-post="/ui/integrations/sso/check" hx-target="#integrations-content" hx-swap="outerHTML">
							<button class="button outline" type="submit">@Icon("refresh")<span>Test Connection</span></button>
						</form>
						<a class="button outline" href="/integrations?setup=sso">@Icon("settings-2")<span>Edit Setup</span></a>
						if view.Enabled {
							<form hx-post="/ui/integrations/sso/enabled" hx-target="#integrations-content" hx-swap="outerHTML">
								<input type="hidden" name="enabled" value="false"/>
								<button class="button outline" type="submit">@Icon("pause")<span>Disable</span></button>
							</form>
						} else {
							<form hx-post="/ui/integrations/sso/enabled" hx-target="#integrations-content" hx-swap="outerHTML">
								<input type="hidden" name="enabled" value="true"/>
								<button class="button" type="submit">@Icon("play")<span>Enable</span></button>
							</form>
						}
					</div>
				</div>
			</div>
		}
	</section>
}

templ SSOMappingTable(view SSOAppView) {
	if len(view.Mappings) == 0 && view.DefaultRoles == "" {
		<p class="muted-cell">No group grants a role yet, so nobody can sign in through the provider.</p>
	} else {
		<div class="admin-desktop-table">
			<table class="isotope-table">
				<thead><tr><th>Provider Group</th><th>Sable Role</th></tr></thead>
				<tbody>
					for _, mapping := range view.Mappings {
						<tr><td><code>{ mapping.Group }</code></td><td>{ mapping.Role }</td></tr>
					}
					if view.DefaultRoles != "" {
						<tr><td class="muted-cell">Everyone who signs in</td><td>{ view.DefaultRoles }</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ RemoveSSODialog(view SSOAppView) {
	<dialog class="custom-server-dialog confirmation-dialog" id="remove-sso-dialog" aria-labelledby="remove-sso-title">
		<div class="dialog-header"><h2 id="remove-sso-title">Remove Single Sign-On</h2><p>Stop using { view.Label }</p></div>
		<button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		<div class="isotope-dialog-body">
			<p>Sable will forget the provider and delete the stored client secret. Accounts it created stay, along with the link between them and the provider, so reconnecting the same provider picks up where it left off.</p>
			<p>Anyone who turned off password sign-in will not be able to get in until you turn it back on for them from the administration page.</p>
		</div>
		<div class="dialog-footer">
			<button class="button outline" type="button" data-dialog-close>Cancel</button>
			<form hx-post="/ui/integrations/sso/remove" hx-target="#integrations-content" hx-swap="outerHTML">
				<button class="button destructive" type="submit">@Icon("trash")<span>Remove Integration</span></button>
			</form>
		</div>
	</dialog>
}

templ UniFiCard(view UniFiAppView) {
	<section class="card integration-card">
		<header>
			<div class="integration-card-identity">
				<span class="integration-card-glyph">@Icon("wifi-sync")</span>
				<div>
					<h2>UniFi Host Sync</h2>
					<p>Publishes UniFi reservations and connected clients as A, AAAA, and PTR records.</p>
				</div>
			</div>
			<span class={ unifiBadgeClass(view) }>{ unifiBadgeLabel(view) }</span>
		</header>
		if !view.Available {
			<div class="integration-card-body"><p class="muted-cell">The synchronizer is not running on this node.</p></div>
		} else if !view.Configured {
			<div class="integration-card-body integration-card-empty">
				<p>Point Sable at your UniFi controller, choose which networks to publish, and map each one to a zone. Sable creates the forward and reverse zones it needs and keeps them current.</p>
				<a class="button" href="/integrations?setup=unifi">@Icon("plus")<span>Set Up UniFi Sync</span></a>
			</div>
		} else {
			<div class="integration-card-body">
				@UniFiStatusPanel(view)
				<div class="unifi-connection cluster-details">
					<dl>
						<div><dt>Controller</dt><dd>{ view.ControllerURL }</dd></div>
						<div><dt>Site</dt><dd>{ view.Site }</dd></div>
						<div><dt>Interval</dt><dd>{ view.Interval }</dd></div>
						<div><dt>Publishing</dt><dd>{ unifiSourceLabel(view) }</dd></div>
					</dl>
				</div>
				@UniFiMappingTable(view)
				@UniFiCardActions(view, false)
			</div>
		}
	</section>
}

// UniFiCardActions is swapped out of band by the status poll so Sync Now can
// disable itself while a synchronization is in flight.
templ UniFiCardActions(view UniFiAppView, outOfBand bool) {
	if outOfBand {
		<div id="unifi-card-actions" class="integration-card-actions" hx-swap-oob="true">
			@UniFiCardActionButtons(view)
		</div>
	} else {
		<div id="unifi-card-actions" class="integration-card-actions">
			@UniFiCardActionButtons(view)
		</div>
	}
}

templ UniFiCardActionButtons(view UniFiAppView) {
	<button class="button outline destructive" type="button" data-dialog-open="remove-unifi-dialog">@Icon("trash")<span>Remove</span></button>
	<div class="integration-card-actions-primary">
		<a class="button outline" href="/integrations?setup=unifi">@Icon("settings-2")<span>Edit Setup</span></a>
		if view.Enabled {
			<form hx-post="/ui/integrations/unifi/enabled" hx-target="#integrations-content" hx-swap="outerHTML">
				<input type="hidden" name="enabled" value="false"/>
				<button class="button outline" type="submit" disabled?={ view.Status.Running }>@Icon("pause")<span>Pause</span></button>
			</form>
			<form hx-post="/ui/integrations/unifi/sync" hx-target="#integrations-content" hx-swap="outerHTML">
				<button class={ "button", templ.KV("is-syncing", view.Status.Running) } type="submit" disabled?={ view.Status.Running }>@Icon("refresh")<span>{ ifThen(view.Status.Running, "Synchronizing…", "Sync Now") }</span></button>
			</form>
		} else {
			<form hx-post="/ui/integrations/unifi/enabled" hx-target="#integrations-content" hx-swap="outerHTML">
				<input type="hidden" name="enabled" value="true"/>
				<button class="button" type="submit">@Icon("play")<span>Resume</span></button>
			</form>
		}
	</div>
}

templ RemoveUniFiDialog() {
	<dialog class="custom-server-dialog confirmation-dialog" id="remove-unifi-dialog" aria-labelledby="remove-unifi-title">
		<div class="dialog-header"><h2 id="remove-unifi-title">Remove UniFi Host Sync</h2><p>Start over with a clean slate</p></div>
		<button class="dialog-close" type="button" data-dialog-close aria-label="Close">@Icon("x")</button>
		<div class="isotope-dialog-body">
			<p>Sable will forget the controller, delete the stored credentials, and remove every record it published. Zones it created stay, along with anything you added to them by hand.</p>
		</div>
		<div class="dialog-footer">
			<button class="button outline" type="button" data-dialog-close>Cancel</button>
			<form hx-post="/ui/integrations/unifi/remove" hx-target="#integrations-content" hx-swap="outerHTML">
				<button class="button destructive" type="submit">@Icon("trash")<span>Remove Integration</span></button>
			</form>
		</div>
	</dialog>
}

templ UniFiStatusPanel(view UniFiAppView) {
	<div id="unifi-status" hx-get="/ui/integrations/unifi/status" hx-trigger={ unifiStatusPoll(view.Status.Running) } hx-swap="outerHTML">
		if view.Status.LastError != "" {
			<div class="unifi-status error">@Icon("alert-triangle")<div><strong>Last synchronization failed</strong><span>{ view.Status.LastError }</span></div></div>
		}
		<div class="unifi-status-metrics">
			<div><span class="metric-value">{ fmt.Sprint(view.Status.Hosts) }</span><span class="metric-label">Hosts</span></div>
			<div><span class="metric-value">{ fmt.Sprint(view.Status.Added) }</span><span class="metric-label">Added</span></div>
			<div><span class="metric-value">{ fmt.Sprint(view.Status.Updated) }</span><span class="metric-label">Updated</span></div>
			<div><span class="metric-value">{ fmt.Sprint(view.Status.Removed) }</span><span class="metric-label">Removed</span></div>
		</div>
		if view.Status.Running {
			<div class="cluster-sync-indeterminate unifi-progress" role="progressbar" aria-label="Synchronizing with the UniFi controller"></div>
		}
		<p class="unifi-status-line">
			if view.Status.Running {
				@Icon("refresh")
				<span>Synchronizing now…</span>
			} else if view.Status.LastSuccess != "" {
				<span>Last synchronized { view.Status.LastSuccess }</span>
				if view.Status.Duration != "" {
					<span>· took { view.Status.Duration }</span>
				}
				if view.Enabled && view.Status.NextAttempt != "" {
					<span>· next { view.Status.NextAttempt }</span>
				}
			} else if view.Enabled {
				<span>Waiting for the first synchronization.</span>
			} else {
				<span>Synchronization is paused. Records already published are left in place.</span>
			}
		</p>
	</div>
}

templ UniFiMappingTable(view UniFiAppView) {
	<div class="admin-desktop-table">
		<table class="isotope-table unifi-mapping-table">
			<thead><tr><th>UniFi Network</th><th>Zone</th><th>Example Name</th><th>TTL</th><th>Reverse</th><th>State</th></tr></thead>
			<tbody>
				for _, mapping := range view.Mappings {
					<tr>
						<td><strong>{ mapping.Name }</strong></td>
						<td><a href={ templ.SafeURL("/zones/" + mapping.Zone) }>{ mapping.Zone }</a></td>
						<td><code class="muted-cell">{ mapping.Preview }</code></td>
						<td>{ fmt.Sprint(mapping.TTL) }</td>
						<td>{ ifThen(mapping.Reverse, "Yes", "No") }</td>
						<td><span class={ ifThen(mapping.Enabled, "status-badge success", "status-badge") }>{ ifThen(mapping.Enabled, "Active", "Paused") }</span></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ UniFiWizardDialog(view UniFiAppView) {
	<dialog class="custom-server-dialog isotope-form-dialog unifi-wizard-dialog" id="unifi-setup-dialog" aria-labelledby="unifi-setup-title" data-dialog-auto-open="true">
		<div class="dialog-header"><h2 id="unifi-setup-title">Set Up UniFi Host Sync</h2><p>Publish UniFi hosts into zones Sable is authoritative for</p></div>
		<a class="dialog-close" href="/integrations" aria-label="Close">@Icon("x")</a>
		<form hx-post="/ui/integrations/unifi/wizard" hx-target="#integrations-content" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']">
			<div class="isotope-dialog-body">
				@UniFiWizardProgress(view.Wizard.Step)
				if view.Wizard.Error != "" {
					<div class="unifi-status error">@Icon("alert-triangle")<div><strong>{ unifiStepProblem(view.Wizard.Step) }</strong><span>{ view.Wizard.Error }</span></div></div>
				}
				switch view.Wizard.Step {
					case "networks":
						@UniFiWizardNetworksStep(view.Wizard)
					case "zones":
						@UniFiWizardZonesStep(view.Wizard)
					case "review":
						@UniFiWizardReviewStep(view.Wizard)
					default:
						@UniFiWizardConnectStep(view.Wizard)
				}
			</div>
			@UniFiWizardFooter(view.Wizard)
		</form>
	</dialog>
}

templ UniFiWizardProgress(step string) {
	<div class="wizard-progress" aria-label={ fmt.Sprintf("Step %d of 4", unifiStepNumber(step)) }>
		@UniFiWizardStepMarker(step, 1, "connect", "Connect")
		<i></i>
		@UniFiWizardStepMarker(step, 2, "networks", "Networks")
		<i></i>
		@UniFiWizardStepMarker(step, 3, "zones", "Zones")
		<i></i>
		@UniFiWizardStepMarker(step, 4, "review", "Review")
	</div>
}

// UniFiWizardStepMarker renders a finished step as a button so the operator can
// jump straight back to it. formnovalidate keeps a half-filled current step from
// blocking the way back.
templ UniFiWizardStepMarker(step string, position int, target, label string) {
	if unifiStepNumber(step) > position {
		<button class={ unifiStepClass(step, position) } type="submit" name="wizard_target" value={ target } formnovalidate title={ "Back to " + label }>
			<span>&#10003;</span><small>{ label }</small>
		</button>
	} else {
		<div class={ unifiStepClass(step, position) }><span>{ unifiStepMarker(step, position) }</span><small>{ label }</small></div>
	}
}

templ UniFiWizardConnectStep(wizard UniFiWizardView) {
	<input type="hidden" name="wizard_step" value="connect"/>
	<section class="wizard-panel compact">
		<div class="wizard-heading compact"><span>@Icon("server")</span><div><strong>Controller</strong><small>Sable reads networks, reservations, and connected clients. It never writes to UniFi.</small></div></div>
		<div class="field-grid two">
			<label class="field-control"><span>Controller URL</span><input name="controller_url" value={ wizard.ControllerURL } placeholder="https://192.168.1.1" required/></label>
			<label class="field-control"><span>Site</span><input name="site" value={ wizard.Site } placeholder="default" required/></label>
		</div>
		<div class="wizard-heading compact"><span>@Icon("key")</span><div><strong>Authentication</strong><small>Credentials are encrypted in Sable's secret vault.</small></div></div>
		<div class="unifi-auth-modes" data-unifi-auth-root>
			<label class={ "choice-tile", templ.KV("active", wizard.AuthMode != "account") }><input type="radio" name="auth_mode" value="api-key" checked?={ wizard.AuthMode != "account" } data-unifi-auth/><span><strong>API Key</strong><small>Recommended</small></span></label>
			<label class={ "choice-tile", templ.KV("active", wizard.AuthMode == "account") }><input type="radio" name="auth_mode" value="account" checked?={ wizard.AuthMode == "account" } data-unifi-auth/><span><strong>Local Account</strong><small>Older controllers</small></span></label>
		</div>
		<div class="field-grid two" data-unifi-auth-panel="api-key" hidden?={ wizard.AuthMode == "account" }>
			<label class="field-control"><span>API Key</span><input type="password" name="api_key" autocomplete="new-password" placeholder={ ifThen(wizard.CredentialsConfigured, "Configured — leave blank to keep", "UniFi API key") }/><small>Create one in UniFi under Settings → Admins, or Settings → Integrations.</small></label>
		</div>
		<div class="field-grid two" data-unifi-auth-panel="account" hidden?={ wizard.AuthMode != "account" }>
			<label class="field-control"><span>Username</span><input name="username" value={ wizard.Username } autocomplete="off"/></label>
			<label class="field-control"><span>Password</span><input type="password" name="password" autocomplete="new-password" placeholder={ ifThen(wizard.CredentialsConfigured, "Configured — leave blank to keep", "Local account password") }/></label>
		</div>
		<div class="wizard-heading compact"><span>@Icon("lock")</span><div><strong>Certificate Trust</strong><small>UniFi consoles ship a self-signed certificate.</small></div></div>
		<div class="field-grid two">
			<label class="field-control"><span>CA File (optional)</span><input name="tls_ca_file" value={ wizard.CAFile } placeholder="/etc/sable/unifi-ca.pem"/></label>
			<label class="field-control checkbox"><input type="checkbox" name="tls_insecure" value="true" checked?={ wizard.Insecure }/><span>Skip certificate verification</span><small>Pin the issuer above, or accept it unverified on a trusted network.</small></label>
		</div>
	</section>
}

templ UniFiWizardNetworksStep(wizard UniFiWizardView) {
	<input type="hidden" name="wizard_step" value="networks"/>
	@UniFiWizardCarriedConnection(wizard)
	<section class="wizard-panel compact">
		<div class="wizard-heading compact"><span>@Icon("hash")</span><div><strong>Networks</strong><small>Choose the UniFi networks whose hosts should appear in DNS.</small></div></div>
		<div class="admin-desktop-table">
			<table class="isotope-table unifi-network-table">
				<thead><tr><th>Sync</th><th>Network</th><th>Subnet</th><th class="right-cell">Hosts</th></tr></thead>
				<tbody>
					for index, network := range wizard.Networks {
						<tr>
							<td><input id={ unifiNetworkFieldID(index) } type="checkbox" name="network" value={ network.ID } checked?={ network.Selected }/></td>
							<td><label for={ unifiNetworkFieldID(index) }>{ network.Name }</label></td>
							<td><code class="muted-cell">{ ifThen(network.Subnet != "", network.Subnet, "—") }</code></td>
							<td class="right-cell">{ fmt.Sprint(network.Hosts) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<input type="hidden" name="sources_present" value="true"/>
		<div class="wizard-heading compact"><span>@Icon("timer")</span><div><strong>What To Publish</strong><small>A reservation always wins when both describe the same device.</small></div></div>
		<div class="field-grid two">
			<label class="field-control checkbox"><input type="checkbox" name="source_reservations" value="true" checked?={ wizard.SyncReservations }/><span>Fixed-IP reservations</span></label>
			<label class="field-control checkbox"><input type="checkbox" name="source_active" value="true" checked?={ wizard.SyncActive }/><span>Connected clients</span></label>
			<label class="field-control"><span>Sync Interval</span><input name="interval" value={ wizard.Interval } placeholder="2m" required/><small>Go duration, at least 30s.</small></label>
		</div>
	</section>
}

templ UniFiWizardZonesStep(wizard UniFiWizardView) {
	<input type="hidden" name="wizard_step" value="zones"/>
	@UniFiWizardCarriedConnection(wizard)
	@UniFiWizardCarriedPublishing(wizard)
	for _, id := range wizard.Selected {
		<input type="hidden" name="network" value={ id }/>
	}
	<section class="wizard-panel compact">
		<div class="wizard-heading compact"><span>@Icon("globe")</span><div><strong>Zones</strong><small>Map each network to a zone. Sable creates any zone that does not exist yet, and <code>host.network.zone</code> keeps names apart when several networks share one.</small></div></div>
		<div class="unifi-zone-rows" data-unifi-zone-rows>
			for index, network := range wizard.Networks {
				<article class="unifi-zone-row" data-unifi-zone-row>
					<input type="hidden" name={ "network_id_" + strconv.Itoa(index) } value={ network.ID }/>
					<input type="hidden" name={ "network_name_" + strconv.Itoa(index) } value={ network.Name }/>
					<input type="hidden" name={ "network_subnet_" + strconv.Itoa(index) } value={ network.Subnet }/>
					<header><strong>{ network.Name }</strong><code class="muted-cell">{ ifThen(network.Subnet != "", network.Subnet, "no subnet") }</code></header>
					<div class="unifi-zone-fields">
						<label class="field-control"><span>Zone</span><input name={ "zone_" + strconv.Itoa(index) } value={ network.Zone } list="unifi-zone-options" placeholder="clients.example.net" data-unifi-zone required/>
							<small class="unifi-zone-preview">
								if network.Preview != "" {
									Example: <code>{ network.Preview }</code>
								}
							</small>
						</label>
						<label class="field-control"><span>Name Layout</span>
							<select name={ "template_" + strconv.Itoa(index) } data-unifi-template>
								<option value="{{host}}.{{network}}.{{zone}}" selected?={ network.Template != "{{host}}.{{zone}}" }>host.network.zone</option>
								<option value="{{host}}.{{zone}}" selected?={ network.Template == "{{host}}.{{zone}}" }>host.zone</option>
							</select>
						</label>
						<label class="field-control"><span>TTL</span><input type="number" name={ "ttl_" + strconv.Itoa(index) } value={ fmt.Sprint(unifiRowTTL(network.TTL)) } min="1" max="604800"/></label>
					</div>
					<label class="field-control checkbox"><input type="checkbox" name={ "reverse_" + strconv.Itoa(index) } value="true" checked?={ network.Reverse }/><span>Publish PTR records</span>
						if len(network.ReverseZones) > 0 {
							<small>Into { strings.Join(network.ReverseZones, ", ") }</small>
						} else {
							<small>This network reports no subnet, so no reverse zone can be derived.</small>
						}
					</label>
				</article>
			}
		</div>
		<datalist id="unifi-zone-options">
			for _, name := range wizard.ZoneOptions {
				<option value={ name }></option>
			}
		</datalist>
	</section>
}

templ UniFiWizardReviewStep(wizard UniFiWizardView) {
	<input type="hidden" name="wizard_step" value="review"/>
	@UniFiWizardCarriedConnection(wizard)
	@UniFiWizardCarriedPublishing(wizard)
	for _, id := range wizard.Selected {
		<input type="hidden" name="network" value={ id }/>
	}
	for index, network := range wizard.Networks {
		<input type="hidden" name={ "network_id_" + strconv.Itoa(index) } value={ network.ID }/>
		<input type="hidden" name={ "network_name_" + strconv.Itoa(index) } value={ network.Name }/>
		<input type="hidden" name={ "network_subnet_" + strconv.Itoa(index) } value={ network.Subnet }/>
		<input type="hidden" name={ "zone_" + strconv.Itoa(index) } value={ network.Zone }/>
		<input type="hidden" name={ "template_" + strconv.Itoa(index) } value={ network.Template }/>
		<input type="hidden" name={ "ttl_" + strconv.Itoa(index) } value={ fmt.Sprint(unifiRowTTL(network.TTL)) }/>
		if network.Reverse {
			<input type="hidden" name={ "reverse_" + strconv.Itoa(index) } value="true"/>
		}
	}
	<section class="wizard-panel compact">
		<div class="wizard-heading compact"><span>@Icon("list")</span><div><strong>Review</strong><small>This is exactly what the first synchronization will do.</small></div></div>
		<div class="unifi-status-metrics">
			<div><span class="metric-value">{ fmt.Sprint(wizard.Plan.Hosts) }</span><span class="metric-label">Hosts</span></div>
			<div><span class="metric-value">{ fmt.Sprint(len(wizard.Plan.Added)) }</span><span class="metric-label">Added</span></div>
			<div><span class="metric-value">{ fmt.Sprint(len(wizard.Plan.Updated)) }</span><span class="metric-label">Updated</span></div>
			<div><span class="metric-value">{ fmt.Sprint(len(wizard.Plan.Removed)) }</span><span class="metric-label">Removed</span></div>
		</div>
		if len(wizard.Plan.CreatedZones) > 0 {
			<div class="cluster-dialog-note compact">@Icon("plus")<p><strong>Zones Sable will create</strong><span>{ strings.Join(wizard.Plan.CreatedZones, ", ") }</span></p></div>
		}
		if wizard.Plan.Empty {
			<div class="cluster-dialog-note compact">@Icon("info")<p><strong>Nothing to change</strong><span>Every record these networks produce already exists.</span></p></div>
		}
		@UniFiPlanRecords("Records to add", wizard.Plan.Added)
		@UniFiPlanRecords("Records to update", wizard.Plan.Updated)
		@UniFiPlanRecords("Records to remove", wizard.Plan.Removed)
		@UniFiPlanRecords("Everything this mapping publishes", wizard.Plan.Publishing)
		if len(wizard.Plan.Skipped) > 0 {
			<details class="unifi-skipped"><summary>{ fmt.Sprintf("%d entries produced no record", len(wizard.Plan.Skipped)) }</summary><ul>
				for _, entry := range wizard.Plan.Skipped {
					<li>{ entry }</li>
				}
			</ul></details>
		}
		<div class="cluster-dialog-note">@Icon("info")<p><strong>Records Sable publishes are marked as UniFi-owned</strong><span>Synchronization only ever changes records it owns, so anything you add by hand in these zones is left alone.</span></p></div>
	</section>
}

templ UniFiPlanRecords(title string, records []UniFiPlanRecordView) {
	if len(records) > 0 {
		<details class="unifi-plan-records" open?={ len(records) <= 12 }>
			<summary>{ fmt.Sprintf("%s (%d)", title, len(records)) }</summary>
			<div class="admin-desktop-table">
				<table class="isotope-table">
					<thead><tr><th>Name</th><th>Type</th><th>Value</th></tr></thead>
					<tbody>
						for _, record := range records {
							<tr><td><code>{ record.Name }</code></td><td>{ record.Type }</td><td><code>{ record.Value }</code></td></tr>
						}
					</tbody>
				</table>
			</div>
		</details>
	}
}

// UniFiWizardCarriedConnection re-posts the connection choices on every step.
// Secrets are deliberately absent: the connection step seals them in the vault
// and later steps read them back from there.
templ UniFiWizardCarriedConnection(wizard UniFiWizardView) {
	<input type="hidden" name="controller_url" value={ wizard.ControllerURL }/>
	<input type="hidden" name="site" value={ wizard.Site }/>
	<input type="hidden" name="auth_mode" value={ wizard.AuthMode }/>
	<input type="hidden" name="username" value={ wizard.Username }/>
	<input type="hidden" name="tls_ca_file" value={ wizard.CAFile }/>
	if wizard.Insecure {
		<input type="hidden" name="tls_insecure" value="true"/>
	}
}

// UniFiWizardCarriedPublishing re-posts the publishing choices on the steps
// after the one that collects them.
templ UniFiWizardCarriedPublishing(wizard UniFiWizardView) {
	<input type="hidden" name="sources_present" value="true"/>
	<input type="hidden" name="interval" value={ wizard.Interval }/>
	if wizard.SyncReservations {
		<input type="hidden" name="source_reservations" value="true"/>
	}
	if wizard.SyncActive {
		<input type="hidden" name="source_active" value="true"/>
	}
}

templ UniFiWizardFooter(wizard UniFiWizardView) {
	<div class="dialog-footer wizard-footer">
		<a class="button outline" href="/integrations">Cancel</a>
		<div class="wizard-footer-advance">
			if unifiPreviousStep(wizard.Step) != "" {
				<button class="button outline" type="submit" name="wizard_target" value={ unifiPreviousStep(wizard.Step) } formnovalidate>@Icon("arrow-left")<span>Back</span></button>
			}
			if wizard.Step == "review" {
				<button class="button" type="submit">@Icon("check")<span>Enable Synchronization</span></button>
			} else {
				<button class="button" type="submit">@Icon("arrow-right")<span>{ unifiNextLabel(wizard.Step) }</span></button>
			}
		</div>
	</div>
}

func unifiStepNumber(step string) int {
	switch step {
	case "networks":
		return 2
	case "zones":
		return 3
	case "review":
		return 4
	default:
		return 1
	}
}

func unifiStepClass(step string, position int) string {
	current := unifiStepNumber(step)
	if current > position {
		return "complete"
	}
	if current == position {
		return "current"
	}
	return ""
}

func unifiStepMarker(step string, position int) string {
	if unifiStepNumber(step) > position {
		return "✓"
	}
	return strconv.Itoa(position)
}

func unifiNextLabel(step string) string {
	switch step {
	case "networks":
		return "Map Zones"
	case "zones":
		return "Review Changes"
	default:
		return "Connect"
	}
}

func unifiPreviousStep(step string) string {
	switch step {
	case "networks":
		return "connect"
	case "zones":
		return "networks"
	case "review":
		return "zones"
	default:
		return ""
	}
}

func unifiStepProblem(step string) string {
	switch step {
	case "networks":
		return "Choose at least one network"
	case "zones":
		return "Check the zone mapping"
	default:
		return "Could not reach the controller"
	}
}

// unifiStatusPoll tightens the refresh while a synchronization is in flight so
// the spinner and progress bar clear promptly, and backs off when idle.
func unifiStatusPoll(running bool) string {
	if running {
		return "every 1s"
	}
	return "every 10s"
}

func unifiNetworkFieldID(index int) string {
	return "unifi-network-" + strconv.Itoa(index)
}

func unifiRowTTL(ttl uint32) uint32 {
	if ttl == 0 {
		return 300
	}
	return ttl
}

func unifiBadgeClass(view UniFiAppView) string {
	switch {
	case !view.Configured:
		return "status-badge"
	case view.Status.LastError != "":
		return "status-badge danger"
	case view.Enabled:
		return "status-badge success"
	default:
		return "status-badge"
	}
}

func unifiBadgeLabel(view UniFiAppView) string {
	switch {
	case !view.Available:
		return "Unavailable"
	case !view.Configured:
		return "Not set up"
	case view.Status.LastError != "":
		return "Needs attention"
	case view.Enabled:
		return "Active"
	default:
		return "Paused"
	}
}

func unifiSourceLabel(view UniFiAppView) string {
	switch {
	case view.SyncReservations && view.SyncActive:
		return "Reservations and connected clients"
	case view.SyncReservations:
		return "Reservations only"
	case view.SyncActive:
		return "Connected clients only"
	default:
		return "Nothing selected"
	}
}

// SSOPreset prefills the provider fields that differ between vendors. Only the
// claim names and scopes vary in practice; everything else is per-deployment.
type SSOPreset struct {
	Key         string
	Name        string
	Scopes      string
	GroupsClaim string
	UsernameKey string
}

// SSOPresets lists the providers Sable ships defaults for. Generic is last
// because it is the fallback rather than a recommendation.
func SSOPresets() []SSOPreset {
	return []SSOPreset{
		{Key: "pocket-id", Name: "Pocket ID", Scopes: "openid profile email groups", GroupsClaim: "groups", UsernameKey: "preferred_username"},
		{Key: "authentik", Name: "Authentik", Scopes: "openid profile email", GroupsClaim: "groups", UsernameKey: "preferred_username"},
		{Key: "keycloak", Name: "Keycloak", Scopes: "openid profile email roles", GroupsClaim: "groups", UsernameKey: "preferred_username"},
		{Key: "entra", Name: "Entra ID", Scopes: "openid profile email", GroupsClaim: "groups", UsernameKey: "preferred_username"},
		{Key: "google", Name: "Google", Scopes: "openid profile email", GroupsClaim: "groups", UsernameKey: "email"},
		{Key: "generic", Name: "Generic", Scopes: "openid profile email groups", GroupsClaim: "groups", UsernameKey: "preferred_username"},
	}
}

func ssoBadgeClass(view SSOAppView) string {
	switch {
	case !view.Configured:
		return "status-badge"
	case !view.SecretStored:
		return "status-badge danger"
	case view.Enabled:
		return "status-badge success"
	default:
		return "status-badge"
	}
}

func ssoBadgeLabel(view SSOAppView) string {
	switch {
	case !view.Configured:
		return "Not set up"
	case !view.SecretStored:
		return "Needs attention"
	case view.Enabled:
		return "Active"
	default:
		return "Paused"
	}
}

func ssoProvisionLabel(view SSOAppView) string {
	switch {
	case view.Provision && view.LinkByEmail:
		return "Created on first sign-in, or attached by verified email"
	case view.Provision:
		return "Created on first sign-in"
	case view.LinkByEmail:
		return "Attached to existing accounts by verified email"
	default:
		return "Existing links only"
	}
}

func ssoLastSignIn(view SSOAppView) string {
	if view.LastSignIn == "" {
		return "Never"
	}
	return view.LastSignIn
}

func ssoSecretPlaceholder(view SSOAppView) string {
	if view.SecretStored {
		return "Stored. Leave blank to keep it."
	}
	return "Paste the client secret"
}

func ssoCheckSummary(check SSOCheckView) string {
	parts := []string{"Discovery and signing keys were read"}
	if check.SupportsPKCE {
		parts = append(parts, "PKCE is supported")
	} else {
		parts = append(parts, "PKCE is not advertised")
	}
	if check.EndSession {
		parts = append(parts, "single logout is available")
	}
	return strings.Join(parts, ", ") + "."
}



templ SSOWizardDialog(wizard SSOWizardView) {
	<dialog class="custom-server-dialog isotope-form-dialog unifi-wizard-dialog sso-wizard-dialog" id="sso-setup-dialog" aria-labelledby="sso-setup-title" data-dialog-auto-open="true">
		<div class="dialog-header"><h2 id="sso-setup-title">Set Up Single Sign-On</h2><p>{ ssoWizardSubtitle(wizard.Step) }</p></div>
		<a class="dialog-close" href="/integrations" aria-label="Close">@Icon("x")</a>
		<form hx-post="/ui/integrations/sso/wizard" hx-target="#integrations-content" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']">
			<div class="isotope-dialog-body">
				@SSOWizardProgress(wizard.Step)
				if wizard.Error != "" {
					<div class="unifi-status error">@Icon("alert-triangle")<div><strong>{ ssoStepProblem(wizard.Step) }</strong><span>{ wizard.Error }</span></div></div>
				}
				switch wizard.Step {
					case SSOStepClaims:
						@SSOWizardClaimsStep(wizard)
					case SSOStepRoles:
						@SSOWizardRolesStep(wizard)
					case SSOStepReview:
						@SSOWizardReviewStep(wizard)
					default:
						@SSOWizardProviderStep(wizard)
				}
			</div>
			@SSOWizardFooter(wizard)
		</form>
	</dialog>
}

templ SSOWizardProgress(step string) {
	<div class="wizard-progress" aria-label={ fmt.Sprintf("Step %d of 4", ssoStepIndex(step)) }>
		@SSOWizardStepMarker(step, 1, SSOStepProvider, "Provider")
		<i></i>
		@SSOWizardStepMarker(step, 2, SSOStepClaims, "Claims")
		<i></i>
		@SSOWizardStepMarker(step, 3, SSOStepRoles, "Roles")
		<i></i>
		@SSOWizardStepMarker(step, 4, SSOStepReview, "Review")
	</div>
}

// SSOWizardStepMarker renders a finished step as a button so the operator can
// jump straight back to it. formnovalidate keeps a half-filled current step
// from blocking the way back.
templ SSOWizardStepMarker(step string, position int, target, label string) {
	if ssoStepIndex(step) > position {
		<button class={ ssoStepClass(step, position) } type="submit" name="wizard_target" value={ target } formnovalidate title={ "Back to " + label }>
			<span>&#10003;</span><small>{ label }</small>
		</button>
	} else {
		<div class={ ssoStepClass(step, position) }><span>{ ssoStepMarker(step, position) }</span><small>{ label }</small></div>
	}
}

templ SSOWizardProviderStep(wizard SSOWizardView) {
	<div class="sso-presets">
		<span>Start from</span>
		for _, preset := range SSOPresets() {
			<button class="button outline" type="button" data-sso-preset={ preset.Key }>{ preset.Name }</button>
		}
	</div>
	<label>
		<span>Issuer URL</span>
		<input name="issuer" value={ wizard.Issuer } placeholder="https://id.example.com" required autofocus/>
		<small>Sable reads { "/.well-known/openid-configuration" } under this address when you continue.</small>
	</label>
	<div class="sso-field-row">
		<label>
			<span>Client ID</span>
			<input name="client_id" value={ wizard.ClientID } required/>
		</label>
		<label>
			<span>Client secret</span>
			<input type="password" name="client_secret" autocomplete="new-password" placeholder={ ssoWizardSecretPlaceholder(wizard) }/>
		</label>
	</div>
	<label>
		<span>Redirect URL</span>
		<input name="redirect_url" value={ wizard.RedirectURL } required/>
		<small>Add this exact address to the application at your provider before continuing. The secret is sealed in the encrypted vault, never written to sable.toml.</small>
	</label>
	<label>
		<span>Display name</span>
		<input name="display_name" value={ wizard.Label } placeholder="Single sign-on" maxlength="64"/>
		<small>Shown on the sign-in button.</small>
	</label>
	<input type="hidden" name="scopes" value={ wizard.Scopes }/>
	<input type="hidden" name="username_claim" value={ wizard.UsernameClaim }/>
	<input type="hidden" name="groups_claim" value={ wizard.GroupsClaim }/>
}

templ SSOWizardClaimsStep(wizard SSOWizardView) {
	if wizard.Probe.Ran {
		<div class="unifi-status">
			@Icon("shield-check")
			<div>
				<strong>{ wizard.Probe.Issuer } answered</strong>
				<span>{ ssoProbeSummary(wizard.Probe) }</span>
			</div>
		</div>
	}
	<label>
		<span>Scopes</span>
		<input name="scopes" value={ wizard.Scopes } placeholder="openid profile email groups" required/>
		if len(wizard.Probe.Scopes) > 0 {
			<small>The provider advertises: { strings.Join(wizard.Probe.Scopes, ", ") }</small>
		} else {
			<small>Ask for the scope that carries group membership, or the groups claim will arrive empty.</small>
		}
	</label>
	<div class="sso-field-row">
		<label>
			<span>Username claim</span>
			<input name="username_claim" value={ wizard.UsernameClaim } placeholder="preferred_username"/>
		</label>
		<label>
			<span>Groups claim</span>
			<input name="groups_claim" value={ wizard.GroupsClaim } placeholder="groups"/>
		</label>
	</div>
	if len(wizard.Probe.Claims) > 0 {
		<p class="muted-cell">Claims the provider says it can send: { strings.Join(wizard.Probe.Claims, ", ") }</p>
	}
	<label class="checkbox">
		<input type="checkbox" name="fetch_userinfo" value="true" checked?={ wizard.FetchUserInfo }/>
		<span>Ask the UserInfo endpoint for claims the token leaves out</span>
	</label>
	@SSOWizardCarriedProvider(wizard)
}

templ SSOWizardRolesStep(wizard SSOWizardView) {
	<fieldset class="sso-toggles">
		<legend>Accounts</legend>
		<label class="checkbox"><input type="checkbox" name="provision" value="true" checked?={ wizard.Provision }/><span>Create a Sable account the first time someone signs in</span></label>
		<label class="checkbox"><input type="checkbox" name="link_by_email" value="true" checked?={ wizard.LinkByEmail }/><span>Attach a first sign-in to an existing account with the same verified email</span></label>
		<label class="checkbox"><input type="checkbox" name="sync_roles" value="true" checked?={ wizard.SyncRoles }/><span>Update roles from the provider's groups on every sign-in</span></label>
	</fieldset>
	<label>
		<span>Roles everyone gets</span>
		<input name="default_roles" value={ wizard.DefaultRoles } placeholder="Auditor"/>
		<small>Comma separated. Leave blank to grant nothing by default.</small>
	</label>
	<fieldset class="sso-mappings">
		<legend>Group to role</legend>
		<p class="muted-cell">Type the group name exactly as your provider sends it in the <code>{ wizard.GroupsClaim }</code> claim.</p>
		for index, mapping := range ssoWizardRows(wizard) {
			<div class="sso-mapping-row">
				<input name="mapping_group" value={ mapping.Group } placeholder="dns-admins" aria-label={ fmt.Sprintf("Provider group %d", index+1) }/>
				@Icon("arrow-right")
				<select name="mapping_role" aria-label={ fmt.Sprintf("Sable role %d", index+1) }>
					<option value="">No role</option>
					for _, role := range wizard.Roles {
						<option value={ role } selected?={ role == mapping.Role }>{ role }</option>
					}
				</select>
			</div>
		}
		<small>Leave a row blank to drop it. Rows are added as you fill the last one.</small>
	</fieldset>
	@SSOWizardCarriedProvider(wizard)
	@SSOWizardCarriedClaims(wizard)
}

templ SSOWizardReviewStep(wizard SSOWizardView) {
	<div class="sso-facts">
		<div><span class="sso-fact-label">Provider</span><span class="sso-fact-value">{ wizard.Label }</span></div>
		<div><span class="sso-fact-label">Issuer</span><span class="sso-fact-value" title={ wizard.Issuer }>{ ssoIssuerHost(wizard.Issuer) }</span></div>
		<div><span class="sso-fact-label">Client ID</span><span class="sso-fact-value" title={ wizard.ClientID }>{ wizard.ClientID }</span></div>
		<div><span class="sso-fact-label">Groups claim</span><span class="sso-fact-value">{ wizard.GroupsClaim }</span></div>
	</div>
	if len(wizard.Mappings) == 0 && wizard.DefaultRoles == "" {
		<div class="unifi-status error">
			@Icon("alert-triangle")
			<div><strong>Nobody can sign in yet</strong><span>No group grants a role and there is no default role, so every sign-in is refused.</span></div>
		</div>
	} else {
		<div class="admin-desktop-table">
			<table class="isotope-table">
				<thead><tr><th>Provider Group</th><th>Sable Role</th></tr></thead>
				<tbody>
					for _, mapping := range wizard.Mappings {
						<tr><td><code>{ mapping.Group }</code></td><td>{ mapping.Role }</td></tr>
					}
					if wizard.DefaultRoles != "" {
						<tr><td class="muted-cell">Everyone who signs in</td><td>{ wizard.DefaultRoles }</td></tr>
					}
				</tbody>
			</table>
		</div>
	}
	<p class="muted-cell sso-review-note">{ ssoWizardProvisionSummary(wizard) }. Nobody loses their password; each person switches to SSO only from the administration page.</p>
	@SSOWizardCarriedProvider(wizard)
	@SSOWizardCarriedClaims(wizard)
	@SSOWizardCarriedRoles(wizard)
}

templ SSOWizardFooter(wizard SSOWizardView) {
	<div class="dialog-footer wizard-footer">
		<input type="hidden" name="wizard_step" value={ wizard.Step }/>
		if wizard.Step == SSOStepProvider {
			<a class="button outline" href="/integrations">Cancel</a>
		} else {
			<button class="button outline" type="submit" name="wizard_target" value={ ssoPreviousStep(wizard.Step) }>Back</button>
		}
		<button class="button" type="submit">
			if wizard.Step == SSOStepReview {
				@Icon("check")
				<span>Enable Single Sign-On</span>
			} else {
				<span>Continue</span>
				@Icon("arrow-right")
			}
		</button>
	</div>
}

// SSOWizardCarriedProvider re-posts the provider answers on every later step,
// because each step is its own form submission.
templ SSOWizardCarriedProvider(wizard SSOWizardView) {
	<input type="hidden" name="display_name" value={ wizard.Label }/>
	<input type="hidden" name="issuer" value={ wizard.Issuer }/>
	<input type="hidden" name="client_id" value={ wizard.ClientID }/>
	<input type="hidden" name="redirect_url" value={ wizard.RedirectURL }/>
}

templ SSOWizardCarriedClaims(wizard SSOWizardView) {
	<input type="hidden" name="claims_present" value="true"/>
	<input type="hidden" name="scopes" value={ wizard.Scopes }/>
	<input type="hidden" name="username_claim" value={ wizard.UsernameClaim }/>
	<input type="hidden" name="groups_claim" value={ wizard.GroupsClaim }/>
	if wizard.FetchUserInfo {
		<input type="hidden" name="fetch_userinfo" value="true"/>
	}
}

templ SSOWizardCarriedRoles(wizard SSOWizardView) {
	<input type="hidden" name="roles_present" value="true"/>
	<input type="hidden" name="default_roles" value={ wizard.DefaultRoles }/>
	if wizard.Provision {
		<input type="hidden" name="provision" value="true"/>
	}
	if wizard.LinkByEmail {
		<input type="hidden" name="link_by_email" value="true"/>
	}
	if wizard.SyncRoles {
		<input type="hidden" name="sync_roles" value="true"/>
	}
	for _, mapping := range wizard.Mappings {
		<input type="hidden" name="mapping_group" value={ mapping.Group }/>
		<input type="hidden" name="mapping_role" value={ mapping.Role }/>
	}
}

// The wizard's steps, named the same way the UniFi wizard names its own.
const (
	SSOStepProvider = "provider"
	SSOStepClaims   = "claims"
	SSOStepRoles    = "roles"
	SSOStepReview   = "review"
)

func ssoStepIndex(step string) int {
	switch step {
	case SSOStepClaims:
		return 2
	case SSOStepRoles:
		return 3
	case SSOStepReview:
		return 4
	default:
		return 1
	}
}

func ssoStepClass(step string, position int) string {
	current := ssoStepIndex(step)
	if current > position {
		return "complete"
	}
	if current == position {
		return "current"
	}
	return ""
}

func ssoStepMarker(step string, position int) string {
	if ssoStepIndex(step) > position {
		return "\u2713"
	}
	return strconv.Itoa(position)
}

func ssoPreviousStep(step string) string {
	switch step {
	case SSOStepReview:
		return SSOStepRoles
	case SSOStepRoles:
		return SSOStepClaims
	default:
		return SSOStepProvider
	}
}

func ssoWizardSubtitle(step string) string {
	switch step {
	case SSOStepClaims:
		return "Tell Sable which claims carry the username and the groups"
	case SSOStepRoles:
		return "Decide who gets in and what they can do"
	case SSOStepReview:
		return "Check it over before anyone can use it"
	default:
		return "Point Sable at your identity provider"
	}
}

func ssoWizardSecretPlaceholder(wizard SSOWizardView) string {
	if wizard.SecretStored {
		return "Stored. Leave blank to keep it."
	}
	return "Paste the client secret"
}

func ssoProbeSummary(probe SSOProbeView) string {
	parts := []string{"Discovery and signing keys were read"}
	if probe.SupportsPKCE {
		parts = append(parts, "PKCE is supported")
	} else {
		parts = append(parts, "PKCE is not advertised, but Sable sends it anyway")
	}
	if probe.EndSession {
		parts = append(parts, "single logout is available")
	}
	return strings.Join(parts, ", ") + "."
}

func ssoWizardProvisionSummary(wizard SSOWizardView) string {
	switch {
	case wizard.Provision && wizard.LinkByEmail:
		return "Created on first sign-in, or attached to an existing account by verified email"
	case wizard.Provision:
		return "Created on first sign-in"
	case wizard.LinkByEmail:
		return "Attached to existing accounts by verified email"
	default:
		return "Existing links only"
	}
}

// ssoWizardRows always leaves one empty row so a mapping can be added without
// a separate button and another round trip.
func ssoWizardRows(wizard SSOWizardView) []SSOMappingView {
	rows := append([]SSOMappingView(nil), wizard.Mappings...)
	return append(rows, SSOMappingView{})
}

// ssoStepProblem names what went wrong in the terms of the step the operator
// is actually looking at.
func ssoStepProblem(step string) string {
	switch step {
	case SSOStepClaims:
		return "Those claim settings were not accepted"
	case SSOStepRoles:
		return "Those role settings were not accepted"
	case SSOStepReview:
		return "Single sign-on could not be saved"
	default:
		return "Sable could not reach that provider"
	}
}

// ssoIssuerHost shortens the issuer to its host for the card. The full value
// stays in the title attribute, because a tenant path is what distinguishes
// two providers on the same hostname.
func ssoIssuerHost(issuer string) string {
	trimmed := strings.TrimPrefix(strings.TrimPrefix(issuer, "https://"), "http://")
	if host, _, found := strings.Cut(trimmed, "/"); found && host != "" {
		return host
	}
	return trimmed
}
