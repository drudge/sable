package pages

import (
	"fmt"
	"net/url"
	"slices"
	"strings"

	"github.com/drudge/sable/internal/web/pages/components"
)

// RuleSetView is one blocking rule set and the devices that use it.
type RuleSetView struct {
	Name string
	// Off says the rule set turns blocking off for its devices.
	Off            bool
	Lists          []string
	Domains        []string
	AllowedDomains []string
	// Apps are the apps the rule set blocks, by name.
	Apps    []RuleSetApp
	Devices []RuleSetDevice
}

// RuleSetApp is one app a rule set can block.
type RuleSetApp struct {
	ID       string
	Name     string
	Category string
	// Chosen marks an app the rule set blocks, in the app picker.
	Chosen bool
}

// RuleSetAppGroup is one category of apps in the app picker.
type RuleSetAppGroup struct {
	Category string
	Apps     []RuleSetApp
}

// RuleSetAppPickerView fills a rule set's panel with every app it can block,
// each one checked when the rule set blocks it.
type RuleSetAppPickerView struct {
	Name   string
	Groups []RuleSetAppGroup
}

// RuleSetDevice is one device, address, or network in a rule set.
type RuleSetDevice struct {
	// Label is the name the operator or UniFi gave the device, or Entry when
	// it has none.
	Label string
	// Entry is the hardware address, IP address, or network that puts the
	// device in the rule set.
	Entry string
	// Kind is "mac", "address", or "network", for how Entry is described.
	Kind string
	// Type is the kind of device the operator set, for its icon.
	Type string
}

// RuleSetDeviceOption is a device Sable has seen, offered when adding one to
// a rule set: Value is what the form sends, Label how it reads.
type RuleSetDeviceOption struct {
	Value string
	Label string
}

// RuleSetFormView fills the rule set dialog. Default edits the block lists
// for devices without a rule set instead of a rule set.
type RuleSetFormView struct {
	Default bool
	// Original is the name of the rule set being edited, empty for a new one.
	Original string
	Set      RuleSetView
	// Lists names every configured block list, in order.
	Lists []string
	// DefaultLists is the default policy's choice; empty means every list.
	DefaultLists []string
}

// RuleSetsPanel is the Blocking tab for rule sets: the default policy, then
// each rule set.
templ RuleSetsPanel(view BlockingPageView) {
	<div class="blocking-panel rule-set-panel" id="blocking-panel-rule-sets" role="tabpanel" aria-labelledby="blocking-tab-rule-sets" data-blocking-panel="rule-sets" hidden?={ view.ActiveTab != "rule-sets" }>
		<div class="blocking-list-toolbar rule-set-toolbar">
			<p class="field-help">Give some devices their own block lists and domains, or turn blocking off for them. Open a rule set to add its devices.</p>
			@components.Button(components.ButtonProps{Label: "Add Rule Set", Icon: "plus", Attrs: ruleSetFormAttrs("/ui/blocking/rule-sets/form", "rule-set-add")})
		</div>
		<div class="blocking-source-list rule-set-list">
			<article class="blocking-source-row rule-set-row" data-rule-set="Default">
				<span class="blocking-source-icon">@Icon("shield")</span>
				<div>
					<strong class="rule-set-name">Default</strong>
					<small>{ defaultListsSummary(view.DefaultLists) }</small>
					<small>Every device without a rule set</small>
				</div>
				@components.Button(components.ButtonProps{Label: "Edit", Icon: "pencil", Variant: components.ButtonOutline, Compact: true, Attrs: ruleSetFormAttrs("/ui/blocking/rule-sets/form?default=1", "rule-set-edit-default", "aria-label", "Edit Default")})
			</article>
			for index, set := range view.RuleSets {
				@RuleSetRow(set, index)
			}
		</div>
		if len(view.RuleSets) == 0 {
			@components.EmptyState(components.EmptyStateProps{Icon: "users", Title: "No rule sets yet", Description: "Add one to give kids, guests, or work devices their own blocking.", Class: "blocking-empty rule-set-empty"})
		}
		<p class="field-help rule-set-note">The Blocked and Allowed tabs apply to every device. A rule set's own domains win over them.</p>
	</div>
}

templ RuleSetRow(set RuleSetView, index int) {
	<article class="blocking-source-row rule-set-row" data-rule-set={ set.Name }>
		<span class="blocking-source-icon">@Icon(ifThen(set.Off, "shield-off", "users"))</span>
		<div>
			<button class="blocking-source-name rule-set-name" type="button" { drawerOpener(RuleSetDrawerLink(set.Name))... } aria-label={ "View details for " + set.Name }>{ set.Name }</button>
			<small>{ ruleSetSummary(set) }</small>
			<small class={ ifThen(len(set.Devices) == 0, "rule-set-devices empty", "rule-set-devices") }>{ ruleSetDevices(set.Devices) }</small>
		</div>
		@components.Button(components.ButtonProps{Label: "Edit", Icon: "pencil", Variant: components.ButtonOutline, Compact: true, Attrs: ruleSetFormAttrs("/ui/blocking/rule-sets/form?"+url.Values{"name": []string{set.Name}}.Encode(), fmt.Sprintf("rule-set-edit-%d", index), "aria-label", "Edit "+set.Name)})
		<button class="icon-button danger" type="button" hx-post="/ui/blocking/rule-sets/delete" hx-vals={ fmt.Sprintf("{\"name\":%q}", set.Name) } hx-target="#blocking-content" hx-swap="outerHTML" hx-confirm={ ruleSetDeleteQuestion(set) } data-confirm-title="Delete rule set?" data-confirm-action="Delete Rule Set" aria-label={ "Delete " + set.Name } data-replica-primary-action>@Icon("trash")</button>
	</article>
}

// RuleSetDialog holds the rule set form, loaded when it opens.
templ RuleSetDialog() {
	@components.Dialog(components.DialogProps{ID: "rule-set-dialog", TitleID: "rule-set-title", Class: "isotope-form-dialog blocking-dialog rule-set-dialog"}) {
		<div class="rule-set-content" id="rule-set-content"></div>
	}
}

// RuleSetForm edits a rule set, or the default policy's block lists. Saving
// swaps the page and closes the dialog; a problem shows inside it instead,
// leaving what was typed alone.
templ RuleSetForm(form RuleSetFormView) {
	if form.Default {
		<form class="rule-set-form" hx-post="/ui/blocking/rule-sets/default" hx-target="#blocking-content" hx-swap="outerHTML" hx-disable="find button[type='submit']">
			@components.DialogHeader(components.DialogProps{TitleID: "rule-set-title", Title: "Edit Default", Description: "The block lists for every device without a rule set."})
			<div class="isotope-dialog-body rule-set-body">
				<div class="rule-set-notice" id="rule-set-notice"></div>
				<fieldset class="field-control rule-set-lists rule-set-scope">
					<legend>Block Lists</legend>
					<div class="rule-set-choice">
						<label><input type="radio" name="scope" value="all" checked?={ len(form.DefaultLists) == 0 }/><span>Every Block List</span></label>
						<label><input type="radio" name="scope" value="chosen" checked?={ len(form.DefaultLists) > 0 }/><span>Only These Lists</span></label>
					</div>
					@ruleSetListChoices(form.Lists, form.DefaultLists)
				</fieldset>
			</div>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Save", Type: "submit", Attrs: templ.Attributes{"data-replica-primary-action": true}})
			}
		</form>
	} else {
		<form class="rule-set-form" hx-post="/ui/blocking/rule-sets/save" hx-target="#blocking-content" hx-swap="outerHTML" hx-disable="find button[type='submit']">
			@components.DialogHeader(components.DialogProps{TitleID: "rule-set-title", Title: ifThen(form.Original == "", "Add Rule Set", "Edit "+form.Original), Description: "Devices in a rule set use only its block lists, plus its own blocked and allowed domains, or skip blocking altogether."})
			if form.Original != "" {
				<input type="hidden" name="original" value={ form.Original }/>
			}
			<div class="isotope-dialog-body rule-set-body">
				<div class="rule-set-notice" id="rule-set-notice"></div>
				@components.Field(components.FieldProps{ID: "rule-set-name", Label: "Name", Input: templ.Attributes{"name": "name", "value": form.Set.Name, "placeholder": "Kids", "maxlength": "64", "autocomplete": "off", "required": true}})
				@components.SwitchField(components.SwitchFieldProps{ID: "rule-set-off", Title: "Turn Off Blocking", Description: "Its devices skip every block list and blocked domain. Blocking everything for one of them still works.", Name: "off", Checked: form.Set.Off, Class: "rule-set-off"})
				<fieldset class="field-control rule-set-lists">
					<legend>Block Lists</legend>
					if len(form.Lists) == 0 {
						<p class="field-help">No block lists yet. Add one in the Block Lists tab.</p>
					} else {
						@ruleSetListChoices(form.Lists, form.Set.Lists)
					}
					<small class="field-help">Leave them all off to use only its own domains and the Blocked tab.</small>
				</fieldset>
				if form.Original == "" {
					<p class="field-help">Add its devices, and its own blocked and allowed domains, from its panel once it's saved.</p>
				}
			</div>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: ifThen(form.Original == "", "Add Rule Set", "Save"), Type: "submit", Attrs: templ.Attributes{"data-replica-primary-action": true}})
			}
		</form>
	}
}

templ ruleSetListChoices(lists, chosen []string) {
	<div class="rule-set-list-choices" role="group" aria-label="Block lists">
		for _, list := range lists {
			<label><input type="checkbox" name="lists" value={ list } checked?={ slices.Contains(chosen, list) }/><span>{ list }</span></label>
		}
	</div>
}

// ruleSetFormAttrs makes a button load the rule set form into the dialog
// and open it.
func ruleSetFormAttrs(endpoint, id string, more ...string) templ.Attributes {
	attributes := templ.Attributes{"id": id, "hx-get": endpoint, "hx-target": "#rule-set-content", "hx-swap": "innerHTML", "data-dialog-load": "rule-set-dialog", "data-replica-primary-action": true}
	for index := 0; index+1 < len(more); index += 2 {
		attributes[more[index]] = more[index+1]
	}
	return attributes
}

func defaultListsSummary(lists []string) string {
	if len(lists) == 0 {
		return "Every block list"
	}
	return "Lists: " + strings.Join(lists, ", ")
}

func ruleSetSummary(set RuleSetView) string {
	if set.Off {
		return "Blocking off"
	}
	parts := []string{ifThen(len(set.Lists) == 0, "No block lists", "Lists: "+strings.Join(set.Lists, ", "))}
	if len(set.Apps) > 0 {
		parts = append(parts, countLabel(uint64(len(set.Apps)), "blocked app", "blocked apps"))
	}
	if len(set.Domains) > 0 {
		parts = append(parts, countLabel(uint64(len(set.Domains)), "blocked domain", "blocked domains"))
	}
	if len(set.AllowedDomains) > 0 {
		parts = append(parts, countLabel(uint64(len(set.AllowedDomains)), "allowed domain", "allowed domains"))
	}
	return strings.Join(parts, " · ")
}

func ruleSetDevices(devices []RuleSetDevice) string {
	if len(devices) == 0 {
		return "No devices yet"
	}
	labels := make([]string, len(devices))
	for index, device := range devices {
		labels[index] = device.Label
	}
	return "Devices: " + strings.Join(labels, ", ")
}

func ruleSetDeleteQuestion(set RuleSetView) string {
	if len(set.Devices) == 0 {
		return "Delete " + set.Name + "?"
	}
	return "Delete " + set.Name + "? " + plural(len(set.Devices), "Its device goes", "Its devices go") + " back to the Default rules."
}

const RuleSetRoute = "/blocked/rule-sets/"

// RuleSetPath is the address of one rule set's panel.
func RuleSetPath(name string) string { return RuleSetRoute + url.PathEscape(name) }

// RuleSetDrawerLink opens a rule set's panel on the Blocking page.
func RuleSetDrawerLink(name string) *DrawerLink {
	return &DrawerLink{
		Dialog: "rule-set-drawer", Loading: "rule-set-drawer-loading", Target: "rule-set-drawer-content",
		URL: "/ui/blocking/rule-set?" + url.Values{"name": []string{name}}.Encode(), Link: RuleSetPath(name),
	}
}

func ruleSetDrawerRoute() templ.Attributes {
	return insightDrawerRoute(RuleSetRoute, "/ui/blocking/rule-set", "name", "rule-set-drawer-content", "rule-set-drawer-loading", "/blocked?tab=rule-sets")
}

// RuleSetDrawerView is one rule set's panel: who it covers, its block lists,
// and its own blocked and allowed domains, which are changed here.
type RuleSetDrawerView struct {
	Set RuleSetView
	// DeviceOptions are the devices Sable has seen that are not in the rule
	// set yet, offered as the Add Device field is filled in.
	DeviceOptions []RuleSetDeviceOption
	// Missing is set when no rule set has the requested name.
	Missing  bool
	CanWrite bool
	Message  string
	Error    string
}

// ruleSetDrawer is the panel a rule set opens in, kept outside the page
// content so the page can refresh beneath it.
templ ruleSetDrawer() {
	<dialog class="query-detail-dialog rule-set-drawer" id="rule-set-drawer" aria-labelledby="rule-set-drawer-title" { ruleSetDrawerRoute()... }>
		<div class="query-detail-content" id="rule-set-drawer-content">
			@ruleSetLoading()
		</div>
	</dialog>
	<template id="rule-set-drawer-loading">
		@ruleSetLoading()
	</template>
}

templ ruleSetLoading() {
	@DetailDrawerContent(DetailDrawerView{ID: "rule-set-drawer", TitleID: "rule-set-drawer-title", Eyebrow: "Rule Set", Title: "Loading…", CloseLabel: "Close rule set details"}, templ.NopComponent) {
		<div class="insight-device-loading" role="status" aria-live="polite">
			<span class="sr-only">Loading rule set details…</span>
			<span class="insight-skeleton-line insights-skeleton-block"></span>
			<span class="insight-skeleton-title insights-skeleton-block"></span>
			<span class="insight-skeleton-line insights-skeleton-block"></span>
		</div>
	}
}

// RuleSetDrawer is one rule set's details, loaded into the open panel.
templ RuleSetDrawer(view RuleSetDrawerView) {
	@DetailDrawerContent(DetailDrawerView{ID: "rule-set-drawer", TitleID: "rule-set-drawer-title", Eyebrow: "Rule Set", Title: ifThen(view.Missing, "Rule set not found", view.Set.Name), CloseLabel: "Close rule set details"}, ruleSetFooter(view)) {
		@Toast(view.Message, "success")
		if view.Error != "" {
			<div class="query-error" role="alert"><strong>Something went wrong</strong><span>{ view.Error }</span></div>
		}
		if view.Missing {
			<div class="query-detail-section-heading"><p>No rule set has this name. It may have been deleted or renamed.</p></div>
		} else {
			@components.FactList(components.FactListProps{Class: "query-detail-grid"}) {
				if view.Set.Off {
					@components.Fact(components.FactProps{Label: "Blocking", Value: "Off for its devices. Blocking everything for one of them still works.", Full: true})
				} else {
					@components.Fact(components.FactProps{Label: "Block lists", Value: ifThen(len(view.Set.Lists) == 0, "None, only its own domains and the Blocked tab", strings.Join(view.Set.Lists, ", ")), Full: true})
				}
			}
			@ruleSetDeviceSection(view)
			if !view.Set.Off {
				@ruleSetApps(view)
				@ruleSetDomains(view, false)
				@ruleSetDomains(view, true)
			}
		}
	}
}

// ruleSetApps lists the apps a rule set blocks, with a button that swaps the
// panel for the app picker.
templ ruleSetApps(view RuleSetDrawerView) {
	<section class="query-detail-answer rule-set-domains rule-set-apps-section" aria-labelledby="rule-set-apps-title">
		<div class="rule-set-domains-heading">
			<h3 id="rule-set-apps-title">Blocked Apps</h3>
			if len(view.Set.Apps) > 0 {
				@components.Badge(components.BadgeProps{Label: formatNumber(uint64(len(view.Set.Apps)))})
			}
		</div>
		<p class="rule-set-domains-help">{ "Blocked for " + view.Set.Name + " devices, with every domain Sable knows each app uses." }</p>
		if view.CanWrite {
			<div class="rule-set-apps-actions">
				@components.Button(components.ButtonProps{Label: ifThen(len(view.Set.Apps) == 0, "Choose Apps", "Change Apps"), Icon: "plus", Variant: components.ButtonOutline, Compact: true, Attrs: ruleSetAppPickerAttrs(view.Set.Name)})
			</div>
		}
		if len(view.Set.Apps) == 0 {
			<p class="rule-set-domains-empty">No blocked apps.</p>
		} else {
			<div class="blocked-domain-list rule-set-app-list">
				for _, app := range view.Set.Apps {
					<div class="rule-set-device-row rule-set-app-row" data-rule-set-app={ app.ID }>
						@AppIcon(app.ID, app.Category)
						<span class="rule-set-device-name">
							<strong>{ app.Name }</strong>
							<small>{ app.Category }</small>
						</span>
						if view.CanWrite {
							<button class="icon-button danger" type="button" aria-label={ "Unblock " + app.Name } { ruleSetAppRemoveAttrs(view.Set.Name, app)... }>@Icon("trash")</button>
						}
					</div>
				}
			</div>
		}
	</section>
}

func ruleSetAppPickerAttrs(name string) templ.Attributes {
	return templ.Attributes{
		"hx-get": "/ui/blocking/rule-sets/apps?" + url.Values{"name": []string{name}}.Encode(), "hx-target": "#rule-set-drawer-content",
		"hx-swap": "innerHTML", "id": "rule-set-choose-apps", "data-replica-primary-action": true,
	}
}

// ruleSetAppRemoveAttrs asks before a rule set stops blocking an app.
func ruleSetAppRemoveAttrs(name string, app RuleSetApp) templ.Attributes {
	return templ.Attributes{
		"hx-post": "/ui/blocking/rule-sets/apps/delete", "hx-vals": fmt.Sprintf(`{"name":%q,"app":%q}`, name, app.ID),
		"hx-target": "#rule-set-drawer-content", "hx-swap": "innerHTML",
		"hx-confirm":         "Unblock " + app.Name + " for " + name + "? Its domains are still blocked when a block list or a blocked domain has them.",
		"data-confirm-title": "Unblock app?", "data-confirm-action": "Unblock App", "data-replica-primary-action": true,
	}
}

// RuleSetAppPicker fills a rule set's panel with every app it can block, by
// category, and a search that narrows them.
templ RuleSetAppPicker(view RuleSetAppPickerView) {
	@DetailDrawerContent(DetailDrawerView{ID: "rule-set-drawer", TitleID: "rule-set-drawer-title", Eyebrow: "Block Apps", Title: view.Name, CloseLabel: "Close rule set details"}, ruleSetAppPickerFooter(view)) {
		<form id="rule-set-app-form" class="rule-set-app-form" hx-post="/ui/blocking/rule-sets/apps" hx-target="#rule-set-drawer-content" hx-swap="innerHTML" hx-disable="find button">
			<input type="hidden" name="name" value={ view.Name }/>
			<p class="rule-set-domains-help">{ "Pick the apps " + view.Name + " devices can't use. Each one blocks every domain Sable knows the app uses." }</p>
			<label class="sr-only" for="rule-set-app-search">Search apps</label>
			<input id="rule-set-app-search" class="rule-set-app-search" type="search" placeholder="Search apps" autocomplete="off" spellcheck="false" data-app-picker-search/>
			for _, group := range view.Groups {
				<fieldset class="rule-set-app-group" data-app-group>
					<legend>{ group.Category }</legend>
					<div class="rule-set-app-grid">
						for _, app := range group.Apps {
							<label class="rule-set-app-choice" data-app-name={ strings.ToLower(app.Name) }>
								<input type="checkbox" name="app" value={ app.ID } checked?={ app.Chosen }/>
								@AppIcon(app.ID, app.Category)
								<span>{ app.Name }</span>
								<span class="rule-set-app-check" aria-hidden="true">@Icon("check")</span>
							</label>
						}
					</div>
				</fieldset>
			}
			<p class="rule-set-domains-empty" data-app-picker-empty hidden>No apps match.</p>
		</form>
	}
}

templ ruleSetAppPickerFooter(view RuleSetAppPickerView) {
	<div class="query-detail-policy-actions insight-drawer-actions">
		@components.Button(components.ButtonProps{Label: "Cancel", Variant: components.ButtonOutline, Attrs: templ.Attributes{
			"hx-get": "/ui/blocking/rule-set?" + url.Values{"name": []string{view.Name}}.Encode(), "hx-target": "#rule-set-drawer-content", "hx-swap": "innerHTML",
		}})
		@components.Button(components.ButtonProps{Label: "Save Apps", Icon: "check", Type: "submit", Attrs: templ.Attributes{"form": "rule-set-app-form", "data-replica-primary-action": true}})
	</div>
}

// ruleSetDomains is one of a rule set's own lists, with a field to add to it.
templ ruleSetDomains(view RuleSetDrawerView, allowed bool) {
	{{ kind := domainPolicyKind(allowed) }}
	<section class="query-detail-answer rule-set-domains" aria-labelledby={ "rule-set-" + kind + "-title" }>
		<div class="rule-set-domains-heading">
			<h3 id={ "rule-set-" + kind + "-title" }>{ ifThen(allowed, "Allowed Domains", "Blocked Domains") }</h3>
			if len(ruleSetList(view.Set, allowed)) > 0 {
				@components.Badge(components.BadgeProps{Label: formatNumber(uint64(len(ruleSetList(view.Set, allowed))))})
			}
		</div>
		<p class="rule-set-domains-help">{ ruleSetDomainsHelp(view.Set.Name, allowed) }</p>
		if view.CanWrite {
			<form class="rule-set-domain-form" hx-post="/ui/blocking/rule-sets/domains/add" hx-target="#rule-set-drawer-content" hx-swap="innerHTML" hx-disable="find button">
				<input type="hidden" name="name" value={ view.Set.Name }/>
				<input type="hidden" name="kind" value={ kind }/>
				<label class="sr-only" for={ "rule-set-add-" + kind }>{ ifThen(allowed, "Domain to allow", "Domain to block") }</label>
				<input id={ "rule-set-add-" + kind } name="domain" placeholder={ ifThen(allowed, "*.school.example", "games.example") } autocomplete="off" spellcheck="false" required/>
				@components.Button(components.ButtonProps{Label: ifThen(allowed, "Allow", "Block"), Icon: "plus", Variant: components.ButtonOutline, Compact: true, Type: "submit", Attrs: templ.Attributes{"data-replica-primary-action": true}})
			</form>
		}
		if len(ruleSetList(view.Set, allowed)) == 0 {
			<p class="rule-set-domains-empty">{ ifThen(allowed, "No allowed domains of its own.", "No blocked domains of its own.") }</p>
		} else {
			<div class="blocked-domain-list rule-set-domain-list">
				for _, domain := range ruleSetList(view.Set, allowed) {
					if view.CanWrite {
						@PolicyDomainRow(domain, allowed, "", ruleSetRemoveAttrs(view.Set.Name, domain, allowed))
					} else {
						@PolicyDomainRow(domain, allowed, "", nil)
					}
				}
			</div>
		}
	</section>
}

// ruleSetDeviceSection lists the devices, addresses, and networks in a rule
// set, with a field to add one.
templ ruleSetDeviceSection(view RuleSetDrawerView) {
	<section class="query-detail-answer rule-set-domains rule-set-devices-section" aria-labelledby="rule-set-devices-title">
		<div class="rule-set-domains-heading">
			<h3 id="rule-set-devices-title">Devices</h3>
			if len(view.Set.Devices) > 0 {
				@components.Badge(components.BadgeProps{Label: formatNumber(uint64(len(view.Set.Devices)))})
			}
		</div>
		<p class="rule-set-domains-help">{ "These use " + view.Set.Name + " instead of the Default rules. A network brings in every device on it that has no rule set of its own." }</p>
		if view.CanWrite {
			<form class="rule-set-domain-form rule-set-device-form" hx-post="/ui/blocking/rule-sets/devices/add" hx-target="#rule-set-drawer-content" hx-swap="innerHTML" hx-disable="find button">
				<input type="hidden" name="name" value={ view.Set.Name }/>
				<label class="sr-only" for="rule-set-add-device">Device to add</label>
				<span class="suggest-input">
					<input id="rule-set-add-device" name="device" list="rule-set-device-options" placeholder="Device, IP address, or network" autocomplete="off" spellcheck="false" required/>
					<span class="styled-select-chevron" aria-hidden="true"></span>
				</span>
				<datalist id="rule-set-device-options">
					for _, option := range view.DeviceOptions {
						<option value={ option.Value } label={ option.Label }></option>
					}
				</datalist>
				@components.Button(components.ButtonProps{Label: "Add", Icon: "plus", Variant: components.ButtonOutline, Compact: true, Type: "submit", Attrs: templ.Attributes{"data-replica-primary-action": true}})
			</form>
		}
		if len(view.Set.Devices) == 0 {
			<p class="rule-set-domains-empty">No devices yet.</p>
		} else {
			<div class="blocked-domain-list rule-set-device-list">
				for _, device := range view.Set.Devices {
					<div class="rule-set-device-row" data-rule-set-device={ device.Entry }>
						<span class="rule-set-device-icon">@Icon(ruleSetDeviceIcon(device))</span>
						<span class="rule-set-device-name">
							<strong>{ device.Label }</strong>
							if detail := ruleSetDeviceDetail(device); detail != "" {
								<small>{ detail }</small>
							}
						</span>
						if view.CanWrite {
							<button class="icon-button danger" type="button" aria-label={ "Remove " + device.Label } { ruleSetDeviceRemoveAttrs(view.Set.Name, device)... }>@Icon("trash")</button>
						}
					</div>
				}
			</div>
		}
	</section>
}

templ ruleSetFooter(view RuleSetDrawerView) {
	if !view.Missing {
		<div class="query-detail-policy-actions insight-drawer-actions">
			@CopyLinkButton(RuleSetPath(view.Set.Name))
			if view.CanWrite {
				@components.Button(components.ButtonProps{Label: "Edit Rule Set", Icon: "pencil", Variant: components.ButtonOutline, Attrs: ruleSetFormAttrs("/ui/blocking/rule-sets/form?"+url.Values{"name": []string{view.Set.Name}}.Encode(), "rule-set-drawer-edit")})
			}
		</div>
	}
}

func ruleSetList(set RuleSetView, allowed bool) []string {
	if allowed {
		return set.AllowedDomains
	}
	return set.Domains
}

func ruleSetDomainsHelp(name string, allowed bool) string {
	if allowed {
		return "Allowed for " + name + " devices, even when a block list has them."
	}
	return "Blocked for " + name + " devices, along with every name under them."
}

func ruleSetDeviceIcon(device RuleSetDevice) string {
	if device.Kind == "network" {
		return "router"
	}
	return insightTypeIcon(device.Type)
}

// ruleSetDeviceDetail says what puts a device in the rule set, under its
// name; a device without a name already shows it.
func ruleSetDeviceDetail(device RuleSetDevice) string {
	switch {
	case device.Kind == "network":
		return "Every device on " + device.Entry
	case device.Label == device.Entry:
		return ""
	case device.Kind == "mac":
		return "Hardware address " + device.Entry
	default:
		return "Address " + device.Entry
	}
}

// ruleSetDeviceRemoveAttrs asks before taking a device out of a rule set.
func ruleSetDeviceRemoveAttrs(name string, device RuleSetDevice) templ.Attributes {
	return templ.Attributes{
		"hx-post": "/ui/blocking/rule-sets/devices/delete", "hx-vals": fmt.Sprintf(`{"name":%q,"device":%q}`, name, device.Entry),
		"hx-target": "#rule-set-drawer-content", "hx-swap": "innerHTML",
		"hx-confirm":         "Take " + device.Label + " out of " + name + "? It goes back to the Default rules unless a network it's on has a rule set.",
		"data-confirm-title": "Remove device?", "data-confirm-action": "Remove Device", "data-replica-primary-action": true,
	}
}

// ruleSetRemoveAttrs takes a domain off one of a rule set's own lists.
func ruleSetRemoveAttrs(name, domain string, allowed bool) templ.Attributes {
	attributes := policyRemoveAttrs(domain, allowed, "/ui/blocking/rule-sets/domains/delete", fmt.Sprintf(`{"name":%q,"domain":%q,"kind":%q}`, name, domain, domainPolicyKind(allowed)), "#rule-set-drawer-content", "innerHTML", " for "+name)
	attributes["data-replica-primary-action"] = true
	return attributes
}
