package pages

import "github.com/drudge/sable/internal/insights/services"

// appLogo is an app's brand mark: its path on a 24-unit square, the brand's
// color, and the ink that reads best on that color.
type appLogo struct {
	Path  string
	Color string
	Ink   string
}

// appCategoryIcons stand in for the mark of an app Simple Icons has none for,
// by the app's category.
var appCategoryIcons = map[string]string{
	services.CategoryStreaming: "clapperboard", services.CategoryMusic: "music", services.CategorySocial: "thumbs-up",
	services.CategoryMessaging: "message-circle", services.CategoryCalls: "video", services.CategoryGaming: "gamepad-2",
	services.CategoryShopping: "shopping-bag", services.CategorySmartHome: "house-wifi", services.CategoryCameras: "cctv",
	services.CategoryCloud: "cloud", services.CategoryProductivity: "briefcase", services.CategoryDeveloper: "code",
	services.CategoryAI: "sparkles", services.CategoryNews: "newspaper", services.CategorySearch: "search",
	services.CategoryPlatform: "cpu", services.CategorySecurity: "shield-check", services.CategoryFinance: "wallet",
}

// AppIcon is an app's logo as a small app tile: the brand's mark, in white or
// black, whichever reads better, on the brand's color. An app without a mark
// shows its category's icon on a gray tile, as a device shows its type. The
// app's name always sits beside it, so the icon is decoration.
templ AppIcon(id, category string) {
	if logo, found := appLogos[id]; found {
		<svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true">
			<rect width="24" height="24" rx="6" fill={ logo.Color }></rect>
			<path d={ logo.Path } fill={ logo.Ink } transform="translate(5 5) scale(.5833)"></path>
		</svg>
	} else {
		<span class="app-icon app-icon-category" aria-hidden="true">@Icon(appCategoryIcon(category))</span>
	}
}

func appCategoryIcon(category string) string {
	if icon, found := appCategoryIcons[category]; found {
		return icon
	}
	return "apps"
}
