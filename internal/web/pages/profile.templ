package pages

import (
	"fmt"
	"net/url"
	"time"

	"github.com/drudge/sable/internal/auth"
	"github.com/drudge/sable/internal/web/pages/components"
)

type ProfilePageView struct {
 PasskeysDisabled bool
 HasPassword bool
	Console         DashboardView
	User            auth.ManagedUser
	Roles           []auth.Role
	Tokens          []auth.APIToken
 Passkeys []auth.Passkey
	ActiveTab       string
	DefaultTokenTTL time.Duration
	Message         string
	Error           string
}

// profileTabs names the sections for the document title. The strip itself is
// built from links because each tab is a separate request.
var profileTabs = []tabOption{
	{Value: "profile", Label: "Account", Icon: "user"},
	{Value: "tokens", Label: "API Tokens", Icon: "key"},
}

// profileTabHref links a tab to its own request.
func profileTabHref(value string) templ.SafeURL {
	return templ.SafeURL("/profile?tab=" + url.QueryEscape(value))
}

templ ProfilePage(view ProfilePageView) {
	@AppDocument(view.Console, documentTitle(tabLabel(profileTabs, view.ActiveTab), "Profile"), "profile", ProfileContent(view))
}

templ ProfileContent(view ProfilePageView) {
	<div class="profile-page" id="profile-content" data-isotope-tabs data-tab-param="tab">
		<header class="page-heading"><h1>Profile</h1><p>Manage your account, passkeys, password, and API tokens</p></header>
		<nav class="isotope-tab-list profile-tabs" aria-label="Profile sections">
			for _, tab := range profileTabs {
				<a class={ ifThen(view.ActiveTab == tab.Value, "isotope-tab active", "isotope-tab") } href={ profileTabHref(tab.Value) } aria-current={ ifThen(view.ActiveTab == tab.Value, "page", "false") }>
					@Icon(tab.Icon)
					<span>{ tab.Label }</span>
					if tab.Value == "tokens" {
						<span class="tab-count">{ fmt.Sprint(len(view.Tokens)) }</span>
					}
				</a>
			}
		</nav>
		if view.Message != "" {
			@Toast(view.Message, "success")
		}
		if view.Error != "" {
			@Toast(view.Error, "error")
		}
		if view.ActiveTab == "tokens" {
			@ProfileTokenSettings(view)
		} else {
			@ProfileAccountSettings(view)
		}
	</div>
}

templ ProfileAccountSettings(view ProfilePageView) {
	<div class="profile-account-stack">
		@components.Card(components.CardProps{Class: "isotope-data-card profile-settings-card"}) {
			@components.CardHeader(components.CardHeaderProps{Title: "Account details", Description: "Your name and contact information", Class: "isotope-data-header"})
			<form class="profile-settings-form" method="post" action="/ui/profile" hx-post="/ui/profile" hx-target="#profile-content" hx-swap="outerHTML">
				<input type="hidden" name="csrf_token" value={ view.Console.CSRFToken }/>
				<div class="profile-settings-body">
					<div class="profile-username"><span>Username</span><strong>{ view.User.Username }</strong><small>Usernames are managed by an administrator.</small></div>
					<div class="profile-field-grid">
						<label class="field-control"><span>Display Name</span><input name="display_name" value={ profileDisplayName(view.User) } maxlength="128" autocomplete="name" required/></label>
						<label class="field-control"><span>Email</span><input type="email" name="email" value={ view.User.Email } maxlength="254" placeholder="name@example.com" autocomplete="email"/></label>
					</div>
				</div>
				<footer class="profile-card-footer">@components.Button(components.ButtonProps{Label: "Save Changes", Type: "submit"})</footer>
			</form>
		}
		@ProfilePasskeys(view)
		@components.Card(components.CardProps{Class: "isotope-data-card profile-settings-card", Attrs: templ.Attributes{"data-passkeys": true, "data-csrf-token": view.Console.CSRFToken}}) {
			@components.CardHeader(components.CardHeaderProps{Title: "Password", Description: ifThen(view.User.PasswordLogin, "Password sign-in is enabled", ifThen(view.HasPassword, "Password sign-in is disabled. Your existing password is saved.", "Set a password below to enable password sign-in.")), Class: "isotope-data-header profile-password-header"}) {
				if view.User.PasswordLogin && len(view.Passkeys) > 0 && !view.PasskeysDisabled {
					@components.Button(components.ButtonProps{Label: "Disable password sign-in", Icon: "pause", Variant: components.ButtonOutline, Compact: true, Disabled: view.Console.ControlPlaneReadOnly, Attrs: templ.Attributes{"data-passkey-action": "disable-password"}})
				} else if !view.User.PasswordLogin && view.HasPassword {
 @components.Button(components.ButtonProps{Label: "Enable password sign-in", Icon: "play", Variant: components.ButtonOutline, Compact: true, Disabled: view.Console.ControlPlaneReadOnly, Attrs: templ.Attributes{"data-passkey-action": "enable-password"}})
 }
			}
			<form class="profile-settings-form" hx-post="/ui/profile/password" hx-target="#profile-content" hx-swap="outerHTML">
				<div class="profile-settings-body">
					if view.User.PasswordLogin {
 <label class="field-control"><span>Current Password</span><input type="password" name="current_password" autocomplete="current-password" required/></label>
 }
					<div class="profile-field-grid">
						@components.Field(components.FieldProps{ID: "profile-new-password", Label: "New Password", Help: "Use at least 12 characters.", Input: templ.Attributes{"type": "password", "name": "new_password", "minlength": "12", "maxlength": "1024", "autocomplete": "new-password", "required": true}})
						<label class="field-control"><span>Confirm New Password</span><input type="password" name="confirm_password" minlength="12" maxlength="1024" autocomplete="new-password" required/></label>
					</div>
					<p role="status" data-passkey-status></p>
					<div class="profile-security-note">@Icon("info")<span>Setting a password enables password sign-in and signs out all active browser sessions.</span></div>
				</div>
				<footer class="profile-card-footer">@components.Button(components.ButtonProps{Label: ifThen(view.User.PasswordLogin, "Change Password", "Set new password and enable sign-in"), Type: "submit"})</footer>
			</form>
		}
	</div>
}

templ ProfileTokenSettings(view ProfilePageView) {
	<div class="profile-token-page">
		@ProfileTokens(view)
		@ProfileCreateTokenDialog(view)
	</div>
}

templ ProfileTokens(view ProfilePageView) {
	@components.Card(components.CardProps{ID: "profile-token-list", Class: "isotope-data-card profile-token-list", Attrs: templ.Attributes{"hx-get": "/ui/profile/tokens", "hx-trigger": "apiTokensChanged from:body", "hx-target": "this", "hx-swap": "outerHTML"}}) {
		@components.CardHeader(components.CardHeaderProps{Title: "API Tokens", Description: fmt.Sprintf("%d active", len(view.Tokens)), Class: "isotope-data-header"}) {
			@components.Button(components.ButtonProps{Label: "Create Token", Icon: "plus", Compact: true, Attrs: templ.Attributes{"data-dialog-open": "create-token-dialog"}})
		}
		if len(view.Tokens) == 0 {
			<div class="admin-empty profile-token-empty"><div>@Icon("key")</div><strong>No API tokens yet</strong><span>Create a token for scripts, integrations, and other API clients.</span></div>
		} else {
			<div class="admin-mobile-list profile-token-mobile-list">
				for _, token := range view.Tokens {
					@ProfileTokenMobileRow(view, token)
				}
			</div>
			<div class="admin-desktop-table"><table class="isotope-table profile-token-table"><caption class="sr-only">Your API tokens</caption><thead><tr><th>Name</th><th>Groups</th><th>Created</th><th>Last Used</th><th>Expires</th><th class="right-cell">Actions</th></tr></thead><tbody>
				for _, token := range view.Tokens {
					<tr><td><strong>{ token.Name }</strong></td><td><div class="table-badges">
						for _, group := range token.Groups {
							<span>{ group }</span>
						}
					</div></td><td class="muted-cell">{ FormatDateTime(token.CreatedAt, view.Console.TimeDisplay) }</td><td class="muted-cell">{ tokenLastUsed(token.LastUsedAt, view.Console.TimeDisplay) }</td><td class="muted-cell">{ profileTokenExpiration(token.ExpiresAt, view.Console.TimeDisplay) }</td><td class="right-cell">@ProfileTokenRevoke(token)</td></tr>
				}
			</tbody></table></div>
		}
	}
}

templ ProfileTokenMobileRow(view ProfilePageView, token auth.APIToken) {
	<article class="profile-token-mobile-row"><div class="profile-token-mobile-heading"><strong>{ token.Name }</strong>@ProfileTokenRevoke(token)</div><div class="table-badges">
		for _, group := range token.Groups {
			<span>{ group }</span>
		}
	</div><dl><div><dt>Created</dt><dd>{ FormatDateTime(token.CreatedAt, view.Console.TimeDisplay) }</dd></div><div><dt>Last used</dt><dd>{ tokenLastUsed(token.LastUsedAt, view.Console.TimeDisplay) }</dd></div><div><dt>Expires</dt><dd>{ profileTokenExpiration(token.ExpiresAt, view.Console.TimeDisplay) }</dd></div></dl></article>
}

templ ProfileTokenRevoke(token auth.APIToken) {
	<form hx-post="/ui/profile/tokens/revoke" hx-target="#profile-token-list" hx-swap="outerHTML" hx-confirm={ "Revoke API token " + token.Name + "? Applications using it will immediately lose access." } data-confirm-title="Revoke API token?" data-confirm-action="Revoke Token"><input type="hidden" name="token_id" value={ fmt.Sprint(token.ID) }/><button class="icon-button danger" type="submit" aria-label={ "Revoke " + token.Name } title="Revoke token">@Icon("trash")</button></form>
}

templ ProfileCreateTokenDialog(view ProfilePageView) {
	@components.Dialog(components.DialogProps{ID: "create-token-dialog", TitleID: "profile-create-token-title", Title: "Create API Token", Description: "Create a credential for an application or command-line client", Class: "isotope-form-dialog profile-token-dialog"}) {
		<form hx-post="/ui/api-tokens" hx-target="#api-token-result" hx-swap="innerHTML"><div class="isotope-dialog-body"><div class="token-creation-fields" data-token-fields>
			<label><span>Name</span><input name="name" maxlength="100" placeholder="Home Assistant" autocomplete="off" required/><small>Use a name that identifies where this token will be used.</small></label>
			<label><span>Expiration</span><select name="expiration" data-styled-select required><option value="default" selected>Default ({ tokenLifetimeLabel(view.DefaultTokenTTL) })</option><option value="1d">1 day</option><option value="1w">7 days</option><option value="1mo">30 days</option><option value="3mo">90 days</option><option value="1y">1 year</option><option value="never">Never</option></select><small>Non-expiring tokens remain valid until revoked.</small></label>
			<fieldset><legend>Groups</legend><div class="role-checks">
				for _, role := range view.Roles {
					if roleHasAPIAccess(role) {
						<label><input type="checkbox" name="groups" value={ role.Name }/><span><strong>{ role.Name }</strong><small>{ apiGrantSummary(role) }</small></span></label>
					}
				}
			</div></fieldset><p class="field-help">Tokens can use only groups currently assigned to your account.</p>
		</div><div class="api-token-result" id="api-token-result">The token secret will be shown once. Store it somewhere safe.</div></div><footer class="dialog-footer">@components.Button(components.ButtonProps{Label: "Cancel", Variant: components.ButtonOutline, Attrs: templ.Attributes{"data-dialog-close": true, "data-token-close": true}})@components.Button(components.ButtonProps{Label: "Create Token", Type: "submit", Disabled: true, Attrs: templ.Attributes{"data-token-submit": true}})</footer></form>
	}
}

func profileDisplayName(user auth.ManagedUser) string { if user.DisplayName != "" { return user.DisplayName }; return user.Username }
func profileTokenExpiration(value time.Time, display TimeDisplay) string { if value.IsZero() { return "Never" }; return FormatDateTime(value, display) }


templ ProfilePasskeys(view ProfilePageView) {
 @components.Card(components.CardProps{Class: "isotope-data-card profile-settings-card", Attrs: templ.Attributes{"data-passkeys": true, "data-csrf-token": view.Console.CSRFToken}}) {
  @components.CardHeader(components.CardHeaderProps{Title: "Passkeys", Description: "Sign in with your fingerprint, face, device PIN, or security key", Class: "isotope-data-header"})
  <div class="profile-settings-body">
   if view.PasskeysDisabled {
 <p>Passkey sign-in is disabled by your administrator. Your saved passkeys are preserved.</p>
 } else {
 <p>Passkeys require HTTPS or localhost and work across cluster nodes on the same domain automatically. Add a backup passkey before disabling your password.</p>
 }
   for _, key := range view.Passkeys {
    <div class="profile-passkey-row"><div class="profile-passkey-details"><strong>{ key.Name }</strong><small>{ key.RPID } · Added { FormatDateTime(key.CreatedAt, view.Console.TimeDisplay) } · Last used { tokenLastUsed(key.LastUsedAt, view.Console.TimeDisplay) }</small></div>
     @components.Button(components.ButtonProps{Label: "Remove", Icon: "trash", Variant: components.ButtonOutline, Compact: true, Destructive: true, Disabled: view.Console.ControlPlaneReadOnly, Attrs: templ.Attributes{"data-passkey-action": "remove", "data-passkey-id": key.ID}})
    </div>
   }
   if !view.PasskeysDisabled {
 <label class="field-control" data-passkey-capability><span>Passkey name</span><input data-passkey-name maxlength="100" placeholder="Personal phone or security key" autocomplete="off"/></label>
 }
   <p role="status" data-passkey-status></p>
  </div>
  if !view.PasskeysDisabled {
 <footer class="profile-card-footer" data-passkey-capability>
   @components.Button(components.ButtonProps{Label: "Add passkey", Disabled: view.Console.ControlPlaneReadOnly, Attrs: templ.Attributes{"data-passkey-action": "register"}})
  </footer>
 }
 }
}
