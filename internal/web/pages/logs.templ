package pages

import (
	"fmt"
	"net/url"
	"strings"
	"time"
)

type LogsPageView struct {
	Console   DashboardView
	ActiveTab string
	Runtime   RuntimeLogsView
	Queries   QueryLogsView
}

type RuntimeLogsView struct {
	Entries  []RuntimeLogEntryView
	Count    int
	Search   string
	Level    string
	Live     bool
	CopyText string
	Error    string
	// Persisted reports that these entries came from the stored history rather
	// than this process's buffer, which is what makes paging past the current
	// run meaningful.
	Persisted    bool
	Page         int
	PageSize     int
	TotalEntries int
	TotalPages   int
	FirstURL     string
	PreviousURL  string
	NextURL      string
	LastURL      string
}

type RuntimeLogEntryView struct {
	OccurredAt string
	Level      string
	Message    string
	Attributes string
}

type QueryLogsView struct {
	Entries      []QueryLogEntryView
	Page         int
	PageSize     int
	TotalEntries int
	TotalPages   int
	ClientIP     string
	Name         string
	RecordType   string
	ResponseCode string
	Source       string
	Protocol     string
	// Start and End bound the window the page counts, in the form a
	// datetime-local input accepts. Exact matches the client and domain whole
	// rather than as a substring, which is what a dashboard ranking links with
	// so its total and this page's total describe the same rows.
	Start        string
	End          string
	Exact        bool
	Live         bool
	FiltersOpen  bool
	CanBlocking  bool
	CopyText     string
	FirstURL     string
	PreviousURL  string
	NextURL      string
	LastURL      string
	ExportURL    string
	Error        string
}

// logsTabs drives both the tab strip and the document title so the browser tab
// names the log source an operator is actually looking at.
var logsTabs = []tabOption{
	{Value: "server", Label: "Server Logs"},
	{Value: "queries", Label: "Query Logs"},
}

templ LogsPage(view LogsPageView) {
	@AppDocument(view.Console, documentTitle(tabLabel(logsTabs, view.ActiveTab), "Logs"), "logs", LogsContent(view))
}

templ LogsContent(view LogsPageView) {
	<div class="logs-page page-stack isotope-control-page" data-isotope-tabs data-active-tab={ view.ActiveTab } data-tab-param="tab" data-title-base="Logs">
		<header class="logs-heading"><div class="page-heading"><h1>Logs</h1><p>View server logs and DNS query history</p></div><a class="icon-button" href="/settings?tab=logging" aria-label="Logging settings" title="Logging settings">@Icon("settings")</a></header>
		<div class="isotope-tab-list logs-tab-list" role="tablist" aria-label="Log sources">
			for _, tab := range logsTabs {
				<button class={ ifThen(view.ActiveTab == tab.Value, "isotope-tab active", "isotope-tab") } type="button" role="tab" data-isotope-tab={ tab.Value } data-tab-title={ tab.Label } aria-selected={ fmt.Sprint(view.ActiveTab == tab.Value) }>{ tab.Label }</button>
			}
		</div>
		<div class="logs-tab-panel" data-isotope-panel="server" hidden?={ view.ActiveTab != "server" }>@RuntimeLogsPanel(view.Runtime)</div>
		<div class="logs-tab-panel" data-isotope-panel="queries" hidden?={ view.ActiveTab != "queries" }>@QueryLogsPanel(view.Queries)</div>
	</div>
}

templ RuntimeLogsPanel(view RuntimeLogsView) {
	<section class="card logs-card emphasized" id="runtime-logs-panel" data-log-live-panel data-live={ fmt.Sprint(view.Live) } data-live-url={ runtimePanelURL(view) }>
		<header class="logs-toolbar">
			<div><div class="log-title"><h2>@Icon("file-text")<span>Runtime Log</span></h2><span class="log-total">{ runtimeLogCount(view) }</span></div></div>
			<div class="logs-toolbar-actions">
				@LogLiveButton(view.Live)
				<label class="runtime-level-field"><span class="sr-only">Log level</span><select name="level" aria-label="Log level" data-runtime-level><option value="all" selected?={ view.Level == "all" }>All Levels</option><option value="debug" selected?={ view.Level == "debug" }>Debug</option><option value="info" selected?={ view.Level == "info" }>Info</option><option value="warn" selected?={ view.Level == "warn" }>Warning</option><option value="error" selected?={ view.Level == "error" }>Error</option></select></label>
			</div>
		</header>
		// The level sits with the live toggle but posts with the search, so both
		// controls take effect on their own rather than through a Search button.
		<form class="log-search-bar" id="runtime-log-search-bar" hx-get="/ui/logs/runtime" hx-target="#runtime-logs-panel" hx-swap="outerHTML" hx-trigger="submit, input delay:400ms from:#runtime-log-search, change from:[data-runtime-level]" hx-include="[data-runtime-level]">
			<div class="search-field">@Icon("search")<input id="runtime-log-search" type="search" name="search" value={ view.Search } placeholder="Search server logs..." autocomplete="off" aria-label="Search server logs" data-search-clearable/>@SearchClear(view.Search == "")</div>
			<input type="hidden" name="live" value={ ifThen(view.Live, "1", "0") } data-log-live-input/>
			<input type="hidden" name="page_size" value={ fmt.Sprint(view.PageSize) }/>
			<div class="log-result-actions"><button class="icon-button" type="button" data-copy-target="runtime-log-copy" aria-label="Copy current entries" title="Copy current entries">@Icon("copy")</button><a class="icon-button" href={ templ.SafeURL(runtimeExportURL(view)) } aria-label="Export server logs" title="Export server logs">@Icon("download")</a></div>
		</form>
		<textarea class="sr-only" id="runtime-log-copy" readonly>{ view.CopyText }</textarea>
		if view.Error != "" {
			<div class="logs-empty error">{ view.Error }</div>
		} else if len(view.Entries) == 0 {
			<div class="logs-empty">No runtime log entries match these filters.</div>
		} else {
			<div class="runtime-log-viewer" role="log" aria-live="polite">
				for _, entry := range view.Entries {
					<div class={ "runtime-log-line level-" + entry.Level }><time>{ entry.OccurredAt }</time><span class="runtime-log-level">{ strings.ToUpper(entry.Level) }</span><span class="runtime-log-message">{ entry.Message }</span>if entry.Attributes != "" {
						<span class="runtime-log-attributes">{ entry.Attributes }</span>
					}</div>
				}
			</div>
		}
		if view.Persisted {
			<footer class="logs-pagination"><div><span>Rows per page</span><select name="page_size" data-query-page-size aria-label="Rows per page"><option selected?={ view.PageSize == 50 }>50</option><option selected?={ view.PageSize == 100 }>100</option><option selected?={ view.PageSize == 250 }>250</option></select></div><span>{ runtimePageSummary(view) }</span><nav aria-label="Server log pages"><button class="icon-button" hx-get={ view.FirstURL } hx-target="#runtime-logs-panel" hx-swap="outerHTML" disabled?={ view.Page <= 1 } aria-label="First page">@Icon("chevrons-left")</button><button class="icon-button" hx-get={ view.PreviousURL } hx-target="#runtime-logs-panel" hx-swap="outerHTML" disabled?={ view.Page <= 1 } aria-label="Previous page">@Icon("chevron-left")</button><button class="icon-button" hx-get={ view.NextURL } hx-target="#runtime-logs-panel" hx-swap="outerHTML" disabled?={ view.Page >= view.TotalPages } aria-label="Next page">@Icon("chevron-right")</button><button class="icon-button" hx-get={ view.LastURL } hx-target="#runtime-logs-panel" hx-swap="outerHTML" disabled?={ view.Page >= view.TotalPages } aria-label="Last page">@Icon("chevrons-right")</button></nav></footer>
		}
	</section>
}

templ QueryLogsPanel(view QueryLogsView) {
	{{ tokens := queryFilterTokens(view) }}
	<section class="card logs-card emphasized" id="query-logs-panel" data-log-live-panel data-live={ fmt.Sprint(view.Live) } data-live-url={ queryPanelLiveURL(view) }>
		<header class="logs-toolbar query-logs-toolbar">
			<div>
				<div class="log-title"><h2>@Icon("logs")<span>DNS Query Log</span></h2><span class="log-total">{ fmt.Sprintf("%s entries", formatCount(view.TotalEntries)) }</span></div>
				if len(tokens) > 0 {
					<div class="query-filter-tokens">
						for _, token := range tokens {
							<span class="query-filter-token"><b>{ token.Label }:</b><span title={ token.Value }>{ token.Value }</span><a href={ templ.SafeURL(token.RemoveURL) } aria-label={ "Remove the " + token.Label + " filter" } title={ "Remove the " + token.Label + " filter" }>@Icon("x")</a></span>
						}
						<a class="query-filter-clear" href="/logs?tab=queries" aria-label="Clear all filters" title="Clear all filters">@Icon("x")</a>
					</div>
				}
			</div>
			<div class="logs-toolbar-actions">
				@LogLiveButton(view.Live)
				<button class={ ifThen(view.FiltersOpen, "button outline filters-toggle active", "button outline filters-toggle") } type="button" data-query-filters-toggle aria-expanded={ fmt.Sprint(view.FiltersOpen) }>@Icon("filter")<span>Filters</span>
					if len(tokens) > 0 {
						<span class="filter-count">{ fmt.Sprint(len(tokens)) }</span>
					}
					<span class="button-caret">@Icon("chevron-down")</span>
				</button>
			</div>
		</header>
		<div class="query-log-filters isotope-query-filters" data-query-filters hidden?={ !view.FiltersOpen }>
			<form hx-get="/ui/logs/queries" hx-target="#query-logs-panel" hx-swap="outerHTML">
				<div class="query-filter-grid">
					<label><span>Client IP</span><input name="client_ip" value={ view.ClientIP } placeholder="e.g. 10.0.7.168"/></label>
					<label><span>Domain</span><input name="name" value={ view.Name } placeholder="e.g. example.com"/></label>
					<label><span>Query Type</span><input name="record_type" value={ view.RecordType } placeholder="e.g. A, AAAA"/></label>
					<label><span>Response Type</span><select name="source">@LogOption("", "All Types", view.Source)@LogOption("authoritative", "Authoritative", view.Source)@LogOption("upstream", "Recursive", view.Source)@LogOption("cache", "Cached", view.Source)@LogOption("blocked", "Blocked", view.Source)@LogOption("local", "Local", view.Source)@LogOption("error", "Error", view.Source)</select></label>
					<label><span>Protocol</span><select name="protocol">@LogOption("", "All Protocols", view.Protocol)@LogOption("UDP", "UDP", view.Protocol)@LogOption("TCP", "TCP", view.Protocol)@LogOption("TLS", "TLS", view.Protocol)@LogOption("HTTPS", "HTTPS", view.Protocol)@LogOption("QUIC", "QUIC", view.Protocol)</select></label>
					<label><span>RCODE</span><input name="response_code" value={ view.ResponseCode } placeholder="e.g. NoError"/></label>
					<div class="query-filter-range query-filter-wide" data-range-root>
						<span>Time Range</span>
						<button class="range-trigger" type="button" data-range-open aria-haspopup="dialog" aria-expanded="false" aria-controls="query-log-range">@Icon("calendar")<span data-range-label>{ queryRangeLabel(view) }</span>@Icon("chevron-down")</button>
						<input type="hidden" name="start" value={ view.Start } data-range-start/>
						<input type="hidden" name="end" value={ view.End } data-range-end/>
						<div class="range-popover query-range-popover" id="query-log-range" role="dialog" aria-label="Query log time range" data-range-popover data-range-default-end-time="23:59" hidden>
							<div class="range-picker-body">
								@RangeCalendar()
								<div class="range-times">
									<label><span>From</span><input class="time-field" type="time" step="60" data-range-start-time/></label>
									<label><span>To</span><input class="time-field" type="time" step="60" data-range-end-time/></label>
								</div>
								<p class="range-error" data-range-error hidden></p>
								<div class="range-picker-actions">
									<button class="button outline" type="button" data-range-clear>Any time</button>
									<button class="button range-apply" type="button" data-range-apply>Apply</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<input type="hidden" name="page_size" value={ fmt.Sprint(view.PageSize) }/><input type="hidden" name="live" value={ ifThen(view.Live, "1", "0") } data-log-live-input/><input type="hidden" name="filters" value="1"/>
				if view.Exact {
					<input type="hidden" name="match" value="exact"/>
				}
				<div class="query-filter-actions"><button class="button" type="submit">@Icon("search")<span>Search</span></button>if len(tokens) > 0 {
					<a class="button outline" href="/logs?tab=queries">@Icon("refresh")<span>Clear</span></a>
				}</div>
			</form>
		</div>
		<div class="log-search-bar query-result-search"><div class="search-field">@Icon("search")<input type="search" placeholder="Search in results..." autocomplete="off" data-query-result-search aria-label="Search in results" data-search-clearable/>@SearchClear(true)</div><div class="log-result-actions"><button class="icon-button" type="button" data-copy-target="query-log-copy" aria-label="Copy current results" title="Copy current results">@Icon("copy")</button><a class="icon-button" href={ templ.SafeURL(view.ExportURL) } aria-label="Export query logs" title="Export query logs">@Icon("download")</a></div></div>
		<textarea class="sr-only" id="query-log-copy" readonly>{ view.CopyText }</textarea>
		if view.Error != "" {
			<div class="logs-empty error">{ view.Error }</div>
		} else if len(view.Entries) == 0 {
			<div class="logs-empty">No DNS queries match these filters.</div>
		} else {
			<div class="table-scroll query-log-table-scroll"><table class="query-log-table full isotope-query-log-table"><thead><tr><th class="query-col-time">Timestamp</th><th class="query-col-client">Client IP</th><th class="query-col-domain">Domain</th><th class="query-col-type">Type</th><th class="query-col-source">Response</th><th class="query-col-status">Status</th><th class="query-col-protocol">Protocol</th><th class="query-col-answer">Answer</th><th class="query-col-actions"><span class="sr-only">Actions</span></th></tr></thead><tbody>
				for _, entry := range view.Entries {
					@QueryLogTableRow(entry, view.CanBlocking)
				}
			</tbody></table></div>
			@QueryDetailDialog(view.CanBlocking)
		}
		<footer class="logs-pagination"><div><span>Rows per page</span><select name="page_size" data-query-page-size aria-label="Rows per page"><option selected?={ view.PageSize == 25 }>25</option><option selected?={ view.PageSize == 50 }>50</option><option selected?={ view.PageSize == 100 }>100</option><option selected?={ view.PageSize == 250 }>250</option></select></div><span>{ queryPageSummary(view) }</span><nav aria-label="Query log pages"><button class="icon-button" hx-get={ view.FirstURL } hx-target="#query-logs-panel" hx-swap="outerHTML" disabled?={ view.Page <= 1 } aria-label="First page">@Icon("chevrons-left")</button><button class="icon-button" hx-get={ view.PreviousURL } hx-target="#query-logs-panel" hx-swap="outerHTML" disabled?={ view.Page <= 1 } aria-label="Previous page">@Icon("chevron-left")</button><button class="icon-button" hx-get={ view.NextURL } hx-target="#query-logs-panel" hx-swap="outerHTML" disabled?={ view.Page >= view.TotalPages } aria-label="Next page">@Icon("chevron-right")</button><button class="icon-button" hx-get={ view.LastURL } hx-target="#query-logs-panel" hx-swap="outerHTML" disabled?={ view.Page >= view.TotalPages } aria-label="Last page">@Icon("chevrons-right")</button></nav></footer>
	</section>
}

templ QueryAnswers(answers []string) {
	if hasAnswers(answers) {
		<div>
			for _, answer := range answers {
				if answer != "" {
					<span title={ answer }>{ answer }</span>
				}
			}
		</div>
	} else {
		<span class="muted-cell">—</span>
	}
}

templ QueryLogTableRow(entry QueryLogEntryView, canBlocking bool) {
	<tr
		data-query-result-row
		data-query-detail-row
		data-query-detail-time={ entry.OccurredAt }
		data-query-detail-client={ entry.ClientIP }
		data-query-detail-name={ entry.Name }
		data-query-detail-type={ entry.RecordType }
		data-query-detail-source={ entry.Source }
		data-query-detail-source-label={ logSourceLabel(entry.Source) }
		data-query-detail-status-label={ rcodeDisplay(entry.Status) }
		data-query-detail-protocol={ entry.Protocol }
		data-query-detail-duration={ entry.Duration }
		data-query-detail-answers={ strings.Join(entry.Answers, "\n") }
	>
		// The client and the protocol ride under the timestamp, and the answers
		// under the domain, so the narrow layout can drop those columns without
		// dropping what they said.
		<td class="query-time query-col-time"><time>{ entry.OccurredAt }</time><span class="query-fold query-fold-meta"><code>{ entry.ClientIP }</code><span>{ ifThen(entry.Protocol != "", entry.Protocol, "—") }</span><span class="query-fold-tight">{ entry.RecordType }</span><span class="query-fold-tight">{ logSourceLabel(entry.Source) }</span></span></td><td class="query-col-client"><code>{ entry.ClientIP }</code></td><td class="query-name query-col-domain" title={ entry.Name }><span class="query-name-text">{ entry.Name }</span><div class="query-fold query-fold-answers query-answers">@QueryAnswers(entry.Answers)</div></td><td class="query-col-type"><span class="pill query-type-pill">{ entry.RecordType }</span></td><td class="query-col-source"><span class={ "source-pill source-" + entry.Source }>{ logSourceLabel(entry.Source) }</span></td><td class="query-col-status"><span class={ "rcode " + rcodeClass(entry.Status) }>{ rcodeDisplay(entry.Status) }</span></td><td class="query-protocol query-col-protocol">{ ifThen(entry.Protocol != "", entry.Protocol, "—") }</td>
		<td class="query-answers query-col-answer">@QueryAnswers(entry.Answers)</td>
		<td class="query-row-actions">
			<button class="query-detail-button" type="button" data-query-detail-button aria-label={ "View details for " + entry.Name } title="View query details">@Icon("chevron-right")</button>
			if canBlocking && entry.Name != "" {
				if entry.Source != "blocked" {
					@QueryPolicyAction(entry.Name, "block", "shield-x", "Block "+entry.Name)
				}
				@QueryPolicyAction(entry.Name, "allow", "shield-check", "Allow "+entry.Name)
			}
		</td>
	</tr>
}

templ QueryDetailDialog(canBlocking bool) {
	<dialog class="query-detail-dialog" id="query-detail-dialog" aria-labelledby="query-detail-title">
		<header class="query-detail-header">
			<div><span>Query details</span><h2 id="query-detail-title" data-query-detail-value="name">—</h2></div>
			<button class="dialog-close" type="button" data-dialog-close aria-label="Close query details">@Icon("x")</button>
		</header>
		<div class="query-detail-body">
			<div class="query-detail-result" aria-label="Query result">
				<span class="source-pill" data-query-detail-source>—</span>
				<span class="rcode" data-query-detail-status>—</span>
			</div>
			<dl class="query-detail-grid">
				<div class="query-detail-fact-wide"><dt>Timestamp</dt><dd data-query-detail-value="time">—</dd></div>
				<div class="query-detail-fact-wide"><dt>Client</dt><dd><code data-query-detail-value="client">—</code></dd></div>
				<div><dt>Query type</dt><dd data-query-detail-value="type">—</dd></div>
				<div><dt>Protocol</dt><dd data-query-detail-value="protocol">—</dd></div>
				<div><dt>Duration</dt><dd data-query-detail-value="duration">—</dd></div>
			</dl>
			<section class="query-detail-answer" aria-labelledby="query-detail-answer-title">
				<h3 id="query-detail-answer-title">Answer</h3>
				<div data-query-detail-answers><span>—</span></div>
			</section>
		</div>
		<footer class="query-detail-footer">
			<button class="button outline" type="button" data-dialog-close>Close</button>
			if canBlocking {
				<div class="query-detail-policy-actions" data-query-detail-policy-actions>
					<form data-query-detail-policy="block" hx-post="/ui/blocking/query-domain" hx-target="body" hx-swap="beforeend"><input type="hidden" name="domain" data-query-detail-domain/><input type="hidden" name="action" value="block"/><button class="button outline destructive" type="submit">@Icon("shield-x")<span>Block</span></button></form>
					<form data-query-detail-policy="allow" hx-post="/ui/blocking/query-domain" hx-target="body" hx-swap="beforeend"><input type="hidden" name="domain" data-query-detail-domain/><input type="hidden" name="action" value="allow"/><button class="button" type="submit">@Icon("shield-check")<span>Allow</span></button></form>
				</div>
			}
		</footer>
	</dialog>
}

templ QueryPolicyAction(domain, action, icon, label string) {
	<form hx-post="/ui/blocking/query-domain" hx-target="body" hx-swap="beforeend"><input type="hidden" name="domain" value={ domain }/><input type="hidden" name="action" value={ action }/><button class={ "query-policy-action " + action } type="submit" aria-label={ label } title={ label }>@Icon(icon)</button></form>
}

templ SearchClear(empty bool) {
	<button class="search-clear" type="button" data-search-clear aria-label="Clear search" title="Clear search" hidden?={ empty }>@Icon("x")</button>
}

templ LogLiveButton(live bool) {
	<button class={ ifThen(live, "button outline live active", "button outline live") } type="button" data-log-live-toggle aria-pressed={ fmt.Sprint(live) }><span class="live-icon play">@Icon("play")</span><span class="live-icon pause">@Icon("pause")</span><span data-log-live-label>{ ifThen(live, "Pause", "Live") }</span></button>
}

templ LogOption(value, label, selected string) { <option value={ value } selected?={ strings.EqualFold(selected, value) }>{ label }</option> }

// queryFilterToken is one applied filter as the toolbar shows it while the
// filter bar is collapsed: what it matches, and where to go to drop just it.
type queryFilterToken struct {
	Label     string
	Value     string
	RemoveURL string
}

func queryFilterTokens(view QueryLogsView) []queryFilterToken {
	fields := []struct{ key, label, value string }{
		{"client_ip", "IP", view.ClientIP},
		{"name", "Domain", view.Name},
		{"record_type", "Type", view.RecordType},
		{"source", "Response", logSourceLabel(view.Source)},
		{"protocol", "Protocol", view.Protocol},
		{"response_code", "RCODE", view.ResponseCode},
	}
	tokens := make([]queryFilterToken, 0, len(fields)+1)
	for _, field := range fields {
		if field.value == "" {
			continue
		}
		tokens = append(tokens, queryFilterToken{Label: field.label, Value: field.value, RemoveURL: queryFilterURL(view, field.key)})
	}
	if view.Start != "" || view.End != "" {
		tokens = append(tokens, queryFilterToken{Label: "Window", Value: logWindowLabel(view.Start, view.End), RemoveURL: queryFilterURL(view, "start", "end")})
	}
	return tokens
}

// queryFilterURL rebuilds the log page with every filter except the ones named,
// which is what a token's remove control links to.
func queryFilterURL(view QueryLogsView, omit ...string) string {
	dropped := func(key string) bool { for _, name := range omit { if name == key { return true } }; return false }
	values := url.Values{"tab": []string{"queries"}}
	for key, value := range map[string]string{"client_ip": view.ClientIP, "name": view.Name, "record_type": view.RecordType, "response_code": view.ResponseCode, "source": view.Source, "protocol": view.Protocol, "start": view.Start, "end": view.End} {
		if value != "" && !dropped(key) {
			values.Set(key, value)
		}
	}
	// Exact only qualifies the client and domain filters, so it leaves with them.
	if view.Exact && (values.Get("client_ip") != "" || values.Get("name") != "") {
		values.Set("match", "exact")
	}
	if view.FiltersOpen {
		values.Set("filters", "1")
	}
	return "/logs?" + values.Encode()
}

// logWindowLabel reads a datetime-local bound back out for people rather than
// for the input that produced it.
func logWindowLabel(start, end string) string {
	switch {
	case start != "" && end != "":
		return logMomentLabel(start) + " – " + logMomentLabel(end)
	case start != "":
		return "After " + logMomentLabel(start)
	case end != "":
		return "Before " + logMomentLabel(end)
	default:
		return ""
	}
}

func logMomentLabel(value string) string {
	moment, err := time.Parse("2006-01-02T15:04", value)
	if err != nil {
		return value
	}
	return moment.Format("Jan 2, 15:04")
}

func queryRangeLabel(view QueryLogsView) string {
	if label := logWindowLabel(view.Start, view.End); label != "" {
		return label
	}
	return "Any time"
}
func queryPageSummary(view QueryLogsView) string { if view.TotalEntries == 0 { return "0 results" }; first := (view.Page-1)*view.PageSize+1; last := min(view.TotalEntries, view.Page*view.PageSize); return fmt.Sprintf("%s–%s of %s", formatCount(first), formatCount(last), formatCount(view.TotalEntries)) }
func logSourceLabel(source string) string { switch source { case "cache": return "Cached"; case "upstream": return "Recursive"; case "authoritative": return "Authoritative"; case "local": return "Local"; case "blocked": return "Blocked"; case "error": return "Error"; default: return source } }
// runtimeLogURL names the same slice of the log for the panel and for the
// export. The follow flag is spelled out rather than left off when paused,
// because an absent flag means follow.
func runtimeLogURL(view RuntimeLogsView, path string, follow bool) string {
	values := make([]string, 0, 5)
	if view.Search != "" {
		values = append(values, "search="+urlQueryEscape(view.Search))
	}
	if view.Level != "" {
		values = append(values, "level="+urlQueryEscape(view.Level))
	}
	if view.Persisted {
		values = append(values, "page=1", "page_size="+fmt.Sprint(view.PageSize))
	}
	if follow {
		values = append(values, "live="+ifThen(view.Live, "1", "0"))
	}
	return path + "?" + strings.Join(values, "&")
}

func runtimePanelURL(view RuntimeLogsView) string { return runtimeLogURL(view, "/ui/logs/runtime", true) }
func runtimeLogCount(view RuntimeLogsView) string { if view.Persisted { return fmt.Sprintf("%s entries", formatCount(view.TotalEntries)) }; return fmt.Sprintf("%s entries", formatCount(view.Count)) }
func runtimePageSummary(view RuntimeLogsView) string { if view.TotalEntries == 0 { return "0 results" }; first := (view.Page-1)*view.PageSize+1; last := min(view.TotalEntries, view.Page*view.PageSize); return fmt.Sprintf("%s\u2013%s of %s", formatCount(first), formatCount(last), formatCount(view.TotalEntries)) }
func runtimeExportURL(view RuntimeLogsView) string { return runtimeLogURL(view, "/api/v1/logs/runtime/export", false) }
func queryPanelLiveURL(view QueryLogsView) string {
	values := url.Values{"page": []string{"1"}, "page_size": []string{fmt.Sprint(view.PageSize)}}
	for key, value := range map[string]string{"client_ip": view.ClientIP, "name": view.Name, "record_type": view.RecordType, "response_code": view.ResponseCode, "source": view.Source, "protocol": view.Protocol, "start": view.Start, "end": view.End} {
		if value != "" {
			values.Set(key, value)
		}
	}
	if view.Exact {
		values.Set("match", "exact")
	}
	if view.Live {
		values.Set("live", "1")
	}
	if view.FiltersOpen {
		values.Set("filters", "1")
	}
	return "/ui/logs/queries?" + values.Encode()
}
func urlQueryEscape(value string) string { return url.QueryEscape(value) }
func hasAnswers(answers []string) bool { for _, answer := range answers { if answer != "" { return true } }; return false }
func formatCount(value int) string { if value < 1_000 { return fmt.Sprint(value) }; whole := fmt.Sprintf("%d", value); for index := len(whole)-3; index > 0; index -= 3 { whole = whole[:index]+","+whole[index:] }; return whole }
