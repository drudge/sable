package pages

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"
)

type LogsPageView struct {
	Console   DashboardView
	ActiveTab string
	Runtime   RuntimeLogsView
	Queries   QueryLogsView
}

type RuntimeLogsView struct {
	Entries  []RuntimeLogEntryView
	Count    int
	Search   string
	Level    string
	Live     bool
	CopyText string
	Error    string
	// Persisted reports that these entries came from the stored history rather
	// than this process's buffer, which is what makes paging past the current
	// run meaningful.
	Persisted    bool
	Page         int
	PageSize     int
	TotalEntries int
	TotalPages   int
	FirstURL     string
	PreviousURL  string
	NextURL      string
	LastURL      string
}

type RuntimeLogEntryView struct {
	OccurredAt string
	Level      string
	Message    string
	Attributes string
}

type QueryLogsView struct {
	Entries      []QueryLogEntryView
	Page         int
	PageSize     int
	TotalEntries int
	TotalPages   int
	ClientIP     string
	Name         string
	RecordType   string
	ResponseCode string
	Source       string
	Protocol     string
	// Start and End bound the window the page counts, in the form a
	// datetime-local input accepts. Exact matches the client and domain whole
	// rather than as a substring, which is what a dashboard ranking links with
	// so its total and this page's total describe the same rows.
	Start        string
	End          string
	Exact        bool
	Live         bool
	NewestID     int64
	FiltersOpen  bool
	CanBlocking  bool
	// CanWatch offers a watch on a query's domain from its details.
	CanWatch     bool
	CopyText     string
	FirstURL     string
	PreviousURL  string
	NextURL      string
	LastURL      string
	ExportURL    string
	Error        string
}

// logsTabs drives both the tab strip and the document title so the browser tab
// names the log source an operator is actually looking at.
var logsTabs = []tabOption{
	{Value: "server", Label: "Server Logs"},
	{Value: "queries", Label: "Query Logs"},
}

templ LogsPage(view LogsPageView) {
	@AppDocument(view.Console, documentTitle(tabLabel(logsTabs, view.ActiveTab), "Logs"), "logs", logsDocument(view))
}

// logsDocument keeps the query details panel outside the query log, so the
// log can refresh beneath it and the panel opens even when no rows show.
templ logsDocument(view LogsPageView) {
	@LogsContent(view)
	@QueryDetailDialog(view.Queries.CanBlocking, view.Queries.CanWatch, queryFilterURL(view.Queries))
}

templ LogsContent(view LogsPageView) {
	<div class="logs-page page-stack isotope-control-page" data-isotope-tabs data-active-tab={ view.ActiveTab } data-tab-param="tab" data-title-base="Logs">
		<header class="logs-heading"><div class="page-heading"><h1>Logs</h1><p>View server logs and DNS query history</p></div><a class="icon-button" href="/settings?tab=logging" aria-label="Logging settings" title="Logging settings">@Icon("settings")</a></header>
		<div class="isotope-tab-list logs-tab-list" role="tablist" aria-label="Log sources">
			for _, tab := range logsTabs {
				<button class={ ifThen(view.ActiveTab == tab.Value, "isotope-tab active", "isotope-tab") } type="button" role="tab" data-isotope-tab={ tab.Value } data-tab-title={ tab.Label } aria-selected={ fmt.Sprint(view.ActiveTab == tab.Value) } tabindex={ ifThen(view.ActiveTab == tab.Value, "0", "-1") }>{ tab.Label }</button>
			}
		</div>
		<div class="logs-tab-panel" role="tabpanel" data-isotope-panel="server" hidden?={ view.ActiveTab != "server" }>@RuntimeLogsPanel(view.Runtime)</div>
		<div class="logs-tab-panel" role="tabpanel" data-isotope-panel="queries" hidden?={ view.ActiveTab != "queries" }>@QueryLogsPanel(view.Queries)</div>
	</div>
}

templ RuntimeLogsPanel(view RuntimeLogsView) {
	<section class="card logs-card" id="runtime-logs-panel" aria-labelledby="runtime-log-title" tabindex="-1" data-log-live-panel data-live-refresh data-live={ fmt.Sprint(view.Live) } data-live-url={ runtimePanelURL(view) }>
		<header class="logs-toolbar">
			<div><div class="log-title"><h2 id="runtime-log-title">@Icon("file-text")<span>Runtime Log</span></h2><span class="log-total">{ runtimeLogCount(view) }</span></div></div>
			<div class="logs-toolbar-actions">
				@LogLiveButton(view.Live)
				<label class="runtime-level-field"><span class="sr-only">Log level</span><select name="level" aria-label="Log level" data-runtime-level data-styled-select><option value="all" selected?={ view.Level == "all" }>All Levels</option><option value="debug" selected?={ view.Level == "debug" }>Debug</option><option value="info" selected?={ view.Level == "info" }>Info</option><option value="warn" selected?={ view.Level == "warn" }>Warning</option><option value="error" selected?={ view.Level == "error" }>Error</option></select></label>
			</div>
		</header>
		// The level sits with the live toggle but posts with the search, so both
		// controls take effect on their own rather than through a Search button.
		// It swaps without a settle: htmx lends the new box the old one's value
		// for the settle, and focus returns to the box before it gives it back,
		// so the box would show the term before the last one typed.
		<form class="log-search-bar" id="runtime-log-search-bar" hx-get="/ui/logs/runtime" hx-target="#runtime-logs-panel" hx-swap="outerHTML settle:0" hx-trigger="submit, input delay:400ms from:#runtime-log-search, change from:[data-runtime-level]" hx-include="[data-runtime-level]">
			@SearchField("Search server logs", "Search server logs...", view.Search, "", templ.Attributes{"id": "runtime-log-search", "name": "search"})
			<input type="hidden" name="live" value={ ifThen(view.Live, "1", "0") } data-log-live-input/>
			<input type="hidden" name="page_size" value={ fmt.Sprint(view.PageSize) }/>
			<div class="log-result-actions"><button class="icon-button" type="button" data-copy-target="runtime-log-copy" aria-label="Copy current entries" title="Copy current entries">@Icon("copy")</button><a class="icon-button" href={ templ.SafeURL(runtimeExportURL(view)) } aria-label="Export server logs" title="Export server logs">@Icon("download")</a></div>
		</form>
		<textarea class="sr-only" id="runtime-log-copy" readonly tabindex="-1" aria-hidden="true">{ view.CopyText }</textarea>
		if view.Error != "" {
			<div class="logs-empty error" role="alert">{ view.Error }</div>
		} else if len(view.Entries) == 0 {
			<div class="logs-empty" role="status">No runtime log entries match these filters.</div>
		} else {
			<div class="runtime-log-viewer" role="log" aria-live="polite" aria-relevant="additions text" aria-atomic="false" aria-label="Runtime log entries" tabindex="0">
				for _, entry := range view.Entries {
					<div class={ "runtime-log-line level-" + entry.Level }><time>{ entry.OccurredAt }</time><span class="runtime-log-level">{ strings.ToUpper(entry.Level) }</span><span class="runtime-log-message">{ entry.Message }</span>if entry.Attributes != "" {
						<span class="runtime-log-attributes">{ entry.Attributes }</span>
					}</div>
				}
			</div>
		}
		if view.Persisted {
			<footer class="logs-pagination"><div><span>Rows per page</span><select name="page_size" data-query-page-size data-styled-select aria-label="Rows per page"><option selected?={ view.PageSize == 50 }>50</option><option selected?={ view.PageSize == 100 }>100</option><option selected?={ view.PageSize == 250 }>250</option></select></div><span>{ runtimePageSummary(view) }</span><nav aria-label="Server log pages"><button class="icon-button" hx-get={ view.FirstURL } hx-target="#runtime-logs-panel" hx-swap="outerHTML" disabled?={ view.Page <= 1 } aria-label="First page">@Icon("chevrons-left")</button><button class="icon-button" hx-get={ view.PreviousURL } hx-target="#runtime-logs-panel" hx-swap="outerHTML" disabled?={ view.Page <= 1 } aria-label="Previous page">@Icon("chevron-left")</button><button class="icon-button" hx-get={ view.NextURL } hx-target="#runtime-logs-panel" hx-swap="outerHTML" disabled?={ view.Page >= view.TotalPages } aria-label="Next page">@Icon("chevron-right")</button><button class="icon-button" hx-get={ view.LastURL } hx-target="#runtime-logs-panel" hx-swap="outerHTML" disabled?={ view.Page >= view.TotalPages } aria-label="Last page">@Icon("chevrons-right")</button></nav></footer>
		}
	</section>
}

templ QueryLogsPanel(view QueryLogsView) {
	{{ tokens := queryFilterTokens(view) }}
	<section class="card logs-card" id="query-logs-panel" aria-labelledby="query-log-title" tabindex="-1" data-log-live-panel data-live-refresh data-live={ fmt.Sprint(view.Live) } data-live-url={ queryPanelLiveURL(view) }>
		<header class="logs-toolbar query-logs-toolbar">
			<div>
				<div class="log-title"><h2 id="query-log-title">@Icon("logs")<span>DNS Query Log</span></h2><span class="log-total">{ fmt.Sprintf("%s entries", formatCount(view.TotalEntries)) }</span></div>
				if len(tokens) > 0 {
					<div class="query-filter-tokens">
						for _, token := range tokens {
							<span class="query-filter-token"><b>{ token.Label }:</b><span title={ token.Value }>{ token.Value }</span><a href={ templ.SafeURL(token.RemoveURL) } aria-label={ "Remove the " + token.Label + " filter" } title={ "Remove the " + token.Label + " filter" }>@Icon("x")</a></span>
						}
						<a class="query-filter-clear" href="/logs?tab=queries" aria-label="Clear all filters" title="Clear all filters">@Icon("x")</a>
					</div>
				}
			</div>
			<div class="logs-toolbar-actions">
				@LogLiveButton(view.Live)
				<button class={ ifThen(view.FiltersOpen, "button outline filters-toggle active", "button outline filters-toggle") } type="button" data-query-filters-toggle aria-expanded={ fmt.Sprint(view.FiltersOpen) } aria-controls="query-log-filters">@Icon("filter")<span>Filters</span>
					if len(tokens) > 0 {
						<span class="filter-count">{ fmt.Sprint(len(tokens)) }</span>
					}
					<span class="button-caret">@Icon("chevron-down")</span>
				</button>
			</div>
		</header>
		<div class="query-log-filters isotope-query-filters" id="query-log-filters" data-query-filters hidden?={ !view.FiltersOpen }>
			<form hx-get="/ui/logs/queries" hx-target="#query-logs-panel" hx-swap="outerHTML">
				<div class="query-filter-grid">
					<label><span>Client IP</span><input name="client_ip" value={ view.ClientIP } placeholder="e.g. 10.0.7.168"/></label>
					<label><span>Domain</span><input name="name" value={ view.Name } placeholder="e.g. example.com"/></label>
					<label><span>Query Type</span><input name="record_type" value={ view.RecordType } placeholder="e.g. A, AAAA"/></label>
					<label><span>Response Type</span><select name="source" data-styled-select>@LogOption("", "All Types", view.Source)@LogOption("authoritative", "Authoritative", view.Source)@LogOption("upstream", "Recursive", view.Source)@LogOption("cache", "Cached", view.Source)@LogOption("blocked", "Blocked", view.Source)@LogOption("local", "Local", view.Source)@LogOption("error", "Error", view.Source)</select></label>
					<label><span>Protocol</span><select name="protocol" data-styled-select>@LogOption("", "All Protocols", view.Protocol)@LogOption("UDP", "UDP", view.Protocol)@LogOption("TCP", "TCP", view.Protocol)@LogOption("TLS", "TLS", view.Protocol)@LogOption("HTTPS", "HTTPS", view.Protocol)@LogOption("QUIC", "QUIC", view.Protocol)</select></label>
					<label><span>RCODE</span><input name="response_code" value={ view.ResponseCode } placeholder="e.g. NoError"/></label>
					<div class="query-filter-range query-filter-wide" data-range-root>
						<span>Time Range</span>
						<button class="range-trigger" type="button" data-range-open aria-haspopup="dialog" aria-expanded="false" aria-controls="query-log-range">@Icon("calendar")<span data-range-label>{ queryRangeLabel(view) }</span><span class="styled-select-chevron" aria-hidden="true"></span></button>
						<input type="hidden" name="start" value={ view.Start } data-range-start/>
						<input type="hidden" name="end" value={ view.End } data-range-end/>
						<div class="range-popover query-range-popover" id="query-log-range" role="dialog" aria-label="Query log time range" data-range-popover data-range-default-end-time="23:59" hidden>
							<div class="range-picker-body">
								@RangeCalendar()
								<div class="range-times">
									<label><span>From</span><input class="time-field" type="time" step="60" data-range-start-time data-styled-time/></label>
									<label><span>To</span><input class="time-field" type="time" step="60" data-range-end-time data-styled-time/></label>
								</div>
								<p class="range-error" role="alert" data-range-error hidden></p>
								<div class="range-picker-actions">
									<button class="button outline" type="button" data-range-clear>Any time</button>
									<button class="button range-apply" type="button" data-range-apply>Apply</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<input type="hidden" name="page_size" value={ fmt.Sprint(view.PageSize) }/><input type="hidden" name="live" value={ ifThen(view.Live, "1", "0") } data-log-live-input/><input type="hidden" name="filters" value="1"/>
				if view.Exact {
					<input type="hidden" name="match" value="exact"/>
				}
				<div class="query-filter-actions"><button class="button" type="submit">@Icon("search")<span>Search</span></button>if len(tokens) > 0 {
					<a class="button outline" href="/logs?tab=queries">@Icon("refresh")<span>Clear</span></a>
				}</div>
			</form>
		</div>
		<div class="log-search-bar query-result-search">@SearchField("Search in results", "Search in results...", "", "", templ.Attributes{"data-query-result-search": true})<div class="log-result-actions"><button class="icon-button" type="button" data-copy-target="query-log-copy" aria-label="Copy current results" title="Copy current results">@Icon("copy")</button><a class="icon-button" href={ templ.SafeURL(view.ExportURL) } aria-label="Export query logs" title="Export query logs">@Icon("download")</a></div></div>
		<textarea class="sr-only" id="query-log-copy" readonly tabindex="-1" aria-hidden="true">{ view.CopyText }</textarea>
		if view.Error != "" {
			<div class="logs-empty error" role="alert">{ view.Error }</div>
		} else if len(view.Entries) == 0 {
			<div class="logs-empty" role="status">No DNS queries match these filters.</div>
		} else {
			<div class="table-scroll query-log-table-scroll" role="region" aria-label="DNS query results" tabindex="0"><table class="query-log-table full isotope-query-log-table"><caption class="sr-only">DNS query results. Use the details button in each row for the full decision path.</caption><thead><tr><th class="query-col-time">Timestamp</th><th class="query-col-client">Client IP</th><th class="query-col-domain">Domain</th><th class="query-col-type">Type</th><th class="query-col-source">Response</th><th class="query-col-status">Status</th><th class="query-col-protocol">Protocol</th><th class="query-col-answer">Answer</th><th class="query-col-actions"><span class="sr-only">Actions</span></th></tr></thead><tbody>
				for _, entry := range view.Entries {
					@QueryLogTableRow(entry, view.CanBlocking)
				}
			</tbody></table></div>
		}
		<footer class="logs-pagination"><div><span>Rows per page</span><select name="page_size" data-query-page-size data-styled-select aria-label="Rows per page"><option selected?={ view.PageSize == 25 }>25</option><option selected?={ view.PageSize == 50 }>50</option><option selected?={ view.PageSize == 100 }>100</option><option selected?={ view.PageSize == 250 }>250</option></select></div><span>{ queryPageSummary(view) }</span><nav aria-label="Query log pages"><button class="icon-button" hx-get={ view.FirstURL } hx-target="#query-logs-panel" hx-swap="outerHTML" disabled?={ view.Page <= 1 } aria-label="First page">@Icon("chevrons-left")</button><button class="icon-button" hx-get={ view.PreviousURL } hx-target="#query-logs-panel" hx-swap="outerHTML" disabled?={ view.Page <= 1 } aria-label="Previous page">@Icon("chevron-left")</button><button class="icon-button" hx-get={ view.NextURL } hx-target="#query-logs-panel" hx-swap="outerHTML" disabled?={ view.Page >= view.TotalPages } aria-label="Next page">@Icon("chevron-right")</button><button class="icon-button" hx-get={ view.LastURL } hx-target="#query-logs-panel" hx-swap="outerHTML" disabled?={ view.Page >= view.TotalPages } aria-label="Last page">@Icon("chevrons-right")</button></nav></footer>
	</section>
}

templ QueryAnswers(answers []string) {
	if hasAnswers(answers) {
		<div>
			for _, answer := range answers {
				if answer != "" {
					<span title={ answer }>{ answer }</span>
				}
			}
		</div>
	} else {
		<span class="muted-cell">—</span>
	}
}

templ QueryLogTableRow(entry QueryLogEntryView, canBlocking bool) {
	<tr
		data-query-result-row
		data-query-detail-row
		data-query-detail-time={ entry.OccurredAt }
		data-query-detail-client={ entry.ClientIP }
		data-query-detail-name={ entry.Name }
		data-query-detail-type={ entry.RecordType }
		data-query-detail-source={ entry.Source }
		data-query-detail-source-label={ logSourceLabel(entry.Source) }
		data-query-detail-status-label={ rcodeDisplay(entry.Status) }
		data-query-detail-protocol={ entry.Protocol }
		data-query-detail-duration={ entry.Duration }
		data-query-detail-answers={ strings.Join(entry.Answers, "\n") }
		data-query-detail-explain-available={ fmt.Sprint(entry.Decision.Available) }
		data-query-detail-explain-summary={ entry.Decision.Summary }
		data-query-detail-policy-label={ entry.Decision.Policy }
		data-query-detail-policy-detail={ entry.Decision.PolicyDetail }
		data-query-detail-cache-label={ entry.Decision.Cache }
		data-query-detail-resolver-label={ entry.Decision.Resolver }
		data-query-detail-resolver-detail={ entry.Decision.ResolverDetail }
		data-query-detail-dnssec-label={ entry.Decision.DNSSEC }
		if entry.ID > 0 {
			data-query-detail-id={ strconv.FormatInt(entry.ID, 10) }
			data-query-detail-link={ QueryPath(entry.ID, entry.Name) }
		}
	>
		// The client and the protocol ride under the timestamp, and the answers
		// under the domain, so the narrow layout can drop those columns without
		// dropping what they said.
		<td class="query-time query-col-time"><time title={ entry.OccurredAt }>{ entry.OccurredAt }</time><span class="query-fold query-fold-meta"><code title={ entry.ClientIP }>{ entry.ClientIP }</code><span>{ ifThen(entry.Protocol != "", entry.Protocol, "—") }</span><span class="query-fold-tight">{ entry.RecordType }</span><span class="query-fold-tight">{ logSourceLabel(entry.Source) }</span></span></td><td class="query-col-client"><code title={ entry.ClientIP }>{ entry.ClientIP }</code></td><td class="query-name query-col-domain" title={ entry.Name }><span class="query-name-text">{ entry.Name }</span><div class="query-fold query-fold-answers query-answers">@QueryAnswers(entry.Answers)</div></td><td class="query-col-type"><span class="pill query-type-pill">{ entry.RecordType }</span></td><td class="query-col-source"><span class={ "source-pill source-" + entry.Source }>{ logSourceLabel(entry.Source) }</span></td><td class="query-col-status"><span class={ "rcode " + rcodeClass(entry.Status) }>{ rcodeDisplay(entry.Status) }</span></td><td class="query-protocol query-col-protocol">{ ifThen(entry.Protocol != "", entry.Protocol, "—") }</td>
		<td class="query-answers query-col-answer">@QueryAnswers(entry.Answers)</td>
		<td class="query-row-actions">
			<div class="query-row-controls">
				<button class="query-detail-button" type="button" data-query-detail-button aria-label={ "View details for " + entry.Name } title="View query details">@Icon("chevron-right")</button>
				if canBlocking && entry.Name != "" {
					if entry.Source != "blocked" {
						@QueryPolicyAction(entry.Name, "block", "shield-x", "Block "+entry.Name)
					}
					@QueryPolicyAction(entry.Name, "allow", "shield-check", "Allow "+entry.Name)
				}
			</div>
		</td>
	</tr>
}

// QueryRoute is where one query's details panel lives. Each query's address
// opens Query Logs with its panel open.
const QueryRoute = "/logs/queries/"

// QueryPath is the address of one query's panel. It carries the domain, so
// the page beneath shows its queries, and a query that has aged out of the
// log can still offer a search for them.
func QueryPath(id int64, name string) string {
	path := QueryRoute + strconv.FormatInt(id, 10)
	if name = strings.TrimSuffix(name, "."); name != "" {
		path += "?" + url.Values{"name": []string{name}}.Encode()
	}
	return path
}

// QueryDetailView is one query in its details panel. Without Loaded, the
// panel is blank, for the page's script to fill from the row that opened it.
type QueryDetailView struct {
	Entry QueryLogEntryView
	// Loaded is set when Entry was read by the query's address.
	Loaded bool
	// Missing is set when the address names a query no longer in the log.
	// Name is the domain the address carried, if any.
	Missing bool
	Name    string
	CanBlocking bool
	CanWatch    bool
}

// QueryDetailDialog is the query details panel. A row fills it in place, so
// it opens at once; an address loads the query from the server instead.
templ QueryDetailDialog(canBlocking, canWatch bool, base string) {
	<dialog class="query-detail-dialog" id="query-detail-dialog" aria-labelledby="query-detail-title" { queryDrawerRoute(base)... }>
		<div class="query-detail-content" id="query-detail-content">
			@QueryDetail(QueryDetailView{CanBlocking: canBlocking, CanWatch: canWatch})
		</div>
	</dialog>
	<template id="query-detail-blank">
		@QueryDetail(QueryDetailView{CanBlocking: canBlocking, CanWatch: canWatch})
	</template>
	<template id="query-detail-loading">
		@queryDetailLoading()
	</template>
}

func queryDrawerRoute(base string) templ.Attributes {
	attributes := insightDrawerRoute(QueryRoute, "/ui/logs/query", "id", "query-detail-content", "query-detail-loading", base)
	attributes["data-drawer-forward"] = "name"
	return attributes
}

templ queryDetailLoading() {
	@DetailDrawerContent(DetailDrawerView{ID: "query-detail-dialog", TitleID: "query-detail-title", Eyebrow: "Query details", Title: "Loading…", CloseLabel: "Close query details"}, templ.NopComponent) {
		<div class="insight-device-loading" role="status" aria-live="polite">
			<span class="sr-only">Loading query details…</span>
			<span class="insight-skeleton-line insights-skeleton-block"></span>
			<span class="insight-skeleton-title insights-skeleton-block"></span>
			<span class="insight-skeleton-line insights-skeleton-block"></span>
		</div>
	}
}

// QueryDetail is the inside of the query details panel. The page's script
// fills a blank one through its data-query-detail hooks, so a loaded one
// keeps every hook for the next row to fill.
templ QueryDetail(view QueryDetailView) {
	if view.Missing {
		@queryMissing(view)
	} else {
		{{ entry := view.Entry }}
		@DetailDrawerContent(DetailDrawerView{
			ID: "query-detail-dialog", TitleID: "query-detail-title", Eyebrow: "Query details", Title: queryDetailText(entry.Name), CloseLabel: "Close query details",
			TitleAttributes: templ.Attributes{"data-query-detail-value": "name"},
		}, queryDetailFooter(view)) {
			<div class="query-detail-result" aria-label="Query result">
				<span class={ queryDetailSourceClass(entry.Source) } data-query-detail-source>{ ifThen(view.Loaded, logSourceLabel(entry.Source), "—") }</span>
				<span class={ "rcode " + ifThen(view.Loaded, rcodeClass(entry.Status), "") } data-query-detail-status>{ ifThen(view.Loaded, rcodeDisplay(entry.Status), "—") }</span>
			</div>
			<dl class="query-detail-grid">
				<div class="query-detail-fact-wide"><dt>Timestamp</dt><dd data-query-detail-value="time">{ queryDetailText(entry.OccurredAt) }</dd></div>
				<div class="query-detail-fact-wide"><dt>Client</dt><dd><code data-query-detail-value="client">{ queryDetailText(entry.ClientIP) }</code></dd></div>
				<div><dt>Query type</dt><dd data-query-detail-value="type">{ queryDetailText(entry.RecordType) }</dd></div>
				<div><dt>Protocol</dt><dd data-query-detail-value="protocol">{ queryDetailText(entry.Protocol) }</dd></div>
				<div><dt>Duration</dt><dd data-query-detail-value="duration">{ queryDetailText(entry.Duration) }</dd></div>
			</dl>
			<section class="query-detail-answer" aria-labelledby="query-detail-answer-title">
				<h3 id="query-detail-answer-title">Answer</h3>
				<div data-query-detail-answers>
					if hasAnswers(entry.Answers) {
						for _, answer := range entry.Answers {
							if answer != "" {
								<code>{ answer }</code>
							}
						}
					} else {
						<span>—</span>
					}
				</div>
			</section>
			<section class="query-detail-explain" aria-labelledby="query-detail-explain-title">
				<div class="query-detail-section-heading"><h3 id="query-detail-explain-title">Why this answer?</h3><p data-query-detail-explain-summary hidden?={ view.Loaded && !entry.Decision.Available }>{ ifThen(entry.Decision.Summary != "", entry.Decision.Summary, "See how Sable handled this query.") }</p></div>
				<ol class="query-decision-path" data-query-detail-explain-path hidden?={ view.Loaded && !entry.Decision.Available }>
					@QueryDecisionStep("policy", "Policy", entry.Decision.Policy, entry.Decision.PolicyDetail)
					@QueryDecisionStep("cache", "Cache", entry.Decision.Cache, "")
					@QueryDecisionStep("resolver", "Resolver", entry.Decision.Resolver, entry.Decision.ResolverDetail)
					@QueryDecisionStep("dnssec", "DNSSEC", entry.Decision.DNSSEC, "")
				</ol>
				<p class="query-detail-explain-legacy" data-query-detail-explain-legacy hidden?={ !view.Loaded || entry.Decision.Available }>Decision details were not recorded for this older query.</p>
				// The page's script points it at the open query's domain, and
				// shows it only for a blocked query.
				<a class="inline-link query-detail-why" href={ templ.SafeURL(CheckDomainPath(entry.Name)) } data-query-detail-why hidden?={ !view.Loaded || entry.Source != "blocked" }>@Icon("shield-question")<span>Why is this blocked?</span></a>
			</section>
		}
	}
}

// queryMissing opens for a query's address when the query is no longer in
// the log. It offers a search for the domain the address carried.
templ queryMissing(view QueryDetailView) {
	@DetailDrawerContent(DetailDrawerView{ID: "query-detail-dialog", TitleID: "query-detail-title", Eyebrow: "Query details", Title: "Not showing right now", CloseLabel: "Close query details"}, queryMissingFooter(view)) {
		<div class="insight-findings-empty insight-link-missing">
			<span>@Icon("search")</span>
			<strong>This query is no longer in the log</strong>
			<p>Sable only keeps queries for a while, so it may have aged out.{ ifThen(view.Name != "", " Newer queries for "+view.Name+" may still be there.", "") }</p>
		</div>
	}
}

templ queryMissingFooter(view QueryDetailView) {
	if view.Name != "" {
		<div class="query-detail-policy-actions insight-drawer-actions">
			<a class="button" href={ templ.SafeURL(queryDomainSearchURL(view.Name)) }>@Icon("search")<span>Search Query Logs</span></a>
		</div>
	}
}

func queryDomainSearchURL(name string) string {
	return "/logs?" + url.Values{"tab": []string{"queries"}, "name": []string{name}}.Encode()
}

func queryDetailText(value string) string { return ifThen(value != "", value, "—") }

func queryDetailSourceClass(source string) string {
	switch source {
	case "authoritative", "upstream", "cache", "blocked", "local", "error":
		return "source-pill source-" + source
	}
	return "source-pill"
}

// queryWatchURL opens Settings with a watch on the query's domain, from its
// client.
func queryWatchURL(entry QueryLogEntryView) string {
	values := url.Values{"tab": []string{"alerts"}}
	if entry.Name != "" {
		values.Set("watch_domain", entry.Name)
	}
	if entry.ClientIP != "" {
		values.Set("watch_client", entry.ClientIP)
	}
	return "/settings?" + values.Encode()
}

templ queryDetailFooter(view QueryDetailView) {
	<div class="query-detail-policy-actions" data-query-detail-policy-actions>
		// The page's script points these at the open query.
		@queryCopyLinkButton(ifThen(view.Loaded, QueryPath(view.Entry.ID, view.Entry.Name), ""))
		if view.CanWatch {
			<a class="button outline" href={ templ.SafeURL(queryWatchURL(view.Entry)) } data-query-detail-watch aria-label={ "Watch " + view.Entry.Name }>@Icon("eye")<span>Watch</span></a>
		}
		if view.CanBlocking {
			<form data-query-detail-policy="block" hx-post="/ui/blocking/query-domain" hx-target="body" hx-swap="beforeend" hidden?={ view.Entry.Source == "blocked" }><input type="hidden" name="domain" value={ view.Entry.Name } data-query-detail-domain/><input type="hidden" name="action" value="block"/><button class="button outline destructive" type="submit">@Icon("shield-x")<span>Block</span></button></form>
			<form data-query-detail-policy="allow" hx-post="/ui/blocking/query-domain" hx-target="body" hx-swap="beforeend"><input type="hidden" name="domain" value={ view.Entry.Name } data-query-detail-domain/><input type="hidden" name="action" value="allow"/><button class="button" type="submit">@Icon("shield-check")<span>Allow</span></button></form>
		}
	</div>
}

// queryCopyLinkButton is CopyLinkButton with the hook the page's script uses
// to point it at the open query.
templ queryCopyLinkButton(link string) {
	<button class="button outline copy-link-button" type="button" data-copy-url={ link } data-query-detail-copy-link hidden?={ link == "" }>@Icon("link")<span data-copy-label>Copy Link</span></button>
}

// DetailDrawerView describes the side drawer that explains one record: a query
// on the Logs page, or the evidence behind an Insights finding. It slides in
// from the right on wide screens and rises as a sheet on phones.
type DetailDrawerView struct {
	ID      string
	TitleID string
	// Eyebrow is the small uppercase label naming what kind of record is open.
	// Range follows it when the drawer's numbers cover a window of time, such
	// as Last 30 days, so a drawer opened from a link says which.
	Eyebrow string
	Range   string
	// Title is the record itself, set in the monospace face used for DNS data.
	Title           string
	TitleAttributes templ.Attributes
	CloseLabel      string
	// TitleAction sits beside the title, such as a rename button, and
	// TitleEditor replaces the visible title while it is being edited.
	TitleAction templ.Component
	TitleEditor templ.Component
	// Leading sits before the title, such as an icon for what the record is.
	Leading templ.Component
	// Attributes go on the dialog itself, such as the address it has while
	// it is open.
	Attributes templ.Attributes
}

// DetailDrawer renders the drawer shell. The body is passed as children and the
// footer actions as a component.
templ DetailDrawer(view DetailDrawerView, footer templ.Component) {
	<dialog class="query-detail-dialog" id={ view.ID } aria-labelledby={ view.TitleID } { view.Attributes... }>
		@DetailDrawerContent(view, footer) {
			{ children... }
		}
	</dialog>
}

// DetailDrawerContent is the inside of a drawer. A drawer whose record is
// loaded on demand swaps this into an already open dialog.
templ DetailDrawerContent(view DetailDrawerView, footer templ.Component) {
	<header class="query-detail-header">
		if view.Leading != nil {
			@view.Leading
		}
		if view.TitleEditor != nil {
			<div class="query-detail-title-editor">@detailDrawerEyebrow(view)<h2 class="sr-only" id={ view.TitleID } { view.TitleAttributes... }>{ view.Title }</h2>@view.TitleEditor</div>
		} else if view.TitleAction != nil {
			<div>@detailDrawerEyebrow(view)<div class="query-detail-title-row"><h2 id={ view.TitleID } { view.TitleAttributes... }>{ view.Title }</h2>@view.TitleAction</div></div>
		} else {
			<div>@detailDrawerEyebrow(view)<h2 id={ view.TitleID } { view.TitleAttributes... }>{ view.Title }</h2></div>
		}
		<button class="dialog-close" type="button" data-dialog-close aria-label={ view.CloseLabel }>@Icon("x")</button>
	</header>
	<div class="query-detail-body">
		{ children... }
	</div>
	<footer class="query-detail-footer">
		@footer
	</footer>
}

// detailDrawerEyebrow is the eyebrow, then the window the drawer covers when it
// has one.
templ detailDrawerEyebrow(view DetailDrawerView) {
	<span>
		{ view.Eyebrow }
		if view.Range != "" {
			<span class="query-detail-range">{ view.Range }</span>
		}
	</span>
}

templ QueryDecisionStep(name, title, label, detail string) {
	<li data-query-decision-step={ name } hidden?={ label == "" }><span class="query-decision-marker" aria-hidden="true"></span><div><span class="query-decision-kind">{ title }</span><strong data-query-decision-label>{ label }</strong><span data-query-decision-detail hidden?={ detail == "" }>{ detail }</span></div></li>
}

templ QueryPolicyAction(domain, action, icon, label string) {
	<form hx-post="/ui/blocking/query-domain" hx-target="body" hx-swap="beforeend"><input type="hidden" name="domain" value={ domain }/><input type="hidden" name="action" value={ action }/><button class={ "query-policy-action " + action } type="submit" aria-label={ label } title={ label }>@Icon(icon)</button></form>
}


templ LogLiveButton(live bool) {
	<button class={ ifThen(live, "button outline live active", "button outline live") } type="button" data-log-live-toggle aria-pressed={ fmt.Sprint(live) }><span class="live-icon play">@Icon("play")</span><span class="live-icon pause">@Icon("pause")</span><span data-log-live-label>{ ifThen(live, "Pause", "Live") }</span></button>
}

templ LogOption(value, label, selected string) { <option value={ value } selected?={ strings.EqualFold(selected, value) }>{ label }</option> }

// queryFilterToken is one applied filter as the toolbar shows it while the
// filter bar is collapsed: what it matches, and where to go to drop just it.
type queryFilterToken struct {
	Label     string
	Value     string
	RemoveURL string
}

func queryFilterTokens(view QueryLogsView) []queryFilterToken {
	fields := []struct{ key, label, value string }{
		{"client_ip", "IP", view.ClientIP},
		{"name", "Domain", view.Name},
		{"record_type", "Type", view.RecordType},
		{"source", "Response", logSourceLabel(view.Source)},
		{"protocol", "Protocol", view.Protocol},
		{"response_code", "RCODE", view.ResponseCode},
	}
	tokens := make([]queryFilterToken, 0, len(fields)+1)
	for _, field := range fields {
		if field.value == "" {
			continue
		}
		tokens = append(tokens, queryFilterToken{Label: field.label, Value: field.value, RemoveURL: queryFilterURL(view, field.key)})
	}
	if view.Start != "" || view.End != "" {
		tokens = append(tokens, queryFilterToken{Label: "Window", Value: logWindowLabel(view.Start, view.End), RemoveURL: queryFilterURL(view, "start", "end")})
	}
	return tokens
}

// queryFilterURL rebuilds the log page with every filter except the ones named,
// which is what a token's remove control links to.
func queryFilterURL(view QueryLogsView, omit ...string) string {
	dropped := func(key string) bool { for _, name := range omit { if name == key { return true } }; return false }
	values := url.Values{"tab": []string{"queries"}}
	for key, value := range map[string]string{"client_ip": view.ClientIP, "name": view.Name, "record_type": view.RecordType, "response_code": view.ResponseCode, "source": view.Source, "protocol": view.Protocol, "start": view.Start, "end": view.End} {
		if value != "" && !dropped(key) {
			values.Set(key, value)
		}
	}
	// Exact only qualifies the client and domain filters, so it leaves with them.
	if view.Exact && (values.Get("client_ip") != "" || values.Get("name") != "") {
		values.Set("match", "exact")
	}
	if view.FiltersOpen {
		values.Set("filters", "1")
	}
	return "/logs?" + values.Encode()
}

// logWindowLabel reads a datetime-local bound back out for people rather than
// for the input that produced it.
func logWindowLabel(start, end string) string {
	switch {
	case start != "" && end != "":
		return logMomentLabel(start) + " – " + logMomentLabel(end)
	case start != "":
		return "After " + logMomentLabel(start)
	case end != "":
		return "Before " + logMomentLabel(end)
	default:
		return ""
	}
}

func logMomentLabel(value string) string {
	moment, err := time.Parse("2006-01-02T15:04", value)
	if err != nil {
		return value
	}
	return moment.Format("Jan 2, 15:04")
}

func queryRangeLabel(view QueryLogsView) string {
	if label := logWindowLabel(view.Start, view.End); label != "" {
		return label
	}
	return "Any time"
}
func queryPageSummary(view QueryLogsView) string { if view.TotalEntries == 0 { return "0 results" }; first := (view.Page-1)*view.PageSize+1; last := min(view.TotalEntries, view.Page*view.PageSize); return fmt.Sprintf("%s–%s of %s", formatCount(first), formatCount(last), formatCount(view.TotalEntries)) }
func logSourceLabel(source string) string { switch source { case "cache": return "Cached"; case "upstream": return "Recursive"; case "authoritative": return "Authoritative"; case "local": return "Local"; case "blocked": return "Blocked"; case "error": return "Error"; default: return source } }
// runtimeLogURL names the same slice of the log for the panel and for the
// export. The follow flag is spelled out rather than left off when paused,
// because an absent flag means follow.
func runtimeLogURL(view RuntimeLogsView, path string, follow bool) string {
	values := make([]string, 0, 5)
	if view.Search != "" {
		values = append(values, "search="+urlQueryEscape(view.Search))
	}
	if view.Level != "" {
		values = append(values, "level="+urlQueryEscape(view.Level))
	}
	if view.Persisted {
		values = append(values, "page=1", "page_size="+fmt.Sprint(view.PageSize))
	}
	if follow {
		values = append(values, "live="+ifThen(view.Live, "1", "0"))
	}
	return path + "?" + strings.Join(values, "&")
}

func runtimePanelURL(view RuntimeLogsView) string { return runtimeLogURL(view, "/ui/logs/runtime", true) }
func runtimeLogCount(view RuntimeLogsView) string { if view.Persisted { return fmt.Sprintf("%s entries", formatCount(view.TotalEntries)) }; return fmt.Sprintf("%s entries", formatCount(view.Count)) }
func runtimePageSummary(view RuntimeLogsView) string { if view.TotalEntries == 0 { return "0 results" }; first := (view.Page-1)*view.PageSize+1; last := min(view.TotalEntries, view.Page*view.PageSize); return fmt.Sprintf("%s\u2013%s of %s", formatCount(first), formatCount(last), formatCount(view.TotalEntries)) }
func runtimeExportURL(view RuntimeLogsView) string { return runtimeLogURL(view, "/api/v1/logs/runtime/export", false) }
func queryPanelLiveURL(view QueryLogsView) string {
	values := url.Values{"page": []string{"1"}, "page_size": []string{fmt.Sprint(view.PageSize)}}
	for key, value := range map[string]string{"client_ip": view.ClientIP, "name": view.Name, "record_type": view.RecordType, "response_code": view.ResponseCode, "source": view.Source, "protocol": view.Protocol, "start": view.Start, "end": view.End} {
		if value != "" {
			values.Set(key, value)
		}
	}
	if view.Exact {
		values.Set("match", "exact")
	}
	if view.Live {
		values.Set("live", "1")
		values.Set("known_total", fmt.Sprint(view.TotalEntries))
		values.Set("after_id", fmt.Sprint(view.NewestID))
	}
	if view.FiltersOpen {
		values.Set("filters", "1")
	}
	return "/ui/logs/queries?" + values.Encode()
}
func urlQueryEscape(value string) string { return url.QueryEscape(value) }
func hasAnswers(answers []string) bool { for _, answer := range answers { if answer != "" { return true } }; return false }
func formatCount(value int) string { if value < 1_000 { return fmt.Sprint(value) }; whole := fmt.Sprintf("%d", value); for index := len(whole)-3; index > 0; index -= 3 { whole = whole[:index]+","+whole[index:] }; return whole }
