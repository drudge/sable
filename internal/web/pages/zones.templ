package pages

import (
	"fmt"
	"net/url"
	"slices"
	"strconv"
	"strings"

	"github.com/drudge/sable/internal/web/pages/components"
	zonemodel "github.com/drudge/sable/internal/zone"
	"github.com/miekg/dns"
)

type ZonesPageView struct {
 CatalogImport *CatalogImportView
	Console  DashboardView
	Zones    []ZoneView
	Selected string
	Message  string
	Error    string
	CanCreate bool
	// AliasSources lists the zones a new alias zone may mirror.
	AliasSources []string
	// TSIGKeys lists the keys configured under Settings. A zone references one
	// by name, so the form offers the configured set rather than a free-text
	// field a typo could silently break.
	TSIGKeys []string
}

type ZoneView struct {
	ConversionFingerprint string
	ConversionSerial uint32
 ConversionError string
	ID           string
	Name         string
	ShowFullRecordNames bool
	Type         string
	DefaultTTL   uint32
	Disabled     bool
	ZoneTransfer string
	TransferACL  []string
	Notify       []string
	PrimaryServers []string
	PrimaryProtocol string
	AliasZone    string
	AliasSources []string
	// CatalogZone names the RFC 9432 catalog this zone belongs to, and
	// CatalogManager is set only when that catalog is subscribed from another
	// server, which makes every setting here read-only.
	CatalogZone string
	CatalogGroup string
	CatalogMemberID string
	CatalogTargets []string
	CatalogRole string
	CatalogManager string
	CatalogMembers []string
	AwaitingFirstTransfer bool
	TSIGKey      string
	TSIGKeys     []string
	DynamicUpdates bool
	DNSSECValidationDisabled bool
	DNSSEC       bool
	DNSSECAlgorithm string
	DNSSECDenial string
	NSEC3Iterations uint16
	NSEC3Salt string
	ZSKLifetime string
	KSKLifetime string
	KeyPrepublish string
	KeyRetireAfter string
	DNSSECKeyTag uint16
	DNSSECDNSKEY string
	DNSSECDS     string
	DNSSECExpires string
	DNSSECParentDSKeyTag uint16
	DNSSECNextAction string
	DNSSECKeys []DNSSECKeyView
	Records      []ZoneRecordView
	Revision     uint64
	History      []ZoneRevisionView
	HistoryError string
	// HistoryLazy marks a zone list row whose history loads when its dialog
	// opens, so drawing the list doesn't read every zone's revisions.
	HistoryLazy bool
	CanSettings  bool
	CanRecords   bool
	CanTransfer  bool
	CanDNSSEC    bool
	CanImport    bool
	CanExport    bool
	CanDelete    bool
	CanCreate    bool
	CanManagePermissions bool
}

type ZoneRevisionView struct {
	Number     uint64
	Kind       string
	KindLabel  string
	OccurredAt string
	Current    bool
}

type ZoneRevisionDiffView struct {
	ZoneName       string
	Revision       uint64
	Summary        string
	Notice         string
	Error          string
	Changes        []ZoneRevisionChangeView
	HiddenChanges  int
	CanRollback    bool
}

type ZoneRevisionChangeView struct {
	Kind   string
	Label  string
	Before string
	After  string
}

type DNSSECKeyView struct {
	Role   string
	State  string
	KeyTag uint16
	DNSKEY string
	DS     string
	Timing string
}

type ZoneRecordView struct {
	ID        string
	Name      string
	Type      string
	Value     string
	TTL       uint32
	Comments  string
	Disabled  bool
	ExpiryTTL uint32
	Managed   bool
	// SourceLabel names the integration that owns the record, if any. Owned
	// records are read-only here because a synchronization would revert an edit
	// made from the zone editor.
	SourceLabel string
}

func containsString(values []string, value string) bool {
	return slices.Contains(values, value)
}

func selectedZone(view ZonesPageView) (ZoneView, bool) {
	for _, zone := range view.Zones {
		if zone.Name == view.Selected {
			return zone, true
		}
	}
	return ZoneView{}, false
}

func zoneHref(name string) templ.SafeURL {
	return templ.SafeURL("/zones/" + url.PathEscape(name))
}

func zoneRecordDialogTitle(zone ZoneView, record ZoneRecordView) string {
	if zoneRecordReadOnly(zone, record) {
		return "DNS Record"
	}
	return "Edit DNS Record"
}

func zoneRecordDialogSubtitle(zone ZoneView, record ZoneRecordView) string {
	if record.SourceLabel != "" {
		return "Published into " + zone.Name + " by " + record.SourceLabel
	}
	if zoneRecordReadOnly(zone, record) {
		return "Maintained by Sable for " + zone.Name
	}
	return "Update the DNS record for " + zone.Name
}

func zoneRecordOpenLabel(zone ZoneView, record ZoneRecordView) string {
	if zoneRecordReadOnly(zone, record) {
		return "View " + record.Type + " record"
	}
	return "Edit " + record.Type + " record"
}

// zoneRecordReadOnly reports whether a record's dialog opens for inspection
// only, either because a synchronizer owns the record or because no record in
// this zone is authored by hand.
func zoneRecordReadOnly(zone ZoneView, record ZoneRecordView) bool {
	return record.SourceLabel != "" || !zoneCanEditRecords(zone)
}

// zoneRecordReadOnlyNote names whoever maintains a record the operator cannot
// change here, and points at the place where they can change it.
func zoneRecordReadOnlyNote(zone ZoneView, record ZoneRecordView) string {
	if zone.Type == "alias" {
		if record.SourceLabel == "" {
			return "Sable maintains this record for the alias zone. Its serial advances whenever " + zone.AliasZone + " changes."
		}
		return "Mirrored from " + zone.AliasZone + ". Change it there and every alias of that zone follows."
	}
	return "Published by " + record.SourceLabel + " synchronization. Change it in " + record.SourceLabel + ", or under Integrations."
}

func zoneRecordEditPath(zone ZoneView, record ZoneRecordView) string {
	return "/zones/" + url.PathEscape(zone.Name) +
		"/records/" + url.PathEscape(record.ID) + "/edit"
}

func zoneTypeLabel(value string) string {
 if value == "secondary_forwarder" { return "Secondary Forwarder" }
	if strings.EqualFold(value, "primary") {
		return "Primary"
	}
	if value == "" {
		return "Primary"
	}
	return strings.ToUpper(value[:1]) + strings.ToLower(value[1:])
}

func zoneTypeClass(value string) string {
 if value == "secondary_forwarder" { return "secondary" }
	value = strings.ToLower(strings.TrimSpace(value))
	if value == "" {
		return "primary"
	}
	return value
}

func zoneCanEditRecords(zone ZoneView) bool { return zone.Type == "" || zone.Type == "primary" || zone.Type == "forwarder" }

// zoneCatalogRoleHeading names which side of RFC 9432 a catalog zone sits on.
func zoneCatalogRoleHeading(zone ZoneView) string {
	if zone.CatalogRole == "subscribed" {
		return "Secondary Catalog Zone"
	}
	return "Catalog Zone"
}

func zoneCatalogRoleDescription(zone ZoneView) string {
	if zone.CatalogRole == "subscribed" {
		return "Sable transfers this catalog from its primary servers and provisions every zone it lists as a secondary zone here."
	}
	return "Sable maintains this catalog from the zones that name it. Name servers subscribed to it transfer the catalog and provision those zones automatically."
}

// zoneTypeDisplay labels a zone in the console. A catalog transferred from
// another server is a secondary catalog, which the bare zone type cannot say
// because both catalog roles share one type.
func zoneTypeDisplay(zone ZoneView) string {
	if zone.CatalogRole == "subscribed" {
		return "Secondary Catalog"
	}
	return zoneTypeLabel(zone.Type)
}

// zoneTypeSelectValue maps a zone onto the option the Add Zone dialog would
// have used for it. Both catalog roles share one zone type, so a subscribed
// catalog resolves to the secondary catalog option.
func zoneTypeSelectValue(zone ZoneView) string {
	if zone.CatalogRole == "subscribed" {
		return "secondary_catalog"
	}
	if zone.Type == "" {
		return "primary"
	}
	return strings.ToLower(zone.Type)
}

// zoneCanOpenRecords reports whether a record dialog is worth rendering. An
// alias zone's records are maintained by Sable rather than authored by hand,
// but they open read-only for inspection the same way integration-owned records
// in an editable zone do.
func zoneCanOpenRecords(zone ZoneView) bool { return zoneCanEditRecords(zone) || zone.Type == "alias" }
func zoneCanResync(zone ZoneView) bool {
	return zone.Type == "secondary" || zone.Type == "secondary_forwarder" || zone.Type == "stub" || zone.CatalogRole == "subscribed"
}

// Primary zones manage signing here; forwarder and stub zones manage upstream
// validation. Secondary zones inherit both from the primary and have no dialog.
func zoneCanDNSSECDialog(zone ZoneView) bool {
	return zone.Type == "" || zone.Type == "primary" || zone.Type == "forwarder" || zone.Type == "stub"
}

func zoneRecordOwner(zone ZoneView, record ZoneRecordView) string {
	name := strings.TrimSpace(record.Name)
	if name == "" || name == "@" {
		return zone.Name
	}
	if strings.HasSuffix(name, ".") {
		return strings.TrimSuffix(name, ".")
	}
	return name + "." + zone.Name
}

func zoneRecordDisplayName(zone ZoneView, record ZoneRecordView) string {
	owner := zoneRecordOwner(zone, record)
	if zone.ShowFullRecordNames {
		return owner
	}
	zoneName := strings.TrimSuffix(strings.TrimSpace(zone.Name), ".")
	if strings.EqualFold(owner, zoneName) {
		return "@"
	}
	suffix := "." + zoneName
	if strings.HasSuffix(strings.ToLower(owner), strings.ToLower(suffix)) {
		return owner[:len(owner)-len(suffix)]
	}
	return owner
}

// zoneRecordSourceClass tints a record's source badge. An alias record carries
// the same violet as the Alias zone badge so the two read as one idea.
func zoneRecordSourceClass(label string) string {
	return strings.ToLower(label)
}

// zoneRecordSourceTitle explains where a record came from. An alias zone
// mirrors another zone in the same catalog rather than synchronizing with an
// integration, so it names the source instead.
func zoneRecordSourceTitle(zone ZoneView, label string) string {
	if zone.Type == "alias" && zone.AliasZone != "" {
		return "Mirrored from " + zone.AliasZone
	}
	return "Published by " + label + " synchronization"
}

func zoneElementID(prefix string, index int) string {
	return fmt.Sprintf("zone-%s-%d", prefix, index)
}

func primaryZoneRecordTypes() []string {
	return []string{"A", "AAAA", "CNAME", "MX", "TXT", "NS"}
}

func additionalZoneRecordTypes() []string {
	return []string{"CAA", "PTR", "SRV", "ANAME", "DNAME", "DS", "SSHFP", "TLSA", "SVCB", "HTTPS", "URI", "NAPTR", "FWD"}
}

func editableZoneRecordTypes() []string {
	return append(primaryZoneRecordTypes(), additionalZoneRecordTypes()...)
}

func zoneRecordDescription(recordType string) string {
	descriptions := map[string]string{
		"A": "Maps a domain to an IPv4 address",
		"AAAA": "Maps a domain to an IPv6 address",
		"CNAME": "Creates an alias pointing to another domain",
		"NS": "Delegates a zone to a name server",
		"MX": "Specifies mail servers for the domain",
		"TXT": "Stores text data (SPF, DKIM, verification)",
		"PTR": "Maps an IP address to a domain name",
		"SRV": "Specifies service location",
		"CAA": "Specifies which CAs can issue certificates",
		"ANAME": "Flattens an alias target into authoritative A and AAAA answers",
		"DNAME": "Aliases an entire subtree to another domain",
		"DS": "Delegation signer digest for a DNSSEC-signed child zone",
		"SSHFP": "Publishes SSH host key fingerprints",
		"TLSA": "Associates a TLS certificate with a service (DANE)",
		"SVCB": "Service binding with connection parameters",
		"HTTPS": "HTTPS service binding with connection parameters",
		"URI": "Maps a domain to a URI",
		"NAPTR": "Rule-based rewrite record (ENUM/SIP)",
		"SOA": "Defines the authoritative zone identity and refresh timers",
		"FWD": "Forwards this name and its subtree to designated DNS servers",
	}
	return descriptions[recordType]
}

// zoneRecordDisplayValue renders a record's rdata for the record list without
// the canonical trailing dot on embedded domain names. The stored value stays
// fully qualified; only the display drops the dot so the list reads the same
// way as the owner column and the edit form, which already trim it.
func zoneRecordDisplayValue(recordType, value string) string {
	trimmed := strings.TrimSpace(value)
	if trimmed == "" {
		return ""
	}
	switch strings.ToUpper(strings.TrimSpace(recordType)) {
	case "FWD":
		return trimmed
	case "ANAME":
		return trimRecordDot(trimmed)
	}
	rr, err := dns.NewRR("record.invalid. 300 IN " + recordType + " " + trimmed)
	if err != nil {
		return trimmed
	}
	switch record := rr.(type) {
	case *dns.CNAME:
		record.Target = trimRecordDot(record.Target)
	case *dns.DNAME:
		record.Target = trimRecordDot(record.Target)
	case *dns.NS:
		record.Ns = trimRecordDot(record.Ns)
	case *dns.PTR:
		record.Ptr = trimRecordDot(record.Ptr)
	case *dns.MX:
		record.Mx = trimRecordDot(record.Mx)
	case *dns.SRV:
		record.Target = trimRecordDot(record.Target)
	case *dns.NAPTR:
		record.Replacement = trimRecordDot(record.Replacement)
	case *dns.HTTPS:
		record.Target = trimRecordDot(record.Target)
	case *dns.SVCB:
		record.Target = trimRecordDot(record.Target)
	case *dns.SOA:
		record.Ns = trimRecordDot(record.Ns)
		record.Mbox = trimRecordDot(record.Mbox)
	default:
		return trimmed
	}
	rendered := strings.TrimSpace(strings.TrimPrefix(rr.String(), rr.Header().String()))
	if rendered == "" {
		return trimmed
	}
	return rendered
}

// trimRecordDot drops the trailing dot from a domain name, leaving the root
// name alone because "." is the whole name there rather than a suffix.
func trimRecordDot(name string) string {
	if name == "." {
		return name
	}
	return strings.TrimSuffix(name, ".")
}

func zoneRecordParsedField(recordType, value, field string) string {
	if strings.TrimSpace(value) == "" {
		return ""
	}
	if recordType == "ANAME" && field == "value" {
		return strings.TrimSuffix(strings.TrimSpace(value), ".")
	}
	if recordType == "FWD" {
		parts := strings.Fields(value)
		if len(parts) == 3 {
			switch field {
			case "fwd_protocol": return parts[0]
			case "fwd_priority": return parts[1]
			case "fwd_address": return parts[2]
			}
		}
		return ""
	}
	rr, err := dns.NewRR("record.invalid. 300 IN " + recordType + " " + value)
	if err != nil {
		return ""
	}
	switch record := rr.(type) {
	case *dns.A:
		if field == "value" { return record.A.String() }
	case *dns.AAAA:
		if field == "value" { return record.AAAA.String() }
	case *dns.CNAME:
		if field == "value" { return strings.TrimSuffix(record.Target, ".") }
	case *dns.DNAME:
		if field == "value" { return strings.TrimSuffix(record.Target, ".") }
	case *dns.NS:
		if field == "value" { return strings.TrimSuffix(record.Ns, ".") }
	case *dns.PTR:
		if field == "value" { return strings.TrimSuffix(record.Ptr, ".") }
	case *dns.MX:
		if field == "preference" { return strconv.FormatUint(uint64(record.Preference), 10) }
		if field == "exchange" { return strings.TrimSuffix(record.Mx, ".") }
	case *dns.TXT:
		if field == "text" { return strings.Join(record.Txt, "") }
	case *dns.SRV:
		switch field {
		case "priority": return strconv.FormatUint(uint64(record.Priority), 10)
		case "weight": return strconv.FormatUint(uint64(record.Weight), 10)
		case "port": return strconv.FormatUint(uint64(record.Port), 10)
		case "target": return strings.TrimSuffix(record.Target, ".")
		}
	case *dns.CAA:
		switch field {
		case "flags": return strconv.FormatUint(uint64(record.Flag), 10)
		case "tag": return record.Tag
		case "ca_domain": return record.Value
		}
	case *dns.DS:
		switch field {
		case "key_tag": return strconv.FormatUint(uint64(record.KeyTag), 10)
		case "algorithm": return strconv.FormatUint(uint64(record.Algorithm), 10)
		case "digest_type": return strconv.FormatUint(uint64(record.DigestType), 10)
		case "digest": return record.Digest
		}
	case *dns.SSHFP:
		switch field {
		case "algorithm": return strconv.FormatUint(uint64(record.Algorithm), 10)
		case "fingerprint_type": return strconv.FormatUint(uint64(record.Type), 10)
		case "fingerprint": return record.FingerPrint
		}
	case *dns.TLSA:
		switch field {
		case "certificate_usage": return strconv.FormatUint(uint64(record.Usage), 10)
		case "selector": return strconv.FormatUint(uint64(record.Selector), 10)
		case "matching_type": return strconv.FormatUint(uint64(record.MatchingType), 10)
		case "certificate": return record.Certificate
		}
	case *dns.URI:
		switch field {
		case "uri_priority": return strconv.FormatUint(uint64(record.Priority), 10)
		case "uri_weight": return strconv.FormatUint(uint64(record.Weight), 10)
		case "uri": return record.Target
		}
	case *dns.NAPTR:
		switch field {
		case "naptr_order": return strconv.FormatUint(uint64(record.Order), 10)
		case "naptr_preference": return strconv.FormatUint(uint64(record.Preference), 10)
		case "naptr_flags": return record.Flags
		case "naptr_services": return record.Service
		case "naptr_regexp": return record.Regexp
		case "naptr_replacement": return strings.TrimSuffix(record.Replacement, ".")
		}
	case *dns.SOA:
		switch field {
		case "primary_ns": return strings.TrimSuffix(record.Ns, ".")
		case "responsible": return strings.TrimSuffix(record.Mbox, ".")
		case "serial": return strconv.FormatUint(uint64(record.Serial), 10)
		case "refresh": return strconv.FormatUint(uint64(record.Refresh), 10)
		case "retry": return strconv.FormatUint(uint64(record.Retry), 10)
		case "expire": return strconv.FormatUint(uint64(record.Expire), 10)
		case "minimum": return strconv.FormatUint(uint64(record.Minttl), 10)
		}
	}
	parts := strings.Fields(value)
	if (recordType == "SVCB" || recordType == "HTTPS") && len(parts) >= 2 {
		if field == "svc_priority" { return parts[0] }
		if field == "svc_target" { return strings.TrimSuffix(parts[1], ".") }
		if field == "svc_params" && len(parts) > 2 { return strings.Join(parts[2:], " ") }
	}
	return ""
}

func zoneRecordGlue(zone ZoneView, record ZoneRecordView) string {
	target := strings.TrimSuffix(strings.ToLower(zoneRecordParsedField("NS", record.Value, "value")), ".")
	if target == "" {
		return ""
	}
	addresses := make([]string, 0, 2)
	for _, candidate := range zone.Records {
		if candidate.Type != "A" && candidate.Type != "AAAA" {
			continue
		}
		if strings.EqualFold(zoneRecordOwner(zone, candidate), target) {
			addresses = append(addresses, candidate.Value)
		}
	}
	return strings.Join(addresses, ", ")
}

templ ZonesPage(view ZonesPageView) {
	@AppDocument(view.Console, zonesTitle(view), "zones", ZonesContent(view))
}

// zonesTitle names the open zone in the browser tab. It reads the resolved zone
// rather than the requested one so a stale bookmark, which falls back to the
// list, does not title the page after a zone that is no longer there.
func zonesTitle(view ZonesPageView) string {
	if zone, found := selectedZone(view); found {
		return documentTitle(zone.Name, "Zones")
	}
	return "Zones"
}

templ ZonesContent(view ZonesPageView) {
	<div class="zones-page" id="zones-content" data-zone-root>
		@Toast(view.Message, "success")
		@Toast(view.Error, "error")
		if zone, found := selectedZone(view); found {
			@ZoneDetailView(zone)
		} else {
			@ZoneListView(view)
		}
		if view.CanCreate {
			@CreateZoneDialog(view.AliasSources, view.TSIGKeys)
			@ImportNewZoneDialog()
 if view.CatalogImport != nil {
 @CatalogImportContent(*view.CatalogImport)
 }
		}
	</div>
}

templ ZoneListView(view ZonesPageView) {
	<div class="isotope-zone-stack">
		<header class="isotope-zone-heading">
			<div><h1>Zones</h1><p>{ fmt.Sprint(len(view.Zones)) } zones configured</p></div>
			if view.CanCreate {
				<div class="zone-heading-actions">
					<details class="pause-menu zone-import-menu">
						<summary class="button outline zone-import-trigger" aria-label="Import options">@Icon("upload")<span>Import</span>@Icon("chevron-down")</summary>
						<div>
							<button type="button" aria-label="Import zone" data-dialog-open="import-new-zone-dialog" data-replica-primary-action>@Icon("file-text")<span><strong>From file or text</strong><small>Upload a zone file or paste records</small></span></button>
							<button type="button" hx-get="/zones/import-catalog" hx-target="#zones-content" hx-swap="outerHTML" data-replica-primary-action>@Icon("layers")<span><strong>From catalog</strong><small>Import zones from another DNS server</small></span></button>
						</div>
					</details>
					@components.Button(components.ButtonProps{Label: "Add Zone", Icon: "plus", Class: "zone-primary-action", Attrs: templ.Attributes{"aria-label": "Add zone", "title": "Add zone", "data-dialog-open": "create-zone-dialog", "data-replica-primary-action": true}})
				</div>
			}
		</header>
		<div class="zone-filter-bar">
			@SearchField("Search zones", "Search zones...", "", "zone-search", templ.Attributes{"data-zone-search": true})
			<div class="zone-filter-selects">
				<label><span class="sr-only">Zone type</span><select data-zone-type-filter data-styled-select><option value="all">All Types</option><option value="primary">Primary</option><option value="secondary">Secondary</option><option value="secondary_forwarder">Secondary Forwarder</option><option value="stub">Stub</option><option value="forwarder">Forwarder</option><option value="alias">Alias</option><option value="catalog">Catalog</option></select></label>
				<label><span class="sr-only">Zone status</span><select data-zone-status-filter data-styled-select><option value="all">All Status</option><option value="active">Active</option><option value="disabled">Disabled</option></select></label>
			</div>
		</div>
		@components.Card(components.CardProps{Class: "isotope-zone-list", Attrs: templ.Attributes{"aria-label": "Configured zones"}}) {
			if len(view.Zones) == 0 {
				<div class="isotope-zone-empty" data-zone-empty><p>{ ifThen(view.CanCreate, "No zones found. Create your first zone to get started.", "No zones are available to this account.") }</p></div>
		}
			for index, zone := range view.Zones {
				<div class={ ifThen(zone.Disabled, "isotope-zone-row disabled", "isotope-zone-row") } data-zone-row data-zone-name={ strings.ToLower(zone.Name) } data-zone-type={ strings.ToLower(zone.Type) } data-zone-status={ ifThen(zone.Disabled, "disabled", "active") }>
					<a class="isotope-zone-row-link" href={ zoneHref(zone.Name) }>
						<div class="isotope-zone-name"><strong>{ zone.Name }</strong>
 if zone.CatalogZone != "" {
 <small class="zone-catalog-membership" title={ ifThen(zone.CatalogManager != "", "Managed by catalog", "Member of catalog") }>@Icon("layers")<span class="sr-only">{ ifThen(zone.CatalogManager != "", "Managed by catalog", "Member of catalog") } </span><span>{ zone.CatalogZone }</span></small>
 }
 <span class="zone-mobile-badges"><span class={ "zone-type-badge " + zoneTypeClass(zone.Type) }>{ zoneTypeDisplay(zone) }</span><span class={ "zone-status-badge " + ifThen(zone.Disabled, "disabled", "active") }>{ ifThen(zone.Disabled, "Disabled", "Active") }</span></span></div>
						<div class="zone-desktop-badges"><span class={ "zone-type-badge " + zoneTypeClass(zone.Type) }>{ zoneTypeDisplay(zone) }</span><span class={ "zone-status-badge " + ifThen(zone.Disabled, "disabled", "active") }>{ ifThen(zone.Disabled, "Disabled", "Active") }</span></div>
					</a>
					@ZoneActionMenu(zone, "", zoneElementID("history", index), zoneElementID("settings", index), zoneElementID("dnssec", index), zoneElementID("clone", index), zoneElementID("delete", index))
					<a class="zone-row-chevron" href={ zoneHref(zone.Name) } aria-label={ "Open " + zone.Name }>@Icon("chevron-right")</a>
				</div>
				if zone.CanSettings {
					@ZoneSettingsDialog(zone, zoneElementID("settings", index))
					if (zone.Type == "secondary" || zone.Type == "secondary_forwarder") && zone.CanRecords {
 @ConvertPrimaryDialog(zone, zoneElementID("settings", index) + "-convert")
 }
				}
				if zoneCanDNSSECDialog(zone) && zone.CanDNSSEC {
					@ZoneDNSSECDialog(zone, zoneElementID("dnssec", index))
				}
				if zone.CanCreate {
					@CloneZoneDialog(zone, zoneElementID("clone", index))
				}
				if zone.CanDelete {
					@DeleteZoneDialog(zone, zoneElementID("delete", index))
				}
				if zoneHasHistory(zone) {
					@ZoneHistoryDialog(zone, zoneElementID("history", index))
				}
			}
			<div class="isotope-zone-empty zone-filter-empty" hidden data-zone-filter-empty><p>No zones match your search</p></div>
		}
	</div>
}

templ ZoneDetailView(zone ZoneView) {
	<div class="isotope-zone-stack">
		<header class="zone-records-heading">
			<a class="icon-button zone-back-button" href="/zones" aria-label="Back to zones">@Icon("arrow-left")</a>
			<div class="zone-records-title">
				<h1>{ zone.Name }</h1>
 if zone.CatalogZone != "" {
 <p class="zone-catalog-membership" title={ ifThen(zone.CatalogManager != "", "Managed by catalog", "Member of catalog") }>@Icon("layers")<span class="sr-only">{ ifThen(zone.CatalogManager != "", "Managed by catalog", "Member of catalog") } </span><a href={ zoneHref(zone.CatalogZone) }>{ zone.CatalogZone }</a></p>
 }
				<div><span class={ "zone-type-badge " + zoneTypeClass(zone.Type) }>{ zoneTypeDisplay(zone) }</span><span class={ "zone-status-badge " + ifThen(zone.Disabled, "disabled", "active") }>{ ifThen(zone.Disabled, "Disabled", "Active") }</span><span class={ "zone-dnssec-badge " + ifThen(zone.DNSSEC, "signed", "unsigned") }>{ ifThen(zone.DNSSEC, "DNSSEC: Signed", "DNSSEC: Unsigned") }</span></div>
				<p>
					{ fmt.Sprint(len(zone.Records)) } { ifThen(len(zone.Records) == 1, "record", "records") }
					if zone.Type == "alias" && zone.AliasZone != "" {
						<span class="zone-alias-source">mirrored from <a href={ zoneHref(zone.AliasZone) }><code>{ zone.AliasZone }</code></a></span>
					}
				</p>
			</div>
			<div class="zone-records-actions">
				<a class="icon-button" href={ zoneHref(zone.Name) } aria-label="Refresh records" title="Refresh records">@Icon("refresh")</a>
				@ZoneActionMenu(zone, "detail-menu", "zone-history-dialog", "settings-selected-zone-dialog", "dnssec-selected-zone-dialog", "clone-selected-zone-dialog", "delete-selected-zone-dialog")
				if zoneCanResync(zone) && zone.CanTransfer {
					<form hx-post="/ui/zones/resync" hx-target="#zones-content" hx-swap="outerHTML"><input type="hidden" name="zone" value={ zone.Name }/>@components.Button(components.ButtonProps{Label: "Resync", Icon: "refresh", Variant: components.ButtonOutline, Type: "submit", Class: "zone-primary-action", Attrs: templ.Attributes{"aria-label": "Resynchronize zone", "title": "Resynchronize zone"}})</form>
				}
				if zoneCanEditRecords(zone) && zone.CanRecords {
					@components.Button(components.ButtonProps{Label: "Add Record", Icon: "plus", Class: "zone-primary-action", Attrs: templ.Attributes{"aria-label": "Add DNS record", "title": "Add DNS record", "data-dialog-open": "add-zone-record-dialog", "data-replica-primary-action": true}})
				}
			</div>
		</header>
		<div class="zone-filter-bar zone-record-filter-bar">
			@SearchField("Filter zone records", "Filter records...", "", "zone-search", templ.Attributes{"data-record-search": true})
			<label class="zone-record-type-filter"><span class="sr-only">Record type</span><select data-record-type-filter data-styled-select><option value="all">All Types</option>@RecordTypeOptions(true)</select></label>
		</div>
		@components.Card(components.CardProps{Class: "isotope-record-list", Attrs: templ.Attributes{"aria-label": "Records for " + zone.Name}}) {
			if len(zone.Records) == 0 {
				<div class="isotope-zone-empty" data-record-empty><p>No records found</p></div>
			}
			for index, record := range zone.Records {
				<div class={ ifThen(record.Disabled, "isotope-record-row disabled", ifThen(record.Type == "SOA", "isotope-record-row managed", "isotope-record-row")) } data-record-row data-record-dialog-row data-record-name={ strings.ToLower(zoneRecordOwner(zone, record) + " " + record.Value) } data-record-type={ strings.ToLower(record.Type) }>
					<span class="record-type-badge">{ record.Type }</span>
					<span class="record-owner-cell">
						@ZoneCopyableText(zoneElementID("owner", index), zoneRecordDisplayName(zone, record), "record-owner-copy")
					</span>
					@ZoneCopyableText(zoneElementID("value", index), zoneRecordDisplayValue(record.Type, record.Value), "record-value-copy")
					<span class="record-ttl">{ fmt.Sprint(record.TTL) }s</span>
					if record.SourceLabel != "" {
						<span class={ "record-source-badge " + zoneRecordSourceClass(record.SourceLabel) } title={ zoneRecordSourceTitle(zone, record.SourceLabel) }>{ record.SourceLabel }</span>
					} else {
						<span class="record-source-badge record-source-badge-empty" aria-hidden="true"></span>
					}
					if zoneCanOpenRecords(zone) && zone.CanRecords && !record.Managed {
						<button class="record-open-button" type="button" data-dialog-open={ zoneElementID("record", index) } data-dialog-url={ zoneRecordEditPath(zone, record) } aria-label={ zoneRecordOpenLabel(zone, record) }>@Icon("chevron-right")</button>
					} else {
						<span class="record-open-placeholder"></span>
					}
				</div>
				if zoneCanOpenRecords(zone) && zone.CanRecords && !record.Managed {
					@EditZoneRecordDialog(zone, record, zoneElementID("record", index))
				}
			}
			<div class="isotope-zone-empty zone-filter-empty" hidden data-record-filter-empty><p>No records match your filter</p></div>
		}
		if zoneCanEditRecords(zone) && zone.CanRecords {
			@AddZoneRecordDialog(zone)
		}
		if zone.CanSettings {
			@ZoneSettingsDialog(zone, "settings-selected-zone-dialog")
			if (zone.Type == "secondary" || zone.Type == "secondary_forwarder") && zone.CanRecords {
 @ConvertPrimaryDialog(zone, "settings-selected-zone-dialog-convert")
 }
		}
		if zoneCanDNSSECDialog(zone) && zone.CanDNSSEC {
			@ZoneDNSSECDialog(zone, "dnssec-selected-zone-dialog")
		}
		if zone.CanCreate {
			@CloneZoneDialog(zone, "clone-selected-zone-dialog")
		}
		if zone.CanDelete {
			@DeleteZoneDialog(zone, "delete-selected-zone-dialog")
		}
		if zoneHasHistory(zone) {
			@ZoneHistoryDialog(zone, "zone-history-dialog")
		}
	</div>
}

templ ZoneHistoryDialog(zone ZoneView, id string) {
	@components.Dialog(components.DialogProps{ID: id, Title: "Change Center", DescriptionContent: zoneHistoryLead(zone.Name), Class: "zone-history-dialog"}) {
		<div class="zone-history-list" id={ id + "-list" }>
			if zone.HistoryLazy {
				<div class="zone-history-empty"><span class="zone-history-loading">Loading history…</span></div>
			} else {
				@ZoneHistoryEntries(zone, id)
			}
		</div>
	}
}

// ZoneHistoryEntries is the body of a zone's history dialog. The zone list
// loads it on demand from zoneHistoryURL.
templ ZoneHistoryEntries(zone ZoneView, id string) {
	if zone.HistoryError != "" {
		<div class="zone-history-empty">{ zone.HistoryError }</div>
	} else if len(zone.History) == 0 {
		<div class="zone-history-empty">No revisions have been recorded for this zone.</div>
	}
	for _, revision := range zone.History {
		<details class="zone-history-entry" hx-get={ templ.SafeURL(zoneHistoryDiffURL(zone.Name, revision.Number)) } hx-trigger="toggle once" hx-target={ "#" + zoneHistoryRevisionID(id, revision.Number) } hx-swap="innerHTML">
			<summary><span class={ "zone-history-marker " + revision.Kind } aria-hidden="true"></span><div><span><strong>Revision { fmt.Sprint(revision.Number) }</strong><span class={ "zone-history-kind " + revision.Kind }>{ revision.KindLabel }</span>
				if revision.Current {
					<span class="current-badge">Current</span>
				}
			</span><small>{ revision.OccurredAt }</small></div>@Icon("chevron-down")</summary>
			<div class="zone-history-diff" id={ zoneHistoryRevisionID(id, revision.Number) }><span class="zone-history-loading">Loading changes…</span></div>
		</details>
	}
}

templ zoneHistoryLead(name string) {
	Revisions of <code>{ name }</code>
}

func zoneHasHistory(zone ZoneView) bool {
	return zone.HistoryLazy || len(zone.History) > 0 || zone.HistoryError != ""
}

func zoneHistoryURL(name, dialogID string) string {
	return "/ui/zones/history?zone=" + url.QueryEscape(name) + "&dialog=" + url.QueryEscape(dialogID)
}

func zoneHistoryRevisionID(dialogID string, revision uint64) string {
	return dialogID + "-revision-" + strconv.FormatUint(revision, 10)
}

func zoneHistoryDiffURL(name string, revision uint64) string {
	return "/ui/zones/history/diff?zone=" + url.QueryEscape(name) + "&revision=" + strconv.FormatUint(revision, 10)
}

templ ZoneRevisionDiff(view ZoneRevisionDiffView) {
	if view.Error != "" {
		<p class="zone-history-notice error">{ view.Error }</p>
	} else {
		<div class="zone-history-diff-heading">
			<p class="zone-history-summary">{ view.Summary }</p>
			if view.CanRollback {
				<form class="zone-history-rollback" hx-post="/ui/zones/rollback" hx-target="#zones-content" hx-swap="outerHTML" hx-confirm={ "Restore revision " + fmt.Sprint(view.Revision) + "? Sable will preserve the zone identity, advance its SOA serial, and save the restored state as a new revision." } data-confirm-title="Restore this revision?" data-confirm-action="Restore Revision">
					<input type="hidden" name="zone" value={ view.ZoneName }/><input type="hidden" name="revision" value={ fmt.Sprint(view.Revision) }/>@components.Button(components.ButtonProps{Label: "Restore revision", Icon: "rotate-ccw", Variant: components.ButtonOutline, Compact: true, Type: "submit", Attrs: templ.Attributes{"data-replica-primary-action": true}})
				</form>
			}
		</div>
		if view.Notice != "" {
			<p class="zone-history-notice">{ view.Notice }</p>
		}
		if len(view.Changes) > 0 {
			<ul class="zone-history-changes">
				for _, change := range view.Changes {
					<li class={ change.Kind }><span class="zone-history-change-kind" aria-hidden="true">{ zoneHistoryChangeSymbol(change.Kind) }</span><div><strong>{ change.Label }</strong>
						if change.Before != "" {
							<span><small>Before</small>{ change.Before }</span>
						}
						if change.After != "" {
							<span><small>After</small>{ change.After }</span>
						}
					</div></li>
				}
			</ul>
		}
		if view.HiddenChanges > 0 {
			<p class="zone-history-notice">{ fmt.Sprint(view.HiddenChanges) } additional changes are not shown.</p>
		}
	}
}

func zoneHistoryChangeSymbol(kind string) string { if kind == "added" { return "+" }; if kind == "removed" { return "−" }; return "~" }

templ ZoneActionMenu(zone ZoneView, className, historyID, settingsID, dnssecID, cloneID, deleteID string) {
	<details class={ "zone-action-menu " + className }>
		<summary class={ ifThen(className == "", "icon-button zone-more-button", "icon-button") } aria-label={ "Actions for " + zone.Name }>@Icon("more-vertical")</summary>
		<div class="zone-menu-content">
			if zone.CanSettings {
				<button type="button" data-dialog-open={ settingsID }>@Icon("sliders")<span>Zone Settings</span></button>
			}
			if historyID != "" && zone.HistoryLazy {
				<button type="button" data-dialog-open={ historyID } hx-get={ templ.SafeURL(zoneHistoryURL(zone.Name, historyID)) } hx-target={ "#" + historyID + "-list" } hx-swap="innerHTML">@Icon("clock")<span>History</span></button>
			} else if historyID != "" && zoneHasHistory(zone) {
				<button type="button" data-dialog-open={ historyID }>@Icon("clock")<span>History</span></button>
			}
			if zone.CanManagePermissions {
				<a href="/administration?tab=groups" title="Manage zone access through groups">@Icon("key")<span>Permissions</span></a>
			}
			if zoneCanDNSSECDialog(zone) && zone.CanDNSSEC {
				<button type="button" data-dialog-open={ dnssecID }>@Icon("shield-check")<span>DNSSEC</span></button>
			} else if zone.Type == "secondary" || zone.Type == "secondary_forwarder" {
				<button type="button" disabled title="Signing is managed by the primary server">@Icon("shield-check")<span>DNSSEC</span></button>
			}
			<hr/>
			if zone.CanExport {
				<a href={ templ.SafeURL("/api/v1/zones/export?zone=" + url.QueryEscape(zone.Name)) }>@Icon("download")<span>Export Zone File</span></a>
			}
			if zoneCanResync(zone) && zone.CanTransfer {
				<form hx-post="/ui/zones/resync" hx-target="#zones-content" hx-swap="outerHTML"><input type="hidden" name="zone" value={ zone.Name }/><button type="submit">@Icon("refresh")<span>Resync Zone</span></button></form>
			}
			if (zone.Type == "secondary" || zone.Type == "secondary_forwarder") && zone.CanSettings && zone.CanRecords {
				<button type="button" data-dialog-open={ settingsID + "-convert" } data-replica-primary-action>@Icon("crown")<span>{ ifThen(zone.Type == "secondary_forwarder", "Convert to independent Forwarder", "Convert to Primary") }</span></button>
			}
			if zoneCanEditRecords(zone) && zone.CanCreate {
				<button type="button" data-dialog-open={ cloneID } data-replica-primary-action>@Icon("copy")<span>Clone Zone</span></button>
			}
			<hr/>
			if zone.CanSettings {
				<form hx-post="/ui/zones/toggle" hx-target="#zones-content" hx-swap="outerHTML"><input type="hidden" name="zone" value={ zone.Name }/><input type="hidden" name="action" value={ ifThen(zone.Disabled, "enable", "disable") }/><button type="submit">@Icon("power")<span>{ ifThen(zone.Disabled, "Enable Zone", "Disable Zone") }</span></button></form>
			}
			if zone.CanDelete {
				<button class="danger" type="button" data-dialog-open={ deleteID } data-replica-primary-action>@Icon("trash")<span>Delete Zone</span></button>
			}
		</div>
	</details>
}

templ ZoneCopyableText(id, text, className string) {
	<span class={ "zone-copyable " + className }><code id={ id }>{ text }</code><button type="button" data-copy-target={ id } aria-label="Copy to clipboard" title="Copy to clipboard">@components.CopyIcons()</button></span>
}

// ZoneTypeOptions lists the zone types the console knows about. Zone Settings
// renders the same options behind a disabled select so a zone's type reads the
// way it was picked, rather than as a text box that looks editable.
templ ZoneTypeOptions(selected string, allowAlias bool) {
	<option value="primary" selected?={ selected == "primary" }>Primary Zone</option>
	<option value="secondary" selected?={ selected == "secondary" }>Secondary Zone</option>
	<option value="stub" selected?={ selected == "stub" }>Stub Zone</option>
	<option value="forwarder" selected?={ selected == "forwarder" }>Forwarder Zone</option>
	<option value="alias" selected?={ selected == "alias" } disabled?={ !allowAlias }>Alias Zone</option>
	<option value="catalog" selected?={ selected == "catalog" }>Catalog Zone</option>
	<option value="secondary_catalog" selected?={ selected == "secondary_catalog" }>Secondary Catalog Zone</option>
}

// TSIGKeySelect offers the keys configured under Settings. A zone that still
// names a key removed from the configuration keeps it listed and selected, so
// the form shows the broken reference instead of silently clearing it.
templ TSIGKeySelect(keys []string, selected string) {
	<select class="mono-input" name="tsig_key" data-styled-select>
		<option value="" selected?={ selected == "" }>None</option>
		for _, key := range keys {
			<option value={ key } selected?={ key == selected }>{ TSIGDisplayName(key) }</option>
		}
		if selected != "" && !containsString(keys, selected) {
			<option value={ selected } selected>{ TSIGDisplayName(selected) } (not configured)</option>
		}
	</select>
}

templ CreateZoneDialog(aliasSources []string, tsigKeys []string) {
	@components.Dialog(components.DialogProps{ID: "create-zone-dialog", TitleID: "create-zone-title", Title: "Create Zone", Description: "Add a new DNS zone to your server.", Class: "isotope-zone-dialog"}) {
		<form class="blocking-dialog-form" hx-post="/ui/zones/add" hx-target="#zones-content" hx-swap="outerHTML" data-zone-create-form>
			<label><span>Zone Name</span><input name="name" placeholder="example.com" autocomplete="off" required/></label>
			<label><span>Zone Type</span><select name="type" data-zone-create-type data-styled-select>@ZoneTypeOptions("primary", len(aliasSources) > 0)</select></label>
			<label><span>TSIG Key (optional)</span>@TSIGKeySelect(tsigKeys, "")<small>Authenticates transfers and updates. Add keys under <a class="inline-link" href="/settings?tab=tsig">Settings &rsaquo; TSIG</a>.</small></label>
			<section class="zone-create-options" data-zone-create-options="transfer" hidden>
				<label><span>Primary Name Servers</span><textarea class="mono-input" name="primary_servers" placeholder={ "192.0.2.53\nprimary.example.net:53" } disabled required></textarea><small>One address per line. Sable tries each server in order.</small></label>
				<label><span>Protocol</span><select name="primary_protocol" data-zone-primary-protocol data-styled-select disabled><option value="tcp">TCP</option><option value="tls">DNS-over-TLS</option><option value="udp" data-stub-protocol>UDP</option></select></label>
			</section>
			<section class="zone-create-options" data-zone-create-options="alias" hidden>
				<label><span>Source Zone</span><select class="mono-input" name="alias_zone" data-styled-select disabled required>
					for _, source := range aliasSources {
						<option value={ source }>{ source }</option>
					}
				</select><small>Every record of the source zone is republished here and kept in step whenever the source changes.</small></label>
			</section>
			<section class="zone-create-options" data-zone-create-options="forwarder" hidden>
				<label><span>Forwarder Address</span><input class="mono-input" name="forwarder_address" placeholder="1.1.1.1 or dns.example:53" disabled required/></label>
				<div class="record-field-grid two"><label><span>Protocol</span><select name="forwarder_protocol" data-styled-select disabled><option value="udp">UDP</option><option value="tcp">TCP</option><option value="tls">DNS-over-TLS</option></select></label><label><span>Priority</span><input type="number" name="forwarder_priority" min="0" max="65535" value="0" disabled required/></label></div>
			</section>
			<section class="zone-create-options" data-zone-create-options="resolution" hidden>
				<input type="hidden" name="dnssec_validation_present" value="1" disabled/>
				<label class="zone-dynamic-toggle"><span><strong>DNSSEC Validation</strong><small>Turn this off when the upstream servers answer for a signed delegation without serving its signatures, such as a private split-horizon copy of a public zone.</small></span><span class="switch"><input type="checkbox" name="dnssec_validation" value="true" checked disabled/><span></span></span></label>
			</section>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Create Zone", Type: "submit"})
			}
		</form>
	}
}

templ AddZoneRecordDialog(zone ZoneView) {
	@components.Dialog(components.DialogProps{ID: "add-zone-record-dialog", TitleID: "add-zone-record-title", Title: "Add DNS Record", Description: "Add a new DNS record to " + zone.Name, Class: "isotope-record-dialog"}) {
		<form class="isotope-record-form" hx-post="/ui/zones/records/add" hx-target="#zones-content" hx-swap="outerHTML">
			<input type="hidden" name="zone" value={ zone.Name }/>
			<div class="isotope-record-dialog-body">
                @RecordTypePicker()
                <label class="record-field"><span>Name</span><input class="mono-input" name="name" placeholder="@ for zone apex, or subdomain" required/></label>
                for _, recordType := range editableZoneRecordTypes() {
                    <div class="record-specific-fields" data-record-fields={ recordType } hidden?={ recordType != "A" }>
                        @ZoneRecordFields(recordType, "", "", "", recordType != "A")
                    </div>
                }
				@RecordAdvancedOptions("", zone.DefaultTTL, 0, "", false)
			</div>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Add Record", Type: "submit"})
			}
		</form>
	}
}

templ RecordTypePicker() {
	<fieldset class="record-type-fieldset">
		<legend>Record Type</legend>
		<input type="hidden" name="type" value="A" data-record-type-value/>
		<div class="record-type-grid">
			for index, recordType := range primaryZoneRecordTypes() {
				<button class={ ifThen(index == 0, "record-type-choice active", "record-type-choice") } type="button" data-record-type-choice={ recordType } data-record-description={ zoneRecordDescription(recordType) } aria-pressed={ ifThen(index == 0, "true", "false") }>{ recordType }</button>
			}
		</div>
		<label class="record-more-types"><span class="sr-only">More record types</span><select data-record-more-types data-styled-select><option value="" data-placeholder>More types...</option>
			for _, recordType := range additionalZoneRecordTypes() {
				<option value={ recordType } data-description={ zoneRecordDescription(recordType) }>{ recordType }</option>
			}
		</select></label>
		<p data-record-type-description>{ zoneRecordDescription("A") }</p>
	</fieldset>
}

templ RecordTypeOptions(includeAll bool) {
	for _, recordType := range append(editableZoneRecordTypes(), "SOA") {
		<option value={ strings.ToLower(recordType) }>{ recordType }</option>
	}
}

templ EditZoneRecordDialog(zone ZoneView, record ZoneRecordView, id string) {
	@components.Dialog(components.DialogProps{
		ID:          id,
		Title:       zoneRecordDialogTitle(zone, record),
		Description: zoneRecordDialogSubtitle(zone, record),
		Class:       "isotope-record-dialog",
		Attrs:       templ.Attributes{"data-dialog-url": zoneRecordEditPath(zone, record), "data-dialog-base-url": "/zones/" + url.PathEscape(zone.Name)},
	}) {
		<form class="isotope-record-form" hx-post="/ui/zones/records/update" hx-target="#zones-content" hx-swap="outerHTML">
			<input type="hidden" name="zone" value={ zone.Name }/><input type="hidden" name="name" value={ record.Name }/><input type="hidden" name="type" value={ record.Type }/><input type="hidden" name="value" value={ record.Value }/><input type="hidden" name="ttl" value={ fmt.Sprint(record.TTL) }/>
			<fieldset class="isotope-record-fieldset" disabled?={ zoneRecordReadOnly(zone, record) }>
			<div class="isotope-record-dialog-body">
				<div class="edit-record-type"><span class="record-type-badge">{ record.Type }</span><small>{ zoneRecordDescription(record.Type) }</small><label class="record-enabled"><span class="switch">
					if record.Type == "SOA" {
						<input type="hidden" name="enabled" value="true"/><input type="checkbox" checked disabled/>
					} else {
						<input type="checkbox" name="enabled" value="true" checked?={ !record.Disabled } data-replica-primary-control/>
					}
					<span></span></span><b>Enabled</b></label></div>
				<label class="record-field"><span>Name</span><input class="mono-input" name="new_name" value={ zoneRecordOwner(zone, record) } readonly?={ record.Type == "SOA" } required/></label>
				@ZoneRecordFields(record.Type, "new_", record.Value, zoneRecordGlue(zone, record), false)
				@RecordAdvancedOptions("new_", record.TTL, record.ExpiryTTL, record.Comments, record.Type == "NS")
			</div>
			</fieldset>
			if zoneRecordReadOnly(zone, record) {
				<footer class="dialog-footer edit-record-footer record-readonly-footer">
					<span class="record-readonly-note">@Icon("info")<span>{ zoneRecordReadOnlyNote(zone, record) }</span></span>
					@components.Button(components.ButtonProps{Label: "Close", Attrs: templ.Attributes{"data-dialog-close": true}})
				</footer>
			} else {
				<footer class="dialog-footer edit-record-footer">
					if record.Type != "SOA" {
						@components.Button(components.ButtonProps{Label: "Delete Record", Icon: "trash", Destructive: true, Type: "submit", Class: "edit-record-delete", Attrs: templ.Attributes{"formaction": "/ui/zones/records/delete"}})
					}
					@components.Button(components.ButtonProps{Label: "Cancel", Variant: components.ButtonOutline, Attrs: templ.Attributes{"data-dialog-close": true}})@components.Button(components.ButtonProps{Label: "Update Record", Type: "submit"})
				</footer>
			}
		</form>
	}
}

templ RecordAdvancedOptions(prefix string, ttl, expiryTTL uint32, comments string, hideComments bool) {
	<details class="record-advanced">
		<summary>@Icon("settings-2")<span>Advanced Options</span><span class="record-advanced-chevron" aria-hidden="true"></span></summary>
		<div class="record-advanced-content">
			<div class="record-advanced-grid"><label class="record-field"><span>TTL (seconds)</span><input name={ prefix + "ttl" } type="number" min="1" max="4294967295" value={ fmt.Sprint(ttl) } required/></label><label class="record-field"><span>Auto-expire (seconds)</span><input name={ prefix + "expiry_ttl" } type="number" min="0" max="4294967295" value={ fmt.Sprint(expiryTTL) } placeholder="0 = never"/></label></div>
			<label class="record-field" data-record-comments hidden?={ hideComments }><span>Comments</span><input name={ prefix + "comments" } value={ comments } placeholder="Optional notes about this record" disabled?={ hideComments }/></label>
		</div>
	</details>
}

templ ZoneRecordFields(recordType, prefix, value, glue string, disabled bool) {
	switch recordType {
		case "A":
			<label class="record-field"><span>IPv4 Address</span><input class="mono-input" name={ prefix + "value" } value={ zoneRecordParsedField(recordType, value, "value") } placeholder="192.168.1.1" autocomplete="off" disabled?={ disabled } required/></label>
		case "AAAA":
			<label class="record-field"><span>IPv6 Address</span><input class="mono-input" name={ prefix + "value" } value={ zoneRecordParsedField(recordType, value, "value") } placeholder="2001:db8::1" autocomplete="off" disabled?={ disabled } required/></label>
		case "CNAME", "ANAME", "DNAME":
			<label class="record-field"><span>Target Host</span><input class="mono-input" name={ prefix + "value" } value={ zoneRecordParsedField(recordType, value, "value") } placeholder="target.example.com" autocomplete="off" disabled?={ disabled } required/></label>
		case "NS":
			<label class="record-field"><span>Name Server</span><input class="mono-input" name={ prefix + "value" } value={ zoneRecordParsedField(recordType, value, "value") } placeholder="ns1.example.com" autocomplete="off" disabled?={ disabled } required/></label>
			<label class="record-field secondary"><span>Glue Addresses (optional)</span><input class="mono-input" name={ prefix + "glue_addresses" } value={ glue } placeholder="192.168.1.1, 2001:db8::1" autocomplete="off" disabled?={ disabled }/><small>Required if name server is within this zone</small></label>
		case "PTR":
			<label class="record-field"><span>Domain Name</span><input class="mono-input" name={ prefix + "value" } value={ zoneRecordParsedField(recordType, value, "value") } placeholder="example.com" autocomplete="off" disabled?={ disabled } required/></label>
		case "MX":
			<div class="record-field-grid mx"><label class="record-field"><span>Mail Server</span><input class="mono-input" name={ prefix + "exchange" } value={ zoneRecordParsedField(recordType, value, "exchange") } placeholder="mail.example.com" autocomplete="off" disabled?={ disabled } required/></label><label class="record-field secondary"><span>Priority</span><input type="number" name={ prefix + "preference" } min="0" max="65535" value={ ifThen(zoneRecordParsedField(recordType, value, "preference") == "", "10", zoneRecordParsedField(recordType, value, "preference")) } disabled?={ disabled } required/></label></div>
		case "TXT":
			<label class="record-field"><span>Text Value</span><textarea class="record-text-value" name={ prefix + "text" } placeholder="v=spf1 include:_spf.google.com ~all" disabled?={ disabled } required>{ zoneRecordParsedField(recordType, value, "text") }</textarea></label>
		case "SRV":
			<label class="record-field"><span>Target Host</span><input class="mono-input" name={ prefix + "target" } value={ zoneRecordParsedField(recordType, value, "target") } placeholder="server.example.com" autocomplete="off" disabled?={ disabled } required/></label>
			<div class="record-field-grid three"><label class="record-field secondary"><span>Priority</span><input type="number" name={ prefix + "priority" } min="0" max="65535" value={ ifThen(zoneRecordParsedField(recordType, value, "priority") == "", "0", zoneRecordParsedField(recordType, value, "priority")) } disabled?={ disabled } required/></label><label class="record-field secondary"><span>Weight</span><input type="number" name={ prefix + "weight" } min="0" max="65535" value={ ifThen(zoneRecordParsedField(recordType, value, "weight") == "", "0", zoneRecordParsedField(recordType, value, "weight")) } disabled?={ disabled } required/></label><label class="record-field secondary"><span>Port</span><input type="number" name={ prefix + "port" } min="0" max="65535" value={ zoneRecordParsedField(recordType, value, "port") } placeholder="80" disabled?={ disabled } required/></label></div>
		case "CAA":
			<div class="record-field-grid caa"><label class="record-field"><span>CA Domain</span><input class="mono-input" name={ prefix + "ca_domain" } value={ zoneRecordParsedField(recordType, value, "ca_domain") } placeholder="letsencrypt.org" autocomplete="off" disabled?={ disabled } required/></label><label class="record-field secondary"><span>Tag</span><select name={ prefix + "tag" } data-styled-select disabled?={ disabled }><option value="issue" selected?={ zoneRecordParsedField(recordType, value, "tag") == "" || zoneRecordParsedField(recordType, value, "tag") == "issue" }>issue</option><option value="issuewild" selected?={ zoneRecordParsedField(recordType, value, "tag") == "issuewild" }>issuewild</option><option value="iodef" selected?={ zoneRecordParsedField(recordType, value, "tag") == "iodef" }>iodef</option></select></label><label class="record-field secondary"><span>Flags</span><input type="number" name={ prefix + "flags" } min="0" max="255" value={ ifThen(zoneRecordParsedField(recordType, value, "flags") == "", "0", zoneRecordParsedField(recordType, value, "flags")) } disabled?={ disabled } required/></label></div>
		case "DS":
			<div class="record-field-grid three"><label class="record-field secondary"><span>Key Tag</span><input type="number" name={ prefix + "key_tag" } min="0" max="65535" value={ zoneRecordParsedField(recordType, value, "key_tag") } placeholder="12345" disabled?={ disabled } required/></label><label class="record-field secondary"><span>Algorithm</span>@DNSSECAlgorithmSelect(prefix + "algorithm", zoneRecordParsedField(recordType, value, "algorithm"), disabled)</label><label class="record-field secondary"><span>Digest Type</span>@DSDigestSelect(prefix + "digest_type", zoneRecordParsedField(recordType, value, "digest_type"), disabled)</label></div>
			<label class="record-field"><span>Digest</span><input class="mono-input" name={ prefix + "digest" } value={ zoneRecordParsedField(recordType, value, "digest") } placeholder="Hex digest of the child zone's KSK DNSKEY" autocomplete="off" disabled?={ disabled } required/></label>
		case "SSHFP":
			<div class="record-field-grid two"><label class="record-field secondary"><span>Algorithm</span><select name={ prefix + "algorithm" } data-styled-select disabled?={ disabled }><option value="1" selected?={ zoneRecordParsedField(recordType, value, "algorithm") == "1" }>RSA</option><option value="2" selected?={ zoneRecordParsedField(recordType, value, "algorithm") == "2" }>DSA</option><option value="3" selected?={ zoneRecordParsedField(recordType, value, "algorithm") == "3" }>ECDSA</option><option value="4" selected?={ zoneRecordParsedField(recordType, value, "algorithm") == "" || zoneRecordParsedField(recordType, value, "algorithm") == "4" }>Ed25519</option><option value="6" selected?={ zoneRecordParsedField(recordType, value, "algorithm") == "6" }>Ed448</option></select></label><label class="record-field secondary"><span>Fingerprint Type</span><select name={ prefix + "fingerprint_type" } data-styled-select disabled?={ disabled }><option value="1" selected?={ zoneRecordParsedField(recordType, value, "fingerprint_type") == "1" }>SHA-1</option><option value="2" selected?={ zoneRecordParsedField(recordType, value, "fingerprint_type") == "" || zoneRecordParsedField(recordType, value, "fingerprint_type") == "2" }>SHA-256</option></select></label></div>
			<label class="record-field"><span>Fingerprint</span><input class="mono-input" name={ prefix + "fingerprint" } value={ zoneRecordParsedField(recordType, value, "fingerprint") } placeholder="Hex fingerprint of the host key" autocomplete="off" disabled?={ disabled } required/></label>
		case "TLSA":
			<div class="record-field-grid three"><label class="record-field secondary"><span>Certificate Usage</span><select name={ prefix + "certificate_usage" } data-styled-select disabled?={ disabled }><option value="0" selected?={ zoneRecordParsedField(recordType, value, "certificate_usage") == "0" }>PKIX-TA</option><option value="1" selected?={ zoneRecordParsedField(recordType, value, "certificate_usage") == "1" }>PKIX-EE</option><option value="2" selected?={ zoneRecordParsedField(recordType, value, "certificate_usage") == "2" }>DANE-TA</option><option value="3" selected?={ zoneRecordParsedField(recordType, value, "certificate_usage") == "" || zoneRecordParsedField(recordType, value, "certificate_usage") == "3" }>DANE-EE</option></select></label><label class="record-field secondary"><span>Selector</span><select name={ prefix + "selector" } data-styled-select disabled?={ disabled }><option value="0" selected?={ zoneRecordParsedField(recordType, value, "selector") == "0" }>Full Certificate</option><option value="1" selected?={ zoneRecordParsedField(recordType, value, "selector") == "" || zoneRecordParsedField(recordType, value, "selector") == "1" }>SPKI</option></select></label><label class="record-field secondary"><span>Matching Type</span><select name={ prefix + "matching_type" } data-styled-select disabled?={ disabled }><option value="0" selected?={ zoneRecordParsedField(recordType, value, "matching_type") == "0" }>Exact</option><option value="1" selected?={ zoneRecordParsedField(recordType, value, "matching_type") == "" || zoneRecordParsedField(recordType, value, "matching_type") == "1" }>SHA2-256</option><option value="2" selected?={ zoneRecordParsedField(recordType, value, "matching_type") == "2" }>SHA2-512</option></select></label></div>
			<label class="record-field"><span>Certificate Association Data</span><textarea class="record-text-value short" name={ prefix + "certificate" } placeholder="Hex digest, or a PEM certificate to hash" disabled?={ disabled } required>{ zoneRecordParsedField(recordType, value, "certificate") }</textarea></label>
		case "SVCB", "HTTPS":
			<div class="record-field-grid mx"><label class="record-field"><span>Target Name</span><input class="mono-input" name={ prefix + "svc_target" } value={ zoneRecordParsedField(recordType, value, "svc_target") } placeholder="svc.example.com, or . for this name" autocomplete="off" disabled?={ disabled } required/></label><label class="record-field secondary"><span>Priority</span><input type="number" name={ prefix + "svc_priority" } min="0" max="65535" value={ ifThen(zoneRecordParsedField(recordType, value, "svc_priority") == "", "1", zoneRecordParsedField(recordType, value, "svc_priority")) } disabled?={ disabled } required/></label></div>
			<label class="record-field secondary"><span>Service Parameters</span><input class="mono-input" name={ prefix + "svc_params" } value={ zoneRecordParsedField(recordType, value, "svc_params") } placeholder="alpn|h2,h3|port|443" autocomplete="off" disabled?={ disabled }/><small>Pipe-separated key and value pairs. Priority 0 makes this an alias record.</small></label>
		case "URI":
			<label class="record-field"><span>URI</span><input class="mono-input" name={ prefix + "uri" } value={ zoneRecordParsedField(recordType, value, "uri") } placeholder="https://www.example.com/" autocomplete="off" disabled?={ disabled } required/></label>
			<div class="record-field-grid two"><label class="record-field secondary"><span>Priority</span><input type="number" name={ prefix + "uri_priority" } min="0" max="65535" value={ ifThen(zoneRecordParsedField(recordType, value, "uri_priority") == "", "0", zoneRecordParsedField(recordType, value, "uri_priority")) } disabled?={ disabled } required/></label><label class="record-field secondary"><span>Weight</span><input type="number" name={ prefix + "uri_weight" } min="0" max="65535" value={ ifThen(zoneRecordParsedField(recordType, value, "uri_weight") == "", "0", zoneRecordParsedField(recordType, value, "uri_weight")) } disabled?={ disabled } required/></label></div>
		case "NAPTR":
			<div class="record-field-grid four"><label class="record-field secondary"><span>Order</span><input type="number" name={ prefix + "naptr_order" } min="0" max="65535" value={ ifThen(zoneRecordParsedField(recordType, value, "naptr_order") == "", "0", zoneRecordParsedField(recordType, value, "naptr_order")) } disabled?={ disabled } required/></label><label class="record-field secondary"><span>Preference</span><input type="number" name={ prefix + "naptr_preference" } min="0" max="65535" value={ ifThen(zoneRecordParsedField(recordType, value, "naptr_preference") == "", "0", zoneRecordParsedField(recordType, value, "naptr_preference")) } disabled?={ disabled } required/></label><label class="record-field secondary"><span>Flags</span><input class="mono-input" name={ prefix + "naptr_flags" } value={ zoneRecordParsedField(recordType, value, "naptr_flags") } placeholder="S, A, U, P" disabled?={ disabled }/></label><label class="record-field secondary"><span>Services</span><input class="mono-input" name={ prefix + "naptr_services" } value={ zoneRecordParsedField(recordType, value, "naptr_services") } placeholder="E2U+sip" disabled?={ disabled }/></label></div>
			<div class="record-field-grid two"><label class="record-field secondary"><span>Regexp</span><input class="mono-input" name={ prefix + "naptr_regexp" } value={ zoneRecordParsedField(recordType, value, "naptr_regexp") } placeholder="!^.*$!sip:info@example.com!" disabled?={ disabled }/></label><label class="record-field secondary"><span>Replacement</span><input class="mono-input" name={ prefix + "naptr_replacement" } value={ zoneRecordParsedField(recordType, value, "naptr_replacement") } placeholder="Domain, or empty when regexp is set" disabled?={ disabled }/></label></div>
		case "SOA":
			<div class="record-field-grid two"><label class="record-field"><span>Primary Name Server</span><input class="mono-input" name={ prefix + "primary_ns" } value={ zoneRecordParsedField(recordType, value, "primary_ns") } placeholder="ns1.example.com" autocomplete="off" disabled?={ disabled } required/></label><label class="record-field"><span>Responsible Person</span><input class="mono-input" name={ prefix + "responsible" } value={ zoneRecordParsedField(recordType, value, "responsible") } placeholder="hostmaster.example.com" autocomplete="off" disabled?={ disabled } required/></label></div>
			<div class="record-field-grid three"><label class="record-field secondary"><span>Serial</span><input type="number" name={ prefix + "serial" } min="0" max="4294967295" value={ zoneRecordParsedField(recordType, value, "serial") } disabled?={ disabled } required/></label><label class="record-field secondary"><span>Refresh</span><input type="number" name={ prefix + "refresh" } min="0" max="4294967295" value={ zoneRecordParsedField(recordType, value, "refresh") } disabled?={ disabled } required/></label><label class="record-field secondary"><span>Retry</span><input type="number" name={ prefix + "retry" } min="0" max="4294967295" value={ zoneRecordParsedField(recordType, value, "retry") } disabled?={ disabled } required/></label></div>
			<div class="record-field-grid three"><label class="record-field secondary"><span>Expire</span><input type="number" name={ prefix + "expire" } min="0" max="4294967295" value={ zoneRecordParsedField(recordType, value, "expire") } disabled?={ disabled } required/></label><label class="record-field secondary"><span>Minimum TTL</span><input type="number" name={ prefix + "minimum" } min="0" max="4294967295" value={ zoneRecordParsedField(recordType, value, "minimum") } disabled?={ disabled } required/></label></div>
		case "FWD":
			<label class="record-field"><span>Forwarder Address</span><input class="mono-input" name={ prefix + "fwd_address" } value={ zoneRecordParsedField(recordType, value, "fwd_address") } placeholder="8.8.8.8, dns.example, or host:port" autocomplete="off" disabled?={ disabled } required/><small>This record applies to the owner name and every name below it.</small></label>
			<div class="record-field-grid two"><label class="record-field secondary"><span>Protocol</span><select name={ prefix + "fwd_protocol" } data-styled-select disabled?={ disabled }><option value="udp" selected?={ zoneRecordParsedField(recordType, value, "fwd_protocol") == "" || zoneRecordParsedField(recordType, value, "fwd_protocol") == "udp" }>UDP</option><option value="tcp" selected?={ zoneRecordParsedField(recordType, value, "fwd_protocol") == "tcp" }>TCP</option><option value="tls" selected?={ zoneRecordParsedField(recordType, value, "fwd_protocol") == "tls" }>DNS-over-TLS</option></select></label><label class="record-field secondary"><span>Priority</span><input type="number" name={ prefix + "fwd_priority" } min="0" max="65535" value={ ifThen(zoneRecordParsedField(recordType, value, "fwd_priority") == "", "0", zoneRecordParsedField(recordType, value, "fwd_priority")) } disabled?={ disabled } required/></label></div>
		default:
			<label class="record-field"><span>Value</span><input class="mono-input" name={ prefix + "value" } value={ value } placeholder="Record value" autocomplete="off" disabled?={ disabled } required/></label>
	}
}

templ DNSSECAlgorithmSelect(name, selected string, disabled bool) {
	<select name={ name } data-styled-select disabled?={ disabled }><option value="5" selected?={ selected == "5" }>RSA/SHA-1</option><option value="8" selected?={ selected == "8" }>RSA/SHA-256</option><option value="10" selected?={ selected == "10" }>RSA/SHA-512</option><option value="13" selected?={ selected == "" || selected == "13" }>ECDSA P-256/SHA-256</option><option value="14" selected?={ selected == "14" }>ECDSA P-384/SHA-384</option><option value="15" selected?={ selected == "15" }>Ed25519</option><option value="16" selected?={ selected == "16" }>Ed448</option></select>
}

templ DSDigestSelect(name, selected string, disabled bool) {
	<select name={ name } data-styled-select disabled?={ disabled }><option value="1" selected?={ selected == "1" }>SHA-1</option><option value="2" selected?={ selected == "" || selected == "2" }>SHA-256</option><option value="3" selected?={ selected == "3" }>GOST R 34.11-94</option><option value="4" selected?={ selected == "4" }>SHA-384</option></select>
}

templ ZoneDNSSECDialog(zone ZoneView, id string) {
	if zone.Type == "forwarder" || zone.Type == "stub" {
		@ZoneValidationDNSSECDialog(zone, id)
	} else {
		@ZoneSigningDNSSECDialog(zone, id)
	}
}

templ ZoneValidationDNSSECDialog(zone ZoneView, id string) {
	@components.Dialog(components.DialogProps{ID: id, Title: "DNSSEC", DescriptionContent: zoneDialogLead("Validate the answers ", zone.Name, " receives from its upstream servers."), Class: "isotope-zone-dialog zone-dnssec-dialog"}) {
		<form class="blocking-dialog-form zone-dnssec-form" hx-post="/ui/zones/dnssec" hx-target="#zones-content" hx-swap="outerHTML">
			<input type="hidden" name="zone" value={ zone.Name }/>
			<input type="hidden" name="dnssec_validation_present" value="1"/>
			<label class="zone-dynamic-toggle">
				<span><strong>Validate Responses</strong><small>Turn this off when the upstream answers for a signed delegation without serving its signatures, such as a private split-horizon copy of a public zone. The zone and everything under it is then treated as insecure instead of bogus.</small></span>
				<span class="switch"><input type="checkbox" name="dnssec_validation" value="true" checked?={ !zone.DNSSECValidationDisabled }/><span></span></span>
			</label>
			<div class="zone-dnssec-note">Sable answers this zone from its upstream servers rather than signing it, so there are no keys to manage here.</div>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Save DNSSEC", Type: "submit"})
			}
		</form>
	}
}

templ ZoneSigningDNSSECDialog(zone ZoneView, id string) {
	@components.Dialog(components.DialogProps{ID: id, Title: "DNSSEC", DescriptionContent: zoneDialogLead("Sign ", zone.Name, " and publish authenticated denial of existence."), Class: "isotope-zone-dialog zone-dnssec-dialog"}) {
		<form class="blocking-dialog-form zone-dnssec-form" hx-post="/ui/zones/dnssec" hx-target="#zones-content" hx-swap="outerHTML">
			<input type="hidden" name="zone" value={ zone.Name }/>
			<label class="zone-dynamic-toggle">
				<span><strong>Sign this zone</strong><small>Sable maintains DNSKEY, authenticated-denial, and RRSIG records and refreshes signatures automatically.</small></span>
				<span class="switch"><input type="checkbox" name="enabled" value="true" checked?={ zone.DNSSEC }/><span></span></span>
			</label>
			<label><span>Signing Algorithm</span><select name="algorithm" data-styled-select><option value="ed25519" selected?={ zone.DNSSECAlgorithm == "" || zone.DNSSECAlgorithm == "ed25519" }>Ed25519 (recommended)</option><option value="ecdsa-p256-sha256" selected?={ zone.DNSSECAlgorithm == "ecdsa-p256-sha256" }>ECDSA P-256 / SHA-256</option><option value="ecdsa-p384-sha384" selected?={ zone.DNSSECAlgorithm == "ecdsa-p384-sha384" }>ECDSA P-384 / SHA-384</option></select><small>The private key is encrypted in Sable's secret vault.</small></label>
			<div class="record-field-grid two zone-dnssec-policy">
				<label><span>ZSK Lifetime</span><input class="mono-input" name="zsk_lifetime" value={ zone.ZSKLifetime } required/><small>Automatic rotation interval; fixed units such as 30d are supported.</small></label>
				<label><span>KSK Lifetime</span><input class="mono-input" name="ksk_lifetime" value={ zone.KSKLifetime } required/><small>Starts a parent-coordinated rollover; for example, 1y.</small></label>
				<label><span>Prepublication Window</span><input class="mono-input" name="key_prepublish" value={ zone.KeyPrepublish } required/><small>Must cover the maximum DNSKEY/zone TTL.</small></label>
				<label><span>Retirement Window</span><input class="mono-input" name="key_retire_after" value={ zone.KeyRetireAfter } required/><small>Old keys remain published for cached signatures and DS records.</small></label>
			</div>
			<label><span>Authenticated Denial</span><select name="denial" data-dnssec-denial data-styled-select><option value="nsec" selected?={ zone.DNSSECDenial == "" || zone.DNSSECDenial == "nsec" }>NSEC</option><option value="nsec3" selected?={ zone.DNSSECDenial == "nsec3" }>NSEC3</option></select><small>NSEC3 hashes owner names in denial proofs. NSEC is faster and simpler.</small></label>
			<section class="zone-dnssec-nsec3" data-dnssec-nsec3 hidden?={ zone.DNSSECDenial != "nsec3" }>
				<label><span>NSEC3 Iterations</span><input type="number" name="nsec3_iterations" min="0" max="0" value={ fmt.Sprint(zone.NSEC3Iterations) } disabled?={ zone.DNSSECDenial != "nsec3" }/><small>Modern DNSSEC guidance requires zero extra iterations to avoid validator and CPU costs.</small></label>
				<label><span>NSEC3 Salt <small>(optional)</small></span><input class="mono-input" name="nsec3_salt" value={ zone.NSEC3Salt } maxlength="64" placeholder="Empty (recommended)" disabled?={ zone.DNSSECDenial != "nsec3" }/><small>Up to 32 bytes encoded as hexadecimal. An empty salt avoids unnecessary re-signing.</small></label>
			</section>
			if len(zone.DNSSECKeys) > 0 {
				<section class="zone-dnssec-status">
					<header><span class="zone-settings-section-icon signed">@Icon("shield-check")</span><span><strong>Managed KSK/ZSK Signing</strong><small>Signatures expire { zone.DNSSECExpires }</small></span></header>
					<div class="zone-dnssec-key-list">
						for index, key := range zone.DNSSECKeys {
							<section class="zone-dnssec-key">
								<header><span><strong>{ key.Role }</strong><small>Key tag { fmt.Sprint(key.KeyTag) }</small></span><span class={ "zone-dnssec-key-state " + key.State }>{ key.State }</span></header>
								if key.Timing != "" {
									<small>{ key.Timing }</small>
								}
								if key.DS != "" {
									<div class="zone-dnssec-copy"><span>DS Record (SHA-256)</span>@ZoneCopyableText(id + "-ds-" + fmt.Sprint(index), key.DS, "dnssec-record-copy")</div>
									<div class="zone-dnssec-actions">@components.Button(components.ButtonProps{Label: "Download DS", Icon: "download", Variant: components.ButtonOutline, Href: templ.SafeURL("/api/v1/zones/ds?zone=" + url.QueryEscape(zone.Name) + "&key_tag=" + fmt.Sprint(key.KeyTag))})
										if (key.State == "active" && zone.DNSSECParentDSKeyTag != key.KeyTag) || key.State == "ready" {
											@components.Button(components.ButtonProps{Label: "Confirm Parent DS", Icon: "check", Type: "submit", Attrs: templ.Attributes{"name": "key_tag", "value": fmt.Sprint(key.KeyTag), "formaction": "/ui/zones/dnssec/confirm-ds", "formmethod": "post"}})
										}
									</div>
								}
							</section>
						}
					</div>
					<div class="zone-dnssec-actions">@components.Button(components.ButtonProps{Label: "Roll ZSK", Icon: "refresh", Variant: components.ButtonOutline, Type: "submit", Attrs: templ.Attributes{"name": "role", "value": "zsk", "formaction": "/ui/zones/dnssec/rollover", "formmethod": "post"}})@components.Button(components.ButtonProps{Label: "Roll KSK", Icon: "refresh", Variant: components.ButtonOutline, Type: "submit", Attrs: templ.Attributes{"name": "role", "value": "ksk", "formaction": "/ui/zones/dnssec/rollover", "formmethod": "post"}})</div>
				</section>
				<div class="zone-dnssec-warning"><strong>Next action</strong><span>{ zone.DNSSECNextAction }</span></div>
			} else if zone.DNSSECDS != "" {
				<section class="zone-dnssec-status">
					<header><span class="zone-settings-section-icon signed">@Icon("shield-check")</span><span><strong>Zone Signed</strong><small>Key tag { fmt.Sprint(zone.DNSSECKeyTag) } · signatures expire { zone.DNSSECExpires }</small></span></header>
					<div class="zone-dnssec-copy"><span>DS Record (SHA-256)</span>@ZoneCopyableText(id + "-ds", zone.DNSSECDS, "dnssec-record-copy")</div>
					<div class="zone-dnssec-copy"><span>DNSKEY Record</span>@ZoneCopyableText(id + "-dnskey", zone.DNSSECDNSKEY, "dnssec-record-copy")</div>
					<div class="zone-dnssec-actions">@components.Button(components.ButtonProps{Label: "Download DS Record", Icon: "download", Variant: components.ButtonOutline, Href: templ.SafeURL("/api/v1/zones/ds?zone=" + url.QueryEscape(zone.Name))})</div>
				</section>
			} else {
				<div class="zone-dnssec-note">Separate KSK and ZSK material will be generated when you save. Publish the KSK DS at the parent only after confirming the signed zone is serving correctly.</div>
			}
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Save DNSSEC", Type: "submit"})
			}
		</form>
	}
}

templ ZoneSettingsDialog(zone ZoneView, id string) {
	@components.Dialog(components.DialogProps{ID: id, Title: "Zone Settings", DescriptionContent: zoneDialogLead("Configure serving and transfer policy for ", zone.Name, "."), Class: "isotope-zone-dialog zone-settings-dialog", Attrs: templ.Attributes{"data-dialog-tabs": true}}) {
		<div class="dialog-tab-list zone-settings-tabs" role="tablist" aria-label="Zone settings sections"><button class="dialog-tab active" type="button" role="tab" aria-selected="true" data-dialog-tab="general">General</button><button class="dialog-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-dialog-tab="transfers">Transfers &amp; Updates</button></div>
		<form class="blocking-dialog-form zone-settings-form" hx-post="/ui/zones/settings" hx-target="#zones-content" hx-swap="outerHTML">
			<input type="hidden" name="zone" value={ zone.Name }/>
			<section class="dialog-tab-panel zone-settings-panel" role="tabpanel" data-dialog-panel="general">
				<label><span>Zone Name</span><input class="mono-input" value={ zone.Name } readonly/></label>
				<label><span>Zone Type</span><select data-styled-select disabled>@ZoneTypeOptions(zoneTypeSelectValue(zone), true)</select></label>
				<label><span>Default TTL (seconds)</span><input type="number" name="default_ttl" min="1" max="4294967295" value={ fmt.Sprint(zone.DefaultTTL) } required/></label>
				if zone.CatalogManager != "" {
					<section class="zone-settings-section">
						<div><span class="zone-settings-section-icon">@Icon("lock")</span><span><strong>Managed by a Catalog</strong><small>Catalog <code>{ zone.CatalogManager }</code> provisioned this zone. Settings changed here would be overwritten on the next catalog refresh, so change them on the server that publishes the catalog.</small></span></div>
					</section>
				}
				if zone.Type == "catalog" {
					<section class="zone-settings-section">
						<div><span class="zone-settings-section-icon">@Icon("layers")</span><span><strong>{ zoneCatalogRoleHeading(zone) }</strong><small>{ zoneCatalogRoleDescription(zone) }</small></span></div>
						if len(zone.CatalogMembers) > 0 {
							<label><span>Member Zones</span><textarea class="mono-input" rows="4" readonly>{ strings.Join(zone.CatalogMembers, "\n") }</textarea><small>{ fmt.Sprintf("%d zone(s) in this catalog.", len(zone.CatalogMembers)) }</small></label>
						} else {
							<p class="zone-settings-empty">This catalog has no member zones yet.</p>
						}
					</section>
				}
				if len(zone.CatalogTargets) > 0 || zone.CatalogZone != "" {
					if zone.CatalogManager == "" {
						<section class="zone-settings-section">
							<div><span class="zone-settings-section-icon">@Icon("layers")</span><span><strong>Catalog Membership</strong><small>Publish this zone in a catalog so subscribed name servers provision it automatically.</small></span></div>
							<label><span>Catalog Zone</span><select class="mono-input" name="catalog_zone" data-styled-select>
								<option value="" selected?={ zone.CatalogZone == "" }>Not published in a catalog</option>
								for _, target := range zone.CatalogTargets {
									<option value={ target } selected?={ target == zone.CatalogZone }>{ target }</option>
								}
							</select></label>
							<label><span>Group (optional)</span><input class="mono-input" name="catalog_group" value={ zone.CatalogGroup } placeholder="operator-x-foo" autocomplete="off"/><small>Published as the RFC 9432 group property so a consumer can apply different settings per group.</small></label>
						</section>
					}
				}
				if zone.Type == "alias" {
					<section class="zone-settings-section">
						<div><span class="zone-settings-section-icon">@Icon("copy")</span><span><strong>Mirrored Zone</strong><small>This zone republishes the records of its source zone.</small></span></div>
						<label><span>Source Zone</span><select class="mono-input" name="alias_zone" data-styled-select required>
							for _, source := range zone.AliasSources {
								<option value={ source } selected?={ source == zone.AliasZone }>{ source }</option>
							}
						</select><small>Changing the source replaces every mirrored record and advances this zone's SOA serial.</small></label>
					</section>
				}
				<section class="zone-settings-section">
					<div><span class="zone-settings-section-icon">@Icon("key")</span><span><strong>TSIG Authentication</strong><small>Authenticate NOTIFY, AXFR, IXFR, and dynamic updates for this zone.</small></span></div>
					<label><span>Key Name</span>@TSIGKeySelect(zone.TSIGKeys, zone.TSIGKey)<small>Leave unset for source-IP and transfer-policy authorization only. Keys are managed under <a class="inline-link" href="/settings?tab=tsig">Settings &rsaquo; TSIG</a>.</small></label>
				</section>
			</section>
			<section class="dialog-tab-panel zone-settings-panel" role="tabpanel" data-dialog-panel="transfers" hidden>
				if zone.Type == "secondary" || zone.Type == "secondary_forwarder" || zone.Type == "stub" || zone.CatalogRole == "subscribed" {
					<section class="zone-settings-section first">
						<div><span class="zone-settings-section-icon">@Icon("server")</span><span><strong>Primary Name Servers</strong><small>Servers used to refresh this { zoneTypeLabel(zone.Type) } zone.</small></span></div>
						<label><span>Server Addresses</span><textarea class="mono-input" name="primary_servers" placeholder={ "192.0.2.53\nprimary.example.net:53" } required>{ strings.Join(zone.PrimaryServers, "\n") }</textarea><small>One address per line, tried in order.</small></label>
						<label><span>Protocol</span><select name="primary_protocol" data-styled-select>
							if zone.Type == "stub" {
								<option value="udp" selected?={ zone.PrimaryProtocol == "udp" }>UDP</option>
							}
							<option value="tcp" selected?={ zone.PrimaryProtocol == "" || zone.PrimaryProtocol == "tcp" }>TCP</option><option value="tls" selected?={ zone.PrimaryProtocol == "tls" }>DNS-over-TLS</option>
						</select></label>
					</section>
				}
				if zonemodel.AcceptsDynamicUpdates(zone.Type) {
				<section class="zone-settings-section first">
					<div><span class="zone-settings-section-icon">@Icon("refresh")</span><span><strong>Dynamic DNS Updates</strong><small>Accept authenticated RFC 2136 record changes for this { strings.ToLower(zoneTypeLabel(zone.Type)) } zone.</small></span></div>
					<label class="zone-dynamic-toggle"><span><strong>Allow Dynamic Updates</strong><small>Every update must be signed by the TSIG key configured above. Changes persist transactionally to the zone database, advance the SOA serial, and notify secondary servers.</small></span><span class="switch"><input type="checkbox" name="dynamic_updates" value="true" checked?={ zone.DynamicUpdates }/><span></span></span></label>
				</section>
				}
				if zone.Type != "stub" {
					<section class={ ifThen(zonemodel.AcceptsDynamicUpdates(zone.Type) || zone.Type == "secondary" || zone.CatalogRole == "subscribed", "zone-settings-section", "zone-settings-section first") }>
						<div><span class="zone-settings-section-icon">@Icon("download")</span><span><strong>Zone Transfer</strong><small>Control who may transfer this zone using AXFR or IXFR.</small></span></div>
						<label><span>Transfer Policy</span><select name="zone_transfer" data-styled-select><option value="deny" selected?={ zone.ZoneTransfer == "" || zone.ZoneTransfer == "deny" }>Deny transfers</option><option value="private" selected?={ zone.ZoneTransfer == "private" }>Private networks only</option><option value="acl" selected?={ zone.ZoneTransfer == "acl" }>Specified networks</option><option value="allow" selected?={ zone.ZoneTransfer == "allow" }>Allow any client</option></select></label>
						<label><span>Allowed Networks</span><textarea class="mono-input" name="transfer_acl" placeholder={ "192.0.2.10\n2001:db8::/64" }>{ strings.Join(zone.TransferACL, "\n") }</textarea><small>One IP address or CIDR network per line. Used by the specified-networks policy.</small></label>
					</section>
					<section class="zone-settings-section">
						<div><span class="zone-settings-section-icon">@Icon("send")</span><span><strong>Notify</strong><small>Notify secondary name servers after this zone changes.</small></span></div>
						<label><span>Secondary Servers</span><textarea class="mono-input" name="notify" placeholder={ "192.0.2.53\nsecondary.example.net:53" }>{ strings.Join(zone.Notify, "\n") }</textarea><small>One DNS server per line. Port 53 is used when no port is provided.</small></label>
					</section>
				}
			</section>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Save Settings", Type: "submit"})
			}
		</form>
	}
}

templ CloneZoneDialog(zone ZoneView, id string) {
	@components.Dialog(components.DialogProps{ID: id, Title: "Clone Zone", DescriptionContent: zoneDialogLead("Copy all records and settings from ", zone.Name, "."), Class: "isotope-zone-dialog"}) {
		<form class="blocking-dialog-form" hx-post="/ui/zones/clone" hx-target="#zones-content" hx-swap="outerHTML">
			<input type="hidden" name="zone" value={ zone.Name }/>
			<label><span>New Zone Name</span><input class="mono-input" name="name" placeholder="clone.example.com" autocomplete="off" required/></label>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Clone Zone", Type: "submit"})
			}
		</form>
	}
}

templ DeleteZoneDialog(zone ZoneView, id string) {
	@components.Dialog(components.DialogProps{ID: id, Title: "Delete Zone?", Description: "Are you sure you want to delete “" + zone.Name + "”? This will permanently delete all records in this zone. This action cannot be undone.", Class: "isotope-zone-dialog"}) {
		<form hx-post="/ui/zones/delete" hx-target="#zones-content" hx-swap="outerHTML"><input type="hidden" name="zone" value={ zone.Name }/><footer class="dialog-footer">@components.Button(components.ButtonProps{Label: "Cancel", Variant: components.ButtonOutline, Attrs: templ.Attributes{"data-dialog-close": true}})@components.Button(components.ButtonProps{Label: "Delete Zone", Destructive: true, Type: "submit"})</footer></form>
	}
}

templ ZoneImportSource(id string, placeholder string) {
	<div class="zone-import-input" data-zone-import-source>
		<div class="zone-import-modes" role="group" aria-label="Import source">
			<button type="button" data-zone-import-mode="file" aria-pressed="true">@Icon("upload") Upload file</button>
			<button type="button" data-zone-import-mode="text" aria-pressed="false">@Icon("file-text") Paste or enter text</button>
		</div>
		<div data-file-dropzone-root data-file-dropzone-state="empty" data-zone-import-panel="file">
			<label class="file-dropzone" data-file-dropzone>
				<input type="file" name="file" accept=".zone,.txt,.db,text/plain,text/dns" data-file-dropzone-input data-zone-file aria-label="Choose zone file"/>
				<span class="file-dropzone-upload-icon">@Icon("upload")</span>
				<strong>Drop your zone file here</strong>
				<span>or <span class="file-dropzone-browse">browse files</span></span>
				<small>BIND or Technitium · .zone, .txt, .db</small>
			</label>
			<div class="file-dropzone-selection" data-zone-file-selection hidden>
				@Icon("file-text")
				<div><strong data-zone-file-name></strong><small data-zone-file-size></small></div>
				<button class="button outline icon-button" type="button" data-zone-file-remove aria-label="Remove selected file">@Icon("x")</button>
			</div>
		</div>
		<div class="zone-import-editor" data-zone-import-panel="text" hidden>
			<div class="zone-import-editor-heading"><label for={ id + "-text" }>Zone file contents</label>@components.Button(components.ButtonProps{Label: "Paste from clipboard", Variant: components.ButtonOutline, Attrs: templ.Attributes{"data-zone-clipboard": true}})</div>
			<textarea id={ id + "-text" } name="zone_text" data-zone-import-text placeholder={ placeholder } spellcheck="false" disabled></textarea>
			<p class="zone-import-help">Paste your zone file or type records in BIND format.</p>
		</div>
		<p class="zone-import-help" data-file-dropzone-status data-zone-import-status role="status" aria-live="polite"></p>
	</div>
}

templ ImportNewZoneDialog() {
	@components.Dialog(components.DialogProps{ID: "import-new-zone-dialog", TitleID: "import-new-zone-title", Title: "Import Zone", Description: "Create a primary zone from a BIND or Technitium zone file.", Class: "isotope-zone-import-dialog"}) {
		<form class="blocking-dialog-form zone-import-form" hx-post="/ui/zones/import-new" hx-encoding="multipart/form-data" hx-target="#zones-content" hx-swap="outerHTML">
			@ZoneImportSource("import-new-zone", "$ORIGIN example.com.\n@  3600  IN  SOA  ns1.example.com. hostmaster.example.com. 1 3600 600 1209600 300")
			<label><span>Zone name <small>Optional</small></span><input class="mono-input" name="zone" placeholder="example.com" autocomplete="off" data-zone-import-name aria-describedby="import-new-zone-help"/></label>
			<p class="zone-import-help" id="import-new-zone-help" data-zone-name-help aria-live="polite">Detected automatically from <code>$ORIGIN</code> or the SOA record. Enter a name only if your file doesn’t include one.</p>
			@components.DialogFooter("Cancel") {
				@components.Button(components.ButtonProps{Label: "Import Zone", Type: "submit", Disabled: true, Attrs: templ.Attributes{"data-zone-import-submit": true}})
			}
		</form>
	}
}


// zoneDialogLead sets a zone name in code inside a dialog's description.
templ zoneDialogLead(before, name, after string) {
	{ before }<code>{ name }</code>{ after }
}

// zoneConversionLead names the zone a conversion makes writable.
templ zoneConversionLead(name string) {
	Make Sable the writable source for <strong>{ name }</strong>.
}

templ ConvertPrimaryDialog(zone ZoneView, id string) {
 @components.Dialog(components.DialogProps{ID: id, Title: ifThen(zone.Type == "secondary_forwarder", "Convert to independent Forwarder", "Convert to Primary Zone"), DescriptionContent: zoneConversionLead(zone.Name), Class: "isotope-zone-dialog zone-conversion-dialog"}) {
  <form class="blocking-dialog-form zone-conversion-form" hx-post="/ui/zones/convert-primary" hx-target="#zones-content" hx-swap="outerHTML">
   <input type="hidden" name="zone" value={ zone.Name }/>
   <input type="hidden" name="confirmation" value={ zone.ConversionFingerprint }/>
   <div class="integration-facts zone-conversion-facts">
 <div class="zone-conversion-source"><span class="integration-fact-label">Current source</span><span class="integration-fact-value">{ strings.Join(zone.PrimaryServers, ", ") }</span></div>
 <div><span class="integration-fact-label">SOA serial</span><span class="integration-fact-value">{ fmt.Sprint(zone.ConversionSerial) }</span></div>
 <div><span class="integration-fact-label">Records</span><span class="integration-fact-value">{ fmt.Sprint(len(zone.Records)) }</span></div>
 </div>
   if zone.ConversionError != "" {
    if strings.Contains(zone.ConversionError, "DNSSEC") || strings.Contains(zone.ConversionError, "signed zones") {
 <div class="warning-box zone-conversion-warning" role="alert">@Icon("alert-triangle")<div><strong>DNSSEC transition required</strong><p>{ zone.ConversionError }</p></div></div>
 <details class="dnssec-migration-details"><summary>How to migrate this zone</summary>@DNSSECMigrationSteps()</details>
 } else if strings.Contains(zone.ConversionError, "belongs to a Sable catalog") {
 <div class="cluster-dialog-note zone-conversion-info">@Icon("info")<p><strong>Managed by a Sable catalog</strong><span>Catalog: <a href={ zoneHref(zone.CatalogZone) }>{ zone.CatalogZone }</a></span><span>This zone can’t be converted while the catalog manages it. Conversion does not detach zones from catalogs.</span><span>Import from Catalog can create independent Secondaries, but it skips zones that already exist in Sable. It won’t replace or detach this managed zone.</span></p></div>
 } else {
 <p class="zone-conversion-notice" role="alert">{ zone.ConversionError }</p>
 }
   } else {
    <p class="zone-import-help">Records, permissions, and history stay in place. The serial advances and synchronization from the current source stops.</p>
    <label><span>Final synchronization</span><select name="final_sync" data-styled-select>
     if zone.CanTransfer {
      <option value="true" selected>Synchronize, then convert</option>
     }
     <option value="false">Use the stored snapshot</option>
    </select></label>
    <p class="zone-import-help">If synchronization fails, the zone stays Secondary. A stored snapshot may contain stale or expired data.</p>
    <div class="zone-import-options">
     @components.ChoiceCard(components.ChoiceCardProps{ID: "zone-convert-freeze", Title: "Source writes are paused", Description: "I have stopped edits and automatic updates on the current source.", Style: components.ChoiceRow, Name: "freeze_confirmed", Value: "true", Required: true})
    </div>
    <p class="zone-import-help">Before moving clients, verify Sable and its replicas. SOA and NS targets remain unchanged; review them before retiring the source.</p>
   }
   <footer class="dialog-footer">
 if zone.ConversionError != "" {
 @components.Button(components.ButtonProps{Label: "Close", Variant: components.ButtonOutline, Attrs: templ.Attributes{"data-dialog-close": true}})
 } else {
 @components.Button(components.ButtonProps{Label: "Cancel", Variant: components.ButtonOutline, Attrs: templ.Attributes{"data-dialog-close": true}})
 @components.Button(components.ButtonProps{Label: ifThen(zone.Type == "secondary_forwarder", "Convert to independent Forwarder", "Convert to Primary"), Icon: "crown", Type: "submit", Attrs: templ.Attributes{"data-replica-primary-action": true}})
 }
 </footer>
  </form>
 }
}

// Shared by conversion and catalog import blockers.
templ DNSSECMigrationSteps() {
 <div class="dnssec-migration-steps">
 <ol>
 <li>If a parent DS record exists, remove it and wait for cached DS records to expire while Technitium continues signing. Update any private trust anchors too.</li>
 <li>Disable DNSSEC for the source zone in Technitium, then resync the Sable Secondary to fetch the unsigned zone. If the import was blocked, retry importing after the source is unsigned.</li>
 <li>Pause source edits and automatic writers, then convert to Primary or import as Primary.</li>
 <li>Enable DNSSEC in Sable if required. Verify signing on all new authorities and allow old delegation and DNSKEY caches to expire before publishing Sable’s new DS record or trust anchor.</li>
 </ol>
 <p class="zone-import-help">This path temporarily suspends DNSSEC validation. Migration with uninterrupted DNSSEC requires coordinated key handling that this flow does not support.</p>
 </div>
}
